  "body": [
    {
      "tag": "p",
      "attributes": {},
      "text": "śrī gaṇapataye namaḥ |",
      "segment_number": 1
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ādyantāntargatānantaśaktiviśrāntinirbharām |",
          "segment_number": 2
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "anuccāryām ahaṃ vācam adhīye hṛdayaṃ vibhoḥ || 1 ||",
          "segment_number": 3
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sa eva bhairavo devas sarve devāś ca yanmayāḥ |",
          "segment_number": 4
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "saivāsau bhairavī sattāsattāpi ca yanmayī || 2 ||",
          "segment_number": 5
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tad eva bhairavaṃ jñānam ajñānam api yanmayam |",
          "segment_number": 6
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sa hi bhairavasiddhāntaḥ pūrvapakṣo 'pi yanmayaḥ || 3 ||",
          "segment_number": 7
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "aikadhyam adhvanāṃ ṣa.ṅnāṃ yatra sā bhairavī sthitiḥ |",
          "segment_number": 8
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "paryante sarvatantrāṇām avācyā paramā gatiḥ || 4 ||",
          "segment_number": 9
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sā cidānandamātrātmamagnecchājñānasatkriyā |",
          "segment_number": 10
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "hṛdayaṃ devadevasya bhairavasyāvibhāgabhūḥ || 5 ||",
          "segment_number": 11
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "citsvābhāvyād asau devaḥ svātmanā vimṛṣan prabhuḥ |",
          "segment_number": 12
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "anāśritādibhūmyantā bhūmikāḥ pratipadyate || 6 ||",
          "segment_number": 13
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tatra vācakavācyātmaspandayor ekaśaḥ prabhoḥ |",
          "segment_number": 14
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sthūlasūkṣmaparābhāsakramayoḥ ṣaḍvidhādhvatā || 7 ||",
          "segment_number": 15
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kramo yo deśakālātmā bhedaprāṇas sa saṃvidām |",
          "segment_number": 16
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vicchedād eṣa vijñātur vicitrābhāsatākṛtaḥ || 8 ||",
          "segment_number": 17
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ubhayo tatra vai rītiḥ śuddhāśuddhātmabhedataḥ |",
          "segment_number": 18
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śuddhir bahiṣkṛtārthānāṃ svāhantāyāṃ nimajjanam || 9 ||",
          "segment_number": 19
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "aśuddhir api magnānāṃ naivaṃ hṛdayaviśramaḥ |",
          "segment_number": 20
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "atrāntare 'py anantās syuḥ sthitayas tāratamyataḥ || 10 ||",
          "segment_number": 21
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ucitocitameyānāṃ pramātṝṇāṃ prakāśane |",
          "segment_number": 22
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sādhāraṇānyathābhāvau bhidyete mātṛmeyayoḥ || 11 ||",
          "segment_number": 23
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "avikalpasphuṭābhāsā sā sṛṣṭiḥ śāmbhavī matā |",
          "segment_number": 24
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "abhedenātmanirmāṇe svātmaiva karaṇīkṛtaḥ || 12 ||",
          "segment_number": 25
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kriyājñānātmacicchaktir bhedāsūtraṇakāraṇāt |",
          "segment_number": 26
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kalāvidyāpadaṃ prāpya bhedodbhede punar bhavet || 13 ||",
          "segment_number": 27
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pramāṇabuddhiprakarā yatkriyāyā vikalpanāḥ |",
          "segment_number": 28
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "saiva vicchinnavicchinnakriyā jñānodyamā yadā || 14 ||",
          "segment_number": 29
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "karmabuddhyakṣatāṃ prāptā tadāsau paśur ucyate |",
          "segment_number": 30
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "itīcchayā sa bhagavān bhairavaḥ parimīyate || 15 ||",
          "segment_number": 31
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "mitavṛttis satī sā ca śaktis tam anuvartate |",
          "segment_number": 32
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tasya vidyeśasādākhyaśivatās saṃkucatsthiteḥ |",
          "segment_number": 33
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dehaprāṇabuddhiśūnyapramātṛtvam upāgaman || 16 ||",
          "segment_number": 34
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tasyāsādhāraṇī sṛṣṭis tattannānāvikalpanā |",
          "segment_number": 35
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śaivasargotthasaṃskārasaṃskṛtasya tadāśrayā || 17 ||",
          "segment_number": 36
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pramātaivāyam etāvatprakāro 'vagrahotsave |",
          "segment_number": 37
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "avyagro vartate svātmany avikalpe cidātmake || 18 ||",
          "segment_number": 38
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vatsa paśya tvam evaitat advayatvena saṃvidaḥ |",
          "segment_number": 39
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "viditaṃ tanmayaṃ viśvam anyat tuccham asad yataḥ || 19 ||",
          "segment_number": 40
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kim upāyam idaṃ tattvaṃ yato 'nyan naiva sambhavi |",
          "segment_number": 41
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ananyopāyam etat tadātmopāyaṃ pracakṣate || 20 ||",
          "segment_number": 42
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "saṃhṛtya sarvataś cintām [aha]m ity anuśīlayan |",
          "segment_number": 43
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "avikalpāṃ svasaṃvittiṃ pratyakṣāṃ pratipadyate || 21 ||",
          "segment_number": 44
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "anantaitāvadākārasvīkāre 'py ekalakṣaṇām |",
          "segment_number": 45
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tāṃ svasaṃvidam āviśya vikalpān na vikalpayet || 22 ||",
          "segment_number": 46
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "khecaryādicatussrotovāhapūrṇamahāhradām |",
          "segment_number": 47
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vyomeśvarīm ātmacitiṃ vigāhya broḍayej jaḍam || 23 ||",
          "segment_number": 48
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sargasthāpanasaṃhāranigrahānugrahakramāt |",
          "segment_number": 49
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pañcakṛtyāni kurvāṇaḥ śivo 'ham iti viśvaset || 24 ||",
          "segment_number": 50
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kṣepajñānaprasaṃkhyā[naga]tinādakrameṇa vā |",
          "segment_number": 51
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "guruvaktreṇa tāny ātmany ākalayya kṛtī bhavet || 25 ||",
          "segment_number": 52
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vikalpayitvā viśvātmā bhairavo 'haṃ mamaiva tāḥ |",
          "segment_number": 53
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "viśvabhaṅgyo yathā vahner jvālābhaṅgyaḥ prabhā raveḥ || 26 ||",
          "segment_number": 54
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "eko 'haṃ mātṛvijñānamānameyaprakāravān |",
          "segment_number": 55
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śuddhabodhādirūpeṇa khecaryādicaturdaśaḥ || 27 ||",
          "segment_number": 56
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "medāmedaprakāreṇa bandhamokṣau vibhāvayan |",
          "segment_number": 57
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhairavo 'smīti visrambhāt svācchandyaṃ paramaṃ vrajet || 28 ||",
          "segment_number": 58
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "antaḥkārabahiṣkārāv akālakramam ātmanaḥ |",
          "segment_number": 59
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "aparādhīnam ādhatse yat tvaṃ prābhavanirbharaḥ || 29 ||",
          "segment_number": 60
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "anuttaravisargātmaviśramodayayāmalam |",
          "segment_number": 61
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "saṃghaṭṭaś śivaśaktyos tadantare cānyaśaktayaḥ || 30 ||",
          "segment_number": 62
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ānandeccheśanonmeṣā ūnatā ceśanecchayoḥ |",
          "segment_number": 63
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "asphuṭasphuṭabhedena vedyollāsas tayor vidaḥ || 31 ||",
          "segment_number": 64
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ānandānuttarābhyāṃ ca sandhībhāvo 'tha vedanā |",
          "segment_number": 65
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vedyānāṃ prāṇabhūteti pūrṇaṃ tad bhairavaṃ vapuḥ || 32 ||",
          "segment_number": 66
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vedyollāso 'yam icchāyām īśane caikataḥ sthitaḥ |",
          "segment_number": 67
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sthūlatvena pṛthivyādibhūtapañcakatām iyāt || 33 ||",
          "segment_number": 68
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sūkṣmatvena ca gandhādipañcatanmātratāṃ tataḥ |",
          "segment_number": 69
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "karaṇatvena saṃsparśād indriyāṇāṃ dvipañcatām || 34 ||",
          "segment_number": 70
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vedyatāyāḥ chādanena vettṛtodbhāsanakrame |",
          "segment_number": 71
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "mano 'haṃbuddhitāṃ eṣām avibhāge pradhānatām |",
          "segment_number": 72
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "puruṣatvaṃ ca saṃkocavikāsau yadapekṣayā || 35 ||",
          "segment_number": 73
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "abhūvann iṣyasaṃyogād dvirūpād ubhayātmanaḥ |",
          "segment_number": 74
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "icchāsvarūpād unmeṣād anyathānuttarāyutāt || 36 ||",
          "segment_number": 75
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "catasraś śaktyo 'ntaḥsthāḥ puṃso 'syāntaś ca dhārikāḥ |",
          "segment_number": 76
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "cidvyomno jaḍabhūmeś ca māyāmayyas triśaṅkuvat || 37 ||",
          "segment_number": 77
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "icchāśaktes trirūpāyās tisro 'nyāś śaktyo 'bhavan |",
          "segment_number": 78
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "visargo 'yam athātyarthaṃ sphuṭo 'bhūt sṛjyavistarāt || 38 ||",
          "segment_number": 79
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "etat sṛṣṭvātmaśaktīnām itaretaramiśrāt |",
          "segment_number": 80
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhavet kṣobhāntaraṃ nāsmād visargād bāhyato bhavet || 39 ||",
          "segment_number": 81
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "iyatsarvaṃ sad icchādidvārānuttarabhairave |",
          "segment_number": 82
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "viśramya viśramya muhus tata eva visṛjyate || 40 ||",
          "segment_number": 83
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "antarnilīnānantārthasvātmāmarśaś citiḥ parā |",
          "segment_number": 84
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ekavāravahād yeyaṃ mantrī vāk śuddhakartṛtā || 41 ||",
          "segment_number": 85
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "trivahaṃ tripathaṃ tristhaṃ kālaṃ sā karṣati svataḥ |",
          "segment_number": 86
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bahis tataś cātmanīti śrīparā kālakarṣiṇī || 42 ||",
          "segment_number": 87
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bheditāntaḥkṛtākha.ṅdabhāvāvekṣā parāparā |",
          "segment_number": 88
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kartṛtā saiva paśyantī tasyaiveśadaśāśrayā || 43",
          "segment_number": 89
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "madhyamā sakramā sthūlā antaḥkaraṇavartinī |",
          "segment_number": 90
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vikalpanābhinnavācyā prāṇavṛttivibheditā || 44 ||",
          "segment_number": 91
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "svavāsanātādavasthyād daśayoḥ pūrvayor api |",
          "segment_number": 92
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "māyāmātur mitatvaṃ syāt paśyantyāś ca kramo hy aṇuḥ || 45 ||",
          "segment_number": 93
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tayor āviśya daśayoḥ kramāc chāntavikalpayoḥ |",
          "segment_number": 94
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dhanyas svasaṃvidvistāraṃ sāścaryam anupaśyati || 46 ||",
          "segment_number": 95
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sā sthānakaraṇāghātapuṃvyāpārātmikā satī |",
          "segment_number": 96
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vaikharī vṛttayo yasyāstā imāḥ śrutigocarāḥ || 47 ||",
          "segment_number": 97
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ābhiḥ parasparaṃ jñānasaṃkrāntyātmā sa laukikaḥ |",
          "segment_number": 98
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vyavahāro 'tha śāstrīyo nānāsaṃkocasaṃkaṭaḥ || 48 ||",
          "segment_number": 99
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "iti vāgvyāptividvāṃsam etadvargādhidevatāḥ |",
          "segment_number": 100
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "māheśvarīmukhā devyo jāgare 'pi na bhuñjate || 49 ||",
          "segment_number": 101
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "upāyenāgrahaḥ kārya upeyā bhairavīsthitiḥ |",
          "segment_number": 102
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yāsau svasaṃvit tām eva sarvopāyāṃ samāviśet || 50 ||",
          "segment_number": 103
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ādyantāntargatānantavācyavācakanirbharam |",
          "segment_number": 104
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "rahasyaṃ mantramudrāṇāṃ prapadye 'nuttaraṃ mahaḥ || 51 ||",
          "segment_number": 105
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "śambhor abhinnahṛdayā jayanti guravaḥ purā |",
          "segment_number": 106
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nirvyutthānasamādhānaprāptaparyantasaṃpadaḥ || 52 ||",
          "segment_number": 107
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "|| namaḥ śivāya ||",
      "segment_number": 108
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "|| paripūrṇā kṛtir iyaṃ śrimadābhinavaguptanāthasya",
      "segment_number": 109
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "paryantapañcāśikā nāma ||",
      "segment_number": 110
