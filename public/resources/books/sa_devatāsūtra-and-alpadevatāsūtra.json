              "segment_number": 82
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "kena svargam avāpnoti kena mokṣaṃ ca gacchati / 19",
              "segment_number": 83
            },
            {
              "tag": "text",
              "text": "bhagavān āha /\n  tyāgān mitrāṇi vardhante maitryā śāmyanti śatravaḥ\n  śīlā",
              "segment_number": 84
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "t",
              "segment_number": 85
            },
            {
              "tag": "text",
