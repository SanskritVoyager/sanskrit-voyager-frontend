              "segment_number": 86
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "Ds; GBM 1544.8",
              "segment_number": 87
            },
            {
              "tag": "text",
              "text": ")\ndevatā prāha /\n  idaṃ saṃśayam adyāpi mama tvaṃ chettum arhasi /\n  asmāl lokā",
              "segment_number": 88
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "t pa",
              "segment_number": 89
            },
            {
              "tag": "text",
              "text": "raṃ lokaṃ ko gato 'tyantavaṃcitaḥ / 21 (",
              "segment_number": 90
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "Ds; GBM 1545.1",
              "segment_number": 91
            },
            {
              "tag": "text",
              "text": ")\nbhagavān āha /\n  vidyamāneṣu bhogeṣu puṇyaṃ yena na saṃcitaṃ /",
              "segment_number": 92
            },
            {
              "tag": "l",
              "attributes": {},
