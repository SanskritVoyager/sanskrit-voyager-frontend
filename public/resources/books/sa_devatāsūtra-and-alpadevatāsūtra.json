          "text": "Devatāsūtra (GBM 1542.5)",
          "segment_number": 1
        },
        {
          "tag": "p",
          "attributes": {},
          "text": "evaṃ mayā śrutam ekasmiṃ samaye bhagavāṃ cchrāvastyāṃ viharati sma (",
          "children": [
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "Ds; GBM 1542.6",
              "segment_number": 3
            },
            {
              "tag": "text",
              "text": ") jetavane 'nāthapiṇḍadasyārāme athānyatamā devatā atikrāntavarṇā atikrāntāyāṃ rātryāṃ yena bhagavāṃs tenopasaṃkrāntā (",
              "segment_number": 4
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "Ds; GBM 1542.7",
              "segment_number": 5
            },
            {
              "tag": "text",
              "text": ") upasaṃkramya bhagavataḥ pādau śirasā vanditvā ekānte niṣaṇṇā / atha tasyā devatāyā varṇānubhāvena sarvaṃ jetavanaṃ udāreṇāvabhāse",
              "segment_number": 6
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "na",
              "segment_number": 7
            },
            {
              "tag": "text",
              "text": "(",
              "segment_number": 8
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "Ds; GBM 1542.8",
              "segment_number": 9
            },
            {
              "tag": "text",
              "text": ") sphuṭam abhūt / ekānte niṣaṇṇā sā devatā tasyāṃ velāyām imāṃ gāthām abhāṣata\n  kiṃ nu taṃ niśitaṃ śastraṃ kiṃ vā hālāhalaṃ viṣaṃ /\n  ko nu prajvā",
              "segment_number": 10
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "li",
              "segment_number": 11
            },
            {
              "tag": "text",
              "text": "to vahni kiṃ vā tad dāruṇaṃ tamaḥ 1 (",
              "segment_number": 12
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "Ds; GBM 1543.1",
              "segment_number": 13
            },
            {
              "tag": "text",
              "text": ")\nbhagavān āha /\n  duṣṭā vāṅ niśitaṃ śastraṃ rāgo hālāhalaṃ viṣaṃ /\n  dveṣaḥ prajvālito vahni 'vidyā tad dāruṇaṃ tamaḥ 2\ndevatā",
              "segment_number": 14
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "prā",
              "segment_number": 15
            },
            {
              "tag": "text",
              "text": "ha (",
              "segment_number": 16
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "Ds; GBM 1543.2",
              "segment_number": 17
            },
            {
              "tag": "text",
              "text": ")\n  gṛhītaṃ kiṃ nu martyena kiṃ vā tad yad ihojjhitaṃ /",
              "segment_number": 18
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "abhedyaṃ kavacaṃ kiṃ nu kiṃ vā tīkṣṇam ihāyudhaṃ / 3",
              "segment_number": 19
            },
            {
              "tag": "text",
              "text": "bhagavān āha /\n  gṛhītaṃ yat svayaṃ dattaṃ yad gṛhe tad iho",
              "segment_number": 20
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "jjhi",
              "segment_number": 21
            },
            {
              "tag": "text",
              "text": "taṃ / (",
              "segment_number": 22
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "Ds; GBM 1543.3",
              "segment_number": 23
            },
            {
              "tag": "text",
              "text": ")",
              "segment_number": 24
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "abhedyaṃ kavacaṃ kṣānti prajñā tīkṣṇam ihāyudham / 4",
              "segment_number": 25
            },
            {
              "tag": "text",
              "text": "devatā prāha /\n  ko nv asau procyate cauro dhanaṃ kiṃ vā satāṃ mataṃ /\n  ke vā sadevake loke pro",
              "segment_number": 26
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "cya",
              "segment_number": 27
            },
            {
              "tag": "text",
              "text": "nte muṣitā iti / 5 (",
              "segment_number": 28
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "Ds; GBM 1543.4",
              "segment_number": 29
            },
            {
              "tag": "text",
              "text": ")\nbhagavān āha /\n  vitarkaḥ kuśalaś cauro dhanaṃ śīlaṃ satāṃ mataṃ /\n  te cāpi muṣitā loke yaiḥ śīlaṃ vinipātitam / 6 (",
              "segment_number": 30
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "Ds; GBM 1543.5",
              "segment_number": 31
            },
            {
              "tag": "text",
              "text": ")\ndevatā prāha /\n  ko nv asau sukhito jñeya ko vā yaḥ parameśvaraḥ\n  ko vā vibhūṣito nityaṃ brūhi ko vā viḍaṃbitaḥ 7\nbhagavān āha / (",
              "segment_number": 32
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "Ds; GBM 1543.6",
              "segment_number": 33
            },
            {
              "tag": "text",
              "text": ")\n  alpecchaḥ sukhito jñeyaḥ saṃtuṣṭo parameśvaraḥ\n  śīlavāṃ vibhūṣito nityaṃ bhraṣṭaśīlo viḍaṃbitaḥ 8\ndevatā prāha /\n  kiṃ svid agnir na dahati na bhi",
              "segment_number": 34
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "na",
              "segment_number": 35
            },
            {
              "tag": "text",
              "text": "tti ca mārutaḥ (",
              "segment_number": 36
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "Ds; GBM 1543.7",
              "segment_number": 37
            },
            {
              "tag": "text",
              "text": ")",
              "segment_number": 38
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "kiṃ svin na kledayanty āpaḥ plāvayanto vasundharām / 9",
              "segment_number": 39
            },
            {
              "tag": "text",
              "text": "bhagavān āha /\n  puṇyam agnir na dahati na bhinatti ca mārutaḥ\n  puṇyaṃ na kledayan",
              "segment_number": 40
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "ty",
              "segment_number": 41
            },
            {
              "tag": "text",
              "text": "āpaḥ plāvayanto vasundharām / 10 (",
              "segment_number": 42
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "Ds; GBM 1543.8",
              "segment_number": 43
            },
            {
              "tag": "text",
              "text": ")\ndevatā prāha /\n  kiṃ svid rājā ca caurāś ca spandamānā samudyatā /\n  nāpahartuṃ śaknuvanti striyā vā puruṣa",
              "segment_number": 44
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "sya",
              "segment_number": 45
            },
            {
              "tag": "text",
              "text": "vā / 11 (",
              "segment_number": 46
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "Ds; GBM 1544.1",
              "segment_number": 47
            },
            {
              "tag": "text",
              "text": ")\nbhagavān āha /\n  puṇyaṃ rājā ca caurāś ca spandamānā samudyatā /",
              "segment_number": 48
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "nāpahartuṃ śaknuvanti striyā vā puruṣasya vā / 12",
              "segment_number": 49
            },
            {
              "tag": "text",
              "text": "devatā prāha /\n  vatsalo bā",
              "segment_number": 50
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "ndha",
              "segment_number": 51
            },
            {
              "tag": "text",
              "text": "vaḥ ko 'sau ko vā duṣṭāśayo ripuḥ (",
              "segment_number": 52
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "Ds; GBM 1544.2",
              "segment_number": 53
            },
            {
              "tag": "text",
              "text": ")",
              "segment_number": 54
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "kiṃ vā tad dāruṇaṃ duḥkhaṃ kiṃ vā paramaṃ sukham / 13",
              "segment_number": 55
            },
            {
              "tag": "text",
              "text": "bhagavān āha /\n  vatsalo bāndhavaḥ puṇyaṃ pāpaṃ duṣṭāśayo ri",
              "segment_number": 56
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "puḥ",
              "segment_number": 57
            },
            {
              "tag": "text",
              "text": "(",
              "segment_number": 58
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "Ds; GBM 1544.3",
              "segment_number": 59
            },
            {
              "tag": "text",
              "text": ")",
              "segment_number": 60
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "nārakaṃ dāruṇaṃ duḥkhaṃ śuddhā bhāvaḥ paramaṃ sukham / 14",
              "segment_number": 61
            },
            {
              "tag": "text",
              "text": "devatā prāha /\n  kenāyam āvṛto lokaḥ kena loko vaśīkṛtaḥ\n  kena tyajati mitrāṇi",
              "segment_number": 62
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "ke",
              "segment_number": 63
            },
            {
              "tag": "text",
              "text": "na svargaṃ na gacchati / 15 (",
              "segment_number": 64
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "Ds; GBM 1544.4",
              "segment_number": 65
            },
            {
              "tag": "text",
              "text": ")\nbhagavān āha /\n  ajñānenāvṛto loko mohena ca vaśīkṛtaḥ\n  lobhāt tyajati mitrāṇi saṃgāt svargaṃ na gaccha",
              "segment_number": 66
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "ti",
              "segment_number": 67
            },
            {
              "tag": "text",
              "text": "/ 16 (",
              "segment_number": 68
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "Ds; GBM 1544.5",
              "segment_number": 69
            },
            {
              "tag": "text",
              "text": ")\ndevatā prāha /\n  kiṃ tat priyam apathyaṃ ca kiṃ vā pathyaṃ na ca priyaṃ",
              "segment_number": 70
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "ko vā pīḍākaro vyādhiḥ ko 'sāv eko bhiṣag varaḥ / 17",
              "segment_number": 71
            },
            {
              "tag": "text",
              "text": "bhagavān āha /",
              "segment_number": 72
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "kā",
              "segment_number": 73
            },
            {
              "tag": "text",
              "text": "māḥ priyā apathyāś ca mokṣaḥ pathyo na ca priyaḥ (",
              "segment_number": 74
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "Ds; GBM 1544.6",
              "segment_number": 75
            },
            {
              "tag": "text",
              "text": ")",
              "segment_number": 76
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "rāgaḥ pīḍākaro vyādhir buddhaś caiko bhiṣag varaḥ / 18",
              "segment_number": 77
            },
            {
              "tag": "text",
              "text": "devatā prāha /\n  kena mitrāṇi vardhante ke",
              "segment_number": 78
            },
            {
              "tag": "hi",
              "attributes": {
                "rend": "bold"
              },
              "text": "na",
              "segment_number": 79
            },
            {
              "tag": "text",
              "text": "śāmyanti śatravaḥ (",
              "segment_number": 80
