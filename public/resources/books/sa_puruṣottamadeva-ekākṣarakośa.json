  "body": [
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "akāro vāsudevaḥ syād ākāraś ca pitāmahaḥ /",
          "segment_number": 1
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pūjāyām api māṅgalye ākāraḥ parikīrttitaḥ // PEk_1",
          "segment_number": 2
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ikāro ucyate kāmo lakṣmī rīkāra ucyate /",
          "segment_number": 3
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ukāraḥ śaṅkaraḥ prokta ūkāraś cāpi rakṣaṇe // PEk_2",
          "segment_number": 4
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ṛkāro devamātā syād ṝkāro danujaprasūḥ /",
          "segment_number": 5
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ḷkāro devayoniḥ syāl ḹr mātā sadbhir ucyate // PEk_3",
          "segment_number": 6
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ekāraḥ kathito viṣṇur aikāraś ca maheśvaraḥ /",
          "segment_number": 7
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "okāras tu bhaved brahmā aukāro rudra ucyate // PEk_4",
          "segment_number": 8
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "aṃ syāc ca paramaṃ brahma aḥ syād devo maheśvaraḥ /",
          "segment_number": 9
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kaḥ prajāpatir uddiṣṭo ko vāyur iti śabditaḥ // PEk_5",
          "segment_number": 10
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kaś cātmā ca samākhyātaḥ kaḥ prakāśa udāhṛtaḥ /",
          "segment_number": 11
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kaṃ śiro jalam ākhyātaṃ kaṃ sukhaṃ ca prakīrtitam // PEk_6",
          "segment_number": 12
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pṛthivyāṃ kuḥ samākhyātā kutsāyāṃ kuḥ prakīrtitaḥ /",
          "segment_number": 13
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kham indriyaṃ samākhyātaṃ kham ākāśam udāhṛtam // PEk_7",
          "segment_number": 14
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "khaṃ svarge ca samākhyātaṃ khaṃ sarpe ca prakīrtitaṃ /",
          "segment_number": 15
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tathā śvabhre ca khaṃ prāhuḥ khaṃ śūnye ca prakīrttitam // PEk_8",
          "segment_number": 16
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "go gaṇapatir uddiṣṭo go gandharvaḥ prakīrttitaḥ /",
          "segment_number": 17
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "gaṃ gītaṃ gā ca gāthā syād gaur dhenur gauḥ sarasvatī // PEk_9",
          "segment_number": 18
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "gaur mātāpi samuddiṣṭā pṛthivyāṃ gauḥ prakīrttitā /",
          "segment_number": 19
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "gho ghaṇṭāyāṃ samākhyātaḥ kiṅkiṇī ghā prakīrttitā // PEk_10",
          "segment_number": 20
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "upamā ghā samākhyātā kusvare ghuḥ prakīrttitaḥ /",
          "segment_number": 21
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "hanane ghā samākhyātā gandhane ghaḥ prakīrttitaḥ // PEk_11",
          "segment_number": 22
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ṅakāro bhairavaḥ khyāto ṅakāro viṣaye smṛtaḥ /",
          "segment_number": 23
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "cakāraś candramāḥ khyātas taskaraś ca prakīrttitaḥ // PEk_12",
          "segment_number": 24
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nirmalaṃ chaṃ samākhyātaṃ taraṇī chaḥ prakīrttitaḥ /",
          "segment_number": 25
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "chedane chaḥ samākhyāto vidvadbhiḥ śabdakovidaiḥ // PEk_13",
          "segment_number": 26
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vegite jaḥ samākhyāto jaghane jaḥ prakīrttitaḥ /",
          "segment_number": 27
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "jetā ca jaḥ samākhyātaḥ prasiddhaiḥ śabdakovidaiḥ // PEk_14",
          "segment_number": 28
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "jhaṃjhāvāte jhakāraḥ syān naṣṭe jhaḥ samudāhṛtaḥ /",
          "segment_number": 29
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ñakāro gāyane prokto ñakāro ghargharadhvanau // PEk_15",
          "segment_number": 30
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ṭaṅkāre ṭaḥ pṛthivyāṃ ṭā ṭo dhvanau ca prakīrtitaḥ /",
          "segment_number": 31
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ṭho maheśvara ākhyātaḥ śūnye ca ṭhaḥ prakīrtitaḥ // PEk_16",
          "segment_number": 32
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bṛhaddhvanau ca ṭhaḥ proktas tathā candrasya maṇḍale /",
          "segment_number": 33
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ḍakāraḥ śaṅkaraḥ proktas trāsadhvanyoḥ prakīrtitaḥ // PEk_17",
          "segment_number": 34
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ḍhakāraḥ kīrtitā ḍhakkā nirguṇe ca dhvanāv api /",
          "segment_number": 35
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ṇakāraḥ kīrtito jñāne nirṇaye 'pi prakīrtitaḥ // PEk_18",
          "segment_number": 36
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "takāraḥ kathitaś cauraḥ kroḍe pucche prakīrtitaḥ /",
          "segment_number": 37
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śiloccaye thakāraḥ syāt thakāro bhayarakṣaṇe // PEk_19",
          "segment_number": 38
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "daṃ kalatre samākhyātaṃ do dānacchedadhātuṣu /",
          "segment_number": 39
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dhaṃ dhane ca dhaneśe dho dhā dhātari nidarśitaḥ // PEk_20",
          "segment_number": 40
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "dhiṣaṇā dhīḥ samākhyātā dhūś ca syād bhāracintayoḥ /",
          "segment_number": 41
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nakāraḥ sugate bandhe nuḥ stutau ca prakīrtitaḥ // PEk_21",
          "segment_number": 42
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "netā nīś ca samākhyātas taraṇau nauḥ prakīrtitā /",
          "segment_number": 43
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nakāraḥ saugate buddhau stuto sūrye ca kīrtitaḥ // PEk_22",
          "segment_number": 44
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "naśabdaḥ svāgate bandhau vṛkṣe sūrye ca kīrtitaḥ /",
          "segment_number": 45
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "paḥ kuberaḥ samākhyātaḥ paścime ca prakīrtitaḥ // PEk_23",
          "segment_number": 46
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pavane paḥ samākhyātaḥ pāḥ pāne pāś ca pātari /",
          "segment_number": 47
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kaphe vāte phakāraḥ syāt tathāhvāne prakīrtitaḥ // PEk_24",
          "segment_number": 48
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "jhaṃjhāvāte phakāraḥ syād akṣare ca prakīrtitaḥ /",
          "segment_number": 49
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kope phiś ca samākhyātas tathā niṣphalabhāṣaṇe // PEk_25",
          "segment_number": 50
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vakṣaḥsthale ca baḥ prokto gadāyāṃ samudāhṛtaḥ /",
          "segment_number": 51
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nakṣatraṃ bhaṃ budhaiḥ proktaṃ bhramare bhaḥ prakīrtitaḥ // PEk_26",
          "segment_number": 52
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bhā dīptir api bhūr bhūmir bhīr bhayaṃ kathitā budhaiḥ /",
          "segment_number": 53
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "maḥ śivaś candramā vedhā mā ca lakṣmīḥ prakīrtitā // PEk_27",
          "segment_number": 54
        }
      ]
    }
  ]
}