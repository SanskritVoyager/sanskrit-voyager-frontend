  "body": [
    {
      "tag": "p",
      "attributes": {},
      "text": "Vajrasūcī (Vs)",
      "segment_number": 1
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "jagadguruṃ mañjughoṣaṃ natvā vākkāyacetasā /",
          "segment_number": 2
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "aśvaghoṣo vajrasūcīṃ sūtrayāmi yathāmatam // Vs_1 //",
          "segment_number": 3
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vedāḥ pramāṇaṃ smṛtayaḥ pramāṇaṃ dharmārthayuktaṃ vacanaṃ pramāṇam /",
          "segment_number": 4
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yasya pramāṇaṃ na bhavetpramāṇaṃ kastasya kuryādvacanaṃ pramāṇam // Vs_2 //",
          "segment_number": 5
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "saptavyādhā daśārṇeṣu mṛgāḥ kālañjare girau /",
          "segment_number": 6
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "cakravākāḥ śaradvīpe haṃsāḥ sarasi mānase // Vs_3 //",
          "segment_number": 7
        }
      ]
    },
    {
      "tag": "l",
      "attributes": {},
      "text": "te 'pi jātāḥ kurukṣetre brāhmaṇā vedapāragāḥ // Vs_4 //",
      "segment_number": 8
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "adhītya caturo vedān sāṅgopāṅgena tavatttaḥ /",
          "segment_number": 9
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śūdrātpratigrahagrāhī brāhmaṇo jāyate kharaḥ // Vs_5 //",
          "segment_number": 10
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kharo dvādaśajanmāni ṣaṣṭhijanmāni śūkaraḥ /",
          "segment_number": 11
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śvānaḥ saptatijanmāni ityevaṃ manurabravīt // Vs_6 //",
          "segment_number": 12
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "hastinyāmacalo jāta ulūkyāṃ keśapiṅgalaḥ /",
          "segment_number": 13
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "agastyo 'gastipuṣpācca kauśikaḥ kuśasambhavaḥ // Vs_7 //",
          "segment_number": 14
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kapilaḥ kapilājjātaḥ śaragulmācca gautamaḥ /",
          "segment_number": 15
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "droṇācāryastu kalaśāttittiristittirīsutaḥ // Vs_8 //",
          "segment_number": 16
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "reṇukājanayadrāmamṛṣyaśṛṅgamuniṃ mṛgī /",
          "segment_number": 17
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kaivartinyajanayad vyāsaṃ kuśikaṃ caiva śūdrikā // Vs_9 //",
          "segment_number": 18
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "viśvāmitraṃ ca caṇḍālī vasiṣṭhaṃ caiva urvaśī /",
          "segment_number": 19
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "na teṣāṃ brāhmaṇī mātā lokācārācca brāhmaṇāḥ // Vs_10 //",
          "segment_number": 20
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sadyaḥ patati māṃsena lākṣayā lavaṇena ca /",
          "segment_number": 21
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tryahācchūdraśca bhavati brāhmaṇaḥ kṣīravikrayī // Vs_11 //",
          "segment_number": 22
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ākāśagāmino viprāḥ patanti māṃsabhakṣaṇāt /",
          "segment_number": 23
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "viprāṇāṃ patanaṃ dṛṣṭvā tato māṃsāni varjayet // Vs_12 //",
          "segment_number": 24
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "brāhmaṇatvaṃ na śāstreṇa na saṃskārairna jātibhiḥ /",
          "segment_number": 25
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "na kulena na vedena na karmaṇā bhavettataḥ // Vs_13 //",
          "segment_number": 26
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nirmamo nirahaṅkāro niḥsaṅgo niṣparigrahaḥ /",
          "segment_number": 27
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "rāgadveṣavinirmuktastaṃ devā brāhmaṇaṃ viduḥ // Vs_14 //",
          "segment_number": 28
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "satyaṃ brahma tapo brahma brahma cendriyanigrahaḥ /",
          "segment_number": 29
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sarvabhūte dayā brahma etad brāhmaṇa lakṣaṇam // Vs_15 //",
          "segment_number": 30
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "satyaṃ nāsti tapo nāsti nāsti cendriyanigrahaḥ /",
          "segment_number": 31
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sarvabhūte dayā nāsti etaccāṇḍālalakṣaṇam // Vs_16 //",
          "segment_number": 32
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "devamānuṣanārīṇāṃ tiryagyonigateṣvapi /",
          "segment_number": 33
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "maithunaṃ nādhigacchanti te viprāste ca brāhmaṇāḥ // Vs_17 //",
          "segment_number": 34
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "na jātirdṛśyate tāvad guṇāḥ kalyāṇakārakāḥ /",
          "segment_number": 35
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "caṇḍālo 'pi hi tatrasthastaṃ devā brāhmaṇaṃ viduḥ // Vs_18 //",
          "segment_number": 36
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vṛṣalīphenapītasya niḥśvāsopahatasya ca /",
          "segment_number": 37
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tatraiva ca prasūtasya niṣkṛtirnopalabhyate // Vs_19 //",
          "segment_number": 38
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "śūdrīhastena yo bhuṃkte māsamekaṃ nirantaram /",
          "segment_number": 39
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "jīvamāno bhavecchūdro mṛtaḥ śvānaśca jāyate // Vs_20 //",
          "segment_number": 40
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "śūdrīparivṛto vipraḥ śūdrī ca gṛhamedhinī /",
          "segment_number": 41
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "varjitaḥ pitṛdevena rauravaṃ so 'dhigacchati // Vs_21 //",
          "segment_number": 42
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "araṇīgarbhasambhūtaḥ kaṭho nāma mahāmuniḥ /",
          "segment_number": 43
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tapasā brāhmaṇo jātastasmājjātirakāraṇam // Vs_22 //",
          "segment_number": 44
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kaivartīgarbhasambhūto vyāso nāma mahāmuniḥ /",
          "segment_number": 45
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tapasā brāhmaṇo jātastasmājjātirakāraṇam // Vs_23 //",
          "segment_number": 46
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "urvarśīgarbhasambhūto vasiṣṭho 'pi mahāmuniḥ /",
          "segment_number": 47
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tapasā brāhmaṇo jātastasmājjātirakāraṇam // Vs_24 //",
          "segment_number": 48
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "hariṇīgarbhasambhūta ṛṣyaśrṛṅgo mahāmuniḥ /",
          "segment_number": 49
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tapasā brāhmaṇo jātastasmājjātirakāraṇam // Vs_25 //",
          "segment_number": 50
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "caṇḍālī garbhasambhūto viśvāmitro? mahāmuniḥ /",
          "segment_number": 51
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tapasā brāhmaṇo jātastasmājjātirakāraṇam // Vs_26 //",
          "segment_number": 52
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tāṇḍūlīgarbhasambhūto nārado hi mahāmuniḥ /",
          "segment_number": 53
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tapasā brāhmaṇo jātastasmājjātirakāraṇam // Vs_27 //",
          "segment_number": 54
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "jitātmā yatirbhavati..................... jitendriyaḥ /\n[yatātmā yatirbhavati vijitātmā(jitātmā ca)jitendriyaḥ /]",
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tapasā tāpaso jāto brahmacaryeṇa brāhmaṇaḥ // Vs_28 //",
          "segment_number": 56
        }
      ],
      "segment_number": 55
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "na ca te brāhmaṇīputrāste ca lokasya brāhmaṇāḥ /",
          "segment_number": 57
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śīlaśaucamayaṃ brahma tasmātkulama kāraṇam // Vs_29 //",
          "segment_number": 58
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "śīlaṃ pradhānaṃ na kulaṃ pradhānaṃ kulena kiṃ śīlavivarjitena /",
          "segment_number": 59
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bahavo narā nīcakula prasūtāḥ svargaṃ gatāḥ śīlamupetya dhīrāḥ // Vs_30 //",
          "segment_number": 60
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "mukhato brāhmaṇo jāto bāhubhyāṃ kṣatriyastathā /",
          "segment_number": 61
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "urubhyāṃ vaiśyaḥ saṃjātaḥ padbhyāṃ śūdraka eva ca // Vs_31 //",
          "segment_number": 62
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pāṇḍostu viśrutaḥ putraḥ sa vai nāmnā yudhiṣṭhiraḥ /",
          "segment_number": 63
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vaiśampāyanamāgamya prāñjaliḥ paripṛcchati // Vs_32 //",
          "segment_number": 64
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ke ca te brāhmaṇāḥ proktāḥ kiṃ vā brāhmaṇalakṣaṇam /",
          "segment_number": 65
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "etadicchāmi bho jñātuṃ tad bhavān vyākaroti me // Vs_33 //",
          "segment_number": 66
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kṣāntyādibhirguṇairyuktastyakta daṇḍo nirāmiṣaḥ /",
          "segment_number": 67
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "na hanti sarvabhūtāni prathamaṃ brahmalakṣaṇam // Vs_34 //",
          "segment_number": 68
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yadā sarvaṃ paradravyaṃ pathi vā yadi vā gṛhe /",
          "segment_number": 69
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "adattaṃ naiva gṛhṇāti dvitīyaṃ brahmalakṣaṇam // Vs_35 //",
          "segment_number": 70
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tyaktvā krūrasvabhāvaṃ tu nirmamo niṣparigrahaḥ /",
          "segment_number": 71
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "muktaścarati yo nityaṃ tṛtīyaṃ brahmalakṣaṇam // Vs_36 //",
          "segment_number": 72
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "devamānuṣa nārīṇāṃ tiryagyonigateṣvapi /",
          "segment_number": 73
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "maithunaṃ hi sadā tyaktaṃ caturthaṃ brahmalakṣaṇam // Vs_37 //",
          "segment_number": 74
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "satyaṃ śaucaṃ dayā śaucaṃ śaucamindriyanigrahaḥ /",
          "segment_number": 75
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sarvabhūta dayā śaucaṃ tapaḥ śaucañca pañcamam // Vs_38 //",
          "segment_number": 76
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pañcalakṣaṇasampanna īdṛśo yo bhaved dvijaḥ /",
          "segment_number": 77
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tamahaṃ brāhmaṇaṃ brūyāṃ śeṣāḥ śūdrā yudhiṣṭhira // Vs_39 //",
          "segment_number": 78
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "na kulena na jātyā vā kriyābhirbrāhmaṇo bhavet /",
          "segment_number": 79
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "caṇḍālo 'pi hi vṛtastho brāhmaṇaḥ sa yudhiṣṭhira // Vs_40 //",
          "segment_number": 80
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ahiṃsā brahmacaryaṃ ca viśuddhācca pratigrahaḥ /",
          "segment_number": 81
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "phalena na samarthaṃ ca brāhmaṇaḥ syādyudhiṣṭhira // Vs_40a //",
          "segment_number": 82
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ekavarṇamidaṃ pūrvaṃ viśvamāsīdyudhiṣṭhira /",
          "segment_number": 83
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "karmakriyāviśeṣeṇa cāturvarṇyaṃ pratiṣṭhitam // Vs_41 //",
          "segment_number": 84
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sarve vai yonijā martyāḥ sarve mūtrapurīṣiṇaḥ /",
          "segment_number": 85
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ekendriyendriyārthāśca tasmācchīlaguṇairdvijāḥ // Vs_42 //",
          "segment_number": 86
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "śūdro 'pi śīlasampannoguṇavān brāhmaṇo bhavet /",
          "segment_number": 87
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "brāhmaṇo 'pi kriyāhīnaḥ śūdrātpratyavaro bhavet // Vs_43 //",
          "segment_number": 88
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pañcendriyārṇavaṃ ghoraṃ yadi śūdro 'pi tīrṇavān /",
          "segment_number": 89
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tasmai dānaṃ pradātavyamaprameyaṃ yudhiṣṭhira // Vs_44 //",
          "segment_number": 90
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "na jātirdṛśyate rājan guṇāḥ kalyāṇakārakāḥ /",
          "segment_number": 91
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "jīvitaṃ yasya dharmārthe parārthe yasya jīvitam /",
          "segment_number": 92
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ahorātraṃ caretkṣāntiṃ taṃ devā brāhmaṇaṃ viduḥ // Vs_45 //",
          "segment_number": 93
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "parityajya gṛhāvāsaṃ ye sthitā mokṣakākṣiṇaḥ /",
          "segment_number": 94
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kāmeṣvasaktāḥ kaunteya brāhmaṇāste yudhiṣṭhira // Vs_46 //",
          "segment_number": 95
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ahiṃsānirmamatvaṃ cā matkṛtyasya varjanam /",
          "segment_number": 96
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "rāgadveṣanivṛttiśca etad brāhmaṇalakṣaṇam // Vs_47 //",
          "segment_number": 97
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kṣamā dayā damo dānaṃ satyaṃ śaucaṃ smṛtirghṛṇā /",
          "segment_number": 98
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vidyā vijñānamāstikyametad brāhmaṇalakṣaṇam // Vs_48 //",
          "segment_number": 99
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "gāyatrīmātra sāro 'pi varaṃ vipraḥ suyantritaḥ /",
          "segment_number": 100
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nāyantritaścaturvedī sarvāśī sarvavikrayī // Vs_49 //",
          "segment_number": 101
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ekarātroṣitasyāpi yā gatirbrahmacāriṇaḥ /",
          "segment_number": 102
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "na tatkratusahasreṇa prāpnuvanti yudhiṣṭhira // Vs_50 //",
          "segment_number": 103
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pāragaṃ sarvavedānāṃ sarvatīrthābhiṣecanam /",
          "segment_number": 104
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "muktaścarati yo dharmaṃ tameva brāhmaṇaṃ viduḥ // Vs_51 //",
          "segment_number": 105
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yadā na kurute pāpaṃ sarvabhūteṣu dāruṇam /",
          "segment_number": 106
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kāyena manasā vācā brahma sampadyate tadā // Vs_52 //",
          "segment_number": 107
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "asmābhiruktaṃ yadidaṃ dvijānāṃ mohaṃ nihantuṃ hatabuddhiṃkānām /",
          "segment_number": 108
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "gṛhmantu santo yadi yuktametanmuñcantvathāyuktamidaṃ yadi syāt // Vs_53 //",
          "segment_number": 109
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "kṛtiriyaṃ siddhācāryāśvaghoṣapādānāmiti vajrasūcī samāpteti śubham //",
      "segment_number": 110
    }
  ]
}