  "body": [
    {
      "tag": "div",
      "attributes": {},
      "children": [
        {
          "tag": "p",
          "attributes": {},
          "text": "[Oṃ bhadraṃ karṇebhiḥ śṛṇuyāma devāḥ bhadraṃ paśyemākṣabhir yajatrāḥ |\nsthirair aṅgais tuṣṭuvāṃsas tanūbhir vyaśema devahitaṃ yadāyuḥ |\nsvasti na indro vṛddhaśravāḥ svasti naḥ pūṣā viśvavedāḥ |\nsvasti nas tārkṣyo 'riṣṭanemiḥ svasti no bṛhaspatir dadhātu |\nOṃ śāntiḥ śāntiḥ śāntiḥ |]",
          "segment_number": 1
        },
        {
          "tag": "p",
          "attributes": {},
          "text": "oṃ",
          "segment_number": 2
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "athāśvalāyano bhagavantaṃ parameṣṭhinam upasametyovāca |",
              "segment_number": 3
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "adhīhi bhagavan brahmavidyāṃ variṣṭhāṃ sadā sadbhiḥ sevyamānāṃ nigūḍhām |",
              "segment_number": 4
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "yathācirāt [yayācirāt] sarvapāpaṃ vyapohya parātparaṃ puruṣaṃ yāti vidvān ||1||",
              "segment_number": 5
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "tasmai sa hovāca pitāmahaś ca śraddhā-bhakti-dhyāna-yogād avaihi |",
              "segment_number": 6
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "na karmaṇā na prajayā dhanena tyāgenaike amṛtatvam ānaśuḥ ||2||",
              "segment_number": 7
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "pareṇa nākaṃ nihitaṃ guhāyāṃ vibhrājate yad yatayo viśanti |",
              "segment_number": 8
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "vedānta-vijñānasuniścitārthāḥ saṃnyāsayogād yatayaḥ śuddhasattvāḥ ||3||",
              "segment_number": 9
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "te brahmalokeṣu parāntakāle parāmṛtāḥ [parāmṛtāt] parimucyanti sarve |",
              "segment_number": 10
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "viviktadeśe ca sukhāsanasthaḥ śuciḥ samagrīvaśiraḥśarīraḥ ||4||",
              "segment_number": 11
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "antyāśramasthaḥ sakalendriyāṇi nirudhya bhaktyā svaguruṃ praṇamya |",
              "segment_number": 12
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "hṛtpuṇḍarīkaṃ virajaṃ viśuddhaṃ vicintya madhye viṣadam [viśadaṃ] viśokam ||5||",
              "segment_number": 13
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "acintyam avyaktam anantarūpaṃ śivaṃ praśāntam amṛtaṃ brahmayonim |",
              "segment_number": 14
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "tam ādimadhyāntavihīnam ekaṃ vibhuṃ cidānandam arūpam adbhutam ||6||",
              "segment_number": 15
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "umāsahāyaṃ parameśvaraṃ prabhuṃ trilocanaṃ nīlakaṇṭhaṃ praśāntam |",
              "segment_number": 16
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "dhyātvā munirgacchati bhūtayoniṃ samastasākṣiṃ tamasaḥ parastāt ||7||",
              "segment_number": 17
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "sa brahmā sa śivaḥ sendraḥ so 'kṣaraḥ paramaḥ svarāṭ |",
              "segment_number": 18
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "sa eva viṣṇuḥ sa prāṇaḥ sa kālo 'gniḥ sa candramāḥ ||8||",
              "segment_number": 19
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "sa eva sarvaṃ yad bhūtaṃ yac ca bhavyaṃ sanātanam |",
              "segment_number": 20
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "jñātvā taṃ mṛtyum atyeti nānyaḥ panthā vimuktaye ||9||",
              "segment_number": 21
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "sarvabhūtastham ātmānaṃ sarvabhūtāni cātmani |",
              "segment_number": 22
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "saṃpaśyan brahma paramaṃ yāti nānyena hetunā ||10||",
              "segment_number": 23
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "ātmānam araṇiṃ kṛtvā praṇavaṃ cottarāraṇim |",
              "segment_number": 24
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "jñānanirmathanābhyāsāt pāpaṃ [pāśaṃ] dahati paṇḍitaḥ ||11||",
              "segment_number": 25
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "sa eva māyāparimohitātmā śarīram āsthāya karoti sarvam |",
              "segment_number": 26
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "striyannapānādivicitrabhogaiḥ sa eva jāgrat paritṛptim eti ||12||",
              "segment_number": 27
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "svapna [svapne] sa jīvaḥ sukhaduḥkhabhoktā svamāyayā kalpitajīvaloke |",
              "segment_number": 28
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "suṣuptikāle sakale vilīne tamo 'bhibhūtaḥ sukharūpam eti ||13||",
              "segment_number": 29
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "punaśca janmāntarakarmayogāt sa eva jīvaḥ svapiti prabuddhaḥ |",
              "segment_number": 30
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "puratraye krīḍati yaśca jīvas tatas tu jātaṃ sakalaṃ vicitram ||14||",
              "segment_number": 31
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dhāramānandam akhaṇḍabodhaṃ yasmiṃl layaṃ yāti puratrayaṃ ca ||14*||",
          "segment_number": 32
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "etasmāj jāyate prāṇo manaḥ sarvendriyāṇi ca |",
              "segment_number": 33
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "khaṃ vāyur jyotir āpaḥ pṛthivī viśvasya dhāriṇī ||15||",
              "segment_number": 34
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "yat paraṃ brahma sarvātmā viśvasyāyatanaṃ mahat |",
              "segment_number": 35
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "sūkṣmāt sūkṣmataraṃ nityaṃ tat tvam eva tvam eva tat ||16||",
              "segment_number": 36
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "jāgratsvapnasuṣuptyādiprapañcaṃ yat prakāśate |",
              "segment_number": 37
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "tad brahmāham iti jñātvā sarvabandhaiḥ pramucyate ||17||",
              "segment_number": 38
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "triṣu dhāmasu yad bhogyaṃ bhoktā bhogaś ca yad bhavet |",
              "segment_number": 39
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "tebhyo vilakṣaṇaḥ sākṣī cinmātro 'haṃ sadā śivaḥ ||18||",
              "segment_number": 40
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "mayy eva sakalaṃ jātaṃ mayi sarvaṃ pratiṣṭhitam |",
              "segment_number": 41
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "mayi sarvaṃl layaṃ yāti tad brahmādvayam asmy aham ||19||",
              "segment_number": 42
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "text": "[iti] prathamaḥ khaṇḍaḥ ||",
          "segment_number": 43
        }
      ]
    },
    {
      "tag": "div",
      "attributes": {},
      "children": [
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "aṇor aṇiyān aham eva tadvan mahān ahaṃ viśvam ahaṃ vicitram |",
              "segment_number": 44
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "purātano 'haṃ puruṣo 'ham īśo hiraṇmayo 'haṃ śivarūpam asmi ||20||",
              "segment_number": 45
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "apāṇipādo 'ham acintyaśaktiḥ paśyāmy acakṣuḥ sa śṛṇomy akarṇaḥ |",
              "segment_number": 46
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "ahaṃ vijānāmi viviktarūpo na cāsti vettā mama cit sadāham ||21||",
              "segment_number": 47
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "vedair anekair aham eva vedyo vedāntakṛd vedavid eva cāham |",
              "segment_number": 48
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "na puṇyapāpe mama nāsti nāśo na janma dehendriyabuddhir asti ||22||",
              "segment_number": 49
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "na bhūmir āpo na ca vahnir asti na cānilo me 'sti na cāmbaraṃ ca |",
              "segment_number": 50
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "evaṃ viditvā paramātmarūpaṃ guhāśayaṃ niṣkalam advitīyam ||23||",
              "segment_number": 51
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "samastasākṣiṃ sadasadvihīnaṃ prayāti śuddhaṃ paramātmarūpam ||23*||",
          "segment_number": 52
        },
        {
          "tag": "p",
          "attributes": {},
          "text": "yaḥ śatarūdrīyam adhīte so 'gnipūto bhavati sa vāyupūto bhavati, sa ātmapūto bhavati sa surāpānāt pūto bhavati sa brahmahatyātpūto bhavati sa suvarṇasteyāt pūto bhavati sa kṛtyākṛtyāt pūto bhavati tasmād avimuktam āśrito bhavaty āśramī sarvadā sakṛd vā japet |",
          "segment_number": 53
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "anena jñānam āpnoti saṃsārārṇavanāśanam |",
              "segment_number": 54
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "tasmād evaṃ viditvainaṃ kaivalyaṃ padam [phalam] aśnute |",
              "segment_number": 55
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "kaivalyaṃ padam [phalam] aśnute ||24||",
              "segment_number": 56
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "text": "ity atharvavede kaivalyopaniṣat samāptā ||",
          "segment_number": 57
        },
        {
          "tag": "p",
          "attributes": {},
          "text": "oṃ tat sat",
          "segment_number": 58
        }
      ]
    }
  ]
}