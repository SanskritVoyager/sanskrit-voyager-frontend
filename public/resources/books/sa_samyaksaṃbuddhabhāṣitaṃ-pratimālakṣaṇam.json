  "body": [
    {
      "tag": "p",
      "attributes": {},
      "text": "Samyaksambuddhabhāṣitaṃ pratimālakṣaṇam",
      "segment_number": 1
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "namo buddhāya /",
      "segment_number": 2
    },
    {
      "tag": "note",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "p. 126"
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "evaṃ mayā śrutamekasmin samaye buddho bhagavān jetavane viharati sma / tuṣitavarabhavanāt māturdharmadeśanāgamanakālasamaye śāriputro bhagavantametadavocat / bhagavan bhagavatā gate parinirvṛte vā śrāddhaiḥ kulaputraiḥkuladuhitṛbhiśca kathaṃ pratipattavyam / bhagavānāha - śāriputra! mayi gate parinirvṛte vā nyagrodhaparimaṇḍalaṃ kāyaṃ kartavyam / yāvatkāyaṃ tāvadvyāmaṃ yāvadvyāmaṃ tāvatkāyaṃ pūjāsatkārārthaṃ pratimā kartavyā / sarvāṅgopāṅgāvayavasthaulyalāvaṇyalālityasalīlatvaṃ chatrākāraṃ śiraḥskandhāṃ(dhasu)saṃsthitoṣṇīṣatvādisusaṃsthānāt / tatrāyāmavistāroccheda(tsedha)sandhibandhanirgamaiḥ pramāṇaṃ bodhisattvānāṃ sugatānāñca pravakṣyāmi tacchṛṇu / tatra tāvat pramāṇaṃ bodhisattvānāṃ svenāṅgulīpramāṇenaśataṃ viṃśatyuttaram, buddhānāṃ pañcaviṃśatyuttaram /",
      "segment_number": 3
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "caturaṅgulamuṣṇīṣaṃ keśasthānaṃ tathaiva ca /",
          "segment_number": 4
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sārddhatrayodasī(śī) mātrā mukhabhāgañca tattrayam // 1 //",
          "segment_number": 5
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "lalāṭaṃ nāsikāñcādhaścibukāntaṃ tṛtīyakam /",
          "segment_number": 6
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "caturaṅgulaṃ lalāṭaṃ ca tulyaṃ nāsikayā bhavet // 2 //",
          "segment_number": 7
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sādhikaṃ cibukāntaṃ tu cibukaṃ dvayaṅgulaṃ bhavet /",
          "segment_number": 8
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "āyāmaṃ nirgamāccaiva caturaṅgulamiṣyate // 3 //",
          "segment_number": 9
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "caturaṅgulau kapolau tu karṇamūlādviniḥśri(sṛ)tau /",
          "segment_number": 10
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "hanuḥ syāttryaṅgulocchedo(tsedho)vistāre dvayaṅgulaśca saḥ // 4 //",
          "segment_number": 11
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sā 'dhikaḥ paripūrṇṇaḥ syānmahāsiṃhahanuryathā /",
          "segment_number": 12
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "adharo dvayaṅgulāyāmo nirgamoccheda(tsedha)mātrikaḥ // 5 //",
          "segment_number": 13
        }
      ]
    },
    {
      "tag": "note",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "p. 127"
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "madhye syācchobhanā rekhā sṛkkaṇī mātṛke smṛtau /",
          "segment_number": 14
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "caturaṅgulamāyāmaṃ vaktraṃ kuryādvicakṣaṇaḥ // 6 //",
          "segment_number": 15
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yathopapannasthānāścatvāriṃśaddaśanāḥ smṛtāḥ /",
          "segment_number": 16
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "uttaroṣṭho 'ṅgulārddhaḥ syāttathaiboccheda(tsedha)nirgamaḥ // 7 //",
          "segment_number": 17
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tribhāgāṅgulikā kāryā godhistasyaiva ca sthitā /",
          "segment_number": 18
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nāsā dvayaṅgulavistārā sārddhamaṅgulamunnatā // 8 //",
          "segment_number": 19
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "arddhāṅgule same vṛtte nāsāyāḥ śrotasī smṛtau(te) /",
          "segment_number": 20
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nāsāvaṃśaḥ samo madhye vistāreṇārddhamātrikaḥ // 9 //",
          "segment_number": 21
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "netrāntaro 'ṅgule jñeyo netre ca caturaṅgule /",
          "segment_number": 22
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vistārāddvayaṅgulau madhye tayostārā tribhāgikī // 10 //",
          "segment_number": 23
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "dṛṣṭiḥ syātpañcabhāgena dvayaṅgulaṃ tryaṅgulaṃ tayoḥ /",
          "segment_number": 24
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "aṅgulasya caturthāṃśo visṛ(stṛ)to 'kṣiḥ samudgakaḥ // 11 //",
          "segment_number": 25
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "padmapatrākṛtiḥ kāryo netrakośo 'ṅgulitrayam /",
          "segment_number": 26
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "karavīrasamaṃ sūtraṃ netrayoḥ nāsikāpuṭe // 12 //",
          "segment_number": 27
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tārā same ca cibuke sṛkkaṇī pariyojayet /",
          "segment_number": 28
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "antarastu bhruvaḥ kāryaṃ vistṛtaṃ sārddhamaṅgulam // 13 //",
          "segment_number": 29
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "madhye corṇātra vijñeyā śubhā pūrṇendusannibhā /",
          "segment_number": 30
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nāsikāvatsa(vaṃśa)sūtrorṇā tathā mūrdhva(rdha)jasaṃsthitam // 14 //",
          "segment_number": 31
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "śiromaṇīḥ sa vijñeyaḥ suprabho vimalastathā /",
          "segment_number": 32
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "caturaṅgulamucchedāllalāṭopari mastakam // 15 //",
          "segment_number": 33
        }
      ]
    },
    {
      "tag": "note",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "p. 128"
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "chatrākāraṃ śubhannīlaṃ dakṣiṇāvarttastūrdhvajam /",
          "segment_number": 34
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhrurekhā syāccaturmātrā karṇāgraṃ cāpi tatsamam // 16 //",
          "segment_number": 35
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "niḥsṛtau dvayaṅgulau karṇau tayoḥ patrārddhamātrikaḥ /",
          "segment_number": 36
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ucchedo(tsedho)mātriko jñeyaḥ śliṣṭaśrotrārddhamātrikāḥ // 17 //",
          "segment_number": 37
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "aṅgulasya caturthāṃsaḥ(śaḥ) karṇāvarttastu vistaraiḥ /",
          "segment_number": 38
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sārddhamātre 'ṅgule dve syāt karṇastvantarabhāgataḥ // 18 //",
          "segment_number": 39
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pārśvau syātāṃ yathāśobhaṃ keśāścāpi tathaiva ca /",
          "segment_number": 40
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "arddhapañcamamātrañca karṇapatramapāṅgataḥ // 19 //",
          "segment_number": 41
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "karṇātkarṇāntavijñeyo mastako 'ṣṭādaśāṅgulaḥ /",
          "segment_number": 42
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "caturdaśāṅgulaṃ pṛṣṭhaṃ tayorantaramiṣyate // 20 //",
          "segment_number": 43
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "catvāriṃśanmātrañca śiraḥ syātpariṇāhataḥ /",
          "segment_number": 44
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "grīvocchedā(tsedhā)ccaturmātrā vistārādaṣṭamātṛkā // 21 //",
          "segment_number": 45
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pariṇāhācca kartavyā caturviśatimātṛkā /",
          "segment_number": 46
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "grīvāntānyaṅgulānyaṣṭau skandhāṃso(śo) dvādaśāṅgulaḥ // 22 //",
          "segment_number": 47
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vināntarāṃśo vṛttaśca skandhaḥ syāllakṣaṇānvitaḥ /",
          "segment_number": 48
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "catvāriṃśatamātrāṇi bāhau cāyāmamiṣyate // 23 //",
          "segment_number": 49
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bāhurviśatimātrastu prabāhuḥ ṣoḍaśastathā /",
          "segment_number": 50
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dvādaśāṅgulahastāgraṃ maṇibandhātprakīrtitaḥ // 24 //",
          "segment_number": 51
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kukuṇīmaṇibandhābhyāmaṅgulañcāṅgulaṃ smṛtam /",
          "segment_number": 52
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bāhau madhyaparikṣepa iṣṭo viṃśatimātṛkaḥ // 25 //",
          "segment_number": 53
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "prabāhuḥ ṣoḍaśaḥśca syāddviṣaṭko maṇibandhane /",
          "segment_number": 54
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "āyāmaṃ saptakaṃ pāṇau talavistārapañcakam // 26 //",
          "segment_number": 55
        }
      ]
    },
    {
      "tag": "note",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "p. 129"
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "śaṅkhañcakraṃ tale nyastaṃ padma cākuliśāṅkuśam /",
          "segment_number": 56
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sarvalakṣaṇarūpiṇyo le(re)khāḥ kāryyāḥ pṛthagvidhāḥ // 27 //",
          "segment_number": 57
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pañcāṅgulāyatā madhyā parvārddhonā pradeśinī /",
          "segment_number": 58
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "aṅgulārddhavihīnā tu kartavyā syādanāmikā // 28 //",
          "segment_number": 59
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "anāmikātaḥ parvonā kartavyā tu kanīyasī /",
          "segment_number": 60
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "triparvāṅgulayaḥ sarvāḥ parvārddhena nakhāḥśubhāḥ // 29 //",
          "segment_number": 61
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "maṇibandhopariṣṭāttu so 'ṅguṣṭhaścaturaṅgulaḥ /",
          "segment_number": 62
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tāvāneva parikṣepaḥ parvārddhena nakhaśca saḥ // 30 //",
          "segment_number": 63
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "aṅguṣṭhāttu pradeśinyā antaraṃ tryaṅgulaṃ smṛtam /",
          "segment_number": 64
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kanīyasī maṇibandhādbhavetpañcāṅgulāyataḥ // 31 //",
          "segment_number": 65
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "agrahastaparikṣepo vijñeyo dvādaśāṅgulaḥ /",
          "segment_number": 66
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dairghyāttṛtīyabhāgaḥ syāt svāṅgulīnāṃ parigrahaḥ // 32 //",
          "segment_number": 67
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "grīvāhṛdayayormadhye sārddhadvādaśamātrikaḥ /",
          "segment_number": 68
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "hṛnnābhyośca catuścaiva stanayorapi cāntaram // 33 //",
          "segment_number": 69
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "stanayorupariṣṭācca kakṣe kārye ṣaḍaṅgule /",
          "segment_number": 70
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tadūrdhvaṃ punarāskandhānnavamātrā prakīrtitā // 34 //",
          "segment_number": 71
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "uraso 'pi ca vistāraḥ pañcaviṃśatimātrikaḥ /",
          "segment_number": 72
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pariṇāhāduraḥ kāryo vistārāttriguṇaṃ śubham // 35 //",
          "segment_number": 73
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "stananābhyantare(raṃ) caiva ṣoḍaśāṅgulamiṣyate /",
          "segment_number": 74
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "avedhaḥ sandhirandhrābhyāṃ nābhimaṇḍalamaṅgulam // 36 //",
          "segment_number": 75
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nābhimadhyāt parikṣepaḥ ṣaṭcatvāriṃśadaṅgulaḥ /",
          "segment_number": 76
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "aṣṭādaśāṅgulaṃ caiva vistāreṇa kaṭirbhavet // 37 //",
          "segment_number": 77
        }
      ]
    },
    {
      "tag": "note",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "p. 130"
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nābhimeḍhrontarañca syāt sārddhadvādaśamātrikaḥ /",
          "segment_number": 78
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tadarddhena tu meḍhraḥ syādapānapariṇāhataḥ // 38 //",
          "segment_number": 79
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pañcamātrāyatau lambau vṛṣaṇau caturaṅgulau /",
          "segment_number": 80
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pañcamātrāṇi catvāri vistārāyāmatastayoḥ // 39 //",
          "segment_number": 81
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ūrū samāhitau kāryau pañcaviṃśatimātrikau /",
          "segment_number": 82
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "suvistāraṃ tayormadhyaṃ māpayeddvādaśāṅgulam // 40 //",
          "segment_number": 83
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pariṇāhe 'pi kartavyaṃ śubhaṃ ṣaṭtriṃśadaṅgulam /",
          "segment_number": 84
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "madhye................caturaṅgulaṃ tu jānutaḥ // 41 //",
          "segment_number": 85
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "sandhibandhaścaturmātrā tridvikaṃ jānugulphakam /",
      "segment_number": 86
    },
    {
      "tag": "l",
      "attributes": {},
      "text": "guḍhagulphaṃ sirāsthitvaṃ sukumārau stayau(?) śubhau // 42 //",
      "segment_number": 87
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ṛjuvṛttāyate jaṃghā(ghe) pañcaviṃśatimātrike /",
          "segment_number": 88
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tayormadhye pariṇāha ekaviṃśatimātrikaḥ // 43 //",
          "segment_number": 89
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "caturdaśāṅgulā 'yatā gulphāntāścaturaṅgulam /",
          "segment_number": 90
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "gulpho dvādaśakāyāmaḥ pādaḥ pādārddhavistaraḥ // 44 //",
          "segment_number": 91
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pārśvau dvayaṅgulavistārau pārṣṇī ca caturaṅgule /",
          "segment_number": 92
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ṣaḍaṅgulaṃ tva(su)vistāraṃ triguṇaṃ pariṇāhataḥ // 45 //",
          "segment_number": 93
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pañcāṅgulyo dviparvāṇi parvārddhena nakhāḥ smṛtāḥ /",
          "segment_number": 94
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pañcāṅgulaṃ parikṣepādaṅguṣṭhastryaṅgulāyataḥ // 46 //",
          "segment_number": 95
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "aṅguṣṭhakasamā caiva āyāmena pradeśinī /",
          "segment_number": 96
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ṣoḍaśāṣṭāṣṭabhāgena śeṣā hīnāḥ parasparam // 47 //",
          "segment_number": 97
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "aṅgulyo mātrikocchre(tse)dhādaṅguṣṭhaḥ sārddhamātrikaḥ /",
          "segment_number": 98
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tatra tāmranakhāḥ sārddhāṃ aṅgulāḥ komalāyatāḥ // 48 //",
          "segment_number": 99
        }
      ]
    },
    {
      "tag": "note",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "p. 131"
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kūrmapṛṣṭhasamau pūrṇau pādau bahiralaṃkṛtau /",
          "segment_number": 100
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "samaśliṣṭānatācchidrau supratiṣṭhataḥ(ṣṭhita) lakṣaṇaiḥ // 49 //",
          "segment_number": 101
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tayostalaṃ sucakrādicitrākāraṃ tu kārayet /",
          "segment_number": 102
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pādāvatra praśaṃsanti sarvajñā hatakilviṣāḥ // 50 //",
          "segment_number": 103
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kukkuṭāṇḍaṃ tilākāraṃ caturasraṃ suvartulam /",
          "segment_number": 104
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sarvasāmānyaliṅgānāṃ mukhametaccaturvidham // 51 //",
          "segment_number": 105
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "mahānarasurastrīṇāṃ kukkuṭāṇḍaṃ tilākṛtiḥ /",
          "segment_number": 106
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "lāvaṇyaṃ darśanīyaṃ tat kārayet mukhadvayam // 52 //",
          "segment_number": 107
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pretabhūtapiśācānāṃ rakṣasāṃ vikṛtākṛtiḥ /",
          "segment_number": 108
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "maṇḍalaṃ caturasraṃ ca kārayettu mukhadvayam // 53 //",
          "segment_number": 109
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "samā dṛṣṭiḥ prasannā ca buddhānāmavalokane /",
          "segment_number": 110
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nādho nordhvaṃ na dainyena saṃyuktaṃ sarvadarśinām // 54 //",
          "segment_number": 111
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "// iti samyaksambuddhabhāṣitaṃ pratimālakṣaṇaṃ samāptam //",
      "segment_number": 112
    }
  ]
