  "body": [
    {
      "tag": "p",
      "attributes": {},
      "text": "Nādabindūpaniṣat",
      "segment_number": 1
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "oṃ",
          "segment_number": 2
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "akāro dakṣiṇaḥ pakṣa ukāras tūttaraḥ smṛtaḥ /",
          "segment_number": 3
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "makāras tasya pucchaṃ vā ardhamātrā śiras tathā // NbiUp_1 //",
          "segment_number": 4
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pādau rajas tamas tasya śarīraṃ sattvam ucyate /",
          "segment_number": 5
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dharmaś ca dakṣiṇaṃ cakṣur adharmaś cottaraṃ smṛtam // NbiUp_2 //",
          "segment_number": 6
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bhūr lokaḥ pādayos tasya bhuvar lokas tu jānunoḥ /",
          "segment_number": 7
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "svar lokaḥ kaṭideśe tu nābhideśe mahar jagat // NbiUp_3 //",
          "segment_number": 8
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "janalokas tu hṛdaye kaṇṭhadeśe tapas tataḥ /",
          "segment_number": 9
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhruvor lalāṭamadhye tu satyaloko vyavasthitaḥ // NbiUp_4 //",
          "segment_number": 10
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sahasram iti cātra mantra eva pradarśitaḥ /",
          "segment_number": 11
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "evam enaṃ samārūḍho haṃsaṃ yogavicakṣaṇaḥ // NbiUp_5 //",
          "segment_number": 12
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "na badhyate karmacārī pāpakoṭiśatair api /",
          "segment_number": 13
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "āgneyī prathamā mātrā vāyavyaiṣā vaśānugā // NbiUp_6 //",
          "segment_number": 14
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bhānumaṇḍalasaṃkāśā bhaven mātrā tathottarā /",
          "segment_number": 15
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "paramā cārdhamātrā ca vāruṇīṃ tāṃ vidur budhāḥ // NbiUp_7 //",
          "segment_number": 16
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kalātrayānanā vāpi tāsāṃ mātrāpratiṣṭhitā /",
          "segment_number": 17
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "eṣa oṃkāra ākhyāto dhāraṇābhir nibodhata // NbiUp_8 //",
          "segment_number": 18
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yoṣiṇī prathamā mātrā vidyunmālā tathāparā /",
          "segment_number": 19
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pataṃgī ca tṛtīyā syāc caturthī vāyuveginī // NbiUp_9 //",
          "segment_number": 20
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pañcamīnām adheyā ca ṣaṣṭhī caindrī vidhīyate /",
          "segment_number": 21
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "saptamī vaiṣṇavī nāma śaṃkarī ca tathāṣṭamī // NbiUp_10 //",
          "segment_number": 22
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "navamī mahatī nāma dhruveti daśamī matā /",
          "segment_number": 23
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ekādaśī bhaven maunī brāhmīti dvādaśī matā // NbiUp_11 //",
          "segment_number": 24
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "prathamāyāṃ tu mātrāyāṃ yadi prāṇair viyujyate /",
          "segment_number": 25
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sa rājā bhārate varṣe sārvabhaumaḥ prajāyate // NbiUp_12 //",
          "segment_number": 26
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "dvitīyāyāṃ samutkrānto bhaved yakṣo mahātmavān /",
          "segment_number": 27
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vidyādharas tṛtīyāyāṃ gandharvas tu caturthikām // NbiUp_13 //",
          "segment_number": 28
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pañcamyām atha mātrāyāṃ yadi prāṇair viyujyate /",
          "segment_number": 29
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "uṣitaḥ sahadevatvaṃ somaloke mahīyate // NbiUp_14 //",
          "segment_number": 30
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ṣaṣṭhyām indrasya sāyujyaṃ saptamyāṃ vaiṣṇavaṃ padam /",
          "segment_number": 31
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "aṣṭamyāṃ vrajate rudraṃ paśūnāṃ ca patiṃ tathā // NbiUp_15 //",
          "segment_number": 32
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "navamyāṃ ca maharlokaṃ daśamyāṃ ca dhruvaṃ vrajet /",
          "segment_number": 33
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ekādaśyāṃ tapolokaṃ dvādaśyāṃ brahma śāśvatam // NbiUp_16 //",
          "segment_number": 34
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tataḥ paraṃ śuddhaṃ vyāpakaṃ niṣkalaṃ śivam /",
          "segment_number": 35
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sadoditaṃ paraṃ brahma jyotiṣām udayo yataḥ // NbiUp_17 //",
          "segment_number": 36
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atīndriyaṃ guṇātītaṃ mano līnaṃ yadā bhavet /",
          "segment_number": 37
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "anaupamyam abhāvaṃ ca yogayuktaṃ tadādiśet // NbiUp_18 //",
          "segment_number": 38
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tadbhaktas tatsamāsaktaḥ śanair muñcet kalevaram /",
          "segment_number": 39
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "susthito yogacāreṇa sarvasaṅgavivarjitaḥ // NbiUp_19 //",
          "segment_number": 40
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tato vilīnapāśo 'sau vimalaḥ kevalaḥ prabhuḥ /",
          "segment_number": 41
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tenaiva brahmabhāvena paramānandam aśnute // NbiUp_20 //",
          "segment_number": 42
        }
      ]
    }
  ]
}