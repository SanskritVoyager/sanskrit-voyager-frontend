  "body": [
    {
      "tag": "p",
      "attributes": {},
      "text": "sāṃkhyasūtravivaraṇam |",
      "segment_number": 1
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "śrīkapilāya namaḥ |",
      "segment_number": 2
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "prakṛtiṃ puruṣaṃ natvā sāṃkhyasūtre vidhīyate /",
          "segment_number": 3
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "saṃkṣepato vivaraṇamavivekāpanuttaye //",
          "segment_number": 4
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "iha khalu bhagavān kapilo munirāsuraye 'nukampayā pañcaviṃśatitattvānyupadiśya sūtrayāmāsa |",
      "segment_number": 5
    },
    {
      "tag": "p",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "[aṣṭau prakṛtayaḥ || Tats_1 ||]",
          "segment_number": 6
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "aṣṭau prakṛtaya ityādi / kāḥ punastā ityucyante / pradhānaṃ mahānahaṃkārastanmātrāṇi ca / pradhānaṃ prakṛtiravyaktamavyākṛtaṃ cetyanarthāntaram / mahān mahattatvaṃ buddhiradhyavasāyalakṣaṇam / ahaṃkāro 'bhimānalakṣaṇo vaikṛtikastaijaso bhūtādiśceti trividhaḥ / tanmātrāṇi tu pañca śabdatanmātramākāśahetuḥ / sparśatanmātraṃ vāyuyoniḥ / rūpatanmātraṃ tejoyoniḥ / rasatanmātramapprakṛtiḥ / gandhatanmātraṃ pṛthivīhetuḥ / iti pañcatanmātrāṇi ityaṣṭau prakṛtayaḥ /",
      "segment_number": 7
    },
    {
      "tag": "p",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "[ṣoḍaśa vikārāḥ || Tats_2 ||]",
          "segment_number": 8
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "ke punarvikārāḥ kati |\nṣoḍaśavikārāḥ |\nekādaśendriyāṇi pañca mahābhūtāni ca |",
      "children": [
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "tatra śrotratvakcakṣūrasanaghrāṇākhyāni buddhīndriyāṇi śabdasparśarūparasagandhālocanavṛttīni |",
              "segment_number": 10
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "vākpāṇipādapāyūpasthāni karmendriyāṇi vacanādānaviharaṇotsargānandavṛttīni |",
              "segment_number": 11
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "jñānakriyāśaktidvayātmakaṃ saṅkalpavikalpalakṣaṇaṃ mana ityekādaśendriyāṇi |",
              "segment_number": 12
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "bhūtāni cākāśavāyutejaḥsalilapṛthivīlakṣaṇāni pañceti ṣoḍaśavikārāḥ ||",
              "segment_number": 13
            }
          ]
        }
      ],
      "segment_number": 9
    },
    {
      "tag": "p",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "[puruṣaḥ || Tats_3 ||]",
          "segment_number": 14
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atha kaḥ puruṣaḥ ityucyate |",
          "segment_number": 15
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "puruṣo 'nekastriguṇarahito vivekī aviṣayo 'sādhāraṇo 'prasavadharmā cetanaḥ sākṣī kevalo madhyastho draṣṭā 'kartā ca ||",
          "segment_number": 16
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "atha ke punastrayo guṇā ityucyante |",
      "segment_number": 17
    },
    {
      "tag": "p",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "[traiguṇyam || Tats_4 ||]",
          "segment_number": 18
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "traiguṇyaṃ sattvaṃ rajastama iti |",
      "children": [
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "traya eva guṇāstraiguṇyam |",
              "segment_number": 20
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "sattvaṃ nāma pāṭavamārdavalāghavaprasannatābhisaṅgaprītituṣṭyanīhāsantoṣādilakṣaṇamanantabhedaṃ samāsataḥ sukhāvaham |",
              "segment_number": 21
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "rajo nāma śokatāpakhedastambhodgamodvegaroṣamānādilakṣaṇamanantabhedaṃ samāsato duḥkhāvaham |",
              "segment_number": 22
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "tamo nāmācchādanāvaraṇabībhatsadainyagauravālasyanidrāpramādādilakṣaṇamanantabhedaṃ samāsato mohātmakaṃ etat traiguṇyaṃ vyākhyātam ||",
              "segment_number": 23
            }
          ]
        }
      ],
      "segment_number": 19
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sattvaṃ prakāśakaṃ vindyādrajo vindyāt pravartakam /",
          "segment_number": 24
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vināśakaṃ tamo vindyāt traiguṇyaṃ nāma sañjñitam //",
          "segment_number": 25
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "[saṃcaraḥ || Tats_5 ||]",
          "segment_number": 26
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "[pratisaṃcaraḥ || Tats_6 ||]",
          "segment_number": 27
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "atrāha kaḥ sañcaraḥ pratisañcaraśceti |\nucyate |\nutpattiḥ sañcaraḥ |\npralayaḥ pratisañcaraḥ |\ntatrotpattirnāmāvyaktāt samupadiṣṭāt sarvajagataḥ pareṇa rūpeṇādhiṣṭhānātmakāt mahān mahato 'haṃkāraḥ |\nsa ca trividhaḥ |\nvaikṛtiko bhūtādistaijasaśceti |\ntatra vaikṛtādindriyāṇyutpadyante bhūtādestanmātrāṇi taijasādubhayam indriyāṇi tanmātrāṇi ceti |\ntanmātrebhyo bhūtāni |\nayaṃ sañcaraḥ |\npratisañcaro nāma bhūtāni tanmātreṣu līyante |\ntanmātrāṇīndriyāṇi cāhaṃkāre |\nahaṃkāro buddhau |",
      "children": [
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "buddhiravyakte |",
              "segment_number": 29
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "tato 'vyaktaṃ tu kvacinna līyate kasmāt anutpannatvāt |",
              "segment_number": 30
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "ityevaṃ pratisañcaraḥ |",
              "segment_number": 31
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "evametau sañcarapratisañcarau vyākhyātau ||",
              "segment_number": 32
            }
          ]
        }
      ],
      "segment_number": 28
    },
    {
      "tag": "p",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "[adhyātmam || Tats_7 ||]",
          "segment_number": 33
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "[adhibhūtam || Tats_8 ||]",
          "segment_number": 34
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "[adhidaivam || Tats_9 ||]",
          "segment_number": 35
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "atrāha kiṃvidhamadhyātmamadhibhūtamadhidaivataṃ ca |\natrocyate |\nbuddhiradhyātmam |\nbodhayitavyamadhibhūtam |\nbrahmā tatrādidaivatam |\nahaṃkāro 'dhyātmam |\nabhimantavyamadhibhūtam |\nrudrastatrādhidaivatam |\nmanodhyātmaṃ saṃkalpamadhibhūtam |\ncandrastatrādidaivatam |\nśrotramadhyātmam |\nsparśayitavyamadhibhūtam |\nvāyustatrādhidaivatam |\ncakṣuradhyātmam |\ndarśayitavyamadhibhūtam |\nsūryastatrādidaivatam |\njihvādhyātmam |\nrasayitavyamadhibhūtam |\nvaruṇastatrādhidaivatam |\nnāsādhyātmam |\nghrātavyamadhibhūtam |\npṛthivī tatrādhidaivatam |\nvāgadhyātmam |\nvaktavyamadhibhūtam |\nagnistatrādhidaivatam |\npāṇiradhyātmam |\nādātavyamadhibhūtam |\nindrastatrādhidaivatam |\npādāvadhyātmam |\ngantavyamadhibhūtam |\nviṣṇustatrādhidaivatam |\npāyuradhyātmam |\nutsraṣṭāvyamadhibhūtam |\nmitrastatrādhidaivatam |\nupasthamadhyātmam |\nānandayitavyamadhibhūtam |",
      "children": [
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "prajāpatistatrādhidaivatam |",
              "segment_number": 37
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "evameva trayodaśakaraṇasyādhyātmamadhibhūtamadhidaivaṃ ca vyākhyātam |",
              "segment_number": 38
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "kāni catvārītyata āha ceti |",
              "segment_number": 39
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "trīṇi guṇarūpāṇi caturthamadhidaivatamityarthaḥ ||",
              "segment_number": 40
            }
          ]
        }
      ],
      "segment_number": 36
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "catvāri yo vedayate yathāvad guṇasvarūpāṇyadhidaivataṃ ca /",
          "segment_number": 41
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vimuktapāpmā gatadoṣasaṅgo guṇāṃstu bhuṅkte na guṇaiḥ sa bhujyate //",
          "segment_number": 42
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "[pañcābhibuddhayaḥ || Tats_10 ||]",
          "segment_number": 43
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "atha kāstā abhibuddhaya ityucyante |\npañcābhibuddhayaḥ |\nbuddhirabhimāna icchā kartavyaṃ tatkriyā ceti |\nabhimukhī buddhirabhibuddhiḥ |\nidaṃ karaṇīyametyetadadhyavasāyo buddhiḥ kriyātmaparāmarśasvarūpapratyayaḥ |\nabhimukho māno 'haṃ karomītyahaṃkāro 'bhimānaḥ |\nbuddhikriyā icchā vāñchā |",
      "children": [
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "kartavyaṃ saṃkalpo manaso vṛttiḥ |",
              "segment_number": 45
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "kriyā etadvastusvarūpamiti kartavyālocanaṃ yadbuddhīndriyāṇāṃ sā kriyā |",
              "segment_number": 46
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "itthametat kartavyamiti yatpravṛttiḥ karmendriyāṇāṃ sā kriyeti |",
              "segment_number": 47
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "evametāha pañcābhibuddhayo vyākhyātāḥ ||",
              "segment_number": 48
            }
          ]
        }
      ],
      "segment_number": 44
    },
    {
      "tag": "p",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "[pañca karmayonayaḥ || Tats_11 ||]",
          "segment_number": 49
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "atha kāḥ pañcakarmayonayaḥ ucyante |\ndhṛtiḥ śraddhā sukhā avividiṣā vividiṣā ceti pañca karmayonayaḥ |",
      "segment_number": 50
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vāci karmaṇi kāye ca pratītiryābhirajyate /",
          "segment_number": 51
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tanniṣṭhastatpratiṣṭhaśca dhṛteretaddhi lakṣaṇam //",
          "segment_number": 52
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "anasūyā brahmacaryaṃ yajanaṃ yājanaṃ tapaḥ /",
          "segment_number": 53
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pratigraho 'trahomaśca śraddhāyā lakṣaṇaṃ smṛtam //",
          "segment_number": 54
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sukhārthī yastu seveta vidyākarmatapāṃsi ca /",
          "segment_number": 55
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "prāyaścittaparo nityaṃ sukheyaṃ parikīrtitā //",
          "segment_number": 56
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "viṣadhūmamūrchitavadavividiṣā |\nvividiṣā dhyāyināṃ prajñāyoniḥ |",
      "segment_number": 57
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ekatvaṃ ca pṛthaktvaṃ ca nityaṃ cedamacetanam /",
          "segment_number": 58
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sūkṣmaṃ satkāryamakṣobhyaṃ jñeyā vividiṣā hi sā //",
          "segment_number": 59
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kāryakāraṇakṣamakarā vividiṣā prākṛtikā vṛttiḥ |",
          "segment_number": 60
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dhṛtiḥ śraddhā sukhā avividiṣā catasro bandhāya vividiṣaikā mokṣāya iti pañca karmayonayo vyākhyātāḥ ||",
          "segment_number": 61
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "[pañca vāyavaḥ || Tats_12 ||]",
          "segment_number": 62
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atrāha ke te pañcavāyavaḥ |",
          "segment_number": 63
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ucyante |",
          "segment_number": 64
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "prāṇo 'pānaḥ samānaśca udāno vyāna eva ca /",
          "segment_number": 65
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ityete vāyavaḥ pañca śarīreṣu śarīriṇām //",
          "segment_number": 66
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "tatra prāṇo nāma vāyuryo 'yaṃ mukhanāsikādhiṣṭhānaprāṇanāt krameṇānanāt prāṇa ityabhidhīyate |\napāno nāma vāyurnābheradhiṣṭhātā apanayanādadhogamanāccāpāna ityabhidhīyate |",
      "children": [
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "samāno nāma vāyurhṛdadhiṣṭhātā samanāt samagamanācca samāna ityabhidhīyate |",
              "segment_number": 68
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "udāno nāma vāyuḥ kaṇṭhādhiṣṭhātā ūrdhvaṃ gamanācca udāna ityabhidhīyate |",
              "segment_number": 69
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "vyāno nāma vāyuḥ sandhyadhiṣṭhātā prāṇādijṛmbhaṇācca vyāna ityabhidhīyate |",
              "segment_number": 70
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "iti pañcavāyavo vyākhyātāḥ ||",
              "segment_number": 71
            }
          ]
        }
      ],
      "segment_number": 67
    },
    {
      "tag": "p",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "[pañca karmātmānaḥ || Tats_13 ||]",
          "segment_number": 72
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "āha ke te pañcakarmātmānaḥ ucyante |\nvaikārikastaijaso bhūtādiśca sānumāno niranumānaśceti |\ntatra vaikārikaḥ śubhakarmakartā |\ntaijaso 'śubhakarmakartā |",
      "children": [
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "bhūtādirmūḍhakarmakartā |",
              "segment_number": 74
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "sānumānaḥ śubhamūḍhakarmakartā |",
              "segment_number": 75
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "niranumāno 'śubhamūḍhakarmakartā |",
              "segment_number": 76
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "ityete pañcakarmakartāro vyākhyātāḥ ||",
              "segment_number": 77
            }
          ]
        }
      ],
      "segment_number": 73
    },
    {
      "tag": "p",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "[pañcaparvāvidyā || Tats_14 ||]",
          "segment_number": 78
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "āha kā sā pañcaparvāvidyeti |\nucyate |\ntamo moho mahāmohastāmisro 'ndhatāmisraśceti |\ntatra tamomohāvubhāvetāvaṣṭātmākau |\nmahāmoho daśātmakaḥ |\ntāmisrāndhatāmisrau cāṣṭādaśātmākau |\ntatra tamo nāmāṣṭāsu prakṛtiṣvavyaktabuddhyahaṃkārapañcatanmātrasañjñitāsu anātmasvātmajñānābhimānastama ityabhidhīyate |\nmoho nāmāṇimādyaṣṭāguṇaiśvaryaprāptaye yobhimāna utpadyate sa moha ityabhidhīyate |",
      "children": [
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "mahāmoho nāma dṛṣṭānuśravikeṣu viṣayeṣu daśasu nivṛtteṣu mukto 'hamiti manyate sa mahāmoha ityabhidhīyate |",
              "segment_number": 80
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "tāmisro nāma aṣṭaguṇaiśvarye 'ṇimādye daśavidhe ca viṣaye pratihatasya duḥkhamutpadyate 'sau tāmisra ityabhidhīyate |",
              "segment_number": 81
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "andhatāmisro nāma aṇimādyaṣṭaguṇaiśvarye daśavidhe ca viṣaye siddhe maraṇakāle ca yo viṣādaḥ pratyapadyate so 'ndhatāmisra ityabhidhīyate |",
              "segment_number": 82
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "evameṣā pañcaparvā 'vidyā dviṣaṣṭibhedā vyākhyātā ||",
              "segment_number": 83
            }
          ]
        }
      ],
      "segment_number": 79
    },
    {
      "tag": "p",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "[aṣṭaviṃśatidhāśaktiḥ || Tats_15 ||]",
          "segment_number": 84
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "atrāha kāṣṭāviṃśatidhāśaktiḥ |\natrocyate |\nekādaśendriyavadhāḥ saptadaśabuddhivadhāḥ |\neṣāṣṭāviṃśatidhāśaktiḥ |\ntatrendriyavadhāstāvat |\nbadhirastvakbadhiraḥ andhaḥ jaḍajihvaḥ ajighraḥ mūkaḥ kuṇiḥ paṅguḥ napuṃsakaḥ ūrdhvavāyuyuktaḥ amanāḥ |\ntaduktam |",
      "segment_number": 85
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bādhiryaṃ kuṣṭhitāndhastvaṃ jaḍatā 'jighratā tathā /",
          "segment_number": 86
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "mūkatā kauṇyapaṅgutvaṃ klaibyodāvartamattatāḥ //",
          "segment_number": 87
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "etedindriyadvārā buddhereva vadhāḥ |\nsākṣādbuddhivadhā yathā |",
      "segment_number": 88
    },
    {
      "tag": "p",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "[navadhā tuṣṭiḥ || Tats_16 ||]",
          "segment_number": 89
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "[aṣṭadhā siddhiḥ || Tats_17 ||]",
          "segment_number": 90
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "navavidhatuṣṭivaikalyāt aṣṭavidhāsiddhavaikalyācca saptadaśabuddhivadhā ityaṣṭāviṃśatidhāśaktiḥ ||",
      "segment_number": 91
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "kā punarnavadhā tuṣṭiḥ ucyate |\ncatasra ādyātmikyastuṣṭayaḥ bāhyāḥ pañca |\nādyāḥ prakṛtyupādānakālabhāgyākhyāḥ |\nprakṛtyaiva muktiḥ kiṃ punaḥ sādhanairiti tuṣṭiḥ prakṛtyākhyā ambho nāma |",
      "children": [
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "sādhanaiḥ saṃnyāsādibhirupāttaistuṣṭiḥ sādhānākhyā salilaṃ nāma |",
              "segment_number": 93
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "kālenaiva muktyādikaṃ setsyati kiṃ duḥkhaiḥ saṃnyāsādisādhanairiti tuṣṭiḥ kālākhyā 'gho nāma |",
              "segment_number": 94
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "yā tu bhāgyādeva sarvaṃ setsyati kiṃ sādhanādidhyānādikleśairiti sā bhāgyākhyā tuṣṭirnāma |",
              "segment_number": 95
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "bāhyāḥ śabdādiviṣayavairāgyāstuṣṭayaḥ arjanarakṣaṇakṣayabhogahiṃsādoṣadarśanaṃ vairāgyahetuḥ pañcavidhastadbhedena pañcatuṣṭayaḥ ||",
              "segment_number": 96
            }
          ]
        }
      ],
      "segment_number": 92
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "atha kāḥ siddhayaḥ ucyante |\naṣṭau siddhayaḥ |\nucyante |\nadhyayanaṃ tāraṃ nāma siddhiḥ |\ntato 'rthajñānaṃ sutāraṃ nāma |\ntatastarkeṇārthaparīkṣaṇaṃ tāratāraṃ nāma siddhiḥ |\ntataḥ parīkṣakasaṃvādanaṃ ramyakaṃ nāma |\ntato vivekakhyātiḥ sadāmuditaṃ nāma |",
      "children": [
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "etāḥ pañca gauṇyaḥ siddhayaḥ |",
              "segment_number": 98
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "duḥkhatrayavighātāstāstrayo mukhyāḥ siddhayaḥ |",
              "segment_number": 99
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "pramodamuditamodanāmākhyāḥ phalamityaṣṭau siddhayaḥ |",
              "segment_number": 100
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "tuṣṭisiddhīnāṃ viparyayāt saptadaśadhā vuddhivadhāḥ ||",
              "segment_number": 101
            }
          ]
        }
      ],
      "segment_number": 97
    },
    {
      "tag": "p",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "[daśa mūlikārthāḥ || Tats_18 ||]",
          "segment_number": 102
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "ke punarmaulikārthāḥ katidhā ucyante |\ndaśadhā maulikārthāha |\nekatvamarthavattvaṃ pārārthyaṃ pradhānasya |\nanyatvamakartṛtvaṃ bahutvaṃ puruṣasya |\nastitvaṃ yogo viyogaścetyubhayayoḥ |\nśeṣavṛttiḥ pariśiṣṭatvaṃ pralaye tadubhayayoḥ |",
      "segment_number": 103
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "taduktam",
          "segment_number": 104
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pradhānāstitvamekatvamarthavattvaṃ yathārthatā /",
          "segment_number": 105
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pārārthyaṃ ca tathā naikyaṃ viyogo yoga eva ca //",
          "segment_number": 106
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "śeṣavṛttirakartṛtvaṃ maulikārthāḥ smṛtā daśa //",
      "segment_number": 107
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "iti |",
      "segment_number": 108
    },
    {
      "tag": "p",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "[anugrahasargaḥ || Tats_19 ||]",
          "segment_number": 109
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "atrāha ko 'nugrahasargaḥ |\nanugṛhṇāti pratyayabhūtādisargaṃ yaḥ sargaḥ so 'nugrahasargaḥ |\ntanmātrasarga evāsau viśeṣāparanāmā |\nke viśeṣāḥ kiyantaśca |\nucyante |\nliṅgadehāha sthūladehāḥ sthūlabhūtāni ca |\ntatra liṅgaṃ sthūladehāt pūrvamutpannamavyāhataṃ sthūlanāśe 'pyanaśvaram |",
      "children": [
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "mahadahaṃkārendriyatanmātrātmakam |",
              "segment_number": 111
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "dharmādharmajñānājñānavairāgyāvairāgyaiśvaryānaiśvaryākhyabhāvavāsitaṃ saṃsarati |",
              "segment_number": 112
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "sthūlabhūtāni tu bhūgolasamudravahniśiśumārabrahmāṇḍavirāṭādīni |",
              "segment_number": 113
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "sthūladehāḥ ke katividhāśceti ucyate ||",
              "segment_number": 114
            }
          ]
        }
      ],
      "segment_number": 110
    },
    {
      "tag": "p",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "[caturdaśavidho bhūtasargaḥ || Tats_20 ||]",
          "segment_number": 115
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "caturdaśavidho bhūtasargaḥ |\ntatrāṣṭāvikalpo daivastairyagyonaḥ pañcadhā mānuṣya ekavidhaḥ brāhmaḥ prājāpatyaḥ paitre gāndharvo yākṣo rākṣasaḥ paiśācāśca daivasargaḥ paśumṛgasarīsṛpasthāvarāḥ tiraścāṃ sargaḥ |\nbrāhmaṇādijātibhede 'pi saṃsthāne viśeṣābhāvāt ekavidho mānuṣya iti caturdaśavidhāḥ sthūladehāḥ |",
      "segment_number": 116
    },
    {
      "tag": "p",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "[trividho bandhaḥ || Tats_21 ||]",
          "segment_number": 117
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "kaḥ punarbandhaḥ katidhā ca |\ntrividho bandhaḥ |\nkāḥ punastā vidhā ucyante |\nprākṛtiko vaikṛtiko dākṣaṇikaśca bandhaḥ |\nprakṛtimātmānaṃ jñātvā taccintanāt prākṛtikaḥ atrocyate pūrṇavarṣasahasraṃ tu tiṣṭhantyavyaktacintakā iti |",
      "children": [
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "mahadādīnātmatvena jñātvā taccintanādvaikārikaḥ |",
              "segment_number": 119
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "atrocyate |",
              "segment_number": 120
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "daśamanvantarāṇīha tiṣṭhantīndriyacintakāḥ /",
              "segment_number": 121
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "bhautikāstu śataṃ pūrṇaṃ sahasraṃ cābhimānikāḥ //",
              "segment_number": 122
            }
          ]
        }
      ],
      "segment_number": 118
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "bauddhā daśasahasrāṇi tiṣṭhanti vigatajvarāḥ /",
      "segment_number": 123
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "amī videhāḥ |\niṣṭāpūrttī dakṣiṇā tannimitto dākṣaṇikaḥ atrocyate /\nsvargasthā narakaṃ yānti nārakāśca triviṣṭapamiti /",
      "segment_number": 124
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "gatāgataṃ kāmakāmā labhanta iti ca |\nata eva hi triṣvapi bandheṣu ekaikāpāye tatastato mokṣa iti |",
      "segment_number": 125
    },
    {
      "tag": "p",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "[trividho mokṣaḥ || Tats_22 ||]",
          "segment_number": 126
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "trividho mokṣaḥ |\nkarmaṇo vikārāt prākṛtaśca mokṣaḥ |\nyaduktam |",
      "segment_number": 127
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "prākṛtena ca bandhena tathā vaikārikeṇa ca /",
          "segment_number": 128
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dakṣiṇābhistṛtīyena vṛddho nānyena mucyate //",
          "segment_number": 129
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "iti |",
      "segment_number": 130
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "atha kutastyānāṃ tattvānāṃ siddhiḥ |\npramāṇāditi brūmaḥ |",
      "segment_number": 131
    },
    {
      "tag": "p",
      "attributes": {},
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "bold"
          },
          "text": "[trividhaṃ pramāṇam || Tats_23 ||]",
          "segment_number": 132
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "tatra pramāṇaṃ kiṃ katividhama vā ucyate trividhaṃ pramāṇam |\ntisro vidhā yasyeti trividham |\nkāstā vidhāḥ |\nucyate |\ndṛṣṭamanumānamāptavacanaṃ ca |\narthasannikṛṣṭendriyajo niścayo dṛṣṭam |\nindriyāṇi pañca cakṣurādīni manaśca |\nvyāptipakṣadharmatājñānapūrvakamanumānam |\ntacca trividham |\npūrvavat śeṣavat sāmānyato dṛṣṭaṃ ca |\npūrvavadyathā kardamena pūrvavṛttavṛṣṭyanumānam |\nśeṣavadyathā |\nsamudrātapalamudakaṃ(?) kṣāramupalabhya śeṣasyāpi kṣāratvānumānam |\nsāmānyato dṛṣṭāṃ ca yathā |\nrūpādyupalabhya tadupalabdheḥ kāraṇasyānumānam |\nrūpādyupalabdhayaḥ karaṇasādhyāḥ kriyatvāt chidikriyāvat |\nāptaśrutirāptavacanaṃ ca |\nyathārthavākyajārthaviṣayodhyavasāya iti yāvat |\nprāvādukodbhāvitānāṃ tu upamānārthāpattisambhavābhāvaitihyapratibhānāmityukteṣvevāntarbhāvaḥ |\nyat tadyathā gaurgavayastatheti vākyam |\ntadjñānanidhīrāgama eva |\ngavayepi gosadṛśasya gavayaśabdo vācaka iti pratyayaḥ soyamanumānametatsaṅketagraharūpatvāt |\nyad gavayasya cakṣuḥsannikṛṣṭagosādṛśyajñānaṃ tatpratyakṣameva |\nata eva smaryamāṇāyāṃ gavi sādṛśyajñānaṃ pratyakṣam |\ngogavayayoḥ sādṛśyasya gavayāntaravarttibhūyovayavasāmānyarūpasya yogarūpasyaikatvādityupamānaṃ na mānāntaram |\njīvato gṛhābhāvadarśanena bahirbhāvakalpanādityarthāpattiranumānameva |\nsambhavopi khāryādau droṇāḍhakaprasthādyavagamarūpo 'numānameva |\niha bhūtale ghaṭo nāstītyādirabhāvāvagamo 'pi pratyakṣameveti nābhāvaḥ pṛthak pramāṇam |\nanirdiṣṭapravaktṛkaṃ pravādamātramaitihyamapīha vaṭe yakṣaḥ prativasatītyapramāṇameva |\nāptamūlatve tvāgama eva |\ndvāravatī puṇyabhūmiriti śruteḥ tatra vasataḥ śreyāṃsastatra gamane puṇyaṃ bhavatītyādibuddhirjāyamānā pratibhā |\nyatrocyate |",
      "children": [
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "anuktamapyūhati paṇḍito jana iti |",
              "segment_number": 134
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "sā tu prāyeṇa pramāṇameva |",
              "segment_number": 135
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "ārṣaṃ tu darśanaṃ pratyakṣameva |",
              "segment_number": 136
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "yā pratibhā sāpyanumānameva ||",
              "segment_number": 137
            }
          ]
        }
      ],
      "segment_number": 133
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "trayoviṃśatisūtrairhi sarvaśāstrārthasaṃgrahaḥ /",
          "segment_number": 138
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kṛto munivareṇātra yathāmati sacīvṛtaḥ(?) //",
          "segment_number": 139
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "iti sāṃkhyasūtravivaraṇākhyā kāpilasūtravṛttiḥ samāptā ||",
      "segment_number": 140
    }
  ]
}