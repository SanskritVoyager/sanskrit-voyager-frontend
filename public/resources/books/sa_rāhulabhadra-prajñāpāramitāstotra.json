  },
  "body": [
    {
      "tag": "head",
      "attributes": {},
      "text": "Rāhulabhadra: Prajñāpāramitāstotra",
      "segment_number": 1,
      "translated_text": "<s>Rāhulabhadra</s>: <s>Prajñāpāramitāstotra</s> (Hymn to the Perfection of Wisdom)"
    },
    {
      "tag": "lg",
      "attributes": {
        "{http://www.w3.org/XML/1998/namespace}id": "RahPps_1"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "nirvikalpe namas tubhyaṃ",
              "segment_number": 2,
              "translated_text": "Homage to you, O unconditioned (<s>nirvikalpa</s>) one,"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "prajñāpāramite 'mite",
              "segment_number": 3,
              "translated_text": "O <s>Prajñāpāramitā</s>, immeasurable (<s>amita</s>),"
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "yā tvaṃ sarvānavadyāṅgi",
              "segment_number": 4,
              "translated_text": "you whose every limb is blameless,"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "niravadyair nirīkṣyase",
              "segment_number": 5,
              "translated_text": "who are beheld by the blameless."
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 6,
              "translated_text": "||"
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "{http://www.w3.org/XML/1998/namespace}id": "RahPps_2"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "ākāśam iva nirlepāṃ",
              "segment_number": 7,
              "translated_text": "Like space, unstained,"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "niṣprapañcāṃ nirakṣarām",
              "segment_number": 8,
              "translated_text": "without elaboration (<s>niṣprapañca</s>), beyond syllables,"
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "yas tvāṃ paśyati bhāvena",
              "segment_number": 9,
              "translated_text": "whoever sees you in reality"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "sa paśyati tathāgatam",
              "segment_number": 10,
              "translated_text": "sees the <s>Tathāgata</s>."
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 11,
              "translated_text": "||"
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "{http://www.w3.org/XML/1998/namespace}id": "RahPps_3"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "tava cārye guṇāḍhyāyā",
              "segment_number": 12,
              "translated_text": "Between you, O Noble Lady, rich in virtues,"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "buddhasya ca jagadguroḥ",
              "segment_number": 13,
              "translated_text": "and the <s>Buddha</s>, the teacher of the world,"
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "na paśyanty antaraṃ santaś",
              "segment_number": 14,
              "translated_text": "the wise see no difference,"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "candracandrikayor iva",
              "segment_number": 15,
              "translated_text": "as between the moon and moonlight."
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 16,
              "translated_text": "||"
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "{http://www.w3.org/XML/1998/namespace}id": "RahPps_4"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "kṛpātmakāḥ prapadya tvāṃ",
              "segment_number": 17,
              "translated_text": "Those of compassionate nature, taking refuge in you,"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "buddhadharmapuraḥsarīm",
              "segment_number": 18,
              "translated_text": "the forerunner of the <s>Buddhadharma</s>,"
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "sukhenāyānti māhātmyam",
              "segment_number": 19,
              "translated_text": "easily attain greatness"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "atulaṃ bhaktivatsale",
              "segment_number": 20,
              "translated_text": "unequaled, O you who cherish the devoted."
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 21,
              "translated_text": "||"
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "{http://www.w3.org/XML/1998/namespace}id": "RahPps_5"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "sakṛd apy āśaye śuddhe",
              "segment_number": 22,
              "translated_text": "Whoever, even once, with pure intention,"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "yas tvāṃ vidhivad īkṣate",
              "segment_number": 23,
              "translated_text": "beholds you according to the proper method,"
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "tenāpi niyataṃ siddhiḥ",
              "segment_number": 24,
              "translated_text": "even by that person, attainment (<s>siddhi</s>) is certainly"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "prāpyate 'moghadarśane",
              "segment_number": 25,
              "translated_text": "obtained, O you of unfailing vision."
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 26,
              "translated_text": "||"
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "{http://www.w3.org/XML/1998/namespace}id": "RahPps_6"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "sarveṣām api vīrāṇāṃ",
              "segment_number": 27,
              "translated_text": "Of all heroes (<s>vīra</s>),"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "parārthaniratātmanām",
              "segment_number": 28,
              "translated_text": "whose natures are devoted to the welfare of others,"
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "poṣikā janayitrī ca",
              "segment_number": 29,
              "translated_text": "you are the nourisher and the progenitress —"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "mātā tvam asi vatsalā",
              "segment_number": 30,
              "translated_text": "a loving mother you are."
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 31,
              "translated_text": "||"
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "{http://www.w3.org/XML/1998/namespace}id": "RahPps_7"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "yad buddhā lokaguravaḥ",
              "segment_number": 32,
              "translated_text": "Since the <s>Buddhas</s>, the teachers of the world,"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "putrās tava kṛpālavaḥ",
              "segment_number": 33,
              "translated_text": "are your compassionate sons,"
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "tena tvam api kalyāṇi",
              "segment_number": 34,
              "translated_text": "therefore, O auspicious one,"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "sarvasattvapitāmahī",
              "segment_number": 35,
              "translated_text": "you are the grandmother of all beings."
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 36,
              "translated_text": "||"
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "{http://www.w3.org/XML/1998/namespace}id": "RahPps_8"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "sarvapāramitābhis tvaṃ",
              "segment_number": 37,
              "translated_text": "By all the <s>pāramitās</s> (perfections),"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "nirmalābhir anindite",
              "segment_number": 38,
              "translated_text": "pure and blameless,"
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "candralekheva tārābhir",
              "segment_number": 39,
              "translated_text": "like the crescent moon by stars,"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "anuyātāsi sarvadā",
              "segment_number": 40,
              "translated_text": "you are always accompanied."
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 41,
              "translated_text": "||"
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "{http://www.w3.org/XML/1998/namespace}id": "RahPps_9"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "vineyaṃ janam āsādya",
              "segment_number": 42,
              "translated_text": "Having found beings to be trained,"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "tatra tatra tathāgataiḥ",
              "segment_number": 43,
              "translated_text": "here and there by the <s>Tathāgatas</s>,"
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "bahurūpā tvam evaikā",
              "segment_number": 44,
              "translated_text": "you alone, though one, in many forms,"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "nānānāmabhir īḍyase",
              "segment_number": 45,
              "translated_text": "are praised by many names."
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 46,
              "translated_text": "||"
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "{http://www.w3.org/XML/1998/namespace}id": "RahPps_10"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "prabhāṃ prāpyeva dīptāṃśor",
              "segment_number": 47,
              "translated_text": "Just as dewdrops reaching"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "avaśyāyodabindavaḥ",
              "segment_number": 48,
              "translated_text": "the radiance of the blazing sun"
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "tvāṃ prāpya pralayaṃ yānti",
              "segment_number": 49,
              "translated_text": "perish, so reaching you perish"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "doṣā vādāś ca vādinām",
              "segment_number": 50,
              "translated_text": "the faults and doctrines of debaters."
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 51,
              "translated_text": "||"
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "{http://www.w3.org/XML/1998/namespace}id": "RahPps_11"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "tvam eva trāsajananī",
              "segment_number": 52,
              "translated_text": "You are the very one who produces terror"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "bālānāṃ bhīmadarśanā",
              "segment_number": 53,
              "translated_text": "in the childish, being fearsome in appearance,"
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "āśvāsajananī cāsi",
              "segment_number": 54,
              "translated_text": "and you are the one who produces comfort"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "viduṣāṃ saumyadarśanā",
              "segment_number": 55,
              "translated_text": "in the wise, being gentle in appearance."
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 56,
              "translated_text": "||"
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "{http://www.w3.org/XML/1998/namespace}id": "RahPps_12"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "yasya tvayy apy abhiṣvaṅgas",
              "segment_number": 57,
              "translated_text": "For one in whom there is no attachment even to you,"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "tvannāthasya na vidyate",
              "segment_number": 58,
              "translated_text": "whose lord you are —"
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "tasyāmba katham anyatra",
              "segment_number": 59,
              "translated_text": "for that one, O Mother, how could"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "rāgadveṣau bhaviṣyataḥ",
              "segment_number": 60,
              "translated_text": "desire and hatred arise toward anything else?"
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 61,
              "translated_text": "||"
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "{http://www.w3.org/XML/1998/namespace}id": "RahPps_13"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "nāgacchasi kutaś cit tvaṃ",
              "segment_number": 62,
              "translated_text": "You do not come from anywhere,"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "na ca kva cana gacchasi",
              "segment_number": 63,
              "translated_text": "nor do you go anywhere,"
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "sthāneṣv api ca sarveṣu",
              "segment_number": 64,
              "translated_text": "and in all places"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "vidvadbhir nopalabhyase",
              "segment_number": 65,
              "translated_text": "you are not apprehended by the wise."
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 66,
              "translated_text": "||"
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "{http://www.w3.org/XML/1998/namespace}id": "RahPps_14"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "ye tvām evaṃ na paśyanti",
              "segment_number": 67,
              "translated_text": "Those who do not see you in this way"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "prapadyante ca bhāvataḥ",
              "segment_number": 68,
              "translated_text": "yet take refuge in you truly,"
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "prapadya ca vimucyante",
              "segment_number": 69,
              "translated_text": "and having taken refuge are liberated —"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "tad idaṃ mahad adbhutam",
              "segment_number": 70,
              "translated_text": "this is a great wonder."
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 71,
              "translated_text": "||"
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "{http://www.w3.org/XML/1998/namespace}id": "RahPps_15"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "tvām eva badhyate paśyann",
              "segment_number": 72,
              "translated_text": "Seeing you, one is bound;"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "apaśyann api badhyate",
              "segment_number": 73,
              "translated_text": "not seeing, one is also bound."
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "tvām eva mucyate paśyann",
              "segment_number": 74,
              "translated_text": "Seeing you, one is freed;"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "apaśyann api mucyate",
              "segment_number": 75,
              "translated_text": "not seeing, one is also freed."
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 76,
              "translated_text": "||"
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "{http://www.w3.org/XML/1998/namespace}id": "RahPps_16"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "aho vismayanīyāsi",
              "segment_number": 77,
              "translated_text": "Ah, you are wondrous!"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "gambhīrāsi yaśasvini",
              "segment_number": 78,
              "translated_text": "You are profound, O illustrious one!"
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "sudurbodhāsi māyeva",
              "segment_number": 79,
              "translated_text": "Most difficult to comprehend — like <s>māyā</s> (illusion),"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "dṛśyase na ca dṛśyase",
              "segment_number": 80,
              "translated_text": "you are seen and yet not seen."
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 81,
              "translated_text": "||"
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "{http://www.w3.org/XML/1998/namespace}id": "RahPps_17"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "buddhaiḥ pratyekabuddhaiś ca",
              "segment_number": 82,
              "translated_text": "Attended by <s>Buddhas</s>, <s>Pratyekabuddhas</s>,"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "śrāvakaiś ca niṣevitā",
              "segment_number": 83,
              "translated_text": "and <s>Śrāvakas</s> (hearers),"
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "mārgas tvam ekā mokṣasya",
              "segment_number": 84,
              "translated_text": "you are the sole path to <s>mokṣa</s> (liberation) —"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "nāsty anya iti niścayaḥ",
              "segment_number": 85,
              "translated_text": "there is no other: this is the certainty."
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 86,
              "translated_text": "||"
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "{http://www.w3.org/XML/1998/namespace}id": "RahPps_18"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "vyavahāraṃ puraskṛtya",
              "segment_number": 87,
              "translated_text": "Resorting to conventional usage,"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "prajñaptyarthaṃ śarīriṇām",
              "segment_number": 88,
              "translated_text": "for the purpose of designation for embodied beings,"
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "kṛpayā lokanāthais tvam",
              "segment_number": 89,
              "translated_text": "out of compassion, by the Protectors of the World,"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "ucyase ca na cocyase",
              "segment_number": 90,
              "translated_text": "you are both spoken and not spoken."
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 91,
              "translated_text": "||"
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "{http://www.w3.org/XML/1998/namespace}id": "RahPps_19"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "śaktaḥ kas tvām iha stotuṃ",
              "segment_number": 92,
              "translated_text": "Who here is able to praise you,"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "nirnimittāṃ nirañjanām",
              "segment_number": 93,
              "translated_text": "you who are without cause, without stain,"
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "sarvavāgviśayātītāṃ",
              "segment_number": 94,
              "translated_text": "who have transcended all domains of speech,"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "yā tvaṃ kva cid aniśritā",
              "segment_number": 95,
              "translated_text": "you who are not established anywhere?"
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 96,
              "translated_text": "||"
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "{http://www.w3.org/XML/1998/namespace}id": "RahPps_20"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "saty evam api saṃvṛtyā",
              "segment_number": 97,
              "translated_text": "Yet even so, through conventional truth (<s>saṃvṛti</s>),"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "vākpathair vayam īdṛśaiḥ",
              "segment_number": 98,
              "translated_text": "by such paths of speech, we"
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "tvām astutyām api satīṃ",
              "segment_number": 99,
              "translated_text": "who are beyond praise yet real,"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "tuṣṭūṣantaḥ sunirvṛtāḥ",
              "segment_number": 100,
              "translated_text": "wishing to praise you, are supremely content."
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 101,
              "translated_text": "||"
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "{http://www.w3.org/XML/1998/namespace}id": "RahPps_21"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "prajñāpāramitāṃ stutvā",
              "segment_number": 102,
              "translated_text": "Having praised the <s>Prajñāpāramitā</s>,"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "yan mayopacitaṃ śubham",
              "segment_number": 103,
              "translated_text": "by whatever merit (<s>śubha</s>) I have accumulated,"
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "tenāstv āśu jagat kṛtsnaṃ",
              "segment_number": 104,
              "translated_text": "may the entire world swiftly"
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "prajñāpāraparāyaṇam",
              "segment_number": 105,
              "translated_text": "become devoted to the far shore of wisdom."
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 106,
              "translated_text": "||"
            }
          ]
        }
      ]
    }
  ]
}