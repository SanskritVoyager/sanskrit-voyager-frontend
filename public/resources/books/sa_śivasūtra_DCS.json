 },
 "body": [
  {
   "tag": "div",
   "attributes": {
    "type": "chapter",
    "n": "1"
   },
   "children": [
    {
     "tag": "head",
     "attributes": {},
     "text": "Chapter 1"
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.1",
      "label": "DCS 1.1"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "caitanyam ātmā ||",
       "translated_text": "Consciousness is the self.",
       "segment_number": 48139
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.2",
      "label": "DCS 1.2"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "jñānaṃ bandhaḥ ||",
       "translated_text": "Knowledge is bondage.",
       "segment_number": 48140
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.3",
      "label": "DCS 1.3"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "yonivargaḥ kalāśarīram ||",
       "translated_text": "The group of wombs is the body made of kalās (limited powers).",
       "segment_number": 48141
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.4",
      "label": "DCS 1.4"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "jñānādhiṣṭhānaṃ mātṛkā ||",
       "translated_text": "The mātṛkā, the matrix of letters, is the foundation of knowledge.",
       "segment_number": 48142
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.5",
      "label": "DCS 1.5"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "udyamo bhairavaḥ ||",
       "translated_text": "Uplifted exertion is <s>Bhairava</s>.",
       "segment_number": 48143
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.6",
      "label": "DCS 1.6"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "śakticakrasaṃdhāne viśvasaṃhāraḥ ||",
       "translated_text": "When the wheel of powers is joined together, there is the dissolution of the universe.",
       "segment_number": 48144
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.7",
      "label": "DCS 1.7"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "jñānaṃ jāgrat ||",
       "translated_text": "Knowledge is the waking state.",
       "segment_number": 48145
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.8",
      "label": "DCS 1.8"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "svapno vikalpāḥ ||",
       "translated_text": "Dream consists of conceptual constructions.",
       "segment_number": 48146
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.9",
      "label": "DCS 1.9"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "aviveko māyā sauṣuptam ||",
       "translated_text": "Non-discrimination, namely māyā, is deep sleep.",
       "segment_number": 48147
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.10",
      "label": "DCS 1.10"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "tritayabhoktā vīreśaḥ ||",
       "translated_text": "The enjoyer of the three states is the lord of heroes.",
       "segment_number": 48148
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.11",
      "label": "DCS 1.11"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "vismayo yogabhūmikāḥ ||",
       "translated_text": "Wonder is the ground of yoga.",
       "segment_number": 48149
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.12",
      "label": "DCS 1.12"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "icchā śaktir umā kumārī ||",
       "translated_text": "Will is power: <s>Umā</s>, the maiden.",
       "segment_number": 48150
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.13",
      "label": "DCS 1.13"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "dṛśyaṃ śarīram ||",
       "translated_text": "The visible object is the body.",
       "segment_number": 48151
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.14",
      "label": "DCS 1.14"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "śuddhatattvasaṃdhānād vāpaśuśaktiḥ ||",
       "translated_text": "Or, through union with the pure principle, there is the power beyond the bound soul.",
       "segment_number": 48152
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.15",
      "label": "DCS 1.15"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "vitarka ātmajñānam ||",
       "translated_text": "Reflective discernment is knowledge of the self.",
       "segment_number": 48153
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.16",
      "label": "DCS 1.16"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "lokānandaḥ samādhisukham ||",
       "translated_text": "The bliss of the worlds is the happiness of samādhi.",
       "segment_number": 48154
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.17",
      "label": "DCS 1.17"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "śaktisaṃdhāne śarīrotpattiḥ ||",
       "translated_text": "When śakti is joined, the body comes into being.",
       "segment_number": 48155
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.18",
      "label": "DCS 1.18"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "bhūtasaṃdhānabhūtapṛthaktvaviśvasaṃghaṭṭāḥ ||",
       "translated_text": "By union with the elements there arise conquest of the elements, separateness from the elements, and the collision of the universe.",
       "segment_number": 48156
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.19",
      "label": "DCS 1.19"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "śuddhavidyodayāc cakreśatvasiddhiḥ ||",
       "translated_text": "From the arising of pure knowledge, mastery over the wheel is accomplished.",
       "segment_number": 48157
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.20",
      "label": "DCS 1.20"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "mahāhradānusaṃdhānān mantravīryānubhavaḥ ||",
       "translated_text": "From contemplation of the great lake comes the experience of the potency of mantra.",
       "segment_number": 48158
      }
     ]
    }
   ]
  },
  {
   "tag": "div",
   "attributes": {
    "type": "chapter",
    "n": "2"
   },
   "children": [
    {
     "tag": "head",
     "attributes": {},
     "text": "Chapter 2"
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_2.1",
      "label": "DCS 2.1"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "cittaṃ mantraḥ ||",
       "translated_text": "The mind is mantra.",
       "segment_number": 48159
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_2.2",
      "label": "DCS 2.2"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "prayatnaḥ sādhakaḥ ||",
       "translated_text": "Effort is the practitioner.",
       "segment_number": 48160
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_2.3",
      "label": "DCS 2.3"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "vidyāśarīrasattā mantrarahasyam ||",
       "translated_text": "The existence of the body of knowledge is the secret of mantra.",
       "segment_number": 48161
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_2.4",
      "label": "DCS 2.4"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "garbhe cittavikāso 'viśiṣṭavidyāsvapnaḥ ||",
       "translated_text": "The development of the mind in the womb is the dream of undifferentiated knowledge.",
       "segment_number": 48162
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_2.5",
      "label": "DCS 2.5"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "vidyāsamutthāne svābhāvike khecarī śivāvasthā ||",
       "translated_text": "When knowledge arises naturally, khecarī is the state of <s>Śiva</s>.",
       "segment_number": 48163
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_2.6",
      "label": "DCS 2.6"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "gurur upāyaḥ ||",
       "translated_text": "The guru is the means.",
       "segment_number": 48164
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_2.8",
      "label": "DCS 2.8"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "mātṛkācakrasaṃbodhaḥ śarīraṃ haviḥ ||",
       "translated_text": "Awakening to the wheel of the mātṛkā: the body is the oblation.",
       "segment_number": 48165
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_2.9",
      "label": "DCS 2.9"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "jñānam annam ||",
       "translated_text": "Knowledge is food.",
       "segment_number": 48166
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_2.10",
      "label": "DCS 2.10"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "vidyāsaṃhāre tadutthasvapnadarśanam ||",
       "translated_text": "When knowledge is withdrawn, there is the vision of the dream that arises from it.",
       "segment_number": 48167
      }
     ]
    }
   ]
  },
  {
   "tag": "div",
   "attributes": {
    "type": "chapter",
    "n": "3"
   },
   "children": [
    {
     "tag": "head",
     "attributes": {},
     "text": "Chapter 3"
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.1",
      "label": "DCS 3.1"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "ātmā cittam ||",
       "translated_text": "The self is the mind.",
       "segment_number": 48168
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.2",
      "label": "DCS 3.2"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "jñānaṃ bandhaḥ ||",
       "translated_text": "Knowledge is bondage.",
       "segment_number": 48169
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.3",
      "label": "DCS 3.3"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "kalādīnāṃ tattvānām aviveko māyā ||",
       "translated_text": "Māyā is the non-discrimination of the principles beginning with kalā.",
       "segment_number": 48170
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.4",
      "label": "DCS 3.4"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "śarīre saṃhāraḥ kalānām ||",
       "translated_text": "In the body there is the withdrawal of the kalās.",
       "segment_number": 48171
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.5",
      "label": "DCS 3.5"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "nāḍīsaṃhārabhūtajayabhūtakaivalyabhūtapṛthaktvāni ||",
       "translated_text": "There are the withdrawal of the nāḍīs, conquest of the elements, isolation of the elements, and separateness from the elements.",
       "segment_number": 48172
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.6",
      "label": "DCS 3.6"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "mohāvaraṇāt siddhiḥ ||",
       "translated_text": "Because of the covering of delusion, there is supernatural attainment.",
       "segment_number": 48173
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.7",
      "label": "DCS 3.7"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "mohajayād anantābhogāt sahajavidyājayaḥ ||",
       "translated_text": "Through conquest of delusion and through unlimited enjoyment, there is mastery of innate knowledge.",
       "segment_number": 48174
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.8",
      "label": "DCS 3.8"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "jāgrad dvitīyakaraḥ ||",
       "translated_text": "In waking, he becomes a maker of a second reality.",
       "segment_number": 48175
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.9",
      "label": "DCS 3.9"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "nartaka ātmā ||",
       "translated_text": "The self is the dancer.",
       "segment_number": 48176
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.10",
      "label": "DCS 3.10"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "raṅgo 'ntarātmā ||",
       "translated_text": "The inner self is the stage.",
       "segment_number": 48177
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.11",
      "label": "DCS 3.11"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "prekṣakāṇīndriyāṇi ||",
       "translated_text": "The senses are the spectators.",
       "segment_number": 48178
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.12",
      "label": "DCS 3.12"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "dhīvaśāt sattvasiddhiḥ ||",
       "translated_text": "Through the control of intelligence, sattva is perfected.",
       "segment_number": 48179
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.13",
      "label": "DCS 3.13"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "siddhaḥ svatantrabhāvaḥ ||",
       "translated_text": "The perfected one has the nature of freedom.",
       "segment_number": 48180
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.14",
      "label": "DCS 3.14"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "yathā tatra tathānyatra ||",
       "translated_text": "As there, so elsewhere.",
       "segment_number": 48181
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.15",
      "label": "DCS 3.15"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "bījāvadhānam ||",
       "translated_text": "Attention to the seed.",
       "segment_number": 48182
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.16",
      "label": "DCS 3.16"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "āsanasthaḥ sukhaṃ hrade nimajjati ||",
       "translated_text": "Established in the posture, he sinks happily into the lake.",
       "segment_number": 48183
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.17",
      "label": "DCS 3.17"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "svamātrānirmāṇam āpādayati ||",
       "translated_text": "He brings about the creation of his own measure.",
       "segment_number": 48184
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.18",
      "label": "DCS 3.18"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "vidyāvināśe janmavināśaḥ ||",
       "translated_text": "With the destruction of knowledge, birth is destroyed.",
       "segment_number": 48185
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.19",
      "label": "DCS 3.19"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "kavargādiṣu māheśvaryādyāḥ paśumātaraḥ ||",
       "translated_text": "Among the letter-groups beginning with ka, the powers such as <s>Māheśvarī</s> are the mothers of the bound soul.",
       "segment_number": 48186
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.20",
      "label": "DCS 3.20"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "triṣu caturthaṃ tailavad āsecyam ||",
       "translated_text": "Into the three, the fourth should be poured like oil.",
       "segment_number": 48187
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.21",
      "label": "DCS 3.21"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "magnaḥ svacittena praviśet ||",
       "translated_text": "Immersed, he should enter with his own mind.",
       "segment_number": 48188
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.22",
      "label": "DCS 3.22"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "prāṇasamācāre samadarśanam ||",
       "translated_text": "When the prāṇa moves evenly, there is equal vision.",
       "segment_number": 48189
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.23",
      "label": "DCS 3.23"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "madhye 'varaprasavaḥ ||",
       "translated_text": "In the middle there is the production of the lower condition.",
       "segment_number": 48190
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.24",
      "label": "DCS 3.24"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "mātrāsv apratyayasaṃdhāne naṣṭasya punar utthānam ||",
       "translated_text": "When connection with the measures has no conceptual support, what was lost rises again.",
       "segment_number": 48191
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.25",
      "label": "DCS 3.25"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "śivatulyo jāyate ||",
       "translated_text": "He becomes equal to <s>Śiva</s>.",
       "segment_number": 48192
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.26",
      "label": "DCS 3.26"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "śarīravṛttir vratam ||",
       "translated_text": "The activity of the body is the vow.",
       "segment_number": 48193
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.27",
      "label": "DCS 3.27"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "kathā japaḥ ||",
       "translated_text": "Speech is japa.",
       "segment_number": 48194
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.28",
      "label": "DCS 3.28"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "dānam ātmajñānam ||",
       "translated_text": "Giving is knowledge of the self.",
       "segment_number": 48195
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.29",
      "label": "DCS 3.29"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "yo 'vipastho jñāhetuś ca ||",
       "translated_text": "He who is established in non-difference is also the cause of knowledge.",
       "segment_number": 48196
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.30",
      "label": "DCS 3.30"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "svaśaktipracayo viśvam ||",
       "translated_text": "The expansion of one's own power is the universe.",
       "segment_number": 48197
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.31",
      "label": "DCS 3.31"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "sthitilayau ||",
       "translated_text": "Persistence and dissolution.",
       "segment_number": 48198
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.32",
      "label": "DCS 3.32"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "tatpravṛttāv apy anirāsaḥ saṃvettṛbhāvāt ||",
       "translated_text": "Even when that activity proceeds, there is no rejection, because of the state of being the knower.",
       "segment_number": 48199
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.33",
      "label": "DCS 3.33"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "sukhāsukhayor bahir mananam ||",
       "translated_text": "Regarding pleasure and pain, reflection is external.",
       "segment_number": 48200
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.34",
      "label": "DCS 3.34"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "tadvimuktas tu kevalī ||",
       "translated_text": "But the one freed from that is alone and absolute.",
       "segment_number": 48201
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.35",
      "label": "DCS 3.35"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "mohapratisaṃhatas tu karmātmā ||",
       "translated_text": "But one compacted by delusion has action as his self.",
       "segment_number": 48202
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.36",
      "label": "DCS 3.36"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "bhedatiraskāre sargāntarakarmatvam ||",
       "translated_text": "When difference is concealed, there is the status of action in another creation.",
       "segment_number": 48203
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.37",
      "label": "DCS 3.37"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "karaṇaśaktiḥ svato 'nubhavāt ||",
       "translated_text": "The power of the instruments exists from itself, because of direct experience.",
       "segment_number": 48204
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.38",
      "label": "DCS 3.38"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "tripadādyanuprāṇanam ||",
       "translated_text": "The enlivening of what begins with the three states.",
       "segment_number": 48205
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.39",
      "label": "DCS 3.39"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "cittasthitivac charīrakaraṇabāhyeṣu ||",
       "translated_text": "As with the state of the mind, so in the body, the instruments, and external things.",
       "segment_number": 48206
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.40",
      "label": "DCS 3.40"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "abhilāpād bahirgatiḥ saṃvāhyasya ||",
       "translated_text": "Because of utterance, the outward movement belongs to what is to be carried along.",
       "segment_number": 48207
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.41",
      "label": "DCS 3.41"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "tadārūḍhapramites tatkṣayāj jīvasaṃkṣayaḥ ||",
       "translated_text": "When valid cognition has mounted upon that, through its destruction there is the destruction of individual life.",
       "segment_number": 48208
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.42",
      "label": "DCS 3.42"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "bhūtakañcukī tadā vimukto bhūyaḥ patisamaḥ paraḥ ||",
       "translated_text": "Then, while still cloaked in the elements, he is liberated; again he becomes supreme, equal to the Lord.",
       "segment_number": 48209
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.43",
      "label": "DCS 3.43"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "naisargikaḥ prāṇasambandhaḥ ||",
       "translated_text": "The connection with prāṇa is natural.",
       "segment_number": 48210
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.44",
      "label": "DCS 3.44"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "nāsikāntarmadhyasaṃyamāt kim atra savyāpasavyasauṣumneṣu ||",
       "translated_text": "From restraint in the middle within the nose, what need is there here of the left, the right, and the suṣumṇā channels?",
       "segment_number": 48211
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.45",
      "label": "DCS 3.45"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "bhūyaḥ syāt pratimīlanam ||",
       "translated_text": "Again there may be closing of the eyes.",
       "segment_number": 48212
      }
     ]
    }
   ]
  }
 ]
}
