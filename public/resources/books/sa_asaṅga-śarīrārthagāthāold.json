  },
  "body": [
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pāpaṃ na kuryān manasā na vācā kāyena vā kiṃcana sarvaloke /",
          "segment_number": 1
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "riktaḥ kāmaiḥ smṛtimān saṃprajānaṃ duḥkhaṃ na seveta anarthasaṃhitam // Śag_1.1",
          "segment_number": 2
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ākhyeyasaṃjñinaḥ satvā ākhyeye 'smin pratiṣṭhitāḥ /",
          "segment_number": 3
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ākhyeyam aparijñāya yogam āyānti mṛtyunaḥ // Śag_2.1",
          "segment_number": 4
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ākhyeyaṃ tu parijñāya ākhyātāraṃ na manyate /",
          "segment_number": 5
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tad vai na vidyate tasya vadeyur yena taṃ pare // Śag_2.2",
          "segment_number": 6
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "samo viśeṣa uta vāpi hīno yo manyate sa vivadeta tena /",
          "segment_number": 7
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vidhātraye 'smin na vikampate yaḥ samo viśiṣṭaś ca na tasya bhavati // Śag_2.3",
          "segment_number": 8
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ācchidya tṛṣṇām iha nāmarūpe prahāya mānaṃ ca na saṃgam eti /",
          "segment_number": 9
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "taṃ śāntadhūmam anighaṃ nirāśaṃ nādrākṣus te devamanuṣyaloke /",
          "segment_number": 10
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "iha bāhirataś ca // Śag_2.4",
          "segment_number": 11
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kāmarāgābhibhūtatvāc cittaṃ me paridahyate /",
          "segment_number": 12
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "aṃga me gautama brūhi śāntiṃ tvam anukaṃpayā // Śag_3.1",
          "segment_number": 13
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "viparyāsena saṃjñānāṃ cittaṃ te paridahyate /",
          "segment_number": 14
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nimittaṃ varjyatāṃ tasmāc chubhaṃ rāgopasaṃhitaṃ // Śag_3.2",
          "segment_number": 15
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "aśubhāṃ bhāvaya sadā tvam ekāgraḥ susamāhitaḥ /",
          "segment_number": 16
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nirvāpayāśu rāgāgniṃ dahyase mā punaḥ punaḥ // Śag_3.3",
          "segment_number": 17
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "saṃskārāvaratāṃ paśya duḥkhato 'nātmatas tathā /",
          "segment_number": 18
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "smṛtiṃ kāyagatāṃ kṛtvā nirvedabahulo bhava // Śag_3.4",
          "segment_number": 19
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bhāvyatām animittaṃ ca mānānuśayanāśanaṃ /",
          "segment_number": 20
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tato mānābhisamayād duḥkhasyāntaṃ kariṣyasi // Śag_3.5",
          "segment_number": 21
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kumārikāpraśnagāthā:",
          "segment_number": 22
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kathaṃvihārabahulo bhikṣuḥ pañcaughatīrṇas taratīha ṣaṣṭhaṃ /",
          "segment_number": 23
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kathaṃdhyāyī vipulāṃ kāmatṛṣṇāṃ tīrṇo bhavaty apratilabdhayoktraḥ // Śag_4.1",
          "segment_number": 24
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "praśrabdhakāyaḥ suvimuktacitto hy asaṃskurvan smṛtimān akopyaḥ",
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ājñāya dharmam avitarkadhyāyī kopaspṛhāstyānadoṣaiḥ viyuktaḥ // Śag_4.2",
          "segment_number": 26
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "evaṃvihārabahulo bhikṣuḥ pañcaughatīrṇas taratīha ṣaṣṭhaṃ /",
              "segment_number": 27
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "evaṃdhyāyī vipulāṃ kāmatṛṣṇāṃ tīrṇo bhavaty apratilabdhayoktraḥ // Śag_4.3",
              "segment_number": 28
            }
          ]
        }
      ],
      "segment_number": 25
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nityotrasto hy ayaṃ loko nityodvignā iyaṃ prajā /",
          "segment_number": 29
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "anutpanneṣu duḥkheṣu samutpanneṣu vā punaḥ /",
          "segment_number": 30
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yadi kiṃcid anutrastaṃ pṛṣṭa ācakṣva tan mama // Śag_5.1",
          "segment_number": 31
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nānyatra jñānatapaso nānyatrendriyanigrahāt /",
          "segment_number": 32
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nānyatra sarvasaṃtyāgān mokṣaṃ paśyāmi devate // Śag_5.2",
          "segment_number": 33
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "cirasya bata paśyāmi brāhmaṇaṃ parinirvṛtaṃ /",
          "segment_number": 34
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sarvavairabhayātītaṃ tīrṇaṃ loke viṣaktikām // Śag_5.3",
          "segment_number": 35
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kenābhivarṇā janatā praṇītā mārgaś ca nairyāṇikataḥ prayuktaḥ /",
          "segment_number": 36
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kutra sthitaḥ kutra ca śikṣamāṇo nāyaṃ martyaḥ paralokād bibheti // Śag_6.1",
          "segment_number": 37
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yaḥ śīlavāñ jñānavān bhāvitātmā samāhitaḥ smṛtimān ṛjugataś ca /",
          "segment_number": 38
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sarve 'sya śokajvarathāḥ prahīṇāḥ samyaksmṛto yasya cittaṃ vimuktaṃ // Śag_6.2",
          "segment_number": 39
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tenābhivarṇā janatā praṇītā mārgaś ca nairyāṇikataḥ prayuktaḥ /",
          "segment_number": 40
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "atra sthitaḥ atra ca śikṣamāṇo nāyaṃ martyaḥ paralokād bibheti // Śag_6.3",
          "segment_number": 41
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kathaṃ yaśasvī bhavati kathaṃ bhavati bhogavān /",
          "segment_number": 42
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kathaṃ kīrtim avāpnoti kathaṃ mitrāṇi vindati // Śag_7.1",
          "segment_number": 43
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "śīlād yaśasvī bhavati dānād bhavati bhogavān /",
          "segment_number": 44
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "satyena kīrtim āpnoti dadan mitrāṇi vindati // Śag_7.2",
          "segment_number": 45
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kutaḥ sarā nivartante kutra vartma na vartate /",
          "segment_number": 46
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kutra duḥkhasukhaṃ loke niḥśeṣam uparudhyate // Śag_8.1",
          "segment_number": 47
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "cakṣuḥ śrotraṃ tathā ghrāṇaṃ jihvā kāyo manas tathā /",
          "segment_number": 48
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yatra nāma ca rūpaṃ ca niḥśeṣam uparuhyate // Śag_8.2",
          "segment_number": 49
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tataḥ sarā nivartante tatra vartma na vartate /",
          "segment_number": 50
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tatra duḥkhasukhaṃ loke niḥśeṣam uparudhyate // Śag_8.3",
          "segment_number": 51
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kena svid oghaṃ tarati kenottarati cārṇavaṃ /",
          "segment_number": 52
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "duḥkhaṃ tyajati kena svit kena svit pariśudhyati // Śag_9.1",
          "segment_number": 53
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "śraddhayā tarati hy ogham apramādena cārṇavaṃ /",
          "segment_number": 54
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vīryeṇa duḥkhaṃ tyajati prajñayā pariśudhyati // Śag_9.2",
          "segment_number": 55
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ka etam oghaṃ tarati rātriṃdivam atandritaḥ /",
          "segment_number": 56
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "anālambe 'pratiṣṭhe ca ko gaṃbhīre na sīdati // Śag_10.1",
          "segment_number": 57
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sarvataḥ śīlasaṃpannaḥ prajñāvān susamāhitaḥ /",
          "segment_number": 58
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "adhyātmacintī smṛtimāṃs taratīmaṃ sudustaraṃ // Śag_10.2",
          "segment_number": 59
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "viraktaḥ kāmasaṃjñābhyo rūpasaṃyojanātigaḥ /",
          "segment_number": 60
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "anālambe 'pratiṣṭhe ca sa gaṃbhīre na sīdati // Śag_10.3",
          "segment_number": 61
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "rāgadveṣau bhagavan kinnidānāv aratiratī romaharṣaḥ kuto 'yam /",
          "segment_number": 62
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kutaḥsamutthāś ca mano vitarkāḥ kumārakā dhātrīm ivāśrayante // Śag_11.1",
          "segment_number": 63
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "snehajā ātmasaṃbhūtā nyagrodhaskandhakā yathā /",
          "segment_number": 64
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pṛthagviṣaktāḥ kāmeṣu mālutā vā latā vane // Śag_11.2",
          "segment_number": 65
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "rāgaś ca dveṣaś ca itonidānāv aratiratī romaharṣaḥ ito 'yaṃ /",
          "segment_number": 66
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "itaḥsamutthāś ca mano vitarkāḥ kumārakā dhātrīm ivāśrayante // Śag_11.3",
          "segment_number": 67
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ye tān prajānanti yatonidānāṃs te tāṃ janā yakṣa vinodayanti /",
          "segment_number": 68
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ta arṇavaṃ saṃpratarantīhaugham atīrṇapūrvam apunarbhavāya // Śag_11.4",
          "segment_number": 69
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kāryam etad brāhmaṇena prahāṇam akilāsinā /",
          "segment_number": 70
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kāmānāṃ viprahāṇārthaṃ na hi kāṃkṣaty asau bhavaṃ // Śag_12.1",
          "segment_number": 71
        }
      ]
    },
    {
      "tag": "l",
      "attributes": {},
      "text": "sa kāryaṃ brāhmaṇasyāsti kṛtārtho brāhmaṇaḥ smṛtaḥ // Śag_12.2",
      "segment_number": 72
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yāvan na gādhaṃ labhate na tīram āyūhate sarvagātraiḥ sa tāvat /",
          "segment_number": 73
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tīraṃ tu labdhveha saṃtiṣṭhati sthale nāyūhate pāragato nirucyate // Śag_12.3",
          "segment_number": 74
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "eṣopamā dāmale brāhmaṇasya kṣīṇāsravo yo nipako dhyānalābhī /",
          "segment_number": 75
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sarve 'sya śokajvarathāḥ prahīṇāḥ samyaksmṛto yasya cittaṃ vimuktam // Śag_12.4",
          "segment_number": 76
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "geya:\nbhikṣo bhikṣo ogham atārṣīḥ /\nāma devate /\nanālambe 'pratiṣṭhe ogham atārṣīḥ /\nāma devate /\nyathā kathaṃ tvaṃ bhikṣo anālambe apratiṣṭhe ogham atārṣīḥ /\nyathā yathāhaṃ devate āyūhāmi tathā tathā saṃsīdāmi / yathā yathā saṃsīdāmi tathā tathā saṃtiṣṭhe / yathā yathā saṃtiṣṭhe tathā tathā uhye / yathā yathāhaṃ devate nāyūhāmi tathā tathā na saṃsīdāmīti vistareṇa śuklapakṣo veditavya",
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "it"
          },
          "text": "ḥ",
          "segment_number": 78
        },
        {
          "tag": "text",
          "text": "// Śag_13",
          "segment_number": 79
        }
      ],
      "segment_number": 77
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kumārikāpraśnagāthā:",
          "segment_number": 80
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "eko 'raṇye prasṛto dhyāyase tvaṃ vittād vihīna uta vā prārthayānaḥ /",
          "segment_number": 81
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "grāmasya vā kiṃcanāgo nv akārṣīḥ kasmāj janena na karoṣi sakhyaṃ",
          "segment_number": 82
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sakhyaṃ na saṃvidyate kena cit tava // Śag_14.1",
          "segment_number": 83
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "arthāprāptyā hṛdayasyeha śāntir jitveha senāṃ priyaśātarūpaṃ /",
          "segment_number": 84
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "eko dhyāyī sukham asmy anvabhotsaṃ tasmād janena na karomi sakhyaṃ",
          "segment_number": 85
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sakhyaṃ na saṃvidyate kena cid mama // Śag_14.2",
          "segment_number": 86
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "anityā bata saṃskārā utpādavyayadharmiṇaḥ /",
          "segment_number": 87
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "utpadya hi nirudhyante teṣāṃ vyupaśamaḥ sukham // Śag_15 (cf. Uv 1.3)",
          "segment_number": 88
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "apramādo 'mṛtapadaṃ pramādo mṛtyunaḥ padaṃ /\napramattā na mriyante pramattās tu sadā mṛtā",
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "it"
          },
          "text": "ḥ",
          "segment_number": 90
        },
        {
          "tag": "text",
          "text": "// Śag_16 (cf. Uv 4.1)",
          "segment_number": 91
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "vitarkapramathitasya dehinas tīvrarāgasya śubhānudarśinaḥ /",
              "segment_number": 92
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "bhūyas tṛṣṇā vivardhate sā gāḍhīkurute 'sya bandhanaṃ // Śag_17 (cf. Uv 3.1)",
              "segment_number": 93
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "dharmasthaṃ śīlasaṃpannaṃ hrīmantaṃ satyavādinaṃ /",
              "segment_number": 94
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "ātmanaḥ priyakartāraṃ taṃ janaḥ kurute priyaṃ // Śag_18 (cf. Uv 5.24)",
              "segment_number": 95
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "yat pareṣūpanidhyāyet karma dṛṣṭveha pāpakam /",
              "segment_number": 96
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "ātmanā tan na kurvīta karmabaddho hi pāpakaḥ // Śag_19 (cf. Uv 9.6)",
              "segment_number": 97
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "subhāṣitaṃ hy uttamam āhur āryāḥ priyaṃ vaden nāpriyaṃ tad dvitīyaṃ /",
              "segment_number": 98
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "satyaṃ vaden nānṛtaṃ tat tṛtīyaṃ dharmaṃ vaden nādharmaṃ tat caturtham // Śag_20 (cf. Uv 8.11)",
              "segment_number": 99
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "śraddhātha hrīḥ śīlam athāpi dānaṃ dharmā ime satpuruṣapraśastāḥ /",
              "segment_number": 100
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "etaṃ hi mārgaṃ divigaṃ vadanti etena vai gacchati devalokam // Śag_21 (cf. Uv 10.1)",
              "segment_number": 101
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "śrutvā dharmaṃ vijānāti śrutvā pāpān nivartate /",
              "segment_number": 102
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "śrutvā anarthaṃ tyajati śrutvā prāpnoti nirvṛtim // Śag_22 (cf. Uv 22.6)",
              "segment_number": 103
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "ākāśasamo na lipyate indrakīlapratimo na kaṃpate /",
              "segment_number": 104
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "hrada iva samupetakardame saṃsāre ramate na paṇḍitaḥ // Śag_23 (cf. Uv 17.12)",
              "segment_number": 105
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "ye rūpeṇa pramiṇvanti māṃ ghoṣeṇānuyānti ca /",
              "segment_number": 106
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "cchandarāgavaśopetā na mā jānanti te janāḥ // Śag_24.1 (cf. Uv 22.12)",
              "segment_number": 107
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "adhyātmaṃ ca vijānāti bahirdhā ca na paśyati /",
              "segment_number": 108
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "adhyātmaphaladarśī yaḥ sa vai ghoṣeṇa nīyate // Śag_24.2 (cf. Uv 22.13)",
              "segment_number": 109
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "adhyātmaṃ ca na jānāti bahirdhā ca vipaśyati /",
              "segment_number": 110
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "bahirdhāphaladarśī yaḥ so 'pi ghoṣeṇa nīyate // Śag_24.3 (cf. Uv 22.14)",
              "segment_number": 111
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "adhyātmaṃ ca na jānāti bahirdhā ca na paśyati /",
              "segment_number": 112
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "samantāvaraṇo bālaḥ so 'pi ghoṣeṇa nīyate // Śag_24.4 (cf. Uv 22.15)",
              "segment_number": 113
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "adhyātmaṃ ca vijānāti bahirdhā ca vipaśyati /",
              "segment_number": 114
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "dhīro niḥsaraṇaprajño na sa ghoṣeṇa nīyate // Śag_24.5 (cf. Uv 22.16)",
              "segment_number": 115
            }
          ]
        }
      ],
      "segment_number": 89
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ṣaṣṭhe adhipatau rājñi rajyamāne rajasvalaḥ /",
          "segment_number": 116
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "arajasy arajā bhavati rakto bālo nirucyate // Śag_25 (cf. Uv 16.22)",
          "segment_number": 117
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nagaram asthiprākāraṃ snāyumāṃsānulepanaṃ /",
          "segment_number": 118
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yatra rāgaś ca dveṣaś ca māno mrakṣaś ca gāhate // Śag_26 (cf. Uv 16.23)",
          "segment_number": 119
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kūrmaḥ svake 'ṅgāni yathā kapāle bhikṣur nidadhyān manaso vitarkāni /",
          "segment_number": 120
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "aniśrito 'nyān aviheṭhamānaḥ parinirvṛto nāpavadeta kaṃ cit // Śag_27 (cf. Uv 26.1)",
          "segment_number": 121
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tulyam atulyaṃ ca saṃbhavaṃ bhavasaṃskāram avāsṛjan muniḥ /",
          "segment_number": 122
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "adhyātmarataḥ samāhita abhinat kośam ivāṇḍasaṃbhavaḥ // Śag_28 (cf. Uv 26.30)",
          "segment_number": 123
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nāsti kāmasamaḥ paṃko nāsti dveṣasamo grahaḥ /",
          "segment_number": 124
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nāsti mohasamaṃ jālaṃ nāsti tṛṣṇāsamā nadī // Śag_29 (cf. Uv 29.37)",
          "segment_number": 125
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ākāśe vai padaṃ nāsti śramaṇo nāsti bāhyakaḥ /",
          "segment_number": 126
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "prapañcābhiratā bālā niṣprapañcās tathāgatāḥ // Śag_30 (cf. Uv 29.38)",
          "segment_number": 127
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "sthitiḥ prapaṃcāś ca na santi yasya yaḥ sa",
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "it"
          },
          "text": "ṃ",
          "segment_number": 129
        },
        {
          "tag": "text",
          "text": "dānaṃ parighaṃ cātivṛttaḥ /",
          "segment_number": 130
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "taṃ nistṛṣṇaṃ muniṃ carantaṃ na vijānāti sadevako 'pi lokaḥ // Śag_31 (cf. Uv 29.51)",
          "segment_number": 131
        },
        {
          "tag": "text",
          "text": "yasya vitarkā vidhūpitā adhyātmam avikalpitā aśeṣaṃ /\nsaṃgaṃ so 'tītya rūpasaṃjñā",
          "segment_number": 132
        },
        {
          "tag": "hi",
          "attributes": {
            "rend": "it"
          },
          "text": "ṃ",
          "segment_number": 133
        },
        {
          "tag": "text",
          "text": "caturyogāpagato na jātim eti // Śag_32 (cf. Uv 29.56)",
          "segment_number": 134
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "dadataḥ puṇyaṃ pravardhate vairaṃ saṃyamato na cīyate /",
              "segment_number": 135
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "kuśalī prajahāti pāpakaṃ kleśānāṃ kṣayatas tu nirvṛtaḥ // Śag_33 (cf. Uv 28.2)",
              "segment_number": 136
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "sarvapāpasyākaraṇaṃ kuśalasyopasaṃpadā /",
              "segment_number": 137
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "svacittaparyavadamanam etaṃ buddhānuśāsanaṃ // Śag_34 (cf. Uv 28.1)",
              "segment_number": 138
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "durnigrahasya laghuno yatrakāmanipātinaḥ /",
              "segment_number": 139
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "cittasya dāmanaṃ sādhu cittaṃ dāntaṃ sukhāvaham // Śag_35 (cf. Uv 31.1)",
              "segment_number": 140
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "cittanimittasya kovidaḥ pravivekasya ca vindate rasaṃ /",
              "segment_number": 141
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "dhyāyī nipakaḥ pratismṛto bhuṃkte prītisukhaṃ nirāmiṣaṃ // Śag_36 (cf. Uv 31.51)",
              "segment_number": 142
            }
          ]
        },
        {
          "tag": "text",
          "text": "aśilpajīvī laghur ātmakāmo jitendriyaḥ sarvato vipramuktaḥ /\nanokasārī hy amamo nirāśaḥ kāmān prahāyaikacaro yas sa bhikṣu",
          "segment_number": 143
        },
        {
          "tag": "hi",
          "attributes": {
            "rend": "it"
          },
          "text": "ḥ",
          "segment_number": 144
        },
        {
          "tag": "text",
          "text": "// Śag_37 (cf. Uv 32.5)\ndūraṃga",
          "segment_number": 145
        },
        {
          "tag": "hi",
          "attributes": {
            "rend": "it"
          },
          "text": "ma",
          "segment_number": 146
        },
        {
          "tag": "text",
          "text": "m ekacaram aśarīraṃ guhāśayaṃ /",
          "segment_number": 147
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "damayati durdamaṃ cittaṃ brāhmaṇaṃ taṃ bravīmy ahaṃ // Śag_38 (cf. Uv 33.55)",
          "segment_number": 148
        }
      ],
      "segment_number": 128
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pārāyaṇeṣv ajitapraśnaḥ:",
          "segment_number": 149
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kenāyaṃ nivṛto lokaḥ kenāyaṃ na prakāśate /",
          "segment_number": 150
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kiṃ cābhilepanaṃ brūṣe kiṃ ca tasya mahad bhayam // Śag_39.1",
          "segment_number": 151
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "avidyānivṛto lokaḥ pramādān na prakāśate /",
          "segment_number": 152
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "jalpābhilepanaṃ brūmi duḥkhaṃ tasya mahad bhayaṃ // Śag_39.2",
          "segment_number": 153
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sravanti sarvataḥ srotāḥ srotasāṃ kiṃ nivāraṇaṃ /",
          "segment_number": 154
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "srotasāṃ saṃvaraṃ brūhi kena srotaḥ pidhīyate // Śag_39.3",
          "segment_number": 155
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yāni srotāṃsi lokasya smṛtiḥ teṣāṃ nivāraṇaṃ /",
          "segment_number": 156
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "srotasāṃ saṃvaraṃ brūmi prajñayā hi pidhīyate // Śag_39.4",
          "segment_number": 157
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "prajñāyāś ca smṛteś caiva nāmarūpasya sarvaśaḥ /",
          "segment_number": 158
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ācakṣva pṛṣṭa etan me kutraitad uparudhyate // Śag_39.5",
          "segment_number": 159
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "prajñā caiva smṛtiś caiva nāmarūpaṃ ca sarvaśaḥ /",
          "segment_number": 160
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vijñānasya nirodhād dhi atraitad uparudhyate // Śag_39.6",
          "segment_number": 161
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kathaṃ smṛtasya carato vijñānam uparudhyate /",
          "segment_number": 162
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ācakṣva pṛṣṭa etan me yathātatham asaṃśayaḥ // Śag_39.7",
          "segment_number": 163
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "adhyātaṃ ca bahirdhā ca vedanāṃ nābhinandataḥ /",
          "segment_number": 164
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "evaṃ smṛtasya carato vijñānam uparudhyate // Śag_39.8",
          "segment_number": 165
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "ye ca saṃkhyātadharmāṇo ye ca śaikṣāḥ pṛ",
      "children": [
        {
          "tag": "hi",
          "attributes": {
            "rend": "it"
          },
          "text": "tha",
          "segment_number": 167
        },
        {
          "tag": "text",
          "text": "gvidhāḥ /",
          "segment_number": 168
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "teṣāṃ me nipakasyeryāṃ pṛṣṭaḥ prabrūhi mārṣa // Śag_39.9",
          "segment_number": 169
        },
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "kāmeṣu nābhigṛdhyeta manasānāvilo bhavet /",
              "segment_number": 170
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "kuśalaḥ sarvadharmeṣu smṛto bhikṣuḥ parivrajet // Śag_39.10",
              "segment_number": 171
            }
          ]
        }
      ],
      "segment_number": 166
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "arthavargīyeṣu kāmān ārabhya gāthā:",
          "segment_number": 172
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kāmān kāmāyamānasya tasya cet tat samṛdhyati /",
          "segment_number": 173
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "addhā prītamanā bhavati labdhvā martyo yad īpsitaṃ // Śag_40.1",
          "segment_number": 174
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tasya cet kāmāyamānasya chandajātasya jaṃtunaḥ /",
          "segment_number": 175
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "te kāmāḥ parihīyaṃte śalyaviddha iva rūpyate // Śag_40.2",
          "segment_number": 176
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yaḥ kāmāṃ parivarjayati sarpasyeva śirāt padaṃ /",
          "segment_number": 177
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sa imāṃ viṣaktikāṃ loke smṛtaḥ samativartate // Śag_40.3",
          "segment_number": 178
