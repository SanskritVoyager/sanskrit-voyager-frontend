  "body": [
    {
      "tag": "p",
      "attributes": {},
      "text": "Vigrahavyāvartanī-kārikā ||",
      "segment_number": 1
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sarveṣāṃ bhāvānāṃ sarvatra na vidyate svabhāvaś cet |",
          "segment_number": 2
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tvadvacanam asvabhāvaṃ na nivartayituṃ svabhāvam alam || NagVvy_01",
          "segment_number": 3
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atha savabhāvam etad vākyaṃ pūrvā hatā pratijñā te |",
          "segment_number": 4
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vaiṣamikatvaṃ tasmin viśeṣahetuś ca vaktavyaḥ || NagVvy_02",
          "segment_number": 5
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "mā śabdavad ity etat syāt te buddhir na caitad upapannam |",
          "segment_number": 6
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śabdena hy atra satā bhaviṣyato vāraṇaṃ tasya || NagVvy_03",
          "segment_number": 7
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pratiṣedhapratiṣedho 'py evam iti mataṃ bhavet tad asad eva |",
          "segment_number": 8
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "evaṃ tava pratijñā lakṣaṅato dūṣyate na mama || NagVvy_04",
          "segment_number": 9
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pratyakṣeṇa hi tāvad yady upalabhya vinivartayasi bhāvān |",
          "segment_number": 10
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tan nāsti pratyakṣaṃ bhāvā yenopalabhyante || NagVvy_05",
          "segment_number": 11
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "anumānaṃ pratyuktaṃ pratyakṣeṇāgamopamāne ca |",
          "segment_number": 12
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "anumānāgamasādhyā ye 'rthā dṛṣṭāntasādhyāś ca || NagVvy_06",
          "segment_number": 13
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kuśalānāṃ dharmāvasthāvidaś ca manyante |",
          "segment_number": 14
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kuśalaṃ janāḥ svabhāvaṃ śeṣeṣv apy eṣa viniyogaḥ || NagVvy_07",
          "segment_number": 15
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nairyāṇikasvabhāvo dharmā nairyāṇikāś ca ye teṣām |",
          "segment_number": 16
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dharmāvasthoktānām evaṃ anairyāṇikādīnām || NagVvy_08",
          "segment_number": 17
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yadi ca na bhavet svabhāvo dharmāṇāṃ niḥsvabhāva ity evam |",
          "segment_number": 18
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nāmāpi bhaven naivaṃ nāma hi nirvastukaṃ nāsti || NagVvy_09",
          "segment_number": 19
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atha vidyate svabhāvaḥ sa ca dharmāṇāṃ na vidyate tasmāt |",
          "segment_number": 20
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dharmair vinā svabhāvaḥ sa yasya tad yuktam upadeṣṭum || NagVvy_10",
          "segment_number": 21
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sata eva pratiṣedho nāsti ghaṭo geha ity ayaṃ yasmāt |",
          "segment_number": 22
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dṛṣṭaḥ pratiṣedho 'yaṃ sataḥ svabhāvasya te tasmāt || NagVvy_11",
          "segment_number": 23
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atha nāsti sa svabhāvaḥ kiṃ nu pratiṣidhyate tvayānena |",
          "segment_number": 24
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vacanenarte vacanāt pratiṣedhaḥ sidhyate hy asataḥ || NagVvy_12",
          "segment_number": 25
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bālānāṃ iva mithyā mṛgatṛṣnāyāṃ yathājalagrāhaḥ |",
          "segment_number": 26
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "evaṃ mithyāgrāhaḥ syāt te pratiṣedhyato hy asataḥ || NagVvy_13",
          "segment_number": 27
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nanv evaṃ saty asti grāho grāhyaṃ ca tadgrahītā ca |",
          "segment_number": 28
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pratiṣedhaḥ pratiṣedhyaṃ pratiṣeddhā ceti ṣaṭkaṃ tat || NagVvy_14",
          "segment_number": 29
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atha naivāsti grāho naiva grāhyaṃ na ca grahītāraḥ |",
          "segment_number": 30
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pratiṣedhaḥ pratiṣedhyaṃ pratiṣeddhāro nanu sa santi || NagVvy_15",
          "segment_number": 31
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "pratiṣedhaḥ pratiṣedhyaṃ pratiṣeddhāraś ca yadyuta na santi |",
      "segment_number": 32
    },
    {
      "tag": "l",
      "attributes": {},
      "text": "siddhā hi sarvabhāvās teṣam eva svabhāvaś ca || NagVvy_16",
      "segment_number": 33
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "hetoś ca te na siddhir naiḥsvābhāvyāt kuto hi te hetuḥ |",
          "segment_number": 34
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nirhetukasya siddhir na copapannāsya te 'rthasya || NagVvy_17",
          "segment_number": 35
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yadi cāhetoḥ siddhiḥ svabhāvavinivartanasya te bhavati |",
          "segment_number": 36
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "svābhāvyasyāstitvaṃ mamāpi nirhetukaṃ siddham || NagVvy_18",
          "segment_number": 37
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atha hetor astitvaṃ bhāvāsvābhāvyam ity anupapannam |",
          "segment_number": 38
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "lokeṣu niḥsvabhāvo na hi kaś cana vidyate bhāvaḥ || NagVvy_19",
          "segment_number": 39
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pūrvaṃ cet pratiṣedhaḥ paścāt pratiṣedhyam ity anupapannam |",
          "segment_number": 40
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "paścāc cānupapanno yugapac ca yataḥ svabhāvaḥ san || NagVvy_20",
          "segment_number": 41
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "hetupratyayasāmagryāṃ ca pṛthak cāpi madvaco na yadi |",
          "segment_number": 42
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "manu śūnyatvaṃ siddhaṃ bhāvānām asvabhāvatvāt || NagVvy_21",
          "segment_number": 43
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yaś ca pratītyabhāvo bhāvānāṃ śūnyateti sā proktā |",
          "segment_number": 44
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yaś pratītyabhāvo bhavati hi tasyāsvabhāvatvam || NagVvy_22",
          "segment_number": 45
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nirmitako nirmitakaṃ māyāpuruṣaḥ svamāyayā sṛṣṭam |",
          "segment_number": 46
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pratiṣedhayeta yadvat pratiṣedho 'yaṃ tathaiva syāt || NagVvy_23",
          "segment_number": 47
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "na svābhāvikam etad vākyaṃ tasmān na vādahānir me |",
          "segment_number": 48
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nāsti ca vaiṣamikatvaṃ viśeṣahetuś ca na nigadyaḥ || NagVvy_24",
          "segment_number": 49
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "mā śabdavad iti nāyaṃ dṛṣṭānto yas tvayā samārabdhaḥ |",
          "segment_number": 50
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śabdena hi tac chabdasya vāraṇaṃ naivam etac ca || NagVvy_25",
          "segment_number": 51
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "naiḥsvābhāvyānāṃ cen naiḥsvābhāvyena vāraṇaṃ yadi hi |",
          "segment_number": 52
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "naiḥsvābhāvyanivṛttau svābhāvyaṃ hi prasiddhaṃ syāt || NagVvy_26",
          "segment_number": 53
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atha vā nirmitakāyāṃ yathā striyāṃ strīyam ity asadgrāham |",
          "segment_number": 54
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nirmitakaḥ pratihanyāt kasya cid evaṃ bhaved etat || NagVvy_27",
          "segment_number": 55
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atha vā sādhyasamo 'yaṃ hetur na hi vidyate dhvaneḥ sattā |",
          "segment_number": 56
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "saṃvyavahāraṃ ca vayaṃ nānabhyupagamya kathayāmaḥ || NagVvy_28",
          "segment_number": 57
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yadi kā cana pratijñā syān me tata eṣa me bhaved doṣaḥ |",
          "segment_number": 58
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nāsti ca mama pratijñā tasmān naivāsti me doṣaḥ || NagVvy_29",
          "segment_number": 59
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yadi kiṃ cid upalabheyaṃ pravartayeyaṃ nivartayeyaṃ vā |",
          "segment_number": 60
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pratyakṣādibhir arthais tadabhāvān me 'nupālambhaḥ || NagVvy_30",
          "segment_number": 61
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yadi ca pramāṇatas te teṣāṃ teṣāṃ prasiddhir arthānām |",
          "segment_number": 62
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "teṣāṃ punaḥ prasiddhiṃ brūhi kathaṃ te pramāṇānām || NagVvy_31",
          "segment_number": 63
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "anyair yadi pramāṇaiḥ pramāṇasiddhir bhavet tad anavasthā |",
          "segment_number": 64
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nādeḥ siddhis tatrāsti naiva madhyasya nāntasya || NagVvy_32",
          "segment_number": 65
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "teṣām atha pramāṇair vinā prasiddhir vihīyate vādaḥ |",
          "segment_number": 66
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vaiṣamikatvaṃ tasmin viśeṣahetuś ca vaktavyaḥ || NagVvy_33",
          "segment_number": 67
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "viṣamopanyāso 'yaṃ na hy ātmānaṃ prakāśayaty agniḥ |",
          "segment_number": 68
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "na hi tasyānupalabdhir dṛṣṭā tamasīva kumbhasya || NagVvy_34",
          "segment_number": 69
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yadi ca svātmānam ayaṃ tvadvacanena prakāśayaty agniḥ |",
          "segment_number": 70
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "param iva nanv ātmānaṃ svaṃ paridhakṣyaty api hutāśaḥ || NagVvy_35",
          "segment_number": 71
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yadi ca svaparātmānau tvadvacanena prakāśayaty agniḥ |",
          "segment_number": 72
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pracchādayiṣyati tamaḥ svaparātmānau hutāśa iva || NagVvy_36",
          "segment_number": 73
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nāsti tamaś ca jvalane yatra ca tiṣṭhati parātmani jvalanaḥ |",
          "segment_number": 74
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kurute kathaṃ prakāśaṃ sa hi prakāśo 'ndhakāravadhaḥ || NagVvy_37",
          "segment_number": 75
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "utpadyamāna eva prakāśayaty agnir ity asadvādaḥ |",
          "segment_number": 76
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "utpadyamāna eva prāpnoti tamo na hi hutāśaḥ || NagVvy_38",
          "segment_number": 77
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "aprāpto 'pi jvalano yadi vā punar andhakāram upahanyāt |",
          "segment_number": 78
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sarveṣu lokadhātuṣu tamo 'yam iha saṃsthito hanyāt || NagVvy_39",
          "segment_number": 79
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yadi svataś ca pramāṇasiddhir anapekṣya tava prameyāṇi |",
          "segment_number": 80
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhavati pramāṇasiddhir na parāpekṣā svataḥsiddhiḥ || NagVvy_40",
          "segment_number": 81
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "anapekṣya hi prameyān arthān yadi te pramāṇasiddhir iti |",
          "segment_number": 82
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "na bhavanti kasya cid evam imāni tāni pramāṇāni || NagVvy_41",
          "segment_number": 83
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atha matam apekṣya siddhis teṣām ity atra bhavati ko doṣaḥ |",
          "segment_number": 84
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "siddhasya sādhanaṃ syān nāsiddho 'pekṣate hy anyat || NagVvy_42",
          "segment_number": 85
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sidhyanti hi prameyāṇy apekṣya yadi sarvathā pramāṇāni |",
          "segment_number": 86
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhavati prameyasiddhir nāpekṣyaiva pramāṇāni || NagVvy_43",
          "segment_number": 87
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yadi ca prameyasiddhir nāpekṣyaiva bhavati pramāṇāni |",
          "segment_number": 88
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kiṃ te pramāṇasiddhyā tāni yadarthaṃ prasiddhaṃ tat || NagVvy_44",
          "segment_number": 89
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atha tu pramāṇasiddhir bhavaty apekṣyaiva te prameyāṇi |",
          "segment_number": 90
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vyatyaya evaṃ sati te dhruvaṃ pramāṇaprameyāṇām || NagVvy_45",
          "segment_number": 91
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atha te pramāṇasiddhyā prameyasiddhiḥ prameyasiddhyā ca |",
          "segment_number": 92
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhavati pramāṇasiddhir nāsty ubhayasyāpi te siddhiḥ || NagVvy_46",
          "segment_number": 93
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sidhyanti hi pramāṇair yadi prameyāṇi tāni tair eva |",
          "segment_number": 94
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sādhyāni ca prameyais tāni kathaṃ sādhayiṣyanti || NagVvy_47",
          "segment_number": 95
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sidhyanti ca prameyair yadi pramāṇāni tāni tair eva |",
          "segment_number": 96
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sādhyāni ca pramāṇais tāni kathaṃ sādhayiṣyanti || NagVvy_48",
          "segment_number": 97
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pitrā yady utpādyaḥ putro yadi tena caiva putreṇa |",
          "segment_number": 98
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "utpādyaḥ sa yadi pitā vada tatrotpādayati kaḥ kam || NagVvy_49",
          "segment_number": 99
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kaś ca pitā kaḥ putras tatra tvaṃ brūhi tāv ubhāv api ca |",
          "segment_number": 100
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pitṛputralakṣaṇadharau yato bhavati no 'tra saṃdehaḥ || NagVvy_50",
          "segment_number": 101
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "naiva svataḥ prasiddhir na parasparataḥ parapramāṇair vā |",
          "segment_number": 102
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "na bhavati na ca prameyair na cāpy akasmāt pramāṇānāṃ || NagVvy_51",
          "segment_number": 103
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kuśalānāṃ dharmāṇāṃ dharmāvasthāvido bruvīran yat |",
          "segment_number": 104
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kuśalaṃ svabhāvam evaṃ pravibhāgenābhidheyaḥ syāt || NagVvy_52",
          "segment_number": 105
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yadi ca pratīya kuśalaḥ svabhāva utpadyate sa kuśalānām |",
          "segment_number": 106
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dharmāṇāṃ parabhāvaḥ svabhāva evaṃ kathaṃ bhavati || NagVvy_53",
          "segment_number": 107
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atha na pratītya kiṃ cit svabhāva utpadyate sa kuśalānām |",
          "segment_number": 108
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dharmāṇam evaṃ syād vāso na brahmacaryasya || NagVvy_54",
          "segment_number": 109
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nādharmo dharmo vā saṃvyavahārāś ca laukikā na syuḥ |",
          "segment_number": 110
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nityāś ca sasvabhāvāḥ syur nityatvād ahetumataḥ || NagVvy_55",
          "segment_number": 111
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "evam akuśaleṣv avyākṛteṣu nairyāṇikādiṣu ca doṣaḥ |",
          "segment_number": 112
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tasmāt sarvaṃ saṃskṛtam asaṃskṛtaṃ te bhavaty eva || NagVvy_56",
          "segment_number": 113
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yaḥ sadbhūtaṃ nāmātra brūyāt sasvabhāva ity evam |",
          "segment_number": 114
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhavatā prativaktavyo nāma brūmaś ca na vayaṃ sat || NagVvy_57",
          "segment_number": 115
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nāmāsad iti ca yad idaṃ tat kiṃ nu sato bhavaty utāpy asataḥ |",
          "segment_number": 116
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yadi hi sato yady asato dvidhāpi te hīyate vādaḥ || NagVvy_58",
          "segment_number": 117
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sarveṣāṃ bhāvānāṃ śūnyatvaṃ copapāditaṃ pūrvam |",
          "segment_number": 118
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sa upālambhas tasmād bhavaty ayaṃ cāpratijñāyāḥ || NagVvy_59",
          "segment_number": 119
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atha vidyate svabhāvaḥ sa ca dharmāṇāṃ na vidyata itīdam |",
          "segment_number": 120
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "āśaṅkitaṃ yad uktaṃ bhavaty anāśaṅkitaṃ tac ca || NagVvy_60",
          "segment_number": 121
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sata eva pratiṣedho yadi śūnyatvaṃ nanu prasiddham idam |",
          "segment_number": 122
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pratiṣedhayate hi bhavān bhāvānāṃ niḥsvabhāvatvam || NagVvy_61",
          "segment_number": 123
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pratiṣedhayase 'tha tvaṃ śūnyatvaṃ tac ca nāsti śūnyatvam |",
          "segment_number": 124
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pratiṣedhaḥ sata iti te nanv eṣa vihīyate vādaḥ || NagVvy_62",
          "segment_number": 125
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pratiṣedhayāmi nāhaṃ kiṃ cit pratiṣedhyam asti na ca kiṃ cit |",
          "segment_number": 126
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tasmāt pratiṣedhayasīty adhilaya eṣa tvayā kriyate || NagVvy_63",
          "segment_number": 127
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yac cāharte vacanād asataḥ pratiṣedhavacanasiddhir iti |",
          "segment_number": 128
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "atra jñāpayate vāg asad iti tan na pratinihanti || NagVvy_64",
          "segment_number": 129
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "mṛgatṛṣṇādṛṣṭānte yaḥ punar uktas tvayā mahāṃś carcaḥ |",
          "segment_number": 130
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tatrāpi nirṇayaṃ śṛṇu yathā sa dṛṣṭānta upapannaḥ || NagVvy_65",
          "segment_number": 131
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sa yadi svabhāvataḥ syād grāho na syāt pratītya saṃbhūtaḥ |",
          "segment_number": 132
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yaś ca pratītya bhavati grāho nanu śūnyatā saiva || NagVvy_66",
          "segment_number": 133
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yadi ca svabhāvataḥ syād grāhaḥ kas taṃ nivartayed grāham |",
          "segment_number": 134
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śeṣeṣv apy eṣa viddhis tasmād eṣo 'nupālambhaḥ || NagVvy_67",
          "segment_number": 135
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "etena hetvabhāvaḥ pratyuktaḥ pūrvam eva sa samatvāt |",
          "segment_number": 136
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "mṛgatṛṣṇādṛṣṭāntavyāvṛttividhau ya uktaḥ prāk || NagVvy_68",
          "segment_number": 137
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yas traikālye hetuḥ pratyuktaḥ pūrvam eva sa samatvāt |",
          "segment_number": 138
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "traikālyapratihetuś ca śūnyatāvādināṃ prāptaḥ || NagVvy_69",
          "segment_number": 139
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "prabhavati ca śūnyateyaṃ yasya prabhavanti tasya sarvārthāḥ |",
          "segment_number": 140
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "prabhavati na tasya kiṃ cin na prabhavati śūnyatā yasya || NagVvy_70",
          "segment_number": 141
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yaḥ śūnyatāṃ pratītyasamutpādaṃ madhyamāṃ pratipadaṃ ca |",
          "segment_number": 142
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ekārthāṃ nijagāda praṇamāmi tam apratimabuddham || NagVvy_71",
          "segment_number": 143
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%",
      "segment_number": 144
