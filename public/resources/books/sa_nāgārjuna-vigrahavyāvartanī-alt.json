  "body": [
    {
      "tag": "p",
      "attributes": {},
      "text": "Vigrahavyāvartanī (Vv)",
      "segment_number": 1
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sarveṣāṃ bhāvānāṃ sarvatra na vidyate svabhāvaścet /",
          "segment_number": 2
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tvadvacanamasvabhāvaṃ na nivartayituṃ svabhāvamalam // Vv_1 //",
          "segment_number": 3
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atha sasvabhāvametadvākyaṃ śrutvā hatā pratijñā te /",
          "segment_number": 4
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vaiṣamikatvaṃ tasmin viśeṣahetuśca vaktavyaḥ // Vv_2 //",
          "segment_number": 5
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "mā śabdavadityetat syātte buddhirna caitadupapannam /",
          "segment_number": 6
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śabdenātra satā bhaviṣyato vāraṇaṃ tasya // Vv_3 //",
          "segment_number": 7
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pratiṣedhaḥ pratiṣeddhyo 'pyevamiti mataṃ bhavet tadasadeva /",
          "segment_number": 8
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "evaṃ tava pratijñā lakṣaṇato duṣyate na mama // Vv_4 //",
          "segment_number": 9
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pratyakṣeṇa hi tāvan yadyupalabhya vinivartayasi bhāvān /",
          "segment_number": 10
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tannāsti pratyakṣaṃ bhāvā yenopalabhyante // Vv_5 //",
          "segment_number": 11
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "anumānaṃ pratyuktaṃ pratyakṣeṇāgamopamāne ca /",
          "segment_number": 12
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "anumānāgamasādhyā ye 'rthā dṛṣṭāntasādhyāśca // Vv_6 //",
          "segment_number": 13
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kuśalānāṃ dharmāṇāṃ dharmāvasthāvidaśca manyante /",
          "segment_number": 14
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kuśalaṃ janasvabhāvaṃ śeṣeṣvapyeṣa viniyogaḥ // Vv_7 //",
          "segment_number": 15
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nairyāṇikasvabhāvo dharmo nairyāṇikāśca ye teṣām /",
          "segment_number": 16
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dharmāvasthoktānāmeva ca nairyāṇikādīnām // Vv_8 //",
          "segment_number": 17
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yadi ca na bhavet svabhāvo dharmāṇāṃ niḥsvabhāva ityevam /",
          "segment_number": 18
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nāmāpi bhavennaivaṃ nāmāpi nirvastukaṃ nāsti // Vv_9 //",
          "segment_number": 19
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atha vidyate svabhāvaḥ sa ca dharmāṇāṃ na vidyate tasmāt /",
          "segment_number": 20
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dharmairvinā svabhāvaḥ sa yasyāsti tad yuktamupadeṣṭum // Vv_10 //",
          "segment_number": 21
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sata eva pratiṣedho nāsti ghaṭo geha ityayaṃ yasmāt /",
          "segment_number": 22
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dṛṣṭaḥ pratiṣedho 'yaṃ sataḥ svabhāvasya te tasmāt // Vv_11 //",
          "segment_number": 23
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atha nāsti sa svabhāvaḥ kiṃ nu pratividhyate tvayānena /",
          "segment_number": 24
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vacanenarte vacanāt pratiṣedhaḥ sidhyate hyasataḥ // Vv_12 //",
          "segment_number": 25
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bālānāmiva mithyā mṛgatṛṣṇāyāṃ yathā jalagrāhaḥ /",
          "segment_number": 26
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "evaṃ mithyāgrāhaḥ syātte pratiṣidhyato hyasataḥ // Vv_13 //",
          "segment_number": 27
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nanvevaṃ satyasti grāho grāhyaṃ ca tagdṛhītaṃ ca /",
          "segment_number": 28
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pratiṣedhaḥ pratiṣedhyaṃ pratiṣeddhā ceti ṣaṭkaṃ tat // Vv_14 //",
          "segment_number": 29
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atha naivāsti grāho na ca grāhyaṃ na ca grahītāraḥ /",
          "segment_number": 30
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pratiṣedhaḥ pratiṣedhyaṃ pratiṣeddhāro 'sya tu na santi // Vv_15 //",
          "segment_number": 31
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pratiṣedhaḥ pratiṣedhyaṃ pratiṣeddhāraśca yadyuta na santi /",
          "segment_number": 32
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "siddhā hi sarvabhāvā yeṣāmevaṃ svabhāvaśca // Vv_16 //",
          "segment_number": 33
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "hetostato na siddhirnaiḥsvābhāvyāt kuto hi te hetuḥ /",
          "segment_number": 34
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nirhetukasya siddhirna copapannāsya te 'rthasya // Vv_17 //",
          "segment_number": 35
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yadi cāhetoḥ siddhiḥ svabhāvavinivartanasya te bhavati /",
          "segment_number": 36
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "svābhāvyasyāstitvaṃ mamāpi nirhetukaṃ siddham // Vv_18 //",
          "segment_number": 37
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atha hetorastitvaṃ bhāvanaiḥsvābhāvyamityanupapannam /",
          "segment_number": 38
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "loke naiḥsvābhāvyānna hi kaścana vidyate bhāvaḥ // Vv_19 //",
          "segment_number": 39
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pūrvaṃ cet pratiṣedhaḥ paścāt pratiṣedhyamiti ca nopapannam /",
          "segment_number": 40
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "paścādanupapanno yugapacca yataḥ svabhāvo 'san // Vv_20 //",
          "segment_number": 41
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "hetupratyayasāmagryāṃ pṛthagbhāve 'pi madvaco na yadi /",
          "segment_number": 42
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nanu śūnyatvaṃ siddhaṃ bhāvānāmasvabhāvatvāt // Vv_21 //",
          "segment_number": 43
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yaśca pratītya bhāvo bhāvānāṃ śūnyateti sā hyuktā /",
          "segment_number": 44
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yaśca pratītya bhāvo bhavati hi tasyāsvabhāvatvam // Vv_22 //",
          "segment_number": 45
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nirmitako nirmitakaṃ māyāpuruṣaḥ svamāyayā sṛṣṭam /",
          "segment_number": 46
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pratisedhayase yadvat pratiṣedho 'yaṃ tathaiva syāt // Vv_23 //",
          "segment_number": 47
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "na svābhāvikametad vākyaṃ tasmānna vādahānirme /",
          "segment_number": 48
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nāsti ca vaiṣamikatvaṃ viśeṣahetuśca na nigadyaḥ // Vv_24 //",
          "segment_number": 49
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "mā śabdavaditi nāyaṃ dṛṣṭānto yastvayā mamārabdhaḥ /",
          "segment_number": 50
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śabdena hi tacca śabdasya vāraṇaṃ naiva me vacaḥ // Vv_25 //",
          "segment_number": 51
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "naiḥsvābhāvyānāṃ cennaiḥsvābhāvyena vāraṇaṃ yadi hi /",
          "segment_number": 52
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "naiḥsvābhāvyanivṛttau svābhāvyaṃ hi prasiddhaṃ syāt // Vv_26 //",
          "segment_number": 53
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "athavā nirmitakāyāṃ yathā striyāṃ striyamityasaṃgrāham /",
          "segment_number": 54
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nirmitakaḥ pratihanyāt kasyacidevaṃ bhavedetat // Vv_27 //",
          "segment_number": 55
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "athavā sādhyasamo 'yaṃ heturna hi vidyate dhvaneḥ sattā /",
          "segment_number": 56
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "saṃvyavahāraṃ ca vayaṃ nānabhyupagamya kathayāmaḥ // Vv_28 //",
          "segment_number": 57
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yadi kācana pratijñā tatra syādeṣa me bhaveddoṣaḥ /",
          "segment_number": 58
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nāsti ca mama pratijñā tasmānnaivāsti me doṣaḥ // Vv_29 //",
          "segment_number": 59
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yadi kiṃcidupalabheyaṃ pravartayeyaṃ nivartayeyaṃ vā /",
          "segment_number": 60
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pratyakṣādibhirarthaistadabhāvānme 'nupālambhaḥ // Vv_30 //",
          "segment_number": 61
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yadi ca pramāṇatasteṣāṃ teṣāṃ prasiddhirarthānām /",
          "segment_number": 62
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "teṣāṃ punaḥ prasiddhiṃ brūhi kathaṃ te pramāṇānām // Vv_31 //",
          "segment_number": 63
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "anyairyadi pramāṇaiḥ pramāṇasiddhirbhavatyanavasthā /",
          "segment_number": 64
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nādeḥ siddhistatrāsti naiva madhyasya nāntasya // Vv_32 //",
          "segment_number": 65
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "teṣāmatha pramāṇairvinā prasiddhirvihīyate vādaḥ /",
          "segment_number": 66
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vaiṣamikatvaṃ tasmin viśeṣahetuśca vaktavyaḥ // Vv_33 //",
          "segment_number": 67
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "viṣamopanyāso 'yaṃ na hyātmānaṃ prakāśayatyagniḥ /",
          "segment_number": 68
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "na hi tasyānupalabdhirdṛṣṭā tamasīva kumbhasya // Vv_35 //",
          "segment_number": 69
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yadi svātmānamayaṃ tvadvacanena prakāśayatyagniḥ /",
          "segment_number": 70
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "paramiva na tvātmānaṃ paridhakṣyatyapi hutāśaḥ // Vv_36 //",
          "segment_number": 71
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yadi ca svaparātmānau tvadvacanena prakāśayatyagniḥ /",
          "segment_number": 72
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pracchādayiṣyati tamaḥ svaparātmānau hutāśa iva // Vv_37 //",
          "segment_number": 73
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nāsti tamaśca jvalane yatra ca tiṣṭhati sadātmani jvalanaḥ /",
          "segment_number": 74
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kurute kathaṃ prakāśaṃ sa hi prakāśo 'ndhakāravadhaḥ // Vv_38 //",
          "segment_number": 75
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "utpadyamāna eva prakāśayatyagnirityasadvādaḥ /",
          "segment_number": 76
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "utpadyamāna eva prāpnoti tamo na hi hutāśaḥ // Vv_39 //",
          "segment_number": 77
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "aprāpto 'pi jvalano yadi vā punarandhakāramupahanyāt /",
          "segment_number": 78
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sarveṣu lokadhātuṣu tamo 'yamihasaṃsthita upahanyāt // Vv_40 //",
          "segment_number": 79
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yadi ca svataḥpramāṇasiddhiranapekṣya te prameyāṇi /",
          "segment_number": 80
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhavati pramāṇasiddhirna parāpekṣā hi siddhiriti // Vv_41 //",
          "segment_number": 81
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "anapekṣya hi prameyānarthān yadi te pramāṇasiddhiḥ /",
          "segment_number": 82
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhavati na bhavati kasyacidevamimāni pramāṇāni // Vv_42 //",
          "segment_number": 83
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atha matamapekṣya siddhisteṣāmityatra ko doṣaḥ /",
          "segment_number": 84
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "siddhasya sādhanaṃ syānnāsiddho 'pekṣate hyanyat // Vv_43 //",
          "segment_number": 85
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sidhyanti hi prameyāṇyapekṣya yadi sarvathā pramāṇāni /",
          "segment_number": 86
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhavati prameyasiddhiranapekṣyaiva pramāṇāni // Vv_44 //",
          "segment_number": 87
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yadi ca prameyasiddhiranapekṣyaiva bhavati pramāṇāni /",
          "segment_number": 88
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kiṃ te pramāṇasiddhyā tāni yadarthaṃ prasiddhaṃ tat // Vv_45 //",
          "segment_number": 89
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atha tu pramāṇasiddhirbhavatyapekṣyaiva te prameyāṇi /",
          "segment_number": 90
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vyatyaya evaṃ sati te dhruvaṃ pramāṇaprameyāṇām // Vv_46 //",
          "segment_number": 91
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "atha tai pramāṇasiddhyā prameyasiddhiḥ prameyasiddhyā cā",
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bhavati pramāṇasiddhirnāstyubhayasyāpi te siddhiḥ // Vv_47 //",
          "segment_number": 93
        }
      ],
      "segment_number": 92
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sidhyanti hi pramāṇairyadi prameyāṇi tāni taireva /",
          "segment_number": 94
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sādhyāni ca prameyaistāni kathaṃ sādhayiṣyanti // Vv_48 //",
          "segment_number": 95
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sidhyanti ca prameyairyadi pramāṇāni tāni taireva /",
          "segment_number": 96
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sādhyāni ca prameyaistāni kathaṃ sādhayiṣyanti // Vv_49 //",
          "segment_number": 97
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pitrā yadyutpādyaḥ putro yadi tena caiva putreṇa /",
          "segment_number": 98
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "utpādyaḥ sa yadi pitā vada tatrotpādayati kaḥ kam // Vv_50 //",
          "segment_number": 99
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kaśca pitā kaḥ putrastatra tvaṃ brūhi tāvubhāvapi ca /",
          "segment_number": 100
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pitāputralakṣaṇadharau yato naḥ putrasaṃdehaḥ // Vv_51 //",
          "segment_number": 101
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "naiva svataḥprasiddhirna parasparataḥ pramāṇairvā /",
          "segment_number": 102
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhavati na ca prameyairna cāpyakasmāt pramāṇānām // Vv_52 //",
          "segment_number": 103
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kuśalānāṃ dharmāṇāṃ dharmāvasthāvidho brūvate yat /",
          "segment_number": 104
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kuśalasvabhāvamevaṃ pravibhāgenābhidheyaḥ syāt // Vv_53 //",
          "segment_number": 105
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yadi ca pratītya kuśalaḥ svabhāva utpadyate sa kuśalānām /",
          "segment_number": 106
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dharmāṇāṃ parabhāvaḥ svabhāva evaṃ kathaṃ bhavati // Vv_54 //",
          "segment_number": 107
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atha na pratītya kiṃcit svabhāva utpadyate sa kuśalānām /",
          "segment_number": 108
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dharmāṇāmevaṃ syāda vāso na brahmacaryasya // Vv_55 //",
          "segment_number": 109
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nādharmo dharmo vā saṃvyavahārāśca laukikā na syuḥ /",
          "segment_number": 110
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nityāśca sarvabhāvāḥ syurnityatvādahetumataḥ // Vv_56 //",
          "segment_number": 111
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "eṣa cākuśaleḥvavyākṛteḥu nairyāṇādiḥu ca doḥaḥ /",
          "segment_number": 112
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tasmāt sarvaṃ saṃskṛtamasaṃskṛtaṃ te bhavatyevam // Vv_57 //",
          "segment_number": 113
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yaḥ sadbhūtaṃ nāma brūyāt sa svabhāva ityevam /",
          "segment_number": 114
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhavatā prativaktavyo nāma brūmaśca na vyaṃ sat // Vv_58 //",
          "segment_number": 115
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nāmāsaditi ca yadidaṃ tatkiṃ nu sato bhavatyutāsataḥ /",
          "segment_number": 116
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yadi hi sato yadyasato dvidhāpi te hīyate vādaḥ // Vv_59 //",
          "segment_number": 117
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sarveṣāṃ bhāvānāṃ śūnyatvaṃ copapāditaṃ pūrvam /",
          "segment_number": 118
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sa upālambhastasmād bhavatyayaṃ ca pratijñāyāḥ // Vv_60 //",
          "segment_number": 119
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atha vidyate svabhāvaḥ sa ca dharmāṇāṃ na vidyata iti /",
          "segment_number": 120
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "idamāśaṅkitaṃ yaduktaṃ bhavatyanāśaṅkitaṃ tacca // Vv_61 //",
          "segment_number": 121
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sata eva pratiṣedho yadi śūnyatvaṃ nanvapratiṣiddhamidam /",
          "segment_number": 122
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pratiṣedhayate hi bhavān bhāvānāṃ niḥsvabhāvatvam // Vv_62 //",
          "segment_number": 123
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pratiṣedhayase 'tha tvaṃ śūnyatvaṃ tacca nāsti śūnyatvam /",
          "segment_number": 124
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pratiṣedhaḥ sata iti te nanvevaṃ hīyate vādaḥ // Vv_63 //",
          "segment_number": 125
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pratiṣedhayāmi nāhaṃ kiṃcit pratiṣedhyamasti na ca kiṃcit /",
          "segment_number": 126
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tasmāt pratiṣedhayasītyadhilaya eva tvayā kriyate // Vv_64 //",
          "segment_number": 127
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yaccāhaṃ te vacanādasataḥ pratiṣedhavacanasiddhiriti /",
          "segment_number": 128
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "atra jñāpayate vāgasaditi tanna pratinihanti // Vv_65 //",
          "segment_number": 129
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "mṛgatṛṣṇādṛṣṭānte yaḥ punaruktaṃ tvayā mahāṃścaryaḥ /",
          "segment_number": 130
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tatrāpi nirṇayaṃ śṛṇu yathā sa dṛṣṭānta upapannaḥ // Vv_66 //",
          "segment_number": 131
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sa yadi svabhāvataḥ syāt bhāvo na syāt pratītyasamudbhūtaḥ /",
          "segment_number": 132
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yaśca pratītya bhavati grāho nanu śūnyatā saiva // Vv_67 //",
          "segment_number": 133
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yadi ca svabhāvataḥ syād grāhaḥ kastaṃ nivartayed grāhyam /",
          "segment_number": 134
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śeṣeṣvapyeṣa vidhistasmād doṣo 'nupālambhaḥ // Vv_68 //",
          "segment_number": 135
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "etena hetvabhāvaḥ pratyuktaḥ pūrvameva sa samatvāt /",
          "segment_number": 136
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "mṛgatṛṣṇādṛṣṭāntavyāvṛttividhau ya uktaḥ prāk // Vv_69 //",
          "segment_number": 137
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yastraikālye hetuḥ pratyuktaḥ pūrvameva sa samatvāt /",
          "segment_number": 138
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "traikālyapratihetuśca śūnyatāvādināṃ prāptaḥ // Vv_70 //",
          "segment_number": 139
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "prabhavati ca śūnyateyaṃ yasya prabhavanti tasya sarvārthāḥ /",
          "segment_number": 140
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "prabhavati na tasya kiṃ na bhavati śūnyatā yasyeti // Vv_71 //",
          "segment_number": 141
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yaḥ śūnyatāṃ pratītyasamutpādaṃ madhyamāṃ pratipadamanekārthām /",
          "segment_number": 142
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nijagāda praṇamāmi tamapratimasaṃbuddham // Vv_72 //",
          "segment_number": 143
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "iti //",
      "segment_number": 144
    }
  ]
}