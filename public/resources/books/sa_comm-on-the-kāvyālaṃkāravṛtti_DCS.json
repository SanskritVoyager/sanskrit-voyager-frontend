{
 "file_title": "comm-on-the-kāvyālaṃkāravṛtti_DCS",
 "file_title_normal": "comm-on-the-kavyalamkaravrtti_DCS",
 "metadata": {
  "original_title": "Comm. on the Kāvyālaṃkāravṛtti",
  "publisher": "Digital Corpus of Sanskrit (DCS)",
  "license": {
