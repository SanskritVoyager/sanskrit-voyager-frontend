        {
          "tag": "l",
          "attributes": {},
          "text": "aṣṭau prakṛtayaḥ || Tats_1 ||",
          "segment_number": 1,
          "translated_text": "Eight are the <s>prakṛtis</s> (primary principles). || Tats_1 ||"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ṣoḍaśa vikārāḥ || Tats_2 ||",
          "segment_number": 2,
          "translated_text": "Sixteen are the <s>vikāras</s> (modifications). || Tats_2 ||"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "puruṣaḥ || Tats_3 ||",
          "segment_number": 3,
          "translated_text": "<s>Puruṣa</s> (the conscious self). || Tats_3 ||"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "traiguṇyam || Tats_4 ||",
          "segment_number": 4,
          "translated_text": "The threefold nature of the <s>guṇas</s> (<s>traiguṇya</s>). || Tats_4 ||"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "saṃcaraḥ || Tats_5 ||",
          "segment_number": 5,
          "translated_text": "Evolution (<s>saṃcara</s>). || Tats_5 ||"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pratisaṃcaraḥ || Tats_6 ||",
          "segment_number": 6,
          "translated_text": "Dissolution (<s>pratisaṃcara</s>). || Tats_6 ||"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "adhyātmam adhibhūtam adhidaivataṃ ca || Tats_7 ||",
          "segment_number": 7,
          "translated_text": "The subjective (<s>adhyātma</s>), the objective (<s>adhibhūta</s>), and the divine (<s>adhidaivata</s>). || Tats_7 ||"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pañcābhibuddhayaḥ || Tats_8 ||",
          "segment_number": 8,
          "translated_text": "Five are the <s>abhibuddhis</s> (intellectual dispositions). || Tats_8 ||"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pañca karmayonayaḥ || Tats_9 ||",
          "segment_number": 9,
          "translated_text": "Five are the <s>karmayonis</s> (sources of action). || Tats_9 ||"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pañca vāyavaḥ || Tats_10 ||",
          "segment_number": 10,
          "translated_text": "Five are the <s>vāyus</s> (vital breaths). || Tats_10 ||"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pañca karmātmānaḥ || Tats_11 ||",
          "segment_number": 11,
          "translated_text": "Five are the <s>karmātmans</s> (organs of action). || Tats_11 ||"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pañcaparvāvidyā || Tats_12 ||",
          "segment_number": 12,
          "translated_text": "<s>Avidyā</s> (ignorance) has five divisions (<s>pañcaparva</s>). || Tats_12 ||"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "aṣṭāviṃśatidhāśaktiḥ || Tats_13 ||",
          "segment_number": 13,
          "translated_text": "<s>Aśakti</s> (incapacity) is of twenty-eight kinds. || Tats_13 ||"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "navadhā tuṣṭiḥ || Tats_14 ||",
          "segment_number": 14,
          "translated_text": "<s>Tuṣṭi</s> (contentment) is ninefold. || Tats_14 ||"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "aṣṭadhā siddhiḥ || Tats_15 ||",
          "segment_number": 15,
          "translated_text": "<s>Siddhi</s> (attainment) is eightfold. || Tats_15 ||"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "daśa mūlikārthāḥ || Tats_16 ||",
          "segment_number": 16,
          "translated_text": "Ten are the fundamental topics (<s>mūlikārthas</s>). || Tats_16 ||"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "anugrahasargaḥ || Tats_17 ||",
          "segment_number": 17,
          "translated_text": "The creation for the benefit [of <s>puruṣa</s>] (<s>anugrahasarga</s>). || Tats_17 ||"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "caturdaśavidho bhūtasargaḥ || Tats_18 ||",
          "segment_number": 18,
          "translated_text": "The elemental creation (<s>bhūtasarga</s>) is of fourteen kinds. || Tats_18 ||"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "trividho bandhaḥ || Tats_19 ||",
          "segment_number": 19,
          "translated_text": "Bondage (<s>bandha</s>) is threefold. || Tats_19 ||"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "trividho mokṣaḥ || Tats_20 ||",
          "segment_number": 20,
          "translated_text": "Liberation (<s>mokṣa</s>) is threefold. || Tats_20 ||"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "trividhaṃ pramāṇam || Tats_21 ||",
          "segment_number": 21,
          "translated_text": "The means of valid knowledge (<s>pramāṇa</s>) is threefold. || Tats_21 ||"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "trividhaṃ duḥkham || Tats_22 ||",
          "segment_number": 22,
          "translated_text": "Suffering (<s>duḥkha</s>) is threefold. || Tats_22 ||"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "etat paramparayā yāthātathyam || Tats_23 ||",
          "segment_number": 23,
          "translated_text": "This is the true state of affairs according to tradition (<s>paramparā</s>). || Tats_23 ||"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "etat sarvaṃ jñātvā kṛtakṛtyaḥ syāt || Tats_24 ||",
          "segment_number": 24,
          "translated_text": "Having known all this, one becomes fulfilled (<s>kṛtakṛtya</s>). || Tats_24 ||"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "na punastrividhena duḥkhenābhibhūyate || Tats_25 ||",
          "segment_number": 25,
          "translated_text": "One is no longer overcome by the threefold suffering. || Tats_25 ||"
        }
      ]
    },
