{
 "file_title": "paramānandīyanāmamālā_DCS",
 "file_title_normal": "paramanandiyanamamala_DCS",
 "metadata": {
  "original_title": "Paramānandīyanāmamālā",
  "publisher": "Digital Corpus of Sanskrit (DCS)",
