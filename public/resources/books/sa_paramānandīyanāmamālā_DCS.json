 },
 "body": [
  {
   "tag": "div",
   "attributes": {},
   "children": [
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1",
      "label": "DCS 1"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "praṇaumi parayā bhaktyā prakṛṣṭavibhutāṃ vibhum",
       "translated_text": "With supreme devotion I bow to the all-pervading Lord of surpassing majesty,",
       "segment_number": 329090
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "nāśotpādasthitipraṣṭaṃ parabrahma nirañjanam ||",
       "translated_text": "the stainless <s>Parabrahman</s>, who presides over dissolution, creation, and continuance.",
       "segment_number": 329091
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_2",
      "label": "DCS 2"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "madīyamānasāmbhojarājahaṃsasamaprabham",
       "translated_text": "His radiance resembles that of a royal swan upon the lotus of my mind,",
       "segment_number": 329092
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "sadā pramodapīyūṣasindhukelikalākulam ||",
       "translated_text": "and he is forever absorbed in playful arts upon the ocean of the nectar of joy.",
       "segment_number": 329093
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3",
      "label": "DCS 3"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "agniśchāgaratho vahniḥ kṛśānuḥ pāvakaḥ śikhī",
       "translated_text": "<s>Agni</s>, <s>Chāgaratha</s>, <s>Vahni</s>, <s>Kṛśānu</s>, <s>Pāvaka</s>, and <s>Śikhin</s> are names for fire;",
       "segment_number": 329094
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "citrabhānuśca damunā dhanaṃjayahutāśanau ||",
       "translated_text": "so too are <s>Citrabhānu</s>, <s>Damunas</s>, <s>Dhanañjaya</s>, and <s>Hutāśana</s>.",
       "segment_number": 329095
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_4",
      "label": "DCS 4"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "dhūmadhvajo bṛhadbhānur jvālājihvas tanūnapāt",
       "translated_text": "Other names are <s>Dhūmadhvaja</s>, <s>Bṛhadbhānu</s>, <s>Jvālājihva</s>, and <s>Tanūnapāt</s>;",
       "segment_number": 329096
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "vaiśvānaraḥ saptamantro jātavedāstarīrapi ||",
       "translated_text": "also <s>Vaiśvānara</s>, <s>Saptamantra</s>, <s>Jātavedas</s>, and <s>Tarī</s>.",
       "segment_number": 329097
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_5",
      "label": "DCS 5"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "jvalano jāgṛvirbarhiḥ kṛṣṇavartmānalau śuciḥ",
       "translated_text": "They include <s>Jvalana</s>, <s>Jāgṛvi</s>, <s>Barhis</s>, <s>Kṛṣṇavartman</s>, <s>Anala</s>, and <s>Śuci</s>;",
       "segment_number": 329098
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "śuṣmadasmau tathā vītihotrānilasakhau vasuḥ ||",
       "translated_text": "likewise <s>Śuṣma</s>, <s>Dasma</s>, <s>Vītihotra</s>, <s>Anilasakha</s>, and <s>Vasu</s>.",
       "segment_number": 329099
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_6",
      "label": "DCS 6"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "śukro vibhāvasuḥ keśaś citrabhānur uṣarbudhaḥ",
       "translated_text": "They also include <s>Śukra</s>, <s>Vibhāvasu</s>, <s>Keśa</s>, <s>Citrabhānu</s>, and <s>Uṣarbudha</s>;",
       "segment_number": 329100
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "vṛṣākapiḥ śamīgarbho rohitāśvo virocanaḥ ||",
       "translated_text": "<s>Vṛṣākapi</s>, <s>Śamīgarbha</s>, <s>Rohitāśva</s>, and <s>Virocana</s>.",
       "segment_number": 329101
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_7",
      "label": "DCS 7"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "arciṣmānāśrayāśo'pi viśvapsā bahulo hariḥ",
       "translated_text": "Further names are <s>Arciṣmant</s>, <s>Āśrayāśa</s>, <s>Viśvapsā</s>, <s>Bahula</s>, and <s>Hari</s>;",
       "segment_number": 329102
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "tithaḥ kṛpīṭayoniśca tuttho havyavahaḥ smṛtaḥ ||",
       "translated_text": "<s>Titha</s>, <s>Kṛpīṭayoni</s>, <s>Tuttha</s>, and <s>Havyavaha</s> are also remembered.",
       "segment_number": 329103
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_8",
      "label": "DCS 8"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "saptodarcir appittaṃ ca havyavāhāśuśukṣaṇī",
       "translated_text": "The terms <s>Saptodarcis</s>, <s>Appitta</s>, <s>Havyavāha</s>, and <s>Āśuśukṣaṇi</s> are also used;",
       "segment_number": 329104
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "pacano hiraṇyaretā barhirjyotis tamoharaḥ ||",
       "translated_text": "as are <s>Pacana</s>, <s>Hiraṇyaretas</s>, <s>Barhirjyotis</s>, and <s>Tamohara</s>.",
       "segment_number": 329105
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_9",
      "label": "DCS 9"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "agnipriyā smṛtāgnāyī svāhāpi kathitā smṛtau",
       "translated_text": "The beloved wife of <s>Agni</s> is remembered as <s>Agnāyī</s>; in traditional teaching she is also called <s>Svāhā</s>.",
       "segment_number": 329106
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "saṃvartakaḥ samudrāgnir vaḍavāmukhabāḍavau ||",
       "translated_text": "<s>Saṃvartaka</s> is the fire of cosmic dissolution; the submarine fire is called <s>Samudrāgni</s>, <s>Vaḍavāmukha</s>, or <s>Bāḍava</s>.",
       "segment_number": 329107
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_10",
      "label": "DCS 10"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "vaḍavānala aurvo'pi davadāvavanāgnayaḥ",
       "translated_text": "<s>Vaḍavānala</s> and <s>Aurva</s> also denote it, while a forest fire is called <s>Dava</s>, <s>Dāva</s>, or <s>Vanāgni</s>.",
       "segment_number": 329108
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "iraṃmado meghavahniḥ karīṣānalachāgaṇau ||",
       "translated_text": "<s>Iraṃmada</s> is the fire in a cloud; <s>Karīṣānala</s> and <s>Chāgaṇa</s> denote a fire of dried dung.",
       "segment_number": 329109
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_11",
      "label": "DCS 11"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "tuṣavahnau kukūlaḥ syāt tulyau saṃtāpasaṃjvarau",
       "translated_text": "A fire of chaff is called <s>Kukūla</s>; <s>Saṃtāpa</s> and <s>Saṃjvara</s> are equivalent terms for burning heat.",
       "segment_number": 329110
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "bāṣpe ūṣmāpyatho vahnijihvā kīlā śikhārciṣaḥ ||",
       "translated_text": "<s>Bāṣpa</s> and <s>Ūṣman</s> denote vapor; a tongue of fire is called <s>Kīlā</s>, <s>Śikhā</s>, or <s>Arcis</s>.",
       "segment_number": 329111
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_12",
      "label": "DCS 12"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "jvālā hetiḥ śikhā vṛddhā jhalakkā parikīrtitā",
       "translated_text": "A high flame is designated by <s>Jvālā</s>, <s>Heti</s>, <s>Śikhā</s>, <s>Vṛddhā</s>, and <s>Jhalakkā</s>.",
       "segment_number": 329112
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "sphuliṅgolkālātavahnikaṇā jvālolmuke api ||",
       "translated_text": "<s>Sphuliṅga</s>, <s>Ulkā</s>, <s>Alāta</s>, <s>Vahnikaṇa</s>, <s>Jvālā</s>, and <s>Ulmuka</s> are terms for sparks and glowing firebrands.",
       "segment_number": 329113
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_13",
      "label": "DCS 13"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "dhūmo 'mbhaḥsūvāyuvāhau karamālo'gniketanam",
       "translated_text": "<s>Dhūma</s>, <s>Ambhaḥsū</s>, <s>Vāyuvāha</s>, <s>Karamāla</s>, and <s>Agniketana</s> are names for smoke;",
       "segment_number": 329114
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "agnivāhastarīḥ proktastathā jīmūtavāhyapi ||",
       "translated_text": "it is also called <s>Agnivāha</s>, <s>Tarī</s>, and <s>Jīmūtavāhin</s>.",
       "segment_number": 329115
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_14",
      "label": "DCS 14"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "śrīmadgaḍhamalāṅgodbhūs tejovargamarūpayat",
       "translated_text": "The illustrious offspring of <s>Gaḍhamala</s>'s line thus set forth the class of terms for fire.",
       "segment_number": 329116
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "vāyuḥ samīraṇo vāto mātariśvā prabhañjanaḥ ||",
       "translated_text": "<s>Vāyu</s>, <s>Samīraṇa</s>, <s>Vāta</s>, <s>Mātariśvan</s>, and <s>Prabhañjana</s> are names for wind;",
       "segment_number": 329117
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_15",
      "label": "DCS 15"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "samīraḥ pavano nityagatiḥ kampākamārutau",
       "translated_text": "so too are <s>Samīra</s>, <s>Pavana</s>, <s>Nityagati</s>, <s>Kampāka</s>, and <s>Māruta</s>.",
       "segment_number": 329118
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "pṛṣadaśvo jagatprāṇo nabhasvānanilo marut ||",
       "translated_text": "Other names are <s>Pṛṣadaśva</s>, <s>Jagatprāṇa</s>, <s>Nabhasvant</s>, <s>Anila</s>, and <s>Marut</s>;",
       "segment_number": 329119
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_16",
      "label": "DCS 16"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "prakampanāśugau gandhavahaḥ samira ityapi",
       "translated_text": "also <s>Prakampana</s>, <s>Āśuga</s>, <s>Gandhavaha</s>, and <s>Samira</s>.",
       "segment_number": 329120
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "nabhaḥśvāso'hikānto'pi daityadevo mahābalaḥ ||",
       "translated_text": "They further include <s>Nabhaḥśvāsa</s>, <s>Ahikānta</s>, <s>Daityadeva</s>, and <s>Mahābala</s>;",
       "segment_number": 329121
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_17",
      "label": "DCS 17"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "sparśanaśca hariḥ proktaḥ pavamānasadāgatī",
       "translated_text": "and wind is called <s>Sparśana</s>, <s>Hari</s>, <s>Pavamāna</s>, and <s>Sadāgati</s>.",
       "segment_number": 329122
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "sa jhañjhā vṛṣṭiyuk proktaḥ vyānas tvaṅmātrasaṃsthitaḥ ||",
       "translated_text": "When accompanied by rain it is called <s>Jhañjhā</s>. <s>Vyāna</s> is present throughout the skin.",
       "segment_number": 329123
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_18",
      "label": "DCS 18"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "apānaḥ pṛṣṭhapārṣṇistha udāno hṛcchiro'ntare",
       "translated_text": "<s>Apāna</s> is situated in the back and heels, while <s>Udāna</s> lies between the heart and the head.",
       "segment_number": 329124
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "prāṇo hṛnnābhinakrasthaḥ samāno nābhihṛdgataḥ ||",
       "translated_text": "<s>Prāṇa</s> is situated at the heart, navel, and the place termed <s>nakra</s>; <s>Samāna</s> extends from the navel to the heart.",
       "segment_number": 329125
      }
     ]
    }
   ]
  }
 ]
}
