          "tag": "hi",
          "attributes": {
            "rend": "it"
          },
          "text": "rārtha",
          "segment_number": 44
        },
        {
          "tag": "text",
          "text": "ñ cobhayārthaṃ ca yāvad e",
          "segment_number": 45
        },
        {
          "tag": "hi",
          "attributes": {
            "rend": "it"
          },
          "text": "vaṃ vo",
          "segment_number": 46
        },
        {
          "tag": "text",
          "text": "bhikṣavaḥ śikṣitavyam //",
          "segment_number": 47
        }
      ],
      "segment_number": 43
    },
