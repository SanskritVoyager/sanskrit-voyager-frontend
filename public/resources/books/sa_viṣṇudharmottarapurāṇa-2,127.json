    "publication_date": "2020-07-31",
    "source": "Bombay 1912, adapted as \"āgneya-viṣṇudharmottarapurāṇādibhya āhṛtya pratisaṃskritam [dūrgāmohanabhaṭṭācāryeṇa]\" in D. Bhattacharyya, \"Lights on the Paippalāda Recension of the Atharvaveda\". In: Our Heritage, Vol. III, part I, 1955. pp. 1-14."
  },
  "body": [
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "puṣkara uvāca-",
          "segment_number": 1
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śāntātītaṃ gaṇaṃ hutvā śāntim āpnoti mānavaḥ /",
          "segment_number": 2
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhaiṣajyaṃ ca gaṇaṃ hutvā sarvān rogān vyapohati // Vdho_2,127.1 //",
          "segment_number": 3
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "triṣaptīyaṃ gaṇaṃ hutvā sarvapāpaiḥ pramucyate /",
          "segment_number": 4
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kvacin nāapnoti ca bhayaṃ hutvā caivābhayaṃ gaṇam // Vdho_2,127.2 //",
          "segment_number": 5
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "na parājāyate rāma gaṇaṃ hutvāparājitam /",
          "segment_number": 6
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "āyuṣyaṃ ca gaṇam hutvā cāpamṛtyūṃ vyapohati // Vdho_2,127.3 //",
          "segment_number": 7
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "svastim āpnoti sarvatra hutvā svastyayanaṃ gaṇaṃ /",
          "segment_number": 8
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śreyasā yogam āpnoti śarmavarmagaṇaṃ tathā // Vdho_2,127.4 //",
          "segment_number": 9
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vāstoṣpatyagaṇaṃ hutvā vāstudoṣān vyapohati /",
          "segment_number": 10
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tathā raudragaṇaṃ hutvā sarvān doṣān vyapohati //",
          "segment_number": 11
        }
      ]
    },
    {
      "tag": "l",
      "attributes": {},
      "text": "etair daśagaṇair homo hy aṣṭādaśasu śāntiṣu // Vdho_2,127.5 //",
      "segment_number": 12
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vaiṣṇavī śāntir aindrī ca brāhmī raudrī tathaiva ca /",
          "segment_number": 13
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vāyavyā vāruṇī caiva kauberī bhārgavī tathā // Vdho_2,127.6 //",
          "segment_number": 14
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "prājāpatyā tathā tvāṣṭrī kaumārī vahnidevatā /",
          "segment_number": 15
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "mārudgaṇā ca gāndharvī śāntair nairṛtakī tathā // Vdho_2,127.7 //",
          "segment_number": 16
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "śāntir āṅgirasī yāmyā pārthivī ca bhṛgūttama /",
      "segment_number": 17
    },
    {
      "tag": "l",
      "attributes": {},
      "text": "etās tu śāntayaḥ proktāḥ sarvakarmahitāḥ sadā // Vdho_2,127.8 //",
      "segment_number": 18
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "yas tvā mṛtyur iti hy etaj japtaṃ mṛtyuvināśanaṃ /",
      "segment_number": 19
    },
    {
      "tag": "l",
      "attributes": {},
      "text": "hutvā ca mātṛnāmāni kāmān evam avāpnuyāt // Vdho_2,127.9 //",
      "segment_number": 20
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "suparṇas tveti hutvā ca bhujagair naiva bādhyate /",
          "segment_number": 21
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "[Bhattacharyya edits bhujagainava bādhyate, which can be just a typo!]",
          "segment_number": 22
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yasyedaṃ bhūmyām iti ca bhūmikāmo japet sadā // Vdho_2,127.10 //",
          "segment_number": 23
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pṛthivyām uttamo 'sīti hutaṃ śraiṣṭhyapradaṃ sadā /",
          "segment_number": 24
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "audumbaraṃ yo na iti tathā vīryavivardhanam // Vdho_2,127.11 //",
          "segment_number": 25
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "indreṇa dattam ity etat sarvabādhāvināśanam /",
          "segment_number": 26
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "hiraṇyavarṇā iti ca snānaṃ pāpaharaṃ bhavet // Vdho_2,127.12 //",
          "segment_number": 27
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "asitasyeti sarvāṇi viṣaghnāni bhṛgūttama /",
          "segment_number": 28
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sarasvatīti mantrāṃś ca viṣaghnān nirviśed budhaḥ // Vdho_2,127.13 //",
          "segment_number": 29
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "śarabhādīni sarvāṇi piśācakṣapaṇāni ca /",
      "segment_number": 30
    },
    {
      "tag": "l",
      "attributes": {},
      "text": "imā devīti mantraś ca sarvaśāntikaraḥ paraḥ // Vdho_2,127.14 //",
      "segment_number": 31
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "devā maruta ity etat sarvakāmakaraṃ bhavet /",
          "segment_number": 32
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yamasya lokād ity etad duḥsvapnaśamanaṃ paraṃ // Vdho_2,127.15 //",
          "segment_number": 33
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "agner va iti cāpy etat kathitaṃ manyunāśanam /",
          "segment_number": 34
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ūrdhvo bhavati vijñeyaḥ kṛtvā sthānakaraḥ paraḥ // Vdho_2,127.16 //",
          "segment_number": 35
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "indraṃ vayaṃ vaṇijam iti paṇyalābhakaraṃ param /",
          "segment_number": 36
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "[Bhattacharyya: baṇijaṃ]",
          "segment_number": 37
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kāmo me rājña ity etat strīṇāṃ saubhāgyavardhanam // Vdho_2,127.17 //",
          "segment_number": 38
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bhadrāya karṇam ity etat karṇaprasyandane japet /",
          "segment_number": 39
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhadrāsy akṣirodhe jātā karṇaprasyandane tathā // Vdho_2,127.18 //",
          "segment_number": 40
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tubyam eva jarimann āyuṣyaṃ tu hutaṃ bhavet /",
          "segment_number": 41
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "āyātu mitra ity etan mitralabdhikaraṃ hutam // Vdho_2,127.19 //",
          "segment_number": 42
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "āśāsānam idaṃ janā miśradhānyena homayet /",
          "segment_number": 43
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ādhipatyam avāpnoti sarvatra manujottama // Vdho_2,127.20 //",
          "segment_number": 44
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "agne gobhir na ity etad gavāṃ vṛddhikaraṃ param /",
          "segment_number": 45
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dvādaśāhaṃ tu juhuyāt parākeṇa viśeṣataḥ // Vdho_2,127.21 //",
          "segment_number": 46
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "śānto agnir itīty etad grāmasvāsthyakaraṃ bhavet /",
          "segment_number": 47
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tasmād grāmān mṛdā kṛtvā vedisāmyaṃ samaśnute // Vdho_2,127.22 //",
          "segment_number": 48
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vidmāsya sarvā cittāni rāṣṭrasvīkaraṇāni tu /",
          "segment_number": 49
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tribhyo rudrebhya ity etad vāstoṣpatam udāhṛtam // Vdho_2,127.23 //",
          "segment_number": 50
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "dhruvaṃ dhruveṇeti hutaṃ sthānalābhakaraṃ bhavet /",
          "segment_number": 51
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "acyutā dyaus tathā rāma kathitaṃ sthānalābhadam // Vdho_2,127.24 //",
          "segment_number": 52
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "payo deveṣv iti hutaṃ rāyaspoṣakaraṃ param /",
          "segment_number": 53
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yunakrasīreti śunā kṛṣilābhakaraṃ bhavet // Vdho_2,127.25 //",
          "segment_number": 54
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ayaṃ te yonir ity etat putralābhakaraṃ bhavet /",
          "segment_number": 55
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śunaṃ vatsān tathā hy etad gavāṃ vṛddhikaraṃ hutam // Vdho_2,127.26 //",
          "segment_number": 56
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "... meti kathitaṃ sarvatśraiṣṭhyakārakam /",
      "segment_number": 57
    },
    {
      "tag": "l",
      "attributes": {},
      "text": "ahaṃ te bhaga ity etad bhavet saubhāgyavardhanaṃ // Vdho_2,127.27 //",
      "segment_number": 58
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ye te pāśās tathāpy etad bandhanān mokṣakārakam /",
          "segment_number": 59
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yo na sva iti cāpy etac chatrunāśakaraṃ param // Vdho_2,127.28 //",
          "segment_number": 60
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sapatnahanam iti tathā nātra kāryā vicāraṇā /",
          "segment_number": 61
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tvam uttamam itīty etad yaśaso vardhanaṃ param // Vdho_2,127.29 //",
          "segment_number": 62
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yathā mṛgo gopayasi strīṇāṃ saubhāgyavardhanam /",
          "segment_number": 63
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ā no agna ity etac ca kathitaṃ patilābhadam // Vdho_2,127.30 //",
          "segment_number": 64
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yena vehad iṣaṃ caiva garbhalābhakaraṃ bhavet /",
          "segment_number": 65
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "imaṃ tapasvinn iti tathā bhavet saubhāgyavardhanam // Vdho_2,127.31 //",
          "segment_number": 66
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yat pṛthivyā anāvṛttaṃ hutam etad yathāvidhi /",
          "segment_number": 67
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "[Bhattacharyya typo: pṛvivyā]",
          "segment_number": 68
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kṛtvā tu śaṃsanaṃ jñeyaṃ nātra kāryā vicāraṇā // Vdho_2,127.32 //",
          "segment_number": 69
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "...... /",
          "segment_number": 70
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śivaḥ śivābhir ity etad bhavec chreyas^karaṃ param // Vdho_2,127.33 //",
          "segment_number": 71
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kṛtyādūṣaṇa ity etat kṛtyādūṣaṇam ucyate /",
          "segment_number": 72
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bṛhaspatiḥ paripātu pathi svastyayanaṃ bhavet // Vdho_2,127.34 //",
          "segment_number": 73
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "mano nv edam abhayadaṃ pathi svastyayanaṃ bhavet /",
          "segment_number": 74
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ayaṃ no agnir adhyakṣo bhaved agniprasādataḥ // Vdho_2,127.35 //",
          "segment_number": 75
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "saṃvatsaraṃ tu śirasā dhārayed yo hutāśanam //",
      "segment_number": 76
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "[Bhattacharyya: hūtāśanam]\nmantram etaj japen nityam āgneyāśāmukhaḥ sthitaḥ //",
      "segment_number": 77
    },
    {
      "tag": "l",
      "attributes": {},
      "text": "anagnijvalanaṃ kuryād rāma saṃvatsare gate // Vdho_2,127.36 //",
      "segment_number": 78
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "dūṣyā dūṣītty etaj japen mantram anuttamam /",
          "segment_number": 79
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kuryāt pratisarābandhaṃ sarvadoṣanibarhaṇam // Vdho_2,127.37 //",
          "segment_number": 80
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "prāṇasūktañ ca kathitaṃ tathā prāṇavivardhanam /",
          "segment_number": 81
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "muñcāmi tveti kathitam apamṛtyuvimokṣaṇam // Vdho_2,127.38 //",
          "segment_number": 82
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atharvaśiraso 'dhyetā sarvapāpaiḥ pramucyate /",
          "segment_number": 83
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "paramaṃ pāvanaṃ tad dhi sarvakalmaṣanāśanam // Vdho_2,127.39 //",
          "segment_number": 84
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "evam ete śubhā mantrāḥ prativedaṃ mayā tava /",
          "segment_number": 85
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "samāsāt kathitā rāma samuddhṛtya pradhānataḥ // Vdho_2,127.40 //",
          "segment_number": 86
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ekaikasya ca mantrasya viniyogāḥ sahasraśaḥ /",
          "segment_number": 87
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "[Bhattacharyya: viniyogaḥ]",
          "segment_number": 88
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kathitā bhṛguśārdūla purāṇaiḥ sumahātmabhiḥ // Vdho_2,127.41 //",
          "segment_number": 89
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "na te śakyā mahābhāga vaktuṃ varṣaśatair api /",
          "segment_number": 90
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "prādhānyena tu mantrāṇāṃ kiñcit karma taveritam // Vdho_2,127.42 //",
          "segment_number": 91
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "home yatra na nirdiṣṭaṃ mayā dravyaṃ purā tava /",
          "segment_number": 92
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "havīṃṣi tatra vakṣyāmi tāni me gadataḥ śṛṇu // Vdho_2,127.43 //",
          "segment_number": 93
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vṛkṣāṇāṃ yajñiyānān tu samidhaḥ prathamaṃ haviḥ /",
          "segment_number": 94
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ājyañ ca vrīhayaś caiva tathā vai gaurasarṣapāḥ // Vdho_2,127.44 //",
          "segment_number": 95
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "akṣatāni tilāś caiva dadhi kṣīrañ ca bhārgava /",
      "segment_number": 96
    },
    {
      "tag": "l",
      "attributes": {},
      "text": "darbhās tathaiva dūrvāś ca bilvāni kamalāni ca // Vdho_2,127.45 //",
      "segment_number": 97
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "śāntipuṣṭikarāṇy āhur dravyāṇy etāni bhārgava /",
          "segment_number": 98
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tailendhanāni dharmajña rājikāṃ rudhiraṃ viṣam /",
          "segment_number": 99
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "samidhaḥ kaṇṭakopetā abhicāreṣu yojayet // Vdho_2,127.46 //",
          "segment_number": 100
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ārṣaṃ vai daivataṃ chandas tv avijñāya bhṛgūttama /",
          "segment_number": 101
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "mantrasya tena mantreṇa japyahomau na kārayet // Vdho_2,127.47 //",
          "segment_number": 102
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "chandasi brāhmaṇe sūkte yad avyaktaṃ pradṛśyate /",
          "segment_number": 103
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vidvadbhiḥ saha niścitya tad yajñam avatārayet // Vdho_2,127.48 //",
          "segment_number": 104
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sambhārā ye yathā yatra yāni dravyāṇi yo vidhiḥ /",
          "segment_number": 105
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śākhāṃ prati tathā tatra tat pramāṇam iti sthitiḥ // Vdho_2,127.49 //",
          "segment_number": 106
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yaḥ svasūtram atikramya parasūtreṇa vartate /",
          "segment_number": 107
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "apramāṇam ṛṣiṃ kṛtvā so 'py adharmeṇa yujyate // Vdho_2,127.50 //",
          "segment_number": 108
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tasmāt sarvaprayatnena svasūtraṃ na vilaṅghayet /",
          "segment_number": 109
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "prāktantrottaratantre dve svaśākhāpratyaye dvija /",
          "segment_number": 110
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sarvakarmasu kartavye madhye karma vidhīyate // Vdho_2,127.51 //",
          "segment_number": 111
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ātharvaṇo 'yaṃ kathito vidhis te saṃkṣepato bhārgavāṃśamukhya /",
          "segment_number": 112
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ataḥ paraṃ kiṃ kathayāmi tubhyaṃ tan me vadasvāyatalohitākṣa // Vdho_2,127.52 //",
          "segment_number": 113
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "// iti śriviṣṇudharmottare dvitīyakhaṇḍe mārkaṇḍeyavajrasaṃvāde rāmaṃ prati puṣkaropākhyāne 'tharvavidhikathanaṃ nāma saptaviṃśatyuttaraśatatamo 'dhyāyaḥ //",
      "segment_number": 114
    }
  ]
}