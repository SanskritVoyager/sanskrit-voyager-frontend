     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "pure nagare ||",
       "translated_text": "In a town, in a city.",
       "segment_number": 329126
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_2",
      "label": "DCS 2"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "dharmye dharmādanapete ||",
       "translated_text": "In one that is righteous, not separated from <s>dharma</s> (normative order).",
       "segment_number": 329127
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3",
      "label": "DCS 3"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "prāpyopakaraṇe labhyauṣadhādike ||",
       "translated_text": "In one where implements are obtainable, such as available medicines and the like.",
       "segment_number": 329128
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_4",
      "label": "DCS 4"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "aiśānyāṃ diśi ||",
       "translated_text": "In the northeastern direction.",
       "segment_number": 329129
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_5",
      "label": "DCS 5"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "trigarbhāṃ tribhittim ||",
       "translated_text": "Having three inner chambers and three walls.",
       "segment_number": 329130
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_6",
      "label": "DCS 6"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "sūkṣmalocanāṃ sūkṣmachidrām ||",
       "translated_text": "Having small windows, that is, small openings.",
       "segment_number": 329131
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_7",
      "label": "DCS 7"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "kuṭīṃ gṛham ||",
       "translated_text": "A <s>kuṭī</s> (hut), a house.",
       "segment_number": 329132
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_8",
      "label": "DCS 8"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "sajjavaidyāṃ sajjopakaraṇāṃ ca ||",
       "translated_text": "Provided with a prepared physician and also with prepared equipment.",
       "segment_number": 329133
      }
     ]
    }
   ]
  }
 ]
