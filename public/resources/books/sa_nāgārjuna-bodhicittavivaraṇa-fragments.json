  "body": [
    {
      "tag": "p",
      "attributes": {},
      "text": "...",
      "segment_number": 1
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "phenapiṇḍopamaṃ rūpaṃ vedanā budbudopamā |",
          "segment_number": 2
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "marīcisadṛśī saṃjñā saṃskārāḥ kadalīnibhāḥ || NagBhc_12",
          "segment_number": 3
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "māyopamaṃ ca vijñānaṃ ... NagBhc_13",
      "segment_number": 4
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "...",
      "segment_number": 5
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "parivrāṭkāmukaśunām ekasyāṃ pramadātanau |",
          "segment_number": 6
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kuṇapaḥ kāminī bhakṣya iti tisro vikalpanāḥ || NagBhc_20",
          "segment_number": 7
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "...",
      "segment_number": 8
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ātmagrahanivṛttyarthaṃ skandhadhātvādideśenā |",
          "segment_number": 9
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sāpi dhvastā mahābhāgaiś cittamātravyavasthayā || NagBhc_25",
          "segment_number": 10
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "...",
      "segment_number": 11
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "cittamātram idaṃ sarvam iti yā deśanā muneḥ |",
          "segment_number": 12
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "uttrāsaparihārārthaṃ bālānāṃ sā na 'tattvataḥ || NagBhc_27",
          "segment_number": 13
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "...",
      "segment_number": 14
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "na bodhyabodhakākāraṃ cittaṃ dṛṣṭaṃ tathāgataiḥ |",
          "segment_number": 15
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yatra boddhā ca bodhyaṃ ca tatra bodhir na vidyate || NagBhc_45",
          "segment_number": 16
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "alakṣaṇam anutpādam asaṃsthitam avāṅmayam |",
          "segment_number": 17
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ākāśaṃ bodhicittaṃ ca bodhir advayalakṣaṇā || NagBhc_46",
          "segment_number": 18
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "...",
      "segment_number": 19
    },
    {
      "tag": "l",
      "attributes": {},
      "text": "śūnyatāsiṃhanādena trasitāḥ sarvavādinaḥ | NagBhc_52",
      "segment_number": 20
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "...",
      "segment_number": 21
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "guḍe madhuratā cāgner uṣṇatvaṃ prakṛtir yathā |",
          "segment_number": 22
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śūnyatā sarvadharmāṇāṃ tathā prakṛtir iṣyate || NagBhc_57",
          "segment_number": 23
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "...",
      "segment_number": 24
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "deśanā lokanāthānāṃ sattvāśayavaśānugāḥ |",
          "segment_number": 25
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhidyante bahudhā loka upāyair bahubhiḥ punaḥ || NagBhc_98",
          "segment_number": 26
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "gambhīrottānabhedena kva cid vobhayalakṣaṇā |",
          "segment_number": 27
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "binnāpi deśanābhinnā śūnyatādvayalakṣanā || NagBhc_99",
          "segment_number": 28
        }
      ]
    },
    {
      "tag": "p",
