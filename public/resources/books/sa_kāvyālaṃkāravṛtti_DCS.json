 },
 "body": [
  {
   "tag": "div",
   "attributes": {
    "type": "chapter",
    "n": "1"
   },
   "children": [
    {
     "tag": "head",
     "attributes": {},
     "text": "Chapter 1"
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.1",
      "label": "DCS 1.1"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "kāvyaṃ grāhyam alaṃkārāt ||",
       "translated_text": "Poetry is to be valued because of <s>alaṃkāra</s> (ornament).",
       "segment_number": 360857
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.2",
      "label": "DCS 1.2"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "saundaryamalaṃkāraḥ ||",
       "translated_text": "<s>Alaṃkāra</s> is beauty.",
       "segment_number": 360858
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.3",
      "label": "DCS 1.3"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "sa doṣaguṇālaṃkārahānādānābhyām ||",
       "translated_text": "It is produced through the rejection of faults and the adoption of qualities and ornaments.",
       "segment_number": 360859
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.4",
      "label": "DCS 1.4"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "śāstrataste ||",
       "translated_text": "These are known from the treatise.",
       "segment_number": 360860
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.5",
      "label": "DCS 1.5"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "kāvyaṃ saddṛṣṭādṛṣṭārthaṃ prītikīrtihetutvāt ||",
       "translated_text": "Good poetry serves seen and unseen purposes, since it is a cause of delight and fame.",
       "segment_number": 360861
      }
     ]
    }
   ]
  },
  {
   "tag": "div",
   "attributes": {
    "type": "chapter",
    "n": "2"
   },
   "children": [
    {
     "tag": "head",
     "attributes": {},
     "text": "Chapter 2"
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_2.1",
      "label": "DCS 2.1"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "arocakinaḥ satṛṇābhyavahāriṇaśca kavayaḥ ||",
       "translated_text": "Poets are of two kinds: those without appetite and those who consume even grass.",
       "segment_number": 360862
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_2.2",
      "label": "DCS 2.2"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "pūrve śiṣyā vivekitvāt ||",
       "translated_text": "The former are fit to be pupils because they possess discrimination.",
       "segment_number": 360863
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_2.3",
      "label": "DCS 2.3"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "netare tadviparyayāt ||",
       "translated_text": "The others are not, because the opposite is true of them.",
       "segment_number": 360864
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_2.4",
      "label": "DCS 2.4"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "na śāstramadravyeṣvarthavat ||",
       "translated_text": "A treatise is not effective in those lacking the proper substance.",
       "segment_number": 360865
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_2.5",
      "label": "DCS 2.5"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "na hi katakaṃ paṅkaprasādanāya ||",
       "translated_text": "For a <s>kataka</s> (clearing-nut) does not clarify mud.",
       "segment_number": 360866
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_2.6",
      "label": "DCS 2.6"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "rītirātmā kāvyasya ||",
       "translated_text": "<s>Rīti</s> (style) is the soul of poetry.",
       "segment_number": 360867
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_2.7",
      "label": "DCS 2.7"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "viśiṣṭā padaracanā rītiḥ ||",
       "translated_text": "<s>Rīti</s> is a distinctive arrangement of words.",
       "segment_number": 360868
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_2.8",
      "label": "DCS 2.8"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "guṇātmā viśeṣaḥ ||",
       "translated_text": "Its distinctiveness consists in <s>guṇas</s> (qualities).",
       "segment_number": 360869
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_2.9",
      "label": "DCS 2.9"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "sā tridhā vaidarbhī gauḍīyā pāñcālī ca ||",
       "translated_text": "It is threefold: <s>Vaidarbhī</s>, <s>Gauḍīyā</s>, and <s>Pāñcālī</s>.",
       "segment_number": 360870
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_2.10",
      "label": "DCS 2.10"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "vidarbhādiṣu dṛṣṭatvāttatsamākhyā ||",
       "translated_text": "They are so named because they are observed in <s>Vidarbha</s> and the other regions.",
       "segment_number": 360871
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_2.11",
      "label": "DCS 2.11"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "samagraguṇā vaidarbhī ||",
       "translated_text": "The <s>Vaidarbhī</s> style possesses all the qualities.",
       "segment_number": 360872
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_2.12",
      "label": "DCS 2.12"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "ojaḥkāntimatī gauḍīyā ||",
       "translated_text": "The <s>Gauḍīyā</s> style possesses <s>ojas</s> (vigor) and <s>kānti</s> (brilliance).",
       "segment_number": 360873
      }
     ]
    }
   ]
  }
 ]
}
