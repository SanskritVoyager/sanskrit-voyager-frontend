  "body": [
    {
      "tag": "p",
      "attributes": {},
      "text": "Śāntipāṭaḥ",
      "segment_number": 1
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "oṃ bhadraṃ karṇebhiḥ śṛṇuyāma devāḥ bhadraṃ",
          "segment_number": 2
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "paśyemākṣabhiryajatrāḥ |",
          "segment_number": 3
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sthirairaṅgaistuṣṭuvāṃ sastanūbhir vyaśema devahitaṃ yadāyuḥ ||",
          "segment_number": 4
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "svasti na indro vṛddhaśravāḥ svasti naḥ pūṣā viśvavedāḥ |",
          "segment_number": 5
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "svasti nastārkṣyo ariṣṭanemiḥ svasti no bṛhaspatir dadhātu ||",
          "segment_number": 6
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "oṃ śāntiḥ | śāntiḥ | śāntiḥ ||",
      "segment_number": 7
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "oṃ pūrṇamadaḥ pūrṇamidaṃ pūrṇāt pūrṇamudacyate |",
          "segment_number": 8
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pūrṇasya pūrṇamādāya pūrṇamevāvaśiṣyate ||",
          "segment_number": 9
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "oṃ śāntiḥ | śāntiḥ | śāntiḥ ||",
      "segment_number": 10
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "Māṇḍūkya Upaniṣad",
      "segment_number": 11
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "Verse 1",
      "children": [
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "omityetadakṣaramidaṃ sarvaṃ tasyopavyākhyānaṃ bhūtaṃ",
              "segment_number": 13
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "bhavadbhaviṣyaditi sarvamoṅkāra eva |",
              "segment_number": 14
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "yaccānyattrikālātītaṃ tadapyoṅkāra eva ||",
              "segment_number": 15
            }
          ]
        }
      ],
      "segment_number": 12
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "Verse 2\nsarvaṃ hyetad brahmāyamātmā brahma so 'yamātmā catuṣpāt ||",
      "segment_number": 16
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 3",
          "segment_number": 17
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "jāgaritasthāno bahiḥ prajñaḥ saptāṅgaḥ",
          "segment_number": 18
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ekonaviṃśatimukhaḥ sthūlabhugvaiśvānaraḥ prathamaḥ pādaḥ ||",
          "segment_number": 19
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 4",
          "segment_number": 20
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "svapnasthāno 'ntaḥ prajñaḥ saptāṅga ekonaviṃśatimukhaḥ",
          "segment_number": 21
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "praviviktabhuktaijaso dvitīyaḥ pādaḥ ||",
          "segment_number": 22
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "Verse 5",
      "children": [
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "yatra supto na kañcana kāmaṃ kāmayate na",
              "segment_number": 24
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "kañcana svapnaṃ paśyati tatsuṣuptam |",
              "segment_number": 25
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "suṣuptasthāna ekībhūtaḥ prajñānaghana evānandamayo",
              "segment_number": 26
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "hyānandabhukcetomukhaḥ prājñastṛtīyaḥ pādah ||",
              "segment_number": 27
            }
          ]
        }
      ],
      "segment_number": 23
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "Verse 6\neṣa sarveśvara eṣa sarvajña eṣo 'ntaryāmyeṣa\nyoniḥ sarvasya prabhavāpyayau hi bhūtānām",
      "segment_number": 28
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "Māṇḍūkya Kārikā",
      "segment_number": 29
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "Verse 1",
      "segment_number": 30
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bahiḥ prajño vibhurviśvo hyantaḥ prajñastu taijasaḥ |",
          "segment_number": 31
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ghanaprajñastathā prājña eka eva tridhā smṛtaḥ ||",
          "segment_number": 32
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 2",
          "segment_number": 33
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dakṣiṇākṣimukhe viśvo manasyantastu taijasaḥ |",
          "segment_number": 34
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ākāśe ca hydi prājñastridhā dehe vyavasthitaḥ ||",
          "segment_number": 35
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 3",
          "segment_number": 36
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "viśvo hi sthūlabhuṅnityaṃ taijasaḥ praviviktabhuk |",
          "segment_number": 37
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ānandabhuk tathā prājñastridhā bhogaṃ nibodhata ||",
          "segment_number": 38
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 4",
          "segment_number": 39
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sthūlaṃ tarpayate viśvaṃ praviviktaṃ tu taijasam |",
          "segment_number": 40
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ānandaśca tathā prājñaṃ tridhā tṛptiṃ nibodhata ||",
          "segment_number": 41
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 5",
          "segment_number": 42
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "triṣu dhāmasu yadbhojyaṃ bhoktā yaśca prakīrtitaḥ |",
          "segment_number": 43
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vedaitadubhayaṃ yastu sa bhuñjāno na lipyate ||",
          "segment_number": 44
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 6",
          "segment_number": 45
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "prabhavaḥ sarvabhāvānāṃ satāmiti viniścayaḥ |",
          "segment_number": 46
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sarvaṃ janayati prāṇaścetoṃ 'śūnpuruṣaḥ pṛthak ||",
          "segment_number": 47
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 7",
          "segment_number": 48
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vibhūtiṃ prasavaṃ tvanye manyante sṛṣṭicintakāḥ |",
          "segment_number": 49
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "svapnamāyāsarūpeti sṛṣṭiranyairvikalpitā ||",
          "segment_number": 50
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 8",
          "segment_number": 51
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "icchāmātraṃ prabhoḥ sṛṣṭiriti sṛṣṭau viniścitāḥ |",
          "segment_number": 52
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kālātprasūtiṃ bhūtānāṃ manyante kālacintakāḥ ||",
          "segment_number": 53
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 9",
          "segment_number": 54
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhogārthaṃ sṛṣṭirityanye krīḍārthamiti cāpare |",
          "segment_number": 55
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "devasyaiṣa svābhāvo 'yamāptakāmasya kā spṛhā ||",
          "segment_number": 56
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "Māṇḍūkya Upaniṣad",
      "segment_number": 57
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "Verse 7\nnāntaḥ prajñaṃ na bahiḥ prajñaṃ nobhayataḥ prajñaṃ\nna prajñānaghanaṃ na prajñaṃ nāprajñam |",
      "children": [
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "adṛśyamavyavahāryamagrāhyamalakṣaṇamacintyamavyapa",
              "segment_number": 59
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "deśyamekātmapratyayasāraṃ prapañcopaśamaṃ śāntaṃ",
              "segment_number": 60
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "śivamadvaitaṃ caturthaṃ manyante sa ātmā sa vijñeyaḥ ||",
              "segment_number": 61
            }
          ]
        }
      ],
      "segment_number": 58
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "Māṇḍūkya Kārikā",
      "segment_number": 62
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 10",
          "segment_number": 63
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nivṛtteḥ sarvaduḥkhānāmīśānaḥ prabhuravyayaḥ |",
          "segment_number": 64
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "advaitaḥ sarvabhāvānāṃ devasturyo vibhuḥ smṛtaḥ ||",
          "segment_number": 65
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 11",
          "segment_number": 66
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kāryakāraṇabaddhau tāviṣyete viśvataijasau |",
          "segment_number": 67
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "prājñaḥ kāraṇabaddhastu dvau tau turye na siddhytaḥ ||",
          "segment_number": 68
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 12",
          "segment_number": 69
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nātmānaṃ na paraṃ caiva na satyaṃ nāpi cānṛtam |",
          "segment_number": 70
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "prājñaḥ kiñcana saṃvetti turyaṃ tatsarvadṛksadā ||",
          "segment_number": 71
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 13",
          "segment_number": 72
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dvaitasyāgrahaṇaṃ tulyamubhayoḥ prājñaturyayoḥ |",
          "segment_number": 73
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bījanidrāyutaḥ prājñaḥ sā ca turye na vidyate ||",
          "segment_number": 74
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 14",
          "segment_number": 75
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "svapnanidrāyutāvādyau prājñastvasvapnanidrayā |",
          "segment_number": 76
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "na nidrāṃ naiva ca svapnaṃ turye paśyanti niścitāḥ ||",
          "segment_number": 77
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 15",
          "segment_number": 78
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "anyathā gṛhṇataḥ svapno nidrā tattvamajānataḥ |",
          "segment_number": 79
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "viparyāse tayoḥ kṣīṇe turīyaṃ padamaśnute ||",
          "segment_number": 80
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 16",
          "segment_number": 81
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "anādimāyayā supto yadā jīvaḥ prabudhyate |",
          "segment_number": 82
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ajamanidramasvapnamadvaitaṃ budhyate tadā ||",
          "segment_number": 83
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 17",
          "segment_number": 84
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "prapañco yadi vidyeta nivarteta na saṃśayaḥ |",
          "segment_number": 85
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "māyāmātramidaṃ dvaitamadvaitaṃ paramārthataḥ ||",
          "segment_number": 86
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 18",
          "segment_number": 87
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vikalpo vinivarteta kalpito yadi kenacit |",
          "segment_number": 88
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "upadeśādayaṃ vādo jñāte dvaitaṃ na vidyate ||",
          "segment_number": 89
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "Māṇḍūkya Upaniṣad",
      "segment_number": 90
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 8",
          "segment_number": 91
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "so 'yamātmādhyakṣaramoṅkāro 'dhimātraṃ",
          "segment_number": 92
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pādā mātrā mātrāśca pādā akāra ukāro makāra iti ||",
          "segment_number": 93
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "Verse 9",
      "children": [
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "jāgaritasthāno vaiśvānaro 'kāraḥ prathamā",
              "segment_number": 95
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "mātrāpterādimattvādvāpnoti ha vai sarvān",
              "segment_number": 96
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "kāmānādiśca bhavati ya evaṃ veda ||",
              "segment_number": 97
            }
          ]
        }
      ],
      "segment_number": 94
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "Verse 10",
      "children": [
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "svapnasthānastaijasa ukāro dvitīyā mātrotkarṣād",
              "segment_number": 99
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "ubhayatvādvotkarṣati ha vai jñānasantatiṃ samānaśca",
              "segment_number": 100
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "bhavati nāsyābrahmavitkule bhavati ya evaṃ veda ||",
              "segment_number": 101
            }
          ]
        }
      ],
      "segment_number": 98
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 11",
          "segment_number": 102
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "suṣuptasthānaḥ prājño makārastṛtīyā mātrā miterapītervā",
          "segment_number": 103
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "minoti ha vā idaṃ sarvamapītiśca bhavati ya evaṃ veda ||",
          "segment_number": 104
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "Māṇḍūkya Kārikā",
      "segment_number": 105
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 19",
          "segment_number": 106
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "viśvasyātvavivakṣāyāmādisāmānyamutkaṭam |",
          "segment_number": 107
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "mātrāsaṃpratipattau syādāptisāmānyameva ca ||",
          "segment_number": 108
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 20",
          "segment_number": 109
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "taijasasyotvavijñāna utkarṣo dṛśyate sphuṭam |",
          "segment_number": 110
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "mātrāsaṃpratipattau syādubhayatvaṃ tathāvidham ||",
          "segment_number": 111
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 21",
          "segment_number": 112
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "makārabhāve prājñasya mānasāmānyamutkaṭam |",
          "segment_number": 113
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "mātrāsaṃpratipattau tu layasāmānyameva ca ||",
          "segment_number": 114
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 22",
          "segment_number": 115
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "triṣu dhāmasu yastulyaṃ sāmānyaṃ vetti niścitaḥ |",
          "segment_number": 116
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sa pūjyaḥ sarvabhūtānāṃ vandyaścaiva mahāmuniḥ ||",
          "segment_number": 117
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 23",
          "segment_number": 118
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "akāro nayate viśvamukāraścāpi taijasam |",
          "segment_number": 119
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "makāraśca punaḥ prājñaṃ nāmātre vidyate gatiḥ ||",
          "segment_number": 120
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "Māṇḍūkya Upaniṣad",
      "segment_number": 121
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "Verse 12",
      "children": [
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "amātraścaturtho 'vyavahāryaḥ prapañcopaśamaḥ śivo 'dvaita",
              "segment_number": 123
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "evamoṅkāra ātmaiva saṃviśatyātmanātmānaṃ ya evaṃ veda |",
              "segment_number": 124
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "ya evaṃ veda ||",
              "segment_number": 125
            }
          ]
        }
      ],
      "segment_number": 122
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "Māṇḍūkya Kārikā",
      "segment_number": 126
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 24",
          "segment_number": 127
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "oṅkāraṃ pādaśo vidyātpādā mātrā na saṃśayaḥ |",
          "segment_number": 128
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "oṅkāraṃ pādaśo jñātvā na kiñcidapi cintayet ||",
          "segment_number": 129
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 25",
          "segment_number": 130
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yuñjīta praṇave cetaḥ praṇavo brahma nirbhayam |",
          "segment_number": 131
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "praṇave nityayuktasya na bhayaṃ vidyate kvacit ||",
          "segment_number": 132
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 26",
          "segment_number": 133
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "praṇavo hyaparaṃ brahma praṇavaśca paraḥ smṛtaḥ |",
          "segment_number": 134
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "apūrvo 'nantaro 'bāhyo 'naparaḥ praṇavo 'vyayaḥ ||",
          "segment_number": 135
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 27",
          "segment_number": 136
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sarvasya praṇavo hyādirmadhyamantastathaiva ca |",
          "segment_number": 137
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "evaṃ hi praṇavaṃ jñātvā vyaśnute tadanantaram ||",
          "segment_number": 138
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 28",
          "segment_number": 139
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "praṇavaṃ hīśvaraṃ vidyātsarvasya hṛdi saṃsthitam |",
          "segment_number": 140
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sarvavyāpinamoṅkāraṃ matvā dhīro na śocati ||",
          "segment_number": 141
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "Verse 29",
          "segment_number": 142
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "amātro 'nantamātraśca dvaitasyopaśamaḥ śivaḥ |",
          "segment_number": 143
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "oṅkāro vidito yena sa munirnetaro janaḥ ||",
          "segment_number": 144
        }
      ]
    }
  ]
}