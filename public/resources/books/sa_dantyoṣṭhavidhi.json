  },
  "body": [
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atharvāṇam ṛṣiṃ devaṃ devahayaśirodharam |",
          "segment_number": 1
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "praṇamya sampravakṣyāmi dantyoṣṭhavidhivistaram || 1.1 ||",
          "segment_number": 2
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "chandasy adhyayane prāpte viduṣām atha dhīmatām |",
          "segment_number": 3
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bakāre saṃśayo nityam auṣṭhyaṃ dantyam iti sma ha || 1.2 ||",
          "segment_number": 4
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tasmāt tadvidhi nirṇaye saṃśayachedanāya ca |",
          "segment_number": 5
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "muktā dantyā prayojyāma auṣṭhyān vakṣye kramāhitaḥ || 1.3 ||",
          "segment_number": 6
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bhaparaṃ yatra dṛśyetāniṃgye sparśanaṃ kva cit |",
          "segment_number": 7
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "auṣṭyaṃ tatra pade dhīro bibhīto bibhratīr yathā || 1.4 ||",
          "segment_number": 8
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ādyudātte bale bāṇe bila śabde tathaiva ca |",
          "segment_number": 9
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "samaste 'pi yatra syātām antodātto viśiṣyate || 1.5 ||",
          "segment_number": 10
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "baladābalānugrāhabaladhanvā tathaiva ca |",
          "segment_number": 11
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "balāsaṃ bāhū ācāryāḥ sarvāsv eva vibhaktiṣu || 1.6 ||",
          "segment_number": 12
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "balī balena barhiś cābalena balīyase |",
          "segment_number": 13
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bradhnaḥ kilbiṣaṃ vaḥ ketuḥ kumbaṃ bādhiṣṭa bāliti || 1.7 ||",
          "segment_number": 14
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bāhuṃ bohi tathā baṃdhur bahubādhe bṛhac ca yat |",
          "segment_number": 15
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pibati bruvate caiva yathārthāḥ samprakīrttitāḥ || 1.8 ||",
          "segment_number": 16
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bastavāsino bāhvaṃkair bāhuvīrye tathaiva ca |",
          "segment_number": 17
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bahavaḥ kābavaṃ bāhvor bodha bahve tathaiva ca || 1.9 ||",
          "segment_number": 18
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tathāa badhnyaṃ tābuvaṃ bahvīr navamaḥ saṃprakīrttitāḥ |",
          "segment_number": 19
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ete sarveṣu śabdeṣu prathamasparśyā hi matāḥ || 1.10 ||",
          "segment_number": 20
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vaibādha devabandhuṃ ca vibaddhas tu vibandhuṣu |",
          "segment_number": 21
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dvitīya sparśyo vijñeyo vibabādhe tathaiva ca || 1.11 ||",
          "segment_number": 22
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bāhau bāhavo bahulaṃ budhnyaṃ baddhkam eva ca |",
          "segment_number": 23
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ete sarve bhavanty oṣṭhyā ye noktās te tu dantajāḥ || 1.12 ||",
          "segment_number": 24
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "iti prathamo 'dhyāyaḥ |",
      "segment_number": 25
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "adharād uttare bhāge bhāgāt prativibhāgaśaḥ |",
          "segment_number": 26
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "daśanāgreṇa saṃspṛṣṭyo na tu pīḍāsu yojayet || 2.1 ||",
          "segment_number": 27
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kambalaṃ balbajaṃ bījaṃ libujā baṇmhāṃ asi |",
          "segment_number": 28
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "biṣkale brahma barjahye śabale bedhiṣe bayaḥ || 2.2 ||",
          "segment_number": 29
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bahiṣṭhaḥ budhnyaḥ paḍbīśam arbudaṃ badhiras tathā |",
          "segment_number": 30
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ābayobinduḥ saṃbiṃbaṃ kāhābām udumbalam || 2.3 ||",
          "segment_number": 31
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kabru pībasi baṃdhuraṃ kaṃbūkāṃ balinas tathā |",
          "segment_number": 32
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kuberaḥ stambajaṃ babhraupabdaiḥ paribedhire || 2.4 ||",
          "segment_number": 33
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "asaṃbādhe nairbādhyena baddhe buddhāni kulbajaṃ |",
          "segment_number": 34
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bato batāsi bandhuṃ ca bisaṃ klībaṃ buje bujaḥ || 2.5 ||",
          "segment_number": 35
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "badhāna prābaṃdhāyāś colbaṃ kāberkas tathā |",
          "segment_number": 36
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ābedhur ailabaś caivābedhe balhikāni ca || 2.6 ||",
          "segment_number": 37
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "abodhi bārhatsāme ghoṣabuddhā tathaiva ca |",
          "segment_number": 38
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "baṃdhanaṃ yatra śeṣaṃ syād ābadhe me nidraśanam || 2.7 ||",
          "segment_number": 39
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "alābu bajaḥ bāṇaṃ syād ādyudātto yadā bhavet |",
          "segment_number": 40
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "brahma śabdaṃ tu sarvārtham auṣṭhyam eva vidur budhāḥ || 2.8 ||",
          "segment_number": 41
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "chubukābdaṣkaye bāle keśabāle tathaiva ca |",
          "segment_number": 42
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "adhibāle vayaḥ proktaḥ śeṣeṣu parimāṇataḥ || 2.9 ||",
          "segment_number": 43
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bibhed ādiṣu bhedāś ca pari pūrvaṃ bale tathā |",
          "segment_number": 44
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "baṃdhu vā siṃdhurapara eteṣāṃ tu balaḥ kva cit || 2.10 ||",
          "segment_number": 45
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tuchubdaś cubukaś caiva babhūvuś ca babhūvuṣī |",
          "segment_number": 46
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ete sarve parityajya bakāronyonya bhakṣana || 2.11 ||",
          "segment_number": 47
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "|| iti dvitīyo 'adhyāyaḥ ||",
      "segment_number": 48
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "|| dantyoṣṭhavidhiḥ samāptaḥ ||",
      "segment_number": 49
    }
  ]
}