    "source": "Bhikkhu Pāsādika and Bhikkhu Tampalawela Dhammaratana: Contemporary Sri Lankan Sanskrit Poetry: The Yaśodharācaritam by Davuldeṇa Jñāneśvara Mahāsthavira. Bulletin d'etudes indienne 21.1 (2003), pp. 47-70."
  },
  "body": [
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "śrī siddhārthaḥ kapilanagare bodhisattvaḥ saputrāṃ",
          "segment_number": 1
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "devīṃ tyaktvā sakalavibhavaṃ cakravartiśriyaṃ ca |",
          "segment_number": 2
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "māsy āṣāḍhe viratamanasā pūrṇimāyāṃ niśīthe",
          "segment_number": 3
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "niścakrāma śramaṇapadabhṛn mokṣam anveṣṭukāmaḥ || Yaśo_1 ||",
          "segment_number": 4
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atha prabhāte śayanāt samutthitā",
          "segment_number": 5
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sutena sārdhaṃ mahiṣī yaśodharā |",
          "segment_number": 6
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "didṛkṣayā svāmivarasya satvaraṃ",
          "segment_number": 7
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "gatāvidūre śayanīyamandiram || Yaśo_2 ||",
          "segment_number": 8
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yathā pure vañcayituṃ sa me patī",
          "segment_number": 9
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "rahogataḥ kutra cid eva gūḍhavān |",
          "segment_number": 10
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vicintya saudhe 'ntarabāhiraṃ bhṛśaṃ",
          "segment_number": 11
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "parīkṣyamāṇāpi dadarśa naiva tam || Yaśo_3 ||",
          "segment_number": 12
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "dadhāva tasmāt sacivasya mandiraṃ",
          "segment_number": 13
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "gavākṣam udghāṭya drutaṃ drutaṃ śucā |",
          "segment_number": 14
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kapāṭam āhatya dṛḍhaṃ muhur muhur",
          "segment_number": 15
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vyarīravac channa bhavan bhavann iti || Yaśo_4 ||",
          "segment_number": 16
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "apekṣya kiṃ cit kvaṇam antarād gṛhe",
          "segment_number": 17
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vyatiṣṭhatālpaṃ pratihārasannidhau |",
          "segment_number": 18
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vicārabhaṅgāc chvasatī ca pāṇinā",
          "segment_number": 19
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pratāḍayām āsa kapolayugmakam || Yaśo_5 ||",
          "segment_number": 20
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tato gatā sā nṛpamandurālayaṃ",
          "segment_number": 21
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "turaṅgamaṃ nātra dadarśa kanthakam |",
          "segment_number": 22
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kuto yayau kiṃ rahasā sa vallabho",
          "segment_number": 23
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vitarkayantīti babhūva mūrchitā || Yaśo_6 ||",
          "segment_number": 24
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vicintya yat kiṃ cid itas tataḥ śiraś",
          "segment_number": 25
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "cacāla jaghrau ca mukhe sutasya sā |",
          "segment_number": 26
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhujātapatreṇa vilocanadvayān",
          "segment_number": 27
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nyavārayat sā sravadaśruśīkaram || Yaśo_7 ||",
          "segment_number": 28
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "aśaknuvantī nitarāṃ samudgamāṃ",
          "segment_number": 29
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "manovyathāṃ soḍhum udagramanyunā |",
          "segment_number": 30
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "patipradattaṃ maṇikaṇṭhabhūṣaṇaṃ",
          "segment_number": 31
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pravālamālām api kuṇḍaladvayam || Yaśo_8 ||",
          "segment_number": 32
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "lalāṭikāṃ hemamayāṅgulīyakaṃ",
          "segment_number": 33
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "hiraṇyasūtreṇa nibaddhamekhalām |",
          "segment_number": 34
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vimucya śīrṣābharaṇaṃ ca kaṅkaṇe",
          "segment_number": 35
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sasarja dhig dhig vadatī sasambhramam || Yaśo_9 ||",
          "segment_number": 36
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atītaḍat pādatalena bhūtalaṃ",
          "segment_number": 37
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "jajṛmbha ūrdhvaṃ vicakarṣa mūrdhajam |",
          "segment_number": 38
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "jajalpa vākyaṃ vigatārtham ākulaṃ",
          "segment_number": 39
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "rurāva bhīteva ruroda gadgadam || Yaśo_10 ||",
          "segment_number": 40
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "niveśya bālaṃ śayane punaḥ punaḥ",
          "segment_number": 41
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "samutkṣipantī yugapat karadvayam |",
          "segment_number": 42
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vikampya śīrṣaṃ ca yathā vicetanā",
          "segment_number": 43
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "jughoṣa śaśvāsa papāta vivyathe || Yaśo_11 ||",
          "segment_number": 44
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nipīḍyamānāpi bubhukṣayāniśaṃ",
          "segment_number": 45
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "na bhojanaṃ bhoktum iyeṣa kiṃ cana |",
          "segment_number": 46
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tṛṣāturā nodakabindum apy asau",
          "segment_number": 47
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "papau ca kāye 'py babhūva vepathuḥ || Yaśo_12 ||",
          "segment_number": 48
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nihanyate dhīsmṛtiśaktidhīratā",
          "segment_number": 49
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śarīravarṇaṃ balam indriyeṣv api |",
          "segment_number": 50
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vinaśyate jīvam anukrameṇa ca",
          "segment_number": 51
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "durantateyaṃ priyaviprayogatā || Yaśo_13 ||",
          "segment_number": 52
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "niṣadya bhūmyāṃ vinatārdhavigrahā",
          "segment_number": 53
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śiraś ca pāṇidvayam aṅkamastake |",
          "segment_number": 54
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "niveśya kiṃ cit pariṇamya kaṃdharaṃ",
          "segment_number": 55
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "mamajja cintājaladhāv apāśraye || Yaśo_14 ||",
          "segment_number": 56
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yaśodharāyā avamānanakriyā",
          "segment_number": 57
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "asahya siddhārthakumāra ekakaḥ |",
          "segment_number": 58
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nivāsam utsṛjya gato nu kānanam",
          "segment_number": 59
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "iti pravādo 'pi bhaved aho mama || Yaśo_15 ||",
          "segment_number": 60
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yad asti kāryaṃ triṣu mandireṣu tac",
          "segment_number": 61
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "cakāra kāryakṣamasevikā yathā |",
          "segment_number": 62
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "gatau sthitau vā śayane ca vipriyaṃ",
          "segment_number": 63
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kadā canāhaṃ na cakāra kiṃ cana || Yaśo_16 ||",
          "segment_number": 64
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vicintayantī sahasāgatāpadaṃ",
          "segment_number": 65
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pragamya devāyatanaṃ priyaṃ prati |",
          "segment_number": 66
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sugandhipuspair api dhūmadīpakair",
          "segment_number": 67
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "apūpujad devagaṇaṃ sagauravam || Yaśo_17 ||",
          "segment_number": 68
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bhujadvayaṃ mūrdhni niveśya śokinī",
          "segment_number": 69
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vilokya devapratimānanaśriyam |",
          "segment_number": 70
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "praṇamya bhaktyā pariśuddhacetasā",
          "segment_number": 71
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yayāca devān iti viprayogataḥ || Yaśo_18 ||",
          "segment_number": 72
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "trilokasargasthitināśahetavaḥ",
          "segment_number": 73
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "caturmukhaśrīpaticandraśekharāḥ |",
          "segment_number": 74
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "mahānubhāvā jagadīśvarāḥ surāḥ",
          "segment_number": 75
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "suduḥkhitāyai śaraṇaṃ bhavantu me || Yaśo_19 ||",
          "segment_number": 76
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vidhāya yācñām iti devahastayor",
          "segment_number": 77
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "upāyanīkṛtya babandha kārṣikau |",
          "segment_number": 78
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "upāharan miṣṭanavāmbupāyasaṃ",
          "segment_number": 79
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sitāṃśukaṃ svarṇamayīṃ ca putrikām || Yaśo_20 ||",
          "segment_number": 80
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pramodam āpādayituṃ sureśvarāṃś",
          "segment_number": 81
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "cakāra ghaṇṭāninadaṃ ca bhūsurān |",
          "segment_number": 82
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ajījapad devagirā ca saṃstavān",
          "segment_number": 83
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nanāma bhūmāv asakṛt nipatya sā || Yaśo_21 ||",
          "segment_number": 84
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pure vane saṃvasathe 'pi vallabho",
          "segment_number": 85
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vased dhi kasminn iti divyācakṣuṣā |",
          "segment_number": 86
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vilokya gehaṃ vinivartayantu taṃ",
          "segment_number": 87
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "divaukasaḥ prārthayataiva sā punaḥ || Yaśo_22 ||",
          "segment_number": 88
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nirīkṣya jihmānimiṣeṇa cakṣuṣā",
          "segment_number": 89
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nihatya gāḍhaṃ caraṇaṃ bhuvas tale |",
          "segment_number": 90
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "muhur muhur daṃśitakomalādharā",
          "segment_number": 91
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "prakarṣam utkṣipya vikampya tarjanīm || Yaśo_23 ||",
          "segment_number": 92
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "are-tvayāryasya gṛhābhiniṣkramaḥ",
          "segment_number": 93
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śruto na dṛṣṭaḥ vada kiṃ nirākulam |",
          "segment_number": 94
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "iti pratīhārabhaṭaṃ ruṣoccakai",
          "segment_number": 95
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "raveṇa papraccha sabāṣpalocanā || Yaśo_24 ||",
          "segment_number": 96
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bhavān sa ārye nṛpavaṃśaśekharo",
          "segment_number": 97
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "mayā na dṛṣṭaḥ pratihāram āgataḥ |",
          "segment_number": 98
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "varāṅganābhiḥ saha kelikānane",
          "segment_number": 99
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "gate niśīthe 'ramateti me śrutam || Yaśo_25 ||",
          "segment_number": 100
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "avītarāgo nanu rājanandano",
          "segment_number": 101
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vavāñcha tasmān nanu nūtanapriyām |",
          "segment_number": 102
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "mithaḥ sa kāṃ cit pariṇīya nāṭikāṃ",
          "segment_number": 103
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bahir gato 'ddheti vitarkayāmy aham || Yaśo_26 ||",
          "segment_number": 104
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "purā hi mandhātvabhidho mahāyaśāḥ",
          "segment_number": 105
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sa sārvabhaumo 'pi surāṅganāgaṇe |",
          "segment_number": 106
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kṛtānurāgo parivarjya mānuṣīṃ",
          "segment_number": 107
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śriyaṃ prapede nu divaukasāṃ puram || Yaśo_27 ||",
          "segment_number": 108
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "mano'bhirāmaṃ surasundarīgaṇaṃ",
          "segment_number": 109
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vihāya vindhyāvanatāpasāśrame |",
          "segment_number": 110
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "agastipatnīṃ parirabhya tāpasīṃ",
          "segment_number": 111
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "lalāsa rantuṃ niśi pākaśāsanaḥ || Yaśo_28 ||",
          "segment_number": 112
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pratītalaṅkāvijite 'grabhūpatir",
          "segment_number": 113
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "daśānano daṇḍakakānanaṃ gataḥ |",
          "segment_number": 114
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vigṛhya sītāṃ janakātmajām api",
          "segment_number": 115
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nijapriyāvad vyadadhāt tadātmasāt || Yaśo_29 ||",
          "segment_number": 116
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "maheśvaraś cāpi purā tapaś carann",
          "segment_number": 117
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "umāmahiṣyā saha kalikānane |",
          "segment_number": 118
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "apāsya sātatyasamādhibhāvanaṃ",
          "segment_number": 119
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vyarīramac cājanayat sutau nanu || Yaśo_30 ||",
          "segment_number": 120
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "śucākulāṃ sāntvayituṃ vadhūttamām",
          "segment_number": 121
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "iti pratīhāra uraḥsthale 'ñjalim |",
          "segment_number": 122
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vidhāya valgudhvaninānukampayā",
          "segment_number": 123
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "natena mūrdhnā vacasā vyajijñapat || Yaśo_31 ||",
          "segment_number": 124
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "are-tvam etarhi bhavantam uttamaṃ",
          "segment_number": 125
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "gṛhe bahir vopavane 'pi kutra cit |",
          "segment_number": 126
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "aharmukhe kiṃ niśi vā dadarśitha",
          "segment_number": 127
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vyapṛcchad itthaṃ nijasevikāṃ ruṣā || Yaśo_32 ||",
          "segment_number": 128
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nidhāya vāmetarajānumaṇḍalaṃ",
          "segment_number": 129
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kṣitau bhujau cāpi lalāṭamastake |",
          "segment_number": 130
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "natārdhakāyaṃ nijagāda sevikā",
          "segment_number": 131
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śrutaṃ ca dṛṣṭaṃ na na vedmi kiṃ cana || Yaśo_33 ||",
          "segment_number": 132
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ataḥ-paraṃ harmyam upeyuṣī satī",
          "segment_number": 133
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pramārjya nisyandajalaṃ vilocane |",
          "segment_number": 134
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "are-kim āryo 'tra samāgato na vā",
          "segment_number": 135
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vyapṛcchad antaḥpurapālapaṇḍakam || Yaśo_34 ||",
          "segment_number": 136
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "praśasyarūpeṇa girā ca valgunā",
          "segment_number": 137
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śriyā 'pi dhṛtyā tava kakṣam āgatāḥ |",
          "segment_number": 138
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "mahottame sarvajanena mānitā",
          "segment_number": 139
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhavanti tasya tritayāḥ priyāṅganāḥ || Yaśo_35 ||",
          "segment_number": 140
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "mano'bhirāmā bhavatī ca bhāratī",
          "segment_number": 141
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tathaiva lakṣmīr iti tāḥ priyāṅganāḥ |",
          "segment_number": 142
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sadaiva tābhī ramate kumārakaḥ",
          "segment_number": 143
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kadā cid anyatra mano 'sya no rajet || Yaśo_36 ||",
          "segment_number": 144
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "jugupsite satpuruṣair manasvibhiḥ",
          "segment_number": 145
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sadoṣakāme vimukho nu te patiḥ |",
          "segment_number": 146
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tato 'sya śuddhāntagatiḥ kadā cana",
          "segment_number": 147
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śrutā na dṛṣṭā na divā vā niśi || Yaśo_37 ||",
          "segment_number": 148
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tapodhanānāṃ samatām upeyivān",
          "segment_number": 149
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ratiṃ na kuryāt sa bhavatraye kva cit |",
          "segment_number": 150
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "amedhyagehena same 'varodhane",
          "segment_number": 151
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kathaṃ vidhatte ratim eṣa te patiḥ || Yaśo_38 ||",
          "segment_number": 152
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "asādhyarogāyatane sukhetare",
          "segment_number": 153
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bubhukṣayā nityanipīḍitodare |",
          "segment_number": 154
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "atarpaṇīye vividhānnapānakaiḥ",
          "segment_number": 155
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "spṛhāṃ na dehe prakaroti paṇḍitaḥ || Yaśo_39 ||",
          "segment_number": 156
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vikīrṇagharmodakavipruṣi tvaci",
          "segment_number": 157
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vicitravarṇaṃ śamalena saṃskṛte |",
          "segment_number": 158
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śarīra ālokya jano vinaśyate",
          "segment_number": 159
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pataṅgavad dīpaśikhojjvalaprabhām || Yaśo_40 ||",
          "segment_number": 160
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tato nṛpāntaḥpurapālakodite",
          "segment_number": 161
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kṛtāvadhānā vacane yaśodharā |",
          "segment_number": 162
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "divaukasāṃ nandanakānanopamaṃ",
          "segment_number": 163
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "jagāma rājopavanaṃ calātmanā || Yaśo_41 ||",
          "segment_number": 164
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "athābhirāmopavanasya rakṣakaḥ",
          "segment_number": 165
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "puraḥ pragamyorasi baddhapāṇinā |",
          "segment_number": 166
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kimartham ārye 'tra samāgatis tava",
          "segment_number": 167
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhavāmi jijñāsur iti nyavedayat || Yaśo_42 ||",
          "segment_number": 168
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sakhe mamāryo rahasāruṇodaye",
          "segment_number": 169
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "samāgato vātra na kiṃ samāgataḥ |",
          "segment_number": 170
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kim atra dṛṣṭaḥ sa na vā śrutas tvayā",
          "segment_number": 171
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vicintya samyag vada māṃ yathātatham || Yaśo_43 ||",
          "segment_number": 172
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "gataspṛhaḥ pañcasu kāmavastuṣu",
          "segment_number": 173
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sa āryaputro vijitendriyo bhavet |",
          "segment_number": 174
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tato 'bhirāmopavanaṃ samāgamo",
          "segment_number": 175
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "na dṛṣṭa ārye na hi vā śruto mayā || Yaśo_44 ||",
          "segment_number": 176
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vidhitsamāno 'bhyudayaṃ jagattraye",
          "segment_number": 177
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "divaukasānām adhigamya yācanam |",
          "segment_number": 178
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "divo 'vatīrṇo nanu puṇyatejasā",
          "segment_number": 179
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "manuṣyajanmany ajaniṣṭa sa prabhuḥ || Yaśo_45 ||",
          "segment_number": 180
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "mahāmahe saty asitarṣir īyivān",
          "segment_number": 181
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "divaṃ kim ity asya vimṛśya kāraṇam |",
          "segment_number": 182
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "svamitraśuddhodanabhūpateḥ suto",
          "segment_number": 183
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "'janīti harṣāt tam avekṣituṃ yayau || Yaśo_46 ||",
          "segment_number": 184
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tato 'sitarṣir nṛpasaudham āgataḥ",
          "segment_number": 185
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kumārakaṃ vīkṣya sapuṇyasampadam |",
          "segment_number": 186
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "atīndriyajñānamayena cakṣuṣā",
          "segment_number": 187
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "parīkṣamāṇo 'sya śarīralakṣaṇam || Yaśo_47 ||",
          "segment_number": 188
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "jagāda vākyaṃ śiśur eṣa puṇyavān",
          "segment_number": 189
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhaved dhi buddho hatamārabandhanaḥ |",
          "segment_number": 190
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pratārayet sarvanarāmarāsurān",
          "segment_number": 191
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "apārasaṃsāramahārṇavād iti || Yaśo_48 ||",
          "segment_number": 192
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "dvijeṣu pañcasv atha dehalakṣaṇaṃ",
          "segment_number": 193
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "parīkṣya kauṇḍaṇyabudho 'bravīd iti |",
          "segment_number": 194
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vinaśya tṛṣṇādimalāny ayaṃ śiśur",
          "segment_number": 195
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "anuttaraṃ buddhapadaṃ gamiṣyati || Yaśo_49 ||",
          "segment_number": 196
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tadā prasūtakṣaṇa eva lumbinī-",
          "segment_number": 197
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vane sa saptāmbujamūrdhny abhivrajan |",
          "segment_number": 198
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "abhītanādaṃ nyanadaj jagattraye",
          "segment_number": 199
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhaveyam agras tv iti siṃhapotavat || Yaśo_50 ||",
          "segment_number": 200
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bhramaddvirephaśrutiramyanisvanaḥ",
          "segment_number": 201
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sugandhinaḥ puṣpaparāgarāśinā |",
          "segment_number": 202
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "taraṃgiṇīśīkaramiśramāruto",
          "segment_number": 203
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vavau samantād vipine śanaiḥ tadā || Yaśo_51 ||",
          "segment_number": 204
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "mahātmanas tasya parārdhyajanmani",
          "segment_number": 205
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vasuṃdharāyā nidhayaḥ samudgatāḥ |",
          "segment_number": 206
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dharāṅganā tarhy atimātramoditā",
          "segment_number": 207
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "savismayāṃ siddhim adarśayad bhuvi || Yaśo_52 ||",
          "segment_number": 208
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tataḥ paraṃ lumbinikānanād gṛhaṃ",
          "segment_number": 209
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vicitrajāmbūnadabimbasaṃnibham |",
          "segment_number": 210
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kumārakaṃ tau pitarau savatsalau",
          "segment_number": 211
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sabandhuvargaṃ parivārya ninyatuḥ || Yaśo_53 ||",
          "segment_number": 212
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "gurupradiṣṭaṃ vidhivad gurupriyaḥ",
          "segment_number": 213
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "samastavidyāsamayaṃ ca darśanam |",
          "segment_number": 214
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhave bhave saṃcitapuṇyatejasā",
          "segment_number": 215
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "samadhyagīṣṭāciram eṣa buddhimā || Yaśo_54 ||",
          "segment_number": 216
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "śrutena dhṛtyā navayauvanaśriyam",
          "segment_number": 217
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "upeyuṣo 'syāryasutasya janmanaḥ |",
          "segment_number": 218
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "saha tvayā ṣoḍaśame hi hāyane",
          "segment_number": 219
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vivāhadīkṣāṃ vidhivac cakāra nu || Yaśo_55 ||",
          "segment_number": 220
        }
      ]
    }
  ]
}