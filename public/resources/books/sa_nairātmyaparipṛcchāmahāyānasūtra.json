  "body": [
    {
      "tag": "p",
      "attributes": {},
      "text": "(#Vaidya 174#)\n#Nairātmyaparipṛcchā nāma mahāyānasūtram |#",
      "segment_number": 1
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "atha te tīrthikā upalambhadṛṣṭayaḥ savikalpāḥ savitarkā mahāyānikamupasṛtya sādarakṛtāñjalipuṭā nairātmyapraśnaṃ paripṛcchanti sma - nairātmakaṃ śarīramiti kulaputra sarvajñena nirdiśyate | yadi śarīraṃ nairātmakam, paramātmā na vidyate | tat kasmātsakāśādete hasitaruditakrīḍitakrodhamānerṣyāṃpaiśunyādayaḥ samutpadyante? tadasmākaṃ saṃdehaṃ mocayitumarhati bhagavān - kimasti śarīre paramātmā, kiṃ vā nāsti?",
      "segment_number": 2
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "mahāyānikāḥ prāhuḥ - mārṣāḥ, śarīre paramātmā astītyucyate, na hi nāstīti | dvayamatra nocyate | asti paramātmetyucyamāne mārṣā mithyāpralāpaḥ | yadyasti, tatkathaṃ mārṣāḥ keśanakhadantacarmaromasirāmāṃsāsthimedamajjāsnāyuplīhāntranālaśiraḥkaracaraṇāṅgasakalaśarīre sa bāhyābhyantare vicāryamāṇe na dṛśyate paramātmā?",
      "segment_number": 3
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "tīrthikāḥ prāhuḥ - na dṛśyate kulaputra paramātmā | māṃsacakṣuṣā vayaṃ na paśyāmaḥ | kadāciddivyacakṣuṣaḥ paśyanti |",
      "segment_number": 4
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "mahāyānikāḥ prāhuḥ - na mārṣā divyacakṣuṣo 'pi paśyanti | yasya na varṇo na rūpaṃ na saṃskāraḥ, tatkathaṃ dṛśyate?",
      "segment_number": 5
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "tīrthikāḥ prāhuḥ - kiṃ nāsti?",
      "segment_number": 6
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "mahāyānikāḥ prāhuḥ - nāstītyucyamāne mārṣā mithyāpralāpaḥ | yadi nāsti, tatkathamasya ete hasitaruditakrīḍitakrodhamānerṣyāpaiśunyādayaḥ saṃbhavanti? tena nāstīti vaktuṃ na pāryate | ubhāvetau dvau nocyete |",
      "segment_number": 7
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "tīrthikāḥ prāhuḥ - yadi kulaputra nocyate astīti vā nāstīti vā, tatkimatrālambanaṃ bhavatu?",
      "segment_number": 8
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "mahāyānikāḥ prāhuḥ - na mārṣāḥ kiṃcidālambanaṃ bhavati |",
      "segment_number": 9
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "tīrthikāḥ prāhuḥ - kiṃ śūnyamākāśamiva?",
      "segment_number": 10
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "mahāyānikāḥ prāhuḥ - evametanmārṣāḥ, evametat | śūnyamākāśamiva |",
      "segment_number": 11
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "tīrthikāḥ prāhuḥ - yadyevaṃ kulaputra, tadete hasitaruditakrīḍitakrodhamānerṣyāpaiśunyādayaḥ kathaṃ draṣṭavyāḥ?",
      "segment_number": 12
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "mahāyānikāḥ prāhuḥ - svapnamāyendrajālasadṛśā draṣṭavyāḥ |",
      "segment_number": 13
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "tīrthikāḥ prāhuḥ - kīdṛśī maya, kīdṛśaḥ svapnaḥ, kidṛśa indrajāla iti?",
      "segment_number": 14
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "mahāyānikāḥ prāhuḥ - upalakṣaṇamātraṃ mayā agrāhā, pratibhāsamātraṃ svapnaḥ prakṛtiśūnyatāsvarūpaḥ, indrajālaḥ kṛtrimaprayogaḥ | evaṃ mārṣāḥ sarve svapnamāyendrajālasadṛśā draṣṭavyāḥ | punaraparaṃ dvau bhedau vinirdiṣṭau yaduta saṃvṛtiḥ paramārthaśca | tatra saṃvṛtirnāma ayamātmā, ayaṃ (#Nparipṛ, Vaidya 175#) paraḥ | evaṃ jīvaḥ puruṣaḥ pudgalaḥ kārakaḥ vedakaḥ | dhanaputrakalatrādikalpanā yā, sā saṃvṛtirnāma | yatra nātmā na paraḥ, evaṃ na jīvo na pudgalaḥ na puruṣaḥ na kārakaḥ na vedakaḥ na dhanaṃ - - - - - sā madhyamā pratipattirdharmāṇām | tatredamucyate -",
      "segment_number": 15
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "saṃvṛtiḥ paramārthaśca dvau bhedau saṃprakāśitau |",
          "segment_number": 16
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "saṃvṛtirlaukiko dharmaḥ paramārthaśca lokottaraḥ || 1 ||",
          "segment_number": 17
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "saṃvṛtidharmamāpannāḥ sattvāḥ kleśavaśānugāḥ |",
          "segment_number": 18
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ciraṃ bhramanti saṃsāre paramārthamajānakāḥ || 2 ||",
          "segment_number": 19
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "saṃvṛtirlaukiko dharmastaṃ kalpayantyapaṇḍitāḥ |",
          "segment_number": 20
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "abhūtaparikalpanādduḥkhānyanubhavanti te || 3 ||",
          "segment_number": 21
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "muktimārgaṃ na paśyanti andhā bālāḥ pṛthagjanāḥ |",
          "segment_number": 22
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "utpadyante nirudhyante ajasraṃ gatipañcasu || 4 ||",
          "segment_number": 23
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bhramanti cakravanmūḍhā lokadharmasamāvṛtāḥ |",
          "segment_number": 24
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "paramārthaṃ na jānanti bhavo yatra nirudhyate |",
          "segment_number": 25
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "veṣṭitā bhavajālena saṃsaranti punaḥ punaḥ || 5 ||",
          "segment_number": 26
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yathā candraśca sūryaśca pratyāgacchati gacchati |",
          "segment_number": 27
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhavaṃ cyutiṃ tathā loke punarāyānti yānti ca || 6 ||",
          "segment_number": 28
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "anityāḥ sarvasaṃskārā adhruvāḥ kṣaṇabhaṅgurāḥ |",
          "segment_number": 29
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ataśca paramārthajño varjayetsaṃvṛteḥ padam || 7 ||",
          "segment_number": 30
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "svargasthāne tu ye devā gandharvāpsarasādayaḥ |",
          "segment_number": 31
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "cyutirasti ca sarveṣāṃ tatsarvaṃ saṃvṛteḥ phalam || 8 ||",
          "segment_number": 32
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "siddhā vidyādharā yakṣāḥ kinnarāśca mahoragāḥ |",
          "segment_number": 33
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "punaste narakaṃ yānti tatsarvaṃ saṃvṛteḥ phalam || 9 ||",
          "segment_number": 34
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "śakratvaṃ cakravartitvaṃ saṃprāpya cottamaṃ padam |",
          "segment_number": 35
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tiryagyonau punarjanma tatsarvaṃ saṃvṛteḥ phalam || 10 ||",
          "segment_number": 36
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ataḥ sarvamidaṃ tyaktvā divyaṃ svargamahāsukham |",
          "segment_number": 37
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhāvayetsatataṃ prājño bodhicittaṃ prabhāsvaram || 11 ||",
          "segment_number": 38
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "niḥsvabhāvaṃ nirālambaṃ sarvaśūnyaṃ nirālayam |",
          "segment_number": 39
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "prapañcasamatikrāntaṃ bodhicittasya lakṣaṇam || 12 ||",
          "segment_number": 40
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "na kāṭhinyaṃ na ca mṛdutvaṃ na coṣṇaṃ naiva śītalam |",
          "segment_number": 41
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "na saṃsparśaṃ na ca grāhyaṃ bodhicittasya lakṣaṇam || 13 ||",
          "segment_number": 42
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "na dīrghaṃ nāpi vā hrasvaṃ na piṇḍaṃ na trikoṇakam |",
          "segment_number": 43
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "na kṛśaṃ nāpi na sthūlaṃ bodhicittasya lakṣaṇam || 14 ||",
          "segment_number": 44
        }
      ]
    },
    {
      "tag": "note",
      "attributes": {},
      "text": "#Nparipṛ, Vaidya 176#)"
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "na śveta nāpi raktaṃ ca na kṛṣṇaṃ na ca pītakam |",
          "segment_number": 45
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "avarṇaṃ ca nirākāraṃ bodhicittasya lakṣaṇam || 15 ||",
          "segment_number": 46
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nirvikāraṃ nirābhāsaṃ nirūhaṃ nirvibandhakam |",
          "segment_number": 47
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "arūpaṃ vyomasaṃkāśaṃ bodhicittasya lakṣaṇam || 16 ||",
          "segment_number": 48
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bhāvanāsamatikrāntaṃ tīrthikānāmagocaram |",
          "segment_number": 49
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "prajñāpāramitārūpaṃ bodhicittasya lakṣaṇam || 17 ||",
          "segment_number": 50
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "anaupamyamanābhāsaṃ adṛśaṃ śāntameva ca |",
          "segment_number": 51
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "prakṛtiśuddhamadravyaṃ bodhicittasya lakṣaṇam || 18 ||",
          "segment_number": 52
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sarvaṃ ca tena sādṛśyaṃ niḥsāraṃ budbudopamam |",
          "segment_number": 53
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "aśāśvataṃ ca nairātmyaṃ māyāmarīcisaṃnibham || 19 ||",
          "segment_number": 54
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "mṛptiṇḍavad ghaṭībhūtaṃ bahuprapañcapūritam |",
          "segment_number": 55
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "rāgadveṣādisaṃyuktaṃ svapnamāyā tu kevalam || 20 ||",
          "segment_number": 56
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "abhrāntare yathā vidyut kṣaṇādapi na dṛśyate |",
          "segment_number": 57
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "prajñāpāramitādṛṣṭyā bhāvayetparamaṃ padam || 21 ||",
          "segment_number": 58
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "krīḍitaṃ hasitaṃ nityaṃ jalpitaṃ ruditaṃ tathā |",
          "segment_number": 59
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nṛtyaṃ gītaṃ tathā vādyaṃ sarvaṃ svapnopamaṃ hi tat || 22 ||",
          "segment_number": 60
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "māyāsvapnopamaṃ sarvaṃ saṃskāraṃ sarvadehinām |",
          "segment_number": 61
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "svapnaṃ ca cittasaṃkalpaṃ cittaṃ ca gaganopamam || 23 ||",
          "segment_number": 62
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bhāvayedya imaṃ nityaṃ prajñāpāramitānayam |",
          "segment_number": 63
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sa sa rvapāpanirmuktaḥ prāpnoti paramaṃ padam || 24 ||",
          "segment_number": 64
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "iyaṃ sānuttarā bodhiḥ sarvabuddhaiḥ prakāśitā |",
          "segment_number": 65
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhāvanāṃ bhāvayitveha nirvāṇaṃ labhate śivam || 25 ||",
          "segment_number": 66
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yāvantaḥ saṃvṛterdoṣāstāvanto nirvṛterguṇāḥ |",
          "segment_number": 67
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nirvṛtiḥ syādanutpattiḥ sarvadoṣairna lipyate || 26 ||",
          "segment_number": 68
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "atha te tīrthikāstuṣṭā vikalparahitāstadā bhāvanāṃ samādhāya mahāyānayajñalābhino 'bhūvanniti ||",
      "segment_number": 69
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "mahāyānanirdeśe nairātmyaparipṛcchā samāptā ||",
      "segment_number": 70
    }
  ]
}