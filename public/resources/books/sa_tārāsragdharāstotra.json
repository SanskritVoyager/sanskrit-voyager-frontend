  "body": [
    {
      "tag": "p",
      "attributes": {},
      "text": "Āryatārāsragdharāstotra",
      "segment_number": 1
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "oṃ namo bhagavatyai āryatārāyai.",
      "segment_number": 2
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bālārkālokatāmrapravarasuraśiraścārucūḍāmaṇiśrī-",
          "segment_number": 3
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "saṃpatsaṃparkarāganāticiraracitālaktakavyaktabhaktī /",
          "segment_number": 4
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhaktyā pādau tavārye karapuṭamukuṭātopabhugnottamāṅgas",
          "segment_number": 5
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tāriṇy āpaccharaṇyair navanutikusumasragbhir abhyarcayāmi // Tss_1",
          "segment_number": 6
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "durlaṅghe duḥkhavahnau vinipatitatanur durbhagaḥ kāṃdiśīkaḥ",
          "segment_number": 7
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kiṃ kiṃ mūḍhaḥ karomīty asakṛd api kṛtārambhavaiyarthyakhinnaḥ /",
          "segment_number": 8
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śrutvā bhūyaḥ parebhyaḥ kṣatanayana iva vyomni candrārkalakṣmīm",
          "segment_number": 9
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ālokāśānibaddhaḥ paragatigamanas tvāṃ śraye pāpahantrīṃ // Tss_2",
          "segment_number": 10
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sarvasmin satvamārge nanu tava karuṇā nirviśeṣaṃ pravṛttā",
          "segment_number": 11
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tanmadhye tadgraheṇa grahaṇam upagataṃ mādṛśasyāpy avaśyam /",
          "segment_number": 12
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sāmarthyaṃ cādvitīyaṃ sakalajagadaghadhvāntatigmāṃśubimbaṃ",
          "segment_number": 13
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "duḥkhīvāhaṃ tathāpi pratapati dhig aho duṣkṛtaṃ durvidagdham // Tss_3",
          "segment_number": 14
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "dhig dhig māṃ mandabhāgyaṃ divasakararucāpy apraṇuṇṇāndhakāraṃ",
          "segment_number": 15
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tṛṣyantaṃ kūlakacche himaśakalaśilāśītale haimavatyāḥ /",
          "segment_number": 16
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ratnadvīpapratolyāvipulamaṇiguhāgehagarbhe daridraṃ",
          "segment_number": 17
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nāthīkṛtvāpy ānāthaṃ bhagavati bhavatīṃ sarvalokaikadhātrīm // Tss_4",
          "segment_number": 18
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "mātāpi stanyahetor viruvati bahuśaḥ khedam āyāti putre",
          "segment_number": 19
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "krodhaṃ dhatte pitāpi pratidivasam asatprārthanāsu prayuktaḥ /",
          "segment_number": 20
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tvaṃ tu trailokyavāñchāvipulaphalamahākalpavṛkṣāgravallī",
          "segment_number": 21
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sarvebhyo 'bhyārcitārthān visṛjasi na ca te vikriyā jātu kācit // Tss_5",
          "segment_number": 22
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yo yaḥ kleśoghavahnijvalitatanur ahaṃ tāraṇī tasya tasye-",
          "segment_number": 23
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tyātmopajñāṃ pratijñāṃ kuru mayi saphalāṃ duḥkhapātālamagne /",
          "segment_number": 24
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vardhante yāvad ante paruṣaparibhavāḥ prāṇināṃ duḥkhavegāḥ",
          "segment_number": 25
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "samyaksaṃbuddhayāne praṇidhidhṛtadhiyāṃ tāvad evānukampā // Tss_6",
          "segment_number": 26
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ity uccair ūrdhvabāhau nadati nutipadavyājam ākrandanādaṃ",
          "segment_number": 27
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nārhaty anyo 'py upekṣāṃ janani janayituṃ kiṃ punar yādṛśī tvam /",
          "segment_number": 28
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tvattaḥ paśyan pareṣām abhimatavibhavaprārthanāḥ prāptakāmā",
          "segment_number": 29
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dahye sahyena bhūyastaram aratibhuvā saṃtatāntarjvareṇa // Tss_7",
          "segment_number": 30
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pāpī yady asmi kasmāt tvayi mama mahatī vardhate bhaktir eṣā",
          "segment_number": 31
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śrutyā smṛtyā ca nāmno 'py apaharasi haṭhāt pāpam ekā tvam eva /",
          "segment_number": 32
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tyaktavyāpārabhārā nudasi mayi kathaṃ kathyatāṃ tathyakathye",
          "segment_number": 33
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pathyaṃ glāne mariṣyaty api vipulakṛpaḥ kiṃ bhiṣag rorudhīti // Tss_8",
          "segment_number": 34
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "māyāmātsaryamānaprabhṛtibhir adhamais tulyakālaṃ kramāc ca",
          "segment_number": 35
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "svair doṣair vākyamāno maṭhakarabha ivānekasādhāraṇāṃsaḥ /",
          "segment_number": 36
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yuṣmatpādābjapūjāṃ kṣaṇam api na labhe yat tadarthaṃ viśeṣād",
          "segment_number": 37
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "eṣā kārpaṇyadīnākṣarapadaracanā syān mamāvandhyakāmā // Tss_9",
          "segment_number": 38
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kalpāntabhrāntavātabhramitajalavalallolakallolahelā-",
          "segment_number": 39
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "saṃkṣobhotkṣiptavelātaṭavikaṭacaṭasphoṭamoṭāṭṭahāsāt /",
          "segment_number": 40
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "majjadbhir bhinnanaukaiḥ sakaruṇaruditākrandaniṣpandamandaiḥ",
          "segment_number": 41
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "svacchandaṃ devi sadyas tvadabhibhūtiparais tīram uttīryate 'bdheḥ // Tss_10",
          "segment_number": 42
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "dhūmabhrāntābhragarbhodbhavagagaṇagṛhotsaṅgariṅgatsphuliṅga-",
          "segment_number": 43
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sphūrjaj jvālākarālajvalanajavaviśadveśmaviśrāntaśayyāḥ /",
          "segment_number": 44
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tvayy ābaddhapraṇamāñjalipuṭamukuṭā gadgadodgītayājñāḥ",
          "segment_number": 45
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "prodyadvidyudvilāsojjvalajaladajavair āpriyante kṣaṇena // Tss_11",
          "segment_number": 46
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "dānāṃbhaḥpūryamāṇobhayakaṭakaṭakālambirolambamālā-",
          "segment_number": 47
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "huṃkārāhūyamānapratigajajanitadveṣavahner dvipasya /",
          "segment_number": 48
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dantāntottuṅgadolātalatulitatanus tvām anusmṛtya mṛtyuṃ",
          "segment_number": 49
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pratyācaṣṭe prahṛṣṭaḥ pṛthuśikharaśiraḥkoṭikoṭṭopaviṣṭaḥ // Tss_12",
          "segment_number": 50
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "prauḍhaprāsaprahāraprahatanaraśiraḥśūlavallyutsavāyāṃ",
          "segment_number": 51
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śūnyāṭavyāṃ karāgragrahavilasadasisphoṭakasphītadarpān /",
          "segment_number": 52
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dasyūn dāsye niyuṅkte sabhṛkuṭīkuṭilabhrūkaṭākṣekṣitākṣāṃś",
          "segment_number": 53
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "cintālekhany akhinnasphuṭalikhitapadaṃ nāmadhāmaśriyāṃ te // Tss_13",
          "segment_number": 54
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vajrakrūraprahāraprakharaṇakhamukhotkhātamattebhakumbhaś",
          "segment_number": 55
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "cyotatsāndrāsradhautasphuṭavikaṭasaṭāsaṃkaṭaskandhasaṃdhiḥ /",
          "segment_number": 56
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "krudhyann āpitsur ārād upari mṛgaripus tīkṣṇadāṃṣṭrotkaṭāsyas",
          "segment_number": 57
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "trasyann āvṛtya yāti tvaducitaracitastotradugdhārthavācaḥ // Tss_14",
          "segment_number": 58
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "dhūmāvartāndhakārākṛtivikṛtiphaṇisphāraphūtkārapūra-",
          "segment_number": 59
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vyāpāravyāttavaktrasphuradururasanārajjukīnāśapāśaiḥ /",
          "segment_number": 60
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pāpāt saṃbhūya bhūyas tava guṇagaṇanā tatparas tvatparātmā",
          "segment_number": 61
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dhatte mattālimālāvalayakuvalayasragvibhūṣāṃ vibhūtiṃ // Tss_15",
          "segment_number": 62
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bhartṛbhrūbhedabhītodbhaṭakaṭakabhaṭākṛṣṭaduḥśliṣṭakeśaś",
          "segment_number": 63
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "cañcadvācāṭaceṭotkaṭaraṭitakaṭugranthipāśopagūḍhaḥ /",
          "segment_number": 64
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kṣuttṛṭkṣāmoṣṭhakaṇṭhas tyajati sa sapadi vyāpadaṃ tāṃ durantāṃ",
          "segment_number": 65
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yo yāyād āryātārācaraṇaśaraṇatāṃ snigdhavandhūjjhito 'pi // Tss_16",
          "segment_number": 66
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "māyānirmāṇakarmakramakṛtavikṛtānekanepathyamithyā-",
          "segment_number": 67
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "rūpārambhānurūpapraharaṇakiraṇāḍaṃbaroḍḍāmarāṇi /",
          "segment_number": 68
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tvattantroddhāryamantrasmṛtihṛtaduritasyā vahanty apradhṛṣyaṃ",
          "segment_number": 69
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pretaprotāntratantrīnicayaviracitasrāñji rakṣāṃsi rakṣāṃ // Tss_17",
          "segment_number": 70
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "garjajjīmūtamūrtitrimadamadanadībadhhadhārāndhakāre",
          "segment_number": 71
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vidyuddyotāyamānapraharaṇakiraṇe niṣpatadbāṇavarṣe /",
          "segment_number": 72
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ruddhaḥ saṃgrāmakāle prabalabhujabalair vidviṣadbhir dviṣadbhis",
          "segment_number": 73
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tvaddattotsāhapuṣṭiḥ prasabham arimahīm ekavīraḥ pinaṣṭi // Tss_18",
          "segment_number": 74
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pāpācārānubandhoddhatagadavigalatpūtipūyāsravisra-",
          "segment_number": 75
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tvaṅmāṃsāsaktanāḍīmukhakuharagalajjantujagdhakṣatāṅgāḥ /",
          "segment_number": 76
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yuṣmatpādopasevāgadavaraguṭikābhyāsabhaktiprasaktā",
          "segment_number": 77
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "jāyante jātarūpapratinidhivapuṣaḥ puṇḍarīkāyatākṣāḥ // Tss_19",
          "segment_number": 78
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "viśrāntaṃ śrotrapātre gurubhir upahṛtāṃ yāsya nāmnāyaṃ bhaikṣyaṃ",
          "segment_number": 79
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vidvadgoṣṭhīṣu yaś ca śrutadhanavirahān mūkatām abhyupaiti /",
          "segment_number": 80
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sarvālaṃkārabhūṣāvibhāvasamuditaṃ prāpya vāgīśvaratvaṃ",
          "segment_number": 81
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "so 'pi tvadbhaktiśaktyā harati nṛpasabhe vādisiṃhāsanāni // Tss_20",
          "segment_number": 82
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bhūśayyādhūlidhūmrasphuṭitakaṭakaṭīkarpaṭodghāṭitāṅgo",
          "segment_number": 83
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yūkāyuṃṣi prapiṃśan parapurapurataḥ karpare tarpaṇārthī /",
          "segment_number": 84
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tvām ārādhyādhyavasyanvarayuvativahaccāmarasmeracārvīm",
          "segment_number": 85
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "urvīṃ dhatte madāndhadvipadaśanaghanām uddhṛtaikātapatrāṃ // Tss_21",
          "segment_number": 86
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sevākarmāntaśilpāpraṇayavinimayopāyaparyāyakhinnaḥ",
          "segment_number": 87
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "prāgjanmopāttapuṇyopacitaśubhaphalaṃ vittam aprāpnuvantaḥ /",
          "segment_number": 88
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "daivātikrāmanīṃ tvāṃ kṛpaṇajanajanany artham abhyarthya bhūyo",
          "segment_number": 89
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhūmer nirvāntacāmīkaranikaranidhīn nirddhanā prāpnuvanti // Tss_22",
          "segment_number": 90
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vṛttichede vilakṣaḥ kṣatanivasanayā bhāryayā bhartsyamāno",
          "segment_number": 91
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dūrād ātmaṃbharitvāt svajanasutasuhṛdbandhubhir varjyamānaḥ /",
          "segment_number": 92
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tvayy āvedya svaduḥkhaṃ turagakhuramukhotkhātasīmnāṃ gṛhāṇām",
          "segment_number": 93
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "īṣṭe svāntaḥpurastrīvalayajhaṇajhaṇājātanidrāprabodhaḥ // Tss_23",
          "segment_number": 94
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "cakraṃdikcakracumbi sphuradurukiraṇā lakṣaṇālaṃkṛtāstrī",
          "segment_number": 95
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ṣaḍdanto dantimukhyaḥ śikhigalaruciraśyāmaromā varāśvaḥ /",
          "segment_number": 96
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhāsvadbhāsvanmayūkho maṇir amalaguṇaḥ koṣabhṛt pūrṇakoṣaḥ",
          "segment_number": 97
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "senānīr vīrasainyo bhavati bhagavati tvatprasādāṃśaleśāt // Tss_24",
          "segment_number": 98
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "svacchandaś candanāṃbhaḥsurabhimaṇiśilādattasaṃketakāntaḥ",
          "segment_number": 99
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kāntākrīḍānurāgād abhinavaracitātithyatathyopacāraḥ /",
          "segment_number": 100
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tvadvidyālabdhasiddhir malayamadhuvanaṃ yāti vidyādharendraḥ",
          "segment_number": 101
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "khaḍgāṃśuśyāmapīnonnatabhujaparigha prollasatpārihāryaḥ // Tss_25",
          "segment_number": 102
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "hārākrāntastanāntāḥ śravaṇakuvalayaspardhamānāyatākṣā",
          "segment_number": 103,
          "translated_text": "With breasts covered by necklaces, with wide eyes rivaling the blue lotuses at their ears,"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "mandārodāraveṇītaruṇaparimalāmoghamādyaddvirephāḥ /",
          "segment_number": 104,
          "translated_text": "With bees irresistibly intoxicated by the fresh fragrance of their generous braids adorned with <s>Mandāra</s> flowers,"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kācīnādānubandhoddhatataracaraṇodāramañjīratūryās",
          "segment_number": 105,
          "translated_text": "With beautiful ankle-bell music following the sound of their waist-chains, their feet raised ever higher—"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tvannāthaṃ prārthayante smaramadamuditāḥ sādarā devakanyāḥ // Tss_26",
          "segment_number": 106,
          "translated_text": "Divine maidens, delighted with the intoxication of <s>Smara</s> (love), respectfully court your lord. (verse 26)"
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ratnacchannāntavāpīkanakakamalinīvajrakiñjalkamālām",
          "segment_number": 107,
          "translated_text": "With pools concealed within, [bearing] garlands of golden lotuses with diamond filaments,"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "unmajjatpārijātadrumadhuramadhūddhūtadhūlīvitānām /",
          "segment_number": 108,
          "translated_text": "With canopies of pollen shaken by the sweet honey of emerging <s>Pārijāta</s> trees,"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vīṇāveṇupravīṇāmarapuraramaṇīdattamādhūryatūryāṃ",
          "segment_number": 109,
          "translated_text": "With sweet music provided by celestial city ladies skilled in <s>vīṇā</s> and flute—"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kṛtvāyuṣmatsaparyām anubhavati ciraṃ nandanodyānayātrām // Tss_27",
          "segment_number": 110,
          "translated_text": "Having performed your worship, one enjoys for long the excursion to the <s>Nandana</s> garden. (verse 27)"
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "karpūrailālavaṅgatvagagarunaladakṣogandhodakāyāṃ",
          "segment_number": 111,
          "translated_text": "In [the river] whose water is fragrant with camphor, cardamom, clove bark, <s>agaru</s>, and <s>nalada</s>,"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dāntākandarpadarpotkaṭakucakuharāvartaviśrāntavīcyām /",
          "segment_number": 112,
          "translated_text": "Whose waves rest in the whirlpool-like recesses of the proud, prominent breasts of subdued [beauties],"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "mandākinyām amandacchaṭasalilasaritkrīḍayā sundarībhiḥ",
          "segment_number": 113,
          "translated_text": "In the <s>Mandākinī</s>, with beautiful women playing in its abundantly splashing waters—"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "krīḍanti tvadgatāntaḥkaraṇapariṇatottaptapuṇyaprabhāvāḥ // Tss_28",
          "segment_number": 114,
          "translated_text": "Those whose power of merit has fully ripened through hearts devoted to you play [there]. (verse 28)"
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "gīrvāṇagrāmaṇībhir vinayabharanamanmaulibhir vanditājñaḥ",
          "segment_number": 115,
          "translated_text": "Whose commands are honored by the leaders of the gods with heads bowed deeply in reverence,"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "svargotsaṅge dhirūḍhaḥ surakariṇi raṇadbhūṣaṇodbhāsitāṅge /",
          "segment_number": 116,
          "translated_text": "Seated firmly in the lap of heaven, upon the divine elephant whose body gleams with jingling ornaments,"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śacyā dordāmadolāviralavalayitoddāmaromāñcamūrtiḥ",
          "segment_number": 117,
          "translated_text": "His body covered with abundant horripilation from being swung on the rope-swing of <s>Śacī</s>'s arms—"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pūtas tvaddṛṣṭipātair avati suramahīṃ hīrabhinnaprakoṣṭhaḥ // Tss_29",
          "segment_number": 118,
          "translated_text": "Purified by the falling of your gaze, with forearms adorned with diamond [bracelets], he protects the divine realm. (verse 29)"
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "cūḍāratnāvataṃsāsanagatasugatavyomalakṣmīvitānaṃ",
          "segment_number": 119,
          "translated_text": "With a canopy of the sky-splendor of <s>Sugatas</s> seated on thrones adorned with crest-jewel ornaments,"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "prodyadbālārkakoṭipaṭutarakiraṇāpūryamānatrilokam /",
          "segment_number": 120,
          "translated_text": "Filling the three worlds with rays sharper than millions of rising young suns,"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "prauḍhālīḍhaikapadaṃ kramabharavinamadbrahmarudrendraviṣṇu",
          "segment_number": 121,
          "translated_text": "With one foot in the mature <s>ālīḍha</s> posture, before which <s>Brahmā</s>, <s>Rudra</s>, <s>Indra</s>, and <s>Viṣṇu</s> bow under the weight of your steps—"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tvadrūpaṃ bhāvyamānaṃ bhavati bhavabhayocchittaye janmabhājām // Tss_30",
          "segment_number": 122,
          "translated_text": "Your form, when meditated upon, becomes the destroyer of the fear of existence for those who have taken birth. (verse 30)"
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "paśyanty eke sakopaṃ praharaṇakiraṇodgūrṇadordaṇḍakhaṇḍa-",
          "segment_number": 123,
          "translated_text": "Some see [your form as] wrathful, with arm-branches swirling with rays of weapons,"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vyāptavyomāntarālaṃ valayaphaṇiphaṇādāruṇāhāryacaryām /",
          "segment_number": 124,
          "translated_text": "Pervading the expanse of the sky, with terrible conduct adorned by serpent-hood bracelets,"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dviṣṭavyuttrāsihāsoḍḍamaraḍamarukoḍḍāmarāsphālavelā-",
          "segment_number": 125,
          "translated_text": "With frightening laughter that terrifies enemies, with the <s>ḍamaru</s> drum of the <s>Ḍāmara</s> rite, with the beating of the <s>ḍāmara</s>—"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vetālottālatālapramadamadamahākelikolāhalogram // Tss_31",
          "segment_number": 126,
          "translated_text": "Fierce with the tumult of the great sport of intoxicated delight with the rhythm of rising <s>vetālas</s>. (verse 31)"
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kecit tv ekaikaromodgamagatagagaṇābhogabhūbhūtalastha-",
          "segment_number": 127,
          "translated_text": "But some [see you] as having, in the expanse of sky entered through each rising hair-pore, upon each level of earth,"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "svasthabrahmendrarudraprabhṛtinaramarutsiddhagandharvanāgam /",
          "segment_number": 128,
          "translated_text": "<s>Brahmā</s>, <s>Indra</s>, <s>Rudra</s> and other beings — humans, wind-gods, <s>Siddhas</s>, <s>Gandharvas</s>, and <s>Nāgas</s> — established,"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dikcakrākrāmidhāmasthitasugataśatānantanirmāṇacitram",
          "segment_number": 129,
          "translated_text": "Adorned with the wonderful emanations of hundreds of <s>Sugatas</s> established with splendor pervading the circle of directions—"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "citraṃ trailokyavandyaṃ sthiracararacitāśeṣabhāvasvabhāvam // Tss_32",
          "segment_number": 130,
          "translated_text": "Wondrous, worshipped by the three worlds, having the nature of all beings composed of the moving and the still. (verse 32)"
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "lākṣāsindūrarāgāruṇatarakiraṇādityalauhityam eke",
          "segment_number": 131,
          "translated_text": "Some [see it as] red like the sun with rays reddened by the color of lac and <s>sindūra</s>;"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śrīmatsāndrendranīlopaladaladalitakṣodanīlaṃ tathānye /",
          "segment_number": 132,
          "translated_text": "Others [see it as] blue like the powder ground from glorious dense sapphire leaves;"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kṣīrābdhikṣubdhadugdhādhikataradhavalaṃ kāñcanābhaṃ ca kecit",
          "segment_number": 133,
          "translated_text": "Some [see it as] whiter than the churned milk of the ocean of milk, and some as golden—"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tvadrūpaṃ viśvarūpaṃ sphaṭikavad upadhāyuktibhedād vibhinnam // Tss_33",
          "segment_number": 134,
          "translated_text": "Your form is the universal form, appearing differently like crystal according to differences in the method of approach. (verse 33)"
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sārvajñajñānadīpaprakaṭitasakalajñeyatattvaikasākṣī",
          "segment_number": 135,
          "translated_text": "The sole witness of all knowable realities revealed by the lamp of omniscient knowledge"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sākṣād vetti tvadīyaṃ guṇagaṇagaṇanāṃ sarvavit tatsuto vā /",
          "segment_number": 136,
          "translated_text": "Directly knows the enumeration of the multitudes of your qualities — the all-knowing one or his son."
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yat tu vyādāya vaktraṃ valibhujaraṭitaṃ mādṛśo raṭīti",
          "segment_number": 137,
          "translated_text": "But that one like me opens his wrinkled, wizened mouth and babbles—"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vyāpat sā tīvraduḥkhajvarajanitarujaścetaso hāsyahetuḥ // Tss_34",
          "segment_number": 138,
          "translated_text": "That effort, born from the pain of the fever of intense suffering, is a cause for laughter. (verse 34)"
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yan me vijñapsyamānaṃ prathamataram adas tvaṃ viśeṣeṇa vettrī",
          "segment_number": 139,
          "translated_text": "What I am about to express, you already know first and foremost, O especially discerning one;"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tvadvyāhārātirekaśramavidhir abudhasvāntasaṃtoṣahetuḥ /",
          "segment_number": 140,
          "translated_text": "The effort of speaking beyond [your knowledge] is a cause of satisfaction for the foolish heart."
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kiṃ tu snigdhasya bandhor viṣaṃ iva purato duḥkham udgīrya vācā",
          "segment_number": 141,
          "translated_text": "But like vomiting poison before a loving friend, having poured forth suffering in words,"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "jñātārthasyāpi duḥkhī hṛdayalaghutayā svasthatāṃ vindatīva // Tss_35",
          "segment_number": 142,
          "translated_text": "Even the sufferer who knows the matter finds well-being, as it were, through the lightening of the heart. (verse 35)"
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kalyāṇānandasindhuprakaṭaśaśikale śītalāṃ dehi dṛṣṭiṃ",
          "segment_number": 143,
          "translated_text": "O crescent moon manifest in the ocean of auspicious bliss, bestow your cool gaze!"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "puṣṭiṃ jñānopadeśaiḥ kuru ghanakaruṇe dhvaṃsaya dhvāntamantaḥ /",
          "segment_number": 144,
          "translated_text": "Nourish [me] with teachings of knowledge, O deeply compassionate one; destroy the inner darkness!"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tvatstotrāṃbhaḥpavitrīkṛtamanasi mayi śreyasaḥ sthānam ekaṃ",
          "segment_number": 145,
          "translated_text": "In me, whose mind is purified by the waters of your hymn, [may there be] the sole abode of welfare,"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dṛṣṭaṃ yasmād amoghaṃ jagati tava guṇastotramātraṃ prajānām // Tss_36",
          "segment_number": 146,
          "translated_text": "For it is seen that the mere hymn of your qualities is never fruitless for beings in the world. (verse 36)"
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "saṃstutya tvadguṇaughāvayavam aniyateyattam āptaṃ mayā yat /",
          "segment_number": 147,
          "translated_text": "Having praised even a portion of the flood of your qualities, of unlimited extent, whatever merit has been obtained by me,"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "puṇyaṃ puṇyāhavāñchāphalamadhurarasāsvādam āmuktibhogyam /",
          "segment_number": 148,
          "translated_text": "That merit, whose sweet taste is the fruit of the desire for auspicious days, is to be enjoyed until liberation—"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "lokas tenāryalokeśvaracaraṇatalasvastikasvasticihnām",
          "segment_number": 149,
          "translated_text": "By that merit, may the world proceed to that land marked with the auspicious <s>svastika</s> signs on the soles of noble <s>Lokeśvara</s>'s feet,"
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ahnāyāyaṃ prayāyāt sugatasutamahīṃ tāṃ sukhāvatyupākhyām // Tss_37",
          "segment_number": 150,
          "translated_text": "Day by day, to that land of the son of the <s>Sugata</s>, called <s>Sukhāvatī</s> (the Blissful). (verse 37)"
        }
      ]
    }
  ]
}