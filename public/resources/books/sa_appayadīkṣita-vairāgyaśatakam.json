  },
  "body": [
    {
      "tag": "p",
      "attributes": {},
      "text": "śrīmadappayadīkṣitaviracitaṃ vairāgyaśatakam /",
      "segment_number": 1
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "āste kaścana bhikṣuḥ saṃgṛhṇannavyayāni daśa /",
          "segment_number": 2
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "na mametyavyayayugalaṃ yācāmastaṃ kimastyanyat // AppVs_1 //",
          "segment_number": 3
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "dhīsacivaṃ dhairyabalaṃ saṃkalpavirodhi śāntidhanam /",
          "segment_number": 4
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "viśvatrayaviṣayamidaṃ vairāgyaṃ nāma sāmrājyam // AppVs_2 //",
          "segment_number": 5
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "rājño bibheti loko rājānaḥ punarito 'pi vairibhyaḥ /",
          "segment_number": 6
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ā brahmaṇaḥ kṛtāntādakutobhayamaspṛhārājyam // AppVs_3 //",
          "segment_number": 7
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bhikṣāpradā jananyaḥ pitaro guravaḥ kumārakāḥ śiṣyāḥ /",
          "segment_number": 8
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ekāntaramaṇahetuḥ śāntirdayitā viraktasya // AppVs_4 //",
          "segment_number": 9
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ye na kimapi ceṣṭante kāryapratikaryayorvirahāt /",
          "segment_number": 10
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "santasta eva muktāḥ saṃdehe gautamaḥ sākṣī // AppVs_5 //",
          "segment_number": 11
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "patatu nabhaḥ sphuṭatu mahī calantu girayo milantu vāridhayaḥ /",
          "segment_number": 12
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "adharottaramastu jagatkā hānirvītarāgasya // AppVs_6 //",
          "segment_number": 13
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ke corāḥ ke piśunāha ke ripavaḥ ke 'pi dāyādāḥ /",
          "segment_number": 14
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "jagadakhilaṃ tasya vaśe yasya vaśe syādidaṃ cetaḥ // AppVs_7 //",
          "segment_number": 15
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "viṣayā upatiṣṭhantāṃ viṣayairvā samavayantu karaṇāni /",
          "segment_number": 16
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "āntaramekaṃ karaṇaṃ śāntaṃ yadi kā tataścintā // AppVs_8 //",
          "segment_number": 17
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kiṃ viṣayānparihartuṃ vastavyaṃ merukaṃdareṣvabudhaiḥ /",
          "segment_number": 18
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nahyadbhiranāsektuṃ dhātuṣu rohanti padmāni // AppVs_9 //",
          "segment_number": 19
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ajñānamiha nidānaṃ prāgrūpaṃ jananameva bhavaroge /",
          "segment_number": 20
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "paripākaḥ saṃsaraṇaṃ bhaiṣajyaṃ naiṣṭhikī śāntiḥ // AppVs_10 //",
          "segment_number": 21
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "svenopabhuktamarthaṃ sūkarajātismaro manuṣya iva /",
          "segment_number": 22
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dūre jugupsamāno dhīro vairāgyamadriyate // AppVs_11 //",
          "segment_number": 23
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "śaiśavamiva kaumāre tattaruṇimnīva sa iva vṛddhatve /",
          "segment_number": 24
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "na svadate dhīrāṇāṃ kāmasya viceṣṭitaṃ śāntau // AppVs_12 //",
          "segment_number": 25
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "śataśaḥ parīkṣya viṣayānsadyo jahati kvacitkvaciddhavyāḥ /",
          "segment_number": 26
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kākā iva vāntāśanamanye tāneva sevante // AppVs_13 //",
          "segment_number": 27
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "caramau mātāpitarau caramā gṛhiṇī sutāścaramāḥ /",
          "segment_number": 28
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kartavye 'pi premaṇi kathamiha dhīrā virajyante // AppVs_14 //",
          "segment_number": 29
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tṛṇavadbhramanti capalāḥ strīnāmani caṇḍamārute calati /",
          "segment_number": 30
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dharaṇidharā iva santastatra na kiṃcitprakampante // AppVs_15 //",
          "segment_number": 31
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kāmijanaparamabhogye kāmasukhe dhārayanti bībhatsam /",
          "segment_number": 32
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "santaḥ śamasukharasikāḥ sudhāśanāḥ sūkarānna iva // AppVs_16 //",
          "segment_number": 33
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vikṣepamātrabhājo vikāsakāṣṭāgatajñānāḥ /",
          "segment_number": 34
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "svasyāpi ceṣṭitāni svayamīkṣante parasyeva // AppVs_17 //",
          "segment_number": 35
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "asthāne 'bhiniviṣṭānmūrkhānasthāna eva saṃtuṣṭān /",
          "segment_number": 36
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "anuvartante dhīrāḥ pitara iva krīḍato bālān // AppVs_18 //",
          "segment_number": 37
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "puṣṇati puruṣe salilairmuṣṇati puṣpaṃ phalaṃ ca tarava iva /",
          "segment_number": 38
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vartante santaḥ samamupakartari cāpakartari ca // AppVs_19 //",
          "segment_number": 39
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nityānityavivekaḥ sarveṣāṃ ghaṭaghaṭatvayorāste /",
          "segment_number": 40
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sa viveko yaḥ śāntikṛdaviveko 'nyaḥ samasto 'pi // AppVs_20 //",
          "segment_number": 41
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "anadhigate kāmasukhe kālena yathā pravartate taruṇaḥ /",
          "segment_number": 42
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "evaṃ brahmasukhe 'pi pravartate ko 'pi bhāgyavaśāt // AppVs_21 //",
          "segment_number": 43
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "putraguṇāḥ svātantrye dāraguṇāścādhivedanāvasare /",
          "segment_number": 44
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhrātṛguṇā dāyavidhau draṣṭavyā mokṣyamāṇena // AppVs_22 //",
          "segment_number": 45
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kā me gatiriti pṛcchati caramaśvāse 'pi yaḥ svārtham /",
          "segment_number": 46
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tasya janasyāpi kṛte pāpāḥ pāpāni kurvanti // AppVs_23 //",
          "segment_number": 47
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pitṛbhiḥ kalahāyante putrānadhyāpayanti pitṛbhaktim /",
          "segment_number": 48
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "paradārānupayantaḥ paṭhanti śāstrāṇi dāreṣu // AppVs_24 //",
          "segment_number": 49
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "śāntiralabhyāduparatirapātrabhāvaḥ pratigrahanivṛttiḥ /",
          "segment_number": 50
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kṣāntirdurbalateti ca nivṛttidharmāḥ kalāvete // AppVs_25 //",
          "segment_number": 51
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nītijñā niyatijñā vedajñā api bhavanti śāstrajñāḥ /",
          "segment_number": 52
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "brahmajñā api labhyāḥ svājñānajñānino viralāḥ // AppVs_26 //",
          "segment_number": 53
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kalikaluṣe manasi sve kathamiva jagadārjavaṃ labhate /",
          "segment_number": 54
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "cakṣurdoṣe jāgrati candradvitvaṃ kuto yātu // AppVs_27 //",
          "segment_number": 55
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "viṣayānanukūlayituṃ viṣayiṇi hṛdaye vidhīyatāṃ yatnaḥ /",
          "segment_number": 56
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dṛśi deyamauṣadhaṃ ko dṛśye dattvā sukhī bhavati // AppVs_28 //",
          "segment_number": 57
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "dārāḥ putreṣu ratāḥ putrāḥ pitṛdhanaparigrahavyagrāḥ /",
          "segment_number": 58
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "rodanaśaraṇā jananī paralokagatasya ko bandhuḥ // AppVs_29 //",
          "segment_number": 59
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "paśyanti mriyamāṇānmariṣyato 'numimate smaranti mṛtān /",
          "segment_number": 60
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kathayante caivamasacceṣṭante nityavattu param // AppVs_30 //",
          "segment_number": 61
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kalahāyante mūḍhāḥ kaḥ pratibhūḥ śvaḥ prabhāta iti /",
          "segment_number": 62
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tasyāmeva rajanyāṃ kaḥ pratibhūḥ svasya sattāyām // AppVs_31 //",
          "segment_number": 63
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kulyāḥ kṛtā viśālāḥ kuḍyānyupalairnibaddhāni /",
          "segment_number": 64
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "krītā balino mahipāḥ kṛtakṛtyāḥ sma iti manyante // AppVs_32 //",
          "segment_number": 65
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ā prapadamā śiraskaṃ cāntaḥ kalimalamalīmase vapuṣi /",
          "segment_number": 66
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "viphalaṃ gaṅgājalamapi madyaghaṭe darbhamuṣṭiriva // AppVs_33 //",
          "segment_number": 67
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "daṇḍyaṃ yatsukhahetoḥ puṣṇanti janāḥ kathaṃ tadeva vapuḥ /",
          "segment_number": 68
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nahi śarkarābhilāṣibhirikṣoḥ kāṇḍāni pūjyante // AppVs_34 //",
          "segment_number": 69
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "prāyo muhyati cetaḥ prāṇabhṛtaḥ prāṇanirgamāvasare /",
          "segment_number": 70
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "puṇyena yadi na muhyati putrāneva smaranmriyate // AppVs_35 //",
          "segment_number": 71
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "śamayitumaudaramagniṃ saṃsārākhyāmbudhau nimajjanti /",
          "segment_number": 72
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tuhinavyathānivṛttyai nahi veśmani pāvako deyaḥ // AppVs_36 //",
          "segment_number": 73
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "āhṛtya parityaktā janayantyarthāḥ sukhābhāsam /",
          "segment_number": 74
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "atyantaparityaktāḥ paramānandāya kalpante // AppVs_37 //",
          "segment_number": 75
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "arthānāmadhikānāṃ rājñā caureṇa vā nāśaḥ /",
          "segment_number": 76
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "anne khalvatimukte vamanaṃ vā syādvireko vā // AppVs_38 //",
          "segment_number": 77
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "praṇamati parisāntvayati[praṇi]patati sadā paribhramati /",
          "segment_number": 78
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "āviṣṭa iva piśācyā puruṣastṛṣṇāvaśaṃ yātaḥ // AppVs_39 //",
          "segment_number": 79
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "jananādṛṣṭātpitarau putrā jāmātaro 'pyayādṛṣṭāt /",
          "segment_number": 80
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kalahādṛṣṭājjñātaya iti nirṇīte kimeṣṭavyam // AppVs_40 //",
          "segment_number": 81
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "svapituḥ paralokāya svayamanudivasaṃ yadācarati /",
          "segment_number": 82
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kriyatāmidamupamānaṃ kiṃ nālaṃ putravairāgye // AppVs_41 //",
          "segment_number": 83
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ananugate dāridrye kimanugataṃ lakṣaṇaṃ dṛṣṭam /",
          "segment_number": 84
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kāmasyāpūrtiryadi kṛpaṇaṃ jagadā caturvadanāt // AppVs_42 //",
          "segment_number": 85
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "na khalu dhanatvaṃ jātiryasya yadiṣṭaṃ tadeva tasya dhanam /",
          "segment_number": 86
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tattadiva pāmarāṇāmākiṃcanyaṃ dhanaṃ viduṣām // AppVs_43 //",
          "segment_number": 87
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "svīkriyate yadi tṛṣṇā svīkartavyaṃ jagatsamastamapi /",
          "segment_number": 88
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "svīkriyate yadi śāntiḥ svātmāpi svasya bhavati na vā // AppVs_44 //",
          "segment_number": 89
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yaddātāraṃ vaśayati yatparijanamasya sāntvayati /",
          "segment_number": 90
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yadapatrapate nāntarbhāvālābhaḥ sa kasya samaḥ // AppVs_45 //",
          "segment_number": 91
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "prādeśamātramudaraṃ paripūrayituṃ kiyānayaṃ yatnaḥ /",
          "segment_number": 92
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "culakenāmbhaḥ pātuṃ svanitavyaḥ kiṃ taṭāko 'pi // AppVs_46 //",
          "segment_number": 93
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yāmārdhamasaṃskārādyāmadvayamanaśanācca suvyakte /",
          "segment_number": 94
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śārīre saundarye 'pyabhiniviśante kiyanmūḍhāḥ // AppVs_47 //",
          "segment_number": 95
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vandhyetyāhustaruṇīṃ jaratīti parityajanti bahuputrām /",
          "segment_number": 96
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "abhinindantyalpasutāṃ kā gṛhiṇī kāmino hṛdyā // AppVs_48 //",
          "segment_number": 97
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yānti śucamakṛtadārā dve bhārye neti kṛtadārāḥ /",
          "segment_number": 98
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "te paradārā neti strībhistṛptānna paśyāmaḥ // AppVs_49 //",
          "segment_number": 99
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "madanasyājñākaraṇe manye jagadakhilamekarūpamidam /",
          "segment_number": 100
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tiryañca iti narā iti devā ityanyato bhedaḥ // AppVs_50 //",
          "segment_number": 101
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "śukravimokasthānaṃ malamūtratyāgadeśavatkimapi /",
          "segment_number": 102
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "striya iti vihitaṃ vidhinā kiyadatra janā nimajjanti // AppVs_51 //",
          "segment_number": 103
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vedānadhītya vidhivanmīmāṃsitvā tadarthaṃ ca /",
          "segment_number": 104
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dārāḥ kartavyā iti kenedaṃ prahasanaṃ kathitam // AppVs_52 //",
          "segment_number": 105
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "duḥkhenopārjyante pālyante pratyahaṃ ca lālyante /",
          "segment_number": 106
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vāmāḥ striyo vimūḍhairupabhuñjānāḥ sukhaṃ viguṇam // AppVs_53 //",
          "segment_number": 107
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "aśnīta pibata svādata jāgrata saṃviśata tiṣṭhata vā /",
          "segment_number": 108
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sakṛdapi cintayatāhnaḥ sāvadhiko dehabandha iti // AppVs_54 //",
          "segment_number": 109
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kiṃ vijitayā pṛthivyā kiṃ kāñcanabhūbhṛtā karasthena /",
          "segment_number": 110
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kiṃ divyābhiḥ strībhirmartavye brahmaṇā likhite // AppVs_55 //",
          "segment_number": 111
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "jīvati katicinnimiṣānkaticitteṣu śrutīradhīta iva /",
          "segment_number": 112
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tāvatsaivākulayati tantrāṇi navāni cātanute // AppVs_56 //",
          "segment_number": 113
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "svalpo jīvanakālaḥ svalpā dhīḥ paricayaḥ svalpaḥ /",
          "segment_number": 114
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tadapi tarema kathaṃcicchrutayo yadi nopajāyante // AppVs_57 //",
          "segment_number": 115
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kuta āgataṃ na jāne kva nu vā gantavyamidamapi na jāne /",
          "segment_number": 116
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "saṃcarasi kvedānīṃ saṃsārapathe mahātamasi // AppVs_58 //",
          "segment_number": 117
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tamasāvṛttāścarantaḥ savidhe dūre ca nāvayantyarthān /",
          "segment_number": 118
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "avayanti tu vispaṣṭaṃ taḍitābhihate śirasi mūḍhāḥ // AppVs_59 //",
          "segment_number": 119
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nimiṣantyatra taruṇyastatra taruṇyo na nimiṣanti /",
          "segment_number": 120
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "īdṛkṣo hi viśeṣaḥ svargaḥ svarga iti kiṃ tatra // AppVs_60 //",
          "segment_number": 121
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kopo maitrāvaruṇeḥ śāpo vā tārkikasya muneḥ /",
          "segment_number": 122
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "saṃsmaryate yadi sakṛcchatrorapi māstu śakrapadam // AppVs_61 //",
          "segment_number": 123
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "gacchatyamarāvatyāṃ gacchatu caturānanasya vā nagare /",
          "segment_number": 124
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "punarāgantavyaṃ yadi puṃsā kiṃ sādhitaṃ bhavati // AppVs_62 //",
          "segment_number": 125
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bhuktā bahavo dārā labdhāḥ putrāśca pautrāśca /",
          "segment_number": 126
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nītaṃ śatamapyāyuḥ satyaṃ vada martumasti manaḥ // AppVs_63 //",
          "segment_number": 127
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "viśleṣaṇasvabhāvānpaśyanviṣayānkaroti ko mamatām /",
          "segment_number": 128
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "naśyadavasthāpannaṃ kaḥ krīṇīte dhanairaśvam // AppVs_64 //",
          "segment_number": 129
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "annābhāve mṛtyuḥ śālibhirannāni śālayo vṛṣṭyā /",
          "segment_number": 130
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vṛṣṭistapaseti vadannamṛtyave tattapaścaratu // AppVs_65 //",
          "segment_number": 131
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kiṃ na nigṛhṇanti manaḥ kiṃ na bhajante janāḥ śivaṃ śaraṇam /",
          "segment_number": 132
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "abhisaṃdhibhedamātrānmokṣopāye na badhyante // AppVs_66 //",
          "segment_number": 133
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bhogāya pāmarāṇāṃ yogāya vivekināṃ śarīramidam /",
          "segment_number": 134
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhogāya ca yogāya ca na kalpate durvidagdhānām // AppVs_67 //",
          "segment_number": 135
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "brāhmaṇacaṇḍālā ityāha muniryanmahāpathikān /",
          "segment_number": 136
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhavamārgamahāpathikānadhikṛtyaiva pravartitaṃ caitat // AppVs_68 //",
          "segment_number": 137
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ekadvāḥ kṣitipatiṣu dvitrā deveṣu pañcaṣā druhiṇe /",
          "segment_number": 138
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "etāvanto jagati brahmānandārṇavasya kaṇāḥ // AppVs_69 //",
          "segment_number": 139
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ajñānenāpihite vijñāne karma kiṃ kurute /",
          "segment_number": 140
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vikale cakṣuṣi tamasā vyādāya mukhaṃ kimīkṣeta // AppVs_70 //",
          "segment_number": 141
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atikaluṣamāśunaśvaramāpātasphuraṇamanabhilāṣakaram /",
          "segment_number": 142
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "api hṛṣyanti janāḥ kathamavalambya jñānakhadyotam // AppVs_71 //",
          "segment_number": 143
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ayutaṃ niyutaṃ vāpi pradiśantu prākṛtāya bhogāya /",
          "segment_number": 144
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "krīṇanti na bilvadalaiḥ kaivalyaṃ pañcaṣairmūḍhāḥ // AppVs_72 //",
          "segment_number": 145
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yāvatkila ceṣṭante tāvatpāśe nibadhyate granthiḥ /",
          "segment_number": 146
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nibhṛtaṃ yadi vartante kālena sraṃsate pāśaḥ // AppVs_73 //",
          "segment_number": 147
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "uparundhanti śvāsānmunayo nāśnanti na pibanti /",
          "segment_number": 148
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "stūyante sujanaiḥ kiṃ kaṇṭhe kurvanti kanakapāśamime // AppVs_74 //",
          "segment_number": 149
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kāmaṃ janāḥ smayante kailāsavilāsavarṇanāvasare /",
          "segment_number": 150
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sādhanakathanāvasare sācīkurvanti vaktrāṇi // AppVs_75 //",
          "segment_number": 151
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vaṅgāḥ kathamaṅgāḥ kathamityanuyuṅkte vṛthā deśān /",
          "segment_number": 152
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kīdṛkkṛtāntapuramiti ko 'pi na jijñāsate lokaḥ // AppVs_76 //",
          "segment_number": 153
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tyaktavyo mamakārastyaktuṃ yadi śakyate nāsau /",
          "segment_number": 154
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kartavyo mamakāraḥ kiṃ tu sa sarvatra kartavyaḥ // AppVs_77 //",
          "segment_number": 155
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "putrā iti dārā iti poṣyānmūrkho janānbrūte /",
          "segment_number": 156
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "andhe tamasi nimajjannātmā poṣya iti nāvaiti // AppVs_78 //",
          "segment_number": 157
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yaccintitamadhigarbhaṃ yacca ciraṃ cintitaṃ narake /",
          "segment_number": 158
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "viṣayānilasaṃsargānmamṛje tatsarvamekapade // AppVs_79 //",
          "segment_number": 159
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bāhyagatāgataśīlā prāṇasya śvāsalakṣaṇā vṛttiḥ /",
          "segment_number": 160
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "karṣati manaso vṛttiṃ kulaṭeva kulastriyaṃ mugdhām // AppVs_80 //",
          "segment_number": 161
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "atigambhīramanāvilamakṣobhyamadṛṣṭapāramavilaṅghyam /",
          "segment_number": 162
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "aviralataraṅgasaṃkulamaikṣiṣi vijñānasāgaraṃ mahatām // AppVs_81 //",
          "segment_number": 163
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "ghoraṃ bhavamapahātuṃ kecidaghoraṃ prapadyante /",
          "segment_number": 164
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "saṃsaraṇakātarāṇāṃ saṃśaraṇaṃ śāṃbhavī śaktiḥ // AppVs_82 //",
          "segment_number": 165
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pāśo yadi moktavyaḥ paśupatirevopasartavyaḥ /",
          "segment_number": 166
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "na khalu vyatimucyante paśavaḥ pāśena saṃbaddhāḥ // AppVs_83 //",
          "segment_number": 167
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "alamalamanubhūtābhirmātṛbhiralamastu pitṛbhiśca /",
          "segment_number": 168
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhavitavyaṃ yadi nityavadarthaṃ mātuḥ pituścāstu // AppVs_84 //",
          "segment_number": 169
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "dhanyāste bahudevāḥ svāmini yeṣāṃ na durbhikṣam /",
          "segment_number": 170
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "jātu na jānīmo vayamekaṃ taṃ svāminaṃ pūrṇam // AppVs_85 //",
          "segment_number": 171
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "santu bṛhanto devāḥ kiṃ tu na tānnantumīhate cetaḥ /",
          "segment_number": 172
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "āḍhyavadānyanyāyādantakajitameva cintayenmanasi // AppVs_86 //",
          "segment_number": 173
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "nidhyāyasi viṣayasukhaṃ na dhyāyasi viṣamamasya paripākam /",
          "segment_number": 174
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bandhuṃ tameva cintaya baddhuṃ moktuṃ ca yaḥ kṣamate // AppVs_87 //",
          "segment_number": 175
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sadanaṃ gurūpasadanaṃ śaraṇaṃ pañcākṣarīpuraścaraṇam /",
          "segment_number": 176
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dhanamabhilāṣanirodhanamantyāśramavartināṃ puṃsām // AppVs_88 //",
          "segment_number": 177
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kau pitarau kaḥ putraḥ kaḥ svāmī yaḥ prapañcasya /",
          "segment_number": 178
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pratyastamite bhede kimidaṃ kimidamiti vipraśnaḥ // AppVs_89 //",
          "segment_number": 179
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sa vidhiryatte vidadhati sa pratiṣedho yato nivartante /",
          "segment_number": 180
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sopaniṣadyadbruvate śaivāśravamartino dhīrāḥ // AppVs_90 //",
          "segment_number": 181
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tyaja saṃsāramasāraṃ bhaja śaraṇaṃ pārvatīramaṇam /",
          "segment_number": 182
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "viśvasihi śrutiśikharaṃ viśvamidaṃ tava nideśakaram // AppVs_91 //",
          "segment_number": 183
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bhavyamabhavyaṃ vā naḥ pralikhatu vedhāḥ sudurmedhāḥ /",
          "segment_number": 184
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "savyamasavyaṃ vā naḥ śaraṇaṃ caraṇaṃ maheśasya // AppVs_92 //",
          "segment_number": 185
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vedhāḥ kathaṃ hariḥ kathamiti tu praśne vayaṃ mūkāḥ /",
          "segment_number": 186
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śivamekaṃ jānīmo na śivādanyaṃ vijānīmaḥ // AppVs_93 //",
          "segment_number": 187
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "dāruṇamasipattravanaṃ dāruṇatamamandhatāmisram /",
          "segment_number": 188
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kā vā tataḥ kṣatirnaḥ śaivā vayamā caturvadanāt // AppVs_94 //",
          "segment_number": 189
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kṛtadīkṣo ghoramakhe kulakūṭastho bharadvājaḥ /",
          "segment_number": 190
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vidyeśvareṣu kaścana pitāmaho na iti visrambhaḥ // AppVs_95 //",
          "segment_number": 191
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kalahaḥ kadāpi māstviti kalitaśarīraikyayoḥ śivayoḥ /",
          "segment_number": 192
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ahamasmyahamasmīti prāptaḥ kalaho mama trāṇe // AppVs_96 //",
          "segment_number": 193
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "narakāyāpi na bhogānnarādhamāyāpi nānyasurān /",
          "segment_number": 194
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "manyante katicidamī māheśvaramāśritā yogam // AppVs_97 //",
          "segment_number": 195
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "jñātuṃ hātuṃ viṣayaṃ śrotuṃ mantuṃ gṛhītumātmānam /",
          "segment_number": 196
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vatsā yadi na hi ghaṭate tatsādhayatāvimuktāya // AppVs_98 //",
          "segment_number": 197
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sāṃkhyaṃ yogaṃ nigamā bhaktiḥ karma pratītiriti /",
          "segment_number": 198
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ekatra sakalametatkevalamavimuktamekatra // AppVs_99 //",
          "segment_number": 199
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "baddhaḥ kaste vakṣyati mukto muktiṃ vijānāti /",
          "segment_number": 200
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yāsyasi cedavimuktaṃ jñāsyasi viśveśvarasya mukhāt // AppVs_100 //",
          "segment_number": 201
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "na gṛhītaṃ śrutihṛdayaṃ na ca na gṛhītaṃ pariplavaṃ hṛdayam /",
          "segment_number": 202
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "icchāmi ca dhāma paraṃ gacchāmi tu viśvanāthapurīm // AppVs_101 //",
          "segment_number": 203
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "iti śrīmadappayadīkṣitaviracitaṃ vairāgyaśatakaṃ saṃpūrṇam /",
      "segment_number": 204
    }
  ]
}