    {
      "tag": "h3",
      "attributes": {
        "rend": "bold"
      },
      "text": "mahāyānasaṁgraha",
      "segment_number": 17
    },
    {
      "tag": "h4",
      "attributes": {
        "rend": "bold"
      },
      "text": "prastāvanā 1",
      "segment_number": 18
    },
    {
      "tag": "",
      "attributes": {},
      "text": "abhidharmamāhāyānasūtre bhagavatpurastān mahāyā-",
      "segment_number": 19
    },
    {
      "tag": "",
      "attributes": {},
      "text": "nasupraviṣṭabodhisattvena mahāyānamāhātmyodbhāvanār-",
      "segment_number": 20
    },
    {
      "tag": "",
      "attributes": {},
      "text": "tham uktaṁ yad uta mahāyānam ārabhya buddhabhagava-",
      "segment_number": 21
    },
    {
      "tag": "",
      "attributes": {},
      "text": "tāṁ daśaprakāraviśeṣaviśiṣṭavacanam|",
      "segment_number": 22
    },
    {
      "tag": "h4",
      "attributes": {
        "rend": "bold"
      },
      "text": "prastāvanā 2",
      "segment_number": 23
    },
    {
      "tag": "",
      "attributes": {},
      "text": "(1)",
      "segment_number": 24
    },
    {
      "tag": "",
      "attributes": {},
      "text": "yad uta buddhabhagavatāṁ (1) jñeyāśrayaviśeṣaviśiṣṭava-",
      "segment_number": 25
    },
    {
      "tag": "",
      "attributes": {},
      "text": "canam| (2) jñeyalakṣaṇaviśeṣaviśiṣṭavacanam| (3) jñeya-",
      "segment_number": 26
    },
    {
      "tag": "",
      "attributes": {},
      "text": "lakṣaṇapraveśaviśeṣaviśiṣṭavacanam| (4) tatpraveśahetu-",
      "segment_number": 27
    },
    {
      "tag": "",
      "attributes": {},
      "text": "phalaviśeṣaviśiṣṭavacanam| (5) taddhetuphalabhāvanāpra-",
      "segment_number": 28
    },
    {
      "tag": "",
      "attributes": {},
      "text": "bhedaviśeṣaviśiṣṭavacanam| (6) tatraiva bhāvanāprabhede",
      "segment_number": 29
    },
    {
      "tag": "",
      "attributes": {},
      "text": "'dhiśīlaviśeṣaviśiṣṭavacanam| (7) adhicittaviśeṣaviśiṣṭavaca-",
      "segment_number": 30
    },
    {
      "tag": "",
      "attributes": {},
      "text": "nam| (8) adhiprajñāviśeṣaviśiṣṭavacanam| (9) tatphalapra-",
      "segment_number": 31
    },
    {
      "tag": "",
      "attributes": {},
      "text": "hāṇaviśeṣaviśiṣṭavacanam| (10) tatphalajñānaviśeṣaviśiṣṭa-",
      "segment_number": 32
    },
    {
      "tag": "",
      "attributes": {},
      "text": "vacanaṁ ca|",
      "segment_number": 33
    },
    {
      "tag": "",
      "attributes": {},
      "text": "eṣā sūtrapadadeśanā mahāyānasya buddhavacanatvam",
      "segment_number": 34
    },
    {
      "tag": "",
      "attributes": {},
      "text": "udbhāvayati|",
      "segment_number": 35
    },
    {
      "tag": "",
      "attributes": {},
      "text": "(2)",
      "segment_number": 36
    },
    {
      "tag": "h4",
      "attributes": {
        "rend": "bold"
      },
      "text": "prastāvanā 3",
      "segment_number": 37
    },
    {
      "tag": "",
      "attributes": {},
      "text": "katham udbhāvayati| - tathā hy etayā deśanayā śrā-",
      "segment_number": 38
    },
    {
      "tag": "",
      "attributes": {},
      "text": "vakayāne 'deśitāni daśasthānāni mahāyānato deśitāni| yad",
      "segment_number": 39
    },
    {
      "tag": "",
      "attributes": {},
      "text": "uta (1) ālayavijñānasya jñeyāśrayatā deśitā| (2) trayāṇāṁ",
      "segment_number": 40
    },
    {
      "tag": "",
      "attributes": {},
      "text": "(3)",
      "segment_number": 41
    },
    {
      "tag": "",
      "attributes": {},
      "text": "svabhāvānāṁ paratantrasya parikalpitasya pariniṣpannasya",
      "segment_number": 42
    },
    {
      "tag": "",
      "attributes": {},
      "text": "ca jñeyalakṣaṇatā deśitā| (3) vijñaptimātratāyā jñeyalak-",
      "segment_number": 43
    },
    {
      "tag": "",
      "attributes": {},
      "text": "ṣaṇapraveśatā deśitā| (4) ṣaṭpāramitānāṁ tatpraveśahetu-",
      "segment_number": 44
    },
    {
      "tag": "",
      "attributes": {},
      "text": "phalatā deśitā| (5) daśabodhisattvabhūmīnāṁ taddhetupha-",
      "segment_number": 45
    },
    {
      "tag": "",
      "attributes": {},
      "text": "labhāvanāprabhedatā deśitā| (6) bodhisattvasaṁvarasya",
      "segment_number": 46
    },
    {
      "tag": "",
      "attributes": {},
      "text": "tatrādhiśīlatā deśitā| (7) śūraṁgamagaganagañjādisamādhī-",
      "segment_number": 47
    },
    {
      "tag": "",
      "attributes": {},
      "text": "nāṁ tatrādhicittatā deśitā| (8) nirvikalpajñānasyādhipra-",
      "segment_number": 48
    },
    {
      "tag": "",
      "attributes": {},
      "text": "jñātā deśitā| (9) apratiṣṭhitanirvāṇasya tatphalaprahāṇatā",
      "segment_number": 49
    },
    {
      "tag": "",
      "attributes": {},
      "text": "deśitā| (10) trayāṇāṁ buddhakāyānāṁ svābhāvikasya",
      "segment_number": 50
    },
    {
      "tag": "",
      "attributes": {},
      "text": "sāṁbhogikasya nairmāṇikasya ca tatphalajñānatā deśitā|",
      "segment_number": 51
    },
    {
      "tag": "",
      "attributes": {},
      "text": "etāni daśasthānāni śrāvakayānād viśiṣṭāni yāni bhagavatā",
      "segment_number": 52
    },
    {
      "tag": "",
      "attributes": {},
      "text": "mahāyāna [udbhāvitāni] viśiṣṭaparamāṇi bodhisattvān āra-",
      "segment_number": 53
    },
    {
      "tag": "",
      "attributes": {},
      "text": "bhya deśitāni|",
      "segment_number": 54
    },
    {
      "tag": "",
      "attributes": {},
      "text": "tena mahāyānam ārabhya buddhabhagavatāṁ daśaprakā-",
      "segment_number": 55
    },
    {
      "tag": "",
      "attributes": {},
      "text": "raviśeṣaviśiṣṭavacanaṁ jñeyam|",
      "segment_number": 56
    },
    {
      "tag": "h4",
      "attributes": {
        "rend": "bold"
      },
      "text": "prastāvanā 4",
      "segment_number": 57
    },
    {
      "tag": "",
      "attributes": {},
      "text": "(4)",
      "segment_number": 58
    },
    {
      "tag": "",
      "attributes": {},
      "text": "kathaṁ punar etena daśaprakāraviśeṣaviśiṣṭena tathāga-",
      "segment_number": 59
    },
    {
      "tag": "",
      "attributes": {},
      "text": "tavacanena mahāyānaṁ buddhavacanam eveti paridīpitaṁ",
      "segment_number": 60
    },
    {
      "tag": "",
      "attributes": {},
      "text": "na ca śrāvakayānaṁ mahāyānam iti pratiṣiddham| -",
      "segment_number": 61
    },
    {
      "tag": "",
      "attributes": {},
      "text": "eteṣāṁ hi daśasthānānāṁ deśanā śrāvakayāne na dṛśyate",
      "segment_number": 62
    },
    {
      "tag": "",
      "attributes": {},
      "text": "mahāyāne tu dṛśyate| etāni daśasthānāni mahābodhisaṁ-",
      "segment_number": 63
    },
    {
      "tag": "",
      "attributes": {},
      "text": "pādakāni sūpapannānukūlāviruddhāni sarvajñajñānaprāp-",
      "segment_number": 64
    },
    {
      "tag": "",
      "attributes": {},
      "text": "taye| atra gāthe|",
      "segment_number": 65
    },
    {
      "tag": "",
      "attributes": {},
      "text": "āśrayo jñeya(sya) lakṣaṇaṁ tatpraveśas taddhetupha-",
      "segment_number": 66
    },
    {
      "tag": "",
      "attributes": {},
      "text": "laṁ tatprabhedaḥ|",
      "segment_number": 67
    },
    {
      "tag": "",
      "attributes": {},
      "text": "śikṣātrayaṁ tatphalaṁ ca prahāṇaṁ jñānaṁ cāgrayā-",
      "segment_number": 68
    },
    {
      "tag": "",
      "attributes": {},
      "text": "nagataṁ viśiṣṭam|| (1)",
      "segment_number": 69
    },
    {
      "tag": "",
      "attributes": {},
      "text": "eṣā hi deśanānyatra na dṛśyate eteṣām uttamabodhihe-",
      "segment_number": 70
    },
    {
      "tag": "",
      "attributes": {},
      "text": "tudarśanena|",
      "segment_number": 71
    },
    {
      "tag": "",
      "attributes": {},
      "text": "buddhavacanam iṣyate mahāyānaṁ daśasthānadeśana-",
      "segment_number": 72
    },
    {
      "tag": "",
      "attributes": {},
      "text": "yā viśiṣṭam|| (2)",
      "segment_number": 73
    },
    {
      "tag": "h4",
      "attributes": {
        "rend": "bold"
      },
      "text": "prastāvanā 5",
      "segment_number": 74
    },
    {
      "tag": "",
      "attributes": {},
      "text": "(5)",
      "segment_number": 75
    },
    {
      "tag": "",
      "attributes": {},
      "text": "kim artham eteṣāṁ daśasthānānām evaṁ kramo deśitaḥ",
      "segment_number": 76
    },
    {
      "tag": "",
      "attributes": {},
      "text": "| - (1) bodhisattvena hi prathamata eva tāvad dharmā-",
      "segment_number": 77
    },
    {
      "tag": "",
      "attributes": {},
      "text": "ṇāṁ hetau kauśalyaṁ niśritya pratītyasamutpāde kauśal-",
      "segment_number": 78
    },
    {
      "tag": "",
      "attributes": {},
      "text": "yaṁ prāptavyam| (2) tataḥ paraṁ pratītyasamutpannadhar-",
      "segment_number": 79
    },
    {
      "tag": "",
      "attributes": {},
      "text": "māṇāṁ lakṣaṇe kauśalyaṁ prāptavyam| samāropāpavādān -",
      "segment_number": 80
    },
    {
      "tag": "",
      "attributes": {},
      "text": "tadoṣaparivarjane kauśalyāt| (3) bodhisattvenaivaṁ prayu-",
      "segment_number": 81
    },
    {
      "tag": "",
      "attributes": {},
      "text": "ktena tasmin sugṛhītalakṣaṇe prativyadhyam| tenāvaraṇe-",
      "segment_number": 82
    },
    {
      "tag": "",
      "attributes": {},
      "text": "bhyaś cittaṁ vimucyate| (4) tataḥ paraṁ jñeyalakṣaṇaṁ",
      "segment_number": 83
    },
    {
      "tag": "",
      "attributes": {},
      "text": "pratividhya pūrvaprāyogikāḥ ṣaṭpāramitā adhigamena",
      "segment_number": 84
    },
    {
      "tag": "",
      "attributes": {},
      "text": "pratipattavyāḥ| viśuddhādhyāśayaṁ niśritya| (5) tataḥ",
      "segment_number": 85
    },
    {
      "tag": "",
      "attributes": {},
      "text": "(6)",
      "segment_number": 86
    },
    {
      "tag": "",
      "attributes": {},
      "text": "paraṁ viśuddhādhyāśayaparigṛhītāḥ ṣaṭpāramitā daśabhū-",
      "segment_number": 87
    },
    {
      "tag": "",
      "attributes": {},
      "text": "miṣu prabhedena bhāvyās trikalpāsaṁkhyeyam| (6-8)",
      "segment_number": 88
    },
    {
      "tag": "",
      "attributes": {},
      "text": "tataḥ paraṁ trayo bodhisattvaśikṣāḥ paripūrayitavyāḥ|",
      "segment_number": 89
    },
    {
      "tag": "",
      "attributes": {},
      "text": "(9-10) paripūrayitvā tatphalaṁ nirvāṇam anuttarasamyak-",
      "segment_number": 90
    },
    {
      "tag": "",
      "attributes": {},
      "text": "saṁbodhiś cābhisaṁboddhavyā| evam eteṣāṁ daśasthānā-",
      "segment_number": 91
    },
    {
      "tag": "",
      "attributes": {},
      "text": "nāṁ kramo deśitaḥ|",
      "segment_number": 92
    },
    {
      "tag": "",
      "attributes": {},
      "text": "etasyāṁ deśanāyāṁ sarvamahāyānaṁ paripūrṇam|",
      "segment_number": 93
    },
    {
      "tag": "h2",
      "attributes": {
        "rend": "bold"
      },
      "text": "chapter I (jñeyāśraya)",
      "segment_number": 94
    },
    {
      "tag": "h3",
      "attributes": {
        "rend": "bold"
      },
      "text": "I.1",
      "segment_number": 95
    },
    {
      "tag": "",
      "attributes": {},
      "text": "tatra tāvat prathamata eva jñeyāśraya ukta ālayavijñā-",
      "segment_number": 96
    },
    {
      "tag": "",
      "attributes": {},
      "text": "naṁ| bhagavatā kutrālayavijñānaṁ deśitam ālayavijñānam",
      "segment_number": 97
    },
    {
      "tag": "",
      "attributes": {},
      "text": "iti vyapadeśena| - bhagavatābhidharmasūtragāthāyām",
      "segment_number": 98
    },
    {
      "tag": "",
      "attributes": {},
      "text": "uktam|",
      "segment_number": 99
    },
    {
      "tag": "",
      "attributes": {},
      "text": "anādikāliko dhātuḥ sarvadharmasamāśrayaḥ|",
      "segment_number": 100
    },
    {
      "tag": "",
      "attributes": {},
      "text": "tasmin sati gatiḥ sarvā nirvāṇādhigamo 'pi ca||",
      "segment_number": 101
    },
    {
      "tag": "",
      "attributes": {},
      "text": "(7)",
      "segment_number": 102
    },
    {
      "tag": "",
      "attributes": {},
      "text": "iti|",
      "segment_number": 103
    },
    {
      "tag": "h3",
      "attributes": {
        "rend": "bold"
      },
      "text": "I.2",
      "segment_number": 104
    },
    {
      "tag": "",
      "attributes": {},
      "text": "api ca tasyām evoktam|",
      "segment_number": 105
    },
    {
      "tag": "",
      "attributes": {},
      "text": "ālīnaṁ sarvadharmeṣu vijñānaṁ sarvabījakam|",
      "segment_number": 106
    },
    {
      "tag": "",
      "attributes": {},
      "text": "tasmād ālayavijñānaṁ sadbhyo mayaiva deśitam||",
      "segment_number": 107
    },
    {
      "tag": "",
      "attributes": {},
      "text": "iti| eṣa tāvad āgamaḥ|",
      "segment_number": 108
    },
    {
      "tag": "h3",
      "attributes": {
        "rend": "bold"
      },
      "text": "I.3",
      "segment_number": 109
    },
    {
      "tag": "",
      "attributes": {},
      "text": "kiṁ kāraṇaṁ tu tad ālayavijñānam ity ucyate| -",
      "segment_number": 110
    },
    {
      "tag": "",
      "attributes": {},
      "text": "sarvaupapattikasāṁkleśikadharmās tasminn ālīnāḥ phala-",
      "segment_number": 111
    },
    {
      "tag": "",
      "attributes": {},
      "text": "bhāvena tac ca teṣv ālīnaṁ hetubhāvenety ālayavijñānam|",
      "segment_number": 112
    },
    {
      "tag": "",
      "attributes": {},
      "text": "atha vā sattvās tadālīnā ātmatvenety ālayavijñānam|",
      "segment_number": 113
    },
    {
      "tag": "h3",
      "attributes": {
        "rend": "bold"
      },
      "text": "I.4",
      "segment_number": 114
    },
    {
      "tag": "",
      "attributes": {},
      "text": "(8)",
      "segment_number": 115
    },
    {
      "tag": "",
      "attributes": {},
      "text": "tac cādānavijñānam ity apy ucyate| atrāgamaḥ| yatho-",
      "segment_number": 116
    },
    {
      "tag": "",
      "attributes": {},
      "text": "ktaṁ saṁdhinirmocanasūtre|",
      "segment_number": 117
    },
    {
      "tag": "",
      "attributes": {},
      "text": "ādānavijñāna gabhīrasūkṣmo ogho yathā vartati",
      "segment_number": 118
    },
    {
      "tag": "",
      "attributes": {},
      "text": "sarvabījo|",
      "segment_number": 119
    },
    {
      "tag": "",
      "attributes": {},
      "text": "bālāna eṣo mayi na prakāśi(te) mā haiva ātmā",
      "segment_number": 120
    },
    {
      "tag": "",
      "attributes": {},
      "text": "parikalpayeyuḥ|| iti| (triṁśikā)",
      "segment_number": 121
    },
    {
      "tag": "h3",
      "attributes": {
        "rend": "bold"
      },
      "text": "I.5",
      "segment_number": 122
    },
    {
      "tag": "",
      "attributes": {},
      "text": "kiṁ kāraṇam ādānavijñānam ity ucyate| - (a) sarva-",
      "segment_number": 123
    },
    {
      "tag": "",
      "attributes": {},
      "text": "rūpīndriyopādānatvena (b) sarvātmabhāvopādānāśrayatvena",
      "segment_number": 124
    },
    {
      "tag": "",
      "attributes": {},
      "text": "ca| tathā hi (a) tena pañcarūpindriyāny upādīyante 'vinā-",
      "segment_number": 125
    },
    {
      "tag": "",
      "attributes": {},
      "text": "śāya yāvad āyur anuvartate| (b) pratisaṁdhibandhe ca",
      "segment_number": 126
    },
    {
      "tag": "",
      "attributes": {},
      "text": "(9)",
      "segment_number": 127
    },
    {
      "tag": "",
      "attributes": {},
      "text": "tadabhinirvṛttyupādānatvenātmabhāva upādīyate| evaṁ tad",
      "segment_number": 128
    },
    {
      "tag": "",
      "attributes": {},
      "text": "ādānavijñānam ity ucyate|",
      "segment_number": 129
    },
    {
      "tag": "h3",
      "attributes": {
        "rend": "bold"
      },
      "text": "I.6",
      "segment_number": 130
    },
    {
      "tag": "",
      "attributes": {},
      "text": "tac ca cittam ity apy ucyate| yathoktaṁ bhagavatā cittaṁ",
      "segment_number": 131
    },
    {
      "tag": "",
      "attributes": {},
      "text": "mano 'tha vijñānam iti|",
      "segment_number": 132
    },
    {
      "tag": "",
      "attributes": {},
      "text": "tatra mano dvividham| (1) samanantarapratyayakāritr-",
      "segment_number": 133
    },
    {
      "tag": "",
      "attributes": {},
      "text": "āśrayatvād anantaraniruddhavijñānaṁ mano nāma vijñā-",
      "segment_number": 134
    },
    {
      "tag": "",
      "attributes": {},
      "text": "nasyotpādāśrayaḥ| (2) dvitīyaṁ ca kliṣṭaṁ manaś catur-",
      "segment_number": 135
    },
    {
      "tag": "",
      "attributes": {},
      "text": "bhiḥ kleśaiḥ sadā samprayuktaṁ satkāyadṛṣṭyā cāsmimā-",
      "segment_number": 136
    },
    {
      "tag": "",
      "attributes": {},
      "text": "nena cātmasnehena cāvidyāyā ca| etad vijñānasya saṁkle-",
      "segment_number": 137
    },
    {
      "tag": "",
      "attributes": {},
      "text": "śāśrayaḥ|",
      "segment_number": 138
    },
    {
      "tag": "",
      "attributes": {},
      "text": "vijñānaṁ yad ekenāśrayenotpadyate dvitīyena tu saṁkli-",
      "segment_number": 139
    },
    {
      "tag": "",
      "attributes": {},
      "text": "śyate| viṣayaprativijñapter vijñānam|",
      "segment_number": 140
    },
    {
      "tag": "",
      "attributes": {},
      "text": "samanantarān mananāc ca mano dvividham|",
      "segment_number": 141
    },
    {
      "tag": "",
      "attributes": {},
      "text": "(10)",
      "segment_number": 142
    },
    {
      "tag": "h3",
      "attributes": {
        "rend": "bold"
      },
      "text": "I.7A",
      "segment_number": 143
    },
    {
      "tag": "",
      "attributes": {},
      "text": "kathaṁ punar gamyate tat kliṣṭaṁ mana astīti| tasminn",
      "segment_number": 144
    },
    {
      "tag": "",
      "attributes": {},
      "text": "avidyamāne| (1) āveṇikyavidyābhāvadoṣo bhavet| (2) pañ-",
      "segment_number": 145
    },
    {
      "tag": "",
      "attributes": {},
      "text": "cabhiś ca sādharmyābhāvadoṣo bhavet| tathā hi pañcavij-",
      "segment_number": 146
    },
    {
      "tag": "",
      "attributes": {},
      "text": "ñānakāyānāṁ sahabhvāśrayāś cakṣurādayaḥ| (3) niruktya-",
      "segment_number": 147
    },
    {
      "tag": "",
      "attributes": {},
      "text": "bhāvadoṣaś ca bhavet| (4) asaṁjñinirodhasamāpattyoś ca",
      "segment_number": 148
    },
    {
      "tag": "",
      "attributes": {},
      "text": "viśeṣābhāvadoṣo bhavet| tathā hy asaṁjñisamāpattiḥ kli-",
      "segment_number": 149
    },
    {
      "tag": "",
      "attributes": {},
      "text": "(11)",
      "segment_number": 150
    },
    {
      "tag": "",
      "attributes": {},
      "text": "ṣṭamanasā prabhāvitā na tu nirodhasamāpattiḥ| anyathā",
      "segment_number": 151
    },
    {
      "tag": "",
      "attributes": {},
      "text": "tayor viśeṣo na syāt| (5) āsaṁjñikāyāṁ caikajātāv akliṣṭa-",
      "segment_number": 152
    },
    {
      "tag": "",
      "attributes": {},
      "text": "tvadoṣo bhaved yadi tatrāhaṁkāro 'smimānaś ca na bha-",
      "segment_number": 153
    },
    {
      "tag": "",
      "attributes": {},
      "text": "vetāṁ| (6) sadā cāhaṁkārasya samudācāra upalabhyate",
      "segment_number": 154
    },
    {
      "tag": "",
      "attributes": {},
      "text": "kuśalākuśalāvyākṛtacitteṣu| anyathākuśalacitta eva tatsa-",
      "segment_number": 155
    },
    {
      "tag": "",
      "attributes": {},
      "text": "ṁprayuktatvād asmimānakleśaḥ samudācaren na tu kuśa-",
      "segment_number": 156
    },
    {
      "tag": "",
      "attributes": {},
      "text": "lāvyakṛtayoḥ| tasmāt sahabhūsamudācāreṇa saṁprayukta-",
      "segment_number": 157
    },
    {
      "tag": "",
      "attributes": {},
      "text": "samudācāreṇa ca ete doṣā na bhavanti|",
      "segment_number": 158
    },
    {
      "tag": "h3",
      "attributes": {
        "rend": "bold"
      },
      "text": "I. 7B",
      "segment_number": 159
    },
    {
      "tag": "",
      "attributes": {},
      "text": "atra gāthāḥ|",
      "segment_number": 160
    },
    {
      "tag": "",
      "attributes": {},
      "text": "āveṇikyā avidyāyāḥ sādharmayasya ca pañcabhiḥ|",
      "segment_number": 161
    },
    {
      "tag": "",
      "attributes": {},
      "text": "(12)",
      "segment_number": 162
    },
    {
      "tag": "",
      "attributes": {},
      "text": "samāpattiviśeṣasya ca nirukteś cābhāvo doṣaḥ|| (1)",
      "segment_number": 163
    },
    {
      "tag": "",
      "attributes": {},
      "text": "āsaṁjñike jātisrotasi cāhaṁkārābhāvo doṣaḥ|",
      "segment_number": 164
    },
    {
      "tag": "",
      "attributes": {},
      "text": "ahaṁkārānubandhaś ca sarvathā nopapadyate|| (2)",
      "segment_number": 165
    },
    {
      "tag": "",
      "attributes": {},
      "text": "vinā kliṣṭamanasā dvayābhāvaḥ trayavirodhaś ca|",
      "segment_number": 166
    },
    {
      "tag": "",
      "attributes": {},
      "text": "tasminn asati sarvatra cāhaṁkāro na bhavati|| (3)",
      "segment_number": 167
    },
    {
      "tag": "",
      "attributes": {},
      "text": "cittavṛttaye sadarthe sadā pratibandhabhūtā|",
      "segment_number": 168
    },
    {
      "tag": "",
      "attributes": {},
      "text": "sarvakālaṁ ca sahabhūr avidyeṣyata āveṇikī|| (4)",
      "segment_number": 169
    },
    {
      "tag": "h3",
      "attributes": {
        "rend": "bold"
      },
      "text": "I. 7C",
      "segment_number": 170
    },
    {
      "tag": "",
      "attributes": {},
      "text": "manaḥ kliṣṭatvān nivṛtāvyākṛtaṁ kleśaiś caturbhiḥ sadā",
      "segment_number": 171
    },
    {
      "tag": "",
      "attributes": {},
      "text": "saṁprayuktam| yathā rūparūpyāvacarakleśā etad nivṛtā-",
      "segment_number": 172
    },
    {
      "tag": "",
      "attributes": {},
      "text": "vyākṛtam| rūpārūpyāvacarasya śamathālingitatvān manasas",
      "segment_number": 173
    },
    {
      "tag": "",
      "attributes": {},
      "text": "tu sarvakālam anubaddhatvāt|",
      "segment_number": 174
    },
    {
      "tag": "h3",
      "attributes": {
        "rend": "bold"
      },
      "text": "I.8",
      "segment_number": 175
    },
    {
      "tag": "",
      "attributes": {},
      "text": "cittaśarīraṁ tṛtīyaṁ nopalabhyata ālayavijñānam anta-",
      "segment_number": 176
    },
    {
      "tag": "",
      "attributes": {},
      "text": "(13)",
      "segment_number": 177
    },
    {
      "tag": "",
      "attributes": {},
      "text": "reṇa| tena siddham ālayavijñānasya cittatvam| tasmāt",
      "segment_number": 178
    },
    {
      "tag": "",
      "attributes": {},
      "text": "sarvabījakān mano vijñānaṁ ca pravartate|",
      "segment_number": 179
    },
    {
      "tag": "h3",
      "attributes": {
        "rend": "bold"
      },
      "text": "I.9",
      "segment_number": 180
    },
    {
      "tag": "",
      "attributes": {},
      "text": "tac ca kiṁkāraṇaṁ cittam ity apy ucyate| citradharma-",
      "segment_number": 181
    },
    {
      "tag": "",
      "attributes": {},
      "text": "vāsanābījair ācitatvena|",
      "segment_number": 182
    },
    {
