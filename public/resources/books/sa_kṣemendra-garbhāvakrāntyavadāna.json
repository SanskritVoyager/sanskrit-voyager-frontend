  },
  "body": [
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "campopānte vimalanalinītīraparyantavasī",
          "segment_number": 1
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śāstā pūrvaṃ sakalabhuvanānugrahāya pravṛttah /",
          "segment_number": 2
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pṛṣṭaḥ sparśāvagatirucinā (?) bhikṣuṇānandanāmnā",
          "segment_number": 3
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "garbhārambhāt prabhṛti janatājanmavṛttiṃ jagāda // KAvk_10.1 //",
          "segment_number": 4
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "śuklaiḥ kṛṣṇaiḥ śabalarucibhir dehināṃ karmasūtraiś",
          "segment_number": 5
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "citraṃ loke bahutaradaśaṃ dṛśyate janmavastram /",
          "segment_number": 6
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "jīrṇasyāpi vyasanamalinasnehalīnaḥ prayatnair",
          "segment_number": 7
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yasyātyantaṃ cirapariṇater naiva niryāti rāgaḥ // KAvk_10.2 //",
          "segment_number": 8
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "puṃsaḥ śukraṃ vigalitadhṛter ārtavaṃ yoṣitaś ca",
          "segment_number": 9
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sparśāveśavyatikarajuṣoḥ saṃgame saṃnipātāt /",
          "segment_number": 10
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ekībhūtaṃ vrajati niyamāt kasya cid bījabhāvaṃ",
          "segment_number": 11
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yo 'ntas tasmin bhavati sahasā saṃnikāṣe yathāgniḥ // KAvk_10.3 //",
          "segment_number": 12
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "rāgodgāraḥ sphaṭikaśakalaṃ megham ambhodhipāthaḥ",
          "segment_number": 13
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "puṣpāmodas tilaṃ iva śanaiḥ kāñcanaṃ vāgnitāpaḥ /",
          "segment_number": 14
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "so 'yaṃ garbhaṃ viśati niyatair apy asaṃlakṣyavṛttir",
          "segment_number": 15
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vāyur gandhair iva bahuvidhaiḥ karmabhir vāsyamānaḥ // KAvk_10.4 //",
          "segment_number": 16
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tasmin sūkṣmakramapariṇatir mīnaparyuṣṭake (?) 'sau",
          "segment_number": 17
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nānākārapracuraracanācitrarūpo 'py alakṣyaḥ /",
          "segment_number": 18
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kaṃ cit kālaṃ vahati vikṛtiṃ nirvikārāyamāno",
          "segment_number": 19
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "māyūrāṇḍe jalamaya iva vyaktabhaktir mayūraḥ // KAvk_10.5 //",
          "segment_number": 20
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tatrādhānād ghanakalalatāśalyapeśyādyavasthās",
          "segment_number": 21
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tyaktvā tās tā jaṭharajanitenoṣmaṇā pacyamānaḥ /",
          "segment_number": 22
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pūrṇair māsair navabhir athavāvartakarmakramo 'sau",
          "segment_number": 23
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kleśaṃ bhuṅkte kim api viṣamaṃ duḥkhasaṃjñāprapannaḥ // KAvk_10.6 //",
          "segment_number": 24
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kāle vṛntāt svayaṃ iva phalaṃ vicyutaṃ karmapākāt",
          "segment_number": 25
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tatkālotthair avihatajavaiḥ preritaḥ pūtivātaiḥ /",
          "segment_number": 26
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "lakṣyābhyāsāyatanasacivair ācitaḥ karmabandhair",
          "segment_number": 27
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "niryāty antaḥ śara iva dhanuryantraṇair yantramuktaḥ // KAvk_10.7 //",
          "segment_number": 28
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "uttānāsyaḥ saralarasanaś cūcukāgraṃ lihānaḥ\nstanyaṃ mātuḥ pibati yad asau naiva karṇena nākṣṇā / janmābhyāsavyasanayatanāyāsasaṃvāsalinā",
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "sā tasyāgre sakalakalanādeśini vāsanaiva // KAvk_10.8 //",
          "segment_number": 30
        }
      ],
      "segment_number": 29
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "syūtair antar vividhaviṣayasvādasaṃpādabhedair",
          "segment_number": 31
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vyāptaḥ sūtair (?) bisalava iva vyaktatantupratānaiḥ /",
          "segment_number": 32
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "mūdhaḥ so 'tha prakṛtisacivair indriyair dattasamjñaḥ",
          "segment_number": 33
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "stanyālāpākṛtiparimalasparśanair vetti dhātrīm // KAvk_10.9 //",
          "segment_number": 34
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "hastākarṣaiḥ śayanavasanāgharṣaṇaiḥ pīḍyamānaḥ",
          "segment_number": 35
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sthāne sthāne taralitatanuḥ kīṭakair bhakṣyamāṇaḥ /",
          "segment_number": 36
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nityākrandī vacanavirahāt kāyikīṃ kleśaśailīṃ",
          "segment_number": 37
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kaṃ bobrūte viṣamavipadām āspadatvaṃ prayātaḥ // KAvk_10.10 //",
          "segment_number": 38
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "pīḍodvāntaiś churitavadanaḥ procchalatkṣīrapūrair",
          "segment_number": 39
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "uttānorastalanipatitair ukṣito lakṣyate 'sau /",
          "segment_number": 40
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "māyāvadhvāḥ smaraṇaharaṇaprauḍhakelīvilāse",
          "segment_number": 41
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "hāseneva sphuritarucinā nirbharavyāptakāyaḥ // KAvk_10.11 //",
          "segment_number": 42
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "so 'tha prāpte lipiparicaye helayā dattahaste",
          "segment_number": 43
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "saṃsāre 'sminn avicalitayā bandhalekhyakriyāsu /",
          "segment_number": 44
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "janmāvartaṃ nijaṃ iva likhan dīrghaṃ oṃkāram ādau",
          "segment_number": 45
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "varge varge vitarati matiṃ bhogasarge niviṣṭaḥ // KAvk_10.12 //",
          "segment_number": 46
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "prāptaprajñaḥ katham api galadbālabhāvapramohaḥ",
          "segment_number": 47
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kāmautsukyāt punar api pare yauvane naṣṭasaṃjñaḥ /",
          "segment_number": 48
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "niḥsāreṣu vyasanavilasadmeghasaudāminīnāṃ",
          "segment_number": 49
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "badhnāty āsthāṃ sthirataradhiyā yoṣitāṃ vibhrameṣu // KAvk_10.13 //",
          "segment_number": 50
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "vāci śrotraṃ vapur api calāliṅganeṣv aṅganānāṃ",
          "segment_number": 51
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ghrāṇaṃ vaktrāsavaparimale svādanaṃ tadrase ca /",
          "segment_number": 52
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "pātre kurvan dṛśam api mukhe suptasarvakriyo 'sau",
          "segment_number": 53
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dhatte mātraṃ tanupariṇatāṃnīva sarvendriyāṇi // KAvk_10.14 //",
          "segment_number": 54
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "dveṣṭi snigdhaṃ paricitaparidveṣaśīlaḥ sa kāmī",
          "segment_number": 55
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "vāñchaty anyāṃ navanavarasaḥ saprayatno 'nyakāmām /",
          "segment_number": 56
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "ity anyonyānucitacaritālakṣyavailakṣyasākṣī",
          "segment_number": 57
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "hāsyāyaiva prakṛtivirasaś citratantro 'sya kāmaḥ // KAvk_10.15 //",
          "segment_number": 58
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "alpādhāre viṣayajaladhau majjataḥ sajjataś ca",
          "segment_number": 59
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhraṣṭasyāsya pratihatagateḥ kuñjarasyeva paṅke /",
          "segment_number": 60
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kiṃkartavyāvagatirahitā jāyate mohamūrcchā",
          "segment_number": 61
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "nītasyāndhyaṃ katipayadinasthāyinā yauvanena // KAvk_10.16 //",
          "segment_number": 62
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "yāvatkālaṃ bhramati calati prīyate jṛmbhate 'sau",
          "segment_number": 63
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "smeraṃ smeraṃ vadati madanāliṅgitair aṅgabhaṅgaiḥ /",
          "segment_number": 64
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tāvat tasyopari paripatary eva kālapramuktā",
          "segment_number": 65
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "prāleyālīdhavalapalitacchadmanā vadhyamālā // KAvk_10.17 //",
          "segment_number": 66
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kāle kāle kṣaṇakalanayā mohanidrāvaśena",
          "segment_number": 67
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "prāptaṃ nāsmin vapuṣi sukṛtaṃ naiva dattaṃ na bhuktaṃ /",
          "segment_number": 68
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "itthaṃ caurair iva sa muṣitaś cintayaty eva duḥkhāt",
          "segment_number": 69
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "saṃmūḍhānāṃ anuśayaphalaḥ so 'vasādapramādaḥ // KAvk_10.18 //",
          "segment_number": 70
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "tasmin yāte lalitavanitāpuṣpavallīvasante",
          "segment_number": 71
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "duṣkarmāptadraviṇatulayā yauvane svapnakalpe /",
          "segment_number": 72
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "naṣṭāśeṣaprakṛtir akhilaiḥ kheditāṅgair viraktair",
          "segment_number": 73
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "rājyabhraṃśe nṛpa iva sukhaṃ so 'tha śocaty atītaṃ // KAvk_10.19 //",
          "segment_number": 74
        }
      ]
    },
    {
      "tag": "p",
      "attributes": {},
      "text": "āyur nītaṃ na ca samucitaṃ yācakāyopanītaṃ",
      "children": [
        {
          "tag": "lg",
          "attributes": {},
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "nāpy unnītaṃ diśi diśi yaśaḥ satpathaṃ na pratītaṃ",
              "segment_number": 76
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "pītaṃ yācñāviṣam adhigataṃ sphītasaṃtāpaśītaṃ",
              "segment_number": 77
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "bhītaṃ pāpāt kim api na mayā yat tad eva praṇītaṃ // KAvk_10.20 //",
              "segment_number": 78
            }
          ]
        }
      ],
      "segment_number": 75
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "kvāsau hemadrumaruciharā hāriṇī yauvanaśrīḥ",
          "segment_number": 79
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kāyaḥ kvāyaṃ kṛmihatataruprāyavicchāyapākaḥ /",
          "segment_number": 80
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "dūrād etāḥ parihṛtadṛśāḥ koṇalīnaṃ taruṇyaḥ",
          "segment_number": 81
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śuṣkaṃ śītaṃ tarum iva vane vānaraṃ māṃ vadanti // KAvk_10.21 //",
          "segment_number": 82
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "so 'yaṃ kāyaḥ śrayati vilayaṃ naiva māyānikāyaḥ",
          "segment_number": 83
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "srastāḥ sarve daśanamaṇayas te ca keśāḥ na doṣāḥ /",
          "segment_number": 84
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "gātrotsāhe praharati marun naiva mohaprarohe",
          "segment_number": 85
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "kṣīṇasyeyaṃ śayanaśaraṇasyāpi tṛṣṇākṣayā me // KAvk_10.22 //",
          "segment_number": 86
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "saṃcintyeti prasṛtaviṣamaśvāsahikkārdito (?) 'sau",
          "segment_number": 87
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "sadyas tyaktuṃ ciraparicitām udyato lokayātrām /",
          "segment_number": 88
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "mūkibhūtaḥ svajanavirahaṃ dhyāyati dhvastadhairyaḥ",
          "segment_number": 89
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "śakticchedād ṛṇaṃ iva mahat prāptakālo daridraḥ // KAvk_10.23 //",
          "segment_number": 90
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "bhūmiṃ gehaṃ vasu parijanaṃ putradārādi cānyat",
          "segment_number": 91
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tāvat tāvat kalayati dhiyā prāṇaparyantakāle /",
          "segment_number": 92
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "yāvaj janmany api punar asau snehamohānubandhais",
          "segment_number": 93
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "tais tair antaḥ kṛtaparicayas tanmayībhāvam eti // KAvk_10.24 //",
          "segment_number": 94
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {},
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "text": "duḥkhaṃ duḥsahapāpakarmajanitaṃ kumbhīsahasrāntare",
          "segment_number": 95
        },
        {
          "tag": "l",
          "attributes": {},
          "text": "bhuktvā rauravakālasūtranarakeṣv āvartate yoniṣu /",
          "segment_number": 96
        },
        {
