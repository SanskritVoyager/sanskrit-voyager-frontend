 },
 "body": [
  {
   "tag": "div",
   "attributes": {
    "type": "chapter",
    "n": "1"
   },
   "children": [
    {
     "tag": "head",
     "attributes": {},
     "text": "Chapter 1"
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_1.1",
      "label": "DCS 1.1"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "āūṃ śrīgurubhyo namaḥ",
       "translated_text": "Om. Reverence to the revered teachers.",
       "segment_number": 593224
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "hariḥ āūṃ",
       "translated_text": "Hariḥ, om.",
       "segment_number": 593225
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "āūṃ śaṃ no mitraḥ śaṃ varuṇaḥ",
       "translated_text": "Om. May <s>Mitra</s> be auspicious to us; may <s>Varuṇa</s> be auspicious.",
       "segment_number": 593226
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "śaṃ no bhavatvaryamā",
       "translated_text": "May <s>Aryaman</s> be auspicious to us.",
       "segment_number": 593227
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "śaṃ na indro bṛhaspatiḥ",
       "translated_text": "May <s>Indra</s> and <s>Bṛhaspati</s> be auspicious to us.",
       "segment_number": 593228
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "śaṃ no viṣṇururukramaḥ",
       "translated_text": "May wide-striding <s>Viṣṇu</s> be auspicious to us.",
       "segment_number": 593229
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "namo brahmaṇe",
       "translated_text": "Reverence to <s>brahman</s>.",
       "segment_number": 593230
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "namaste vāyo",
       "translated_text": "Reverence to you, O <s>Vāyu</s>.",
       "segment_number": 593231
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "tvameva pratyakṣaṃ brahmāsi",
       "translated_text": "You alone are the directly perceptible <s>brahman</s>.",
       "segment_number": 593232
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "tvām eva pratyakṣaṃ brahma vadiṣyāmi",
       "translated_text": "You alone I shall declare to be the directly perceptible <s>brahman</s>.",
       "segment_number": 593233
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "ṛtaṃ vadiṣyāmi",
       "translated_text": "I shall speak <s>ṛta</s> (cosmic truth).",
       "segment_number": 593234
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "satyaṃ vadiṣyāmi",
       "translated_text": "I shall speak truth.",
       "segment_number": 593235
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "tanmāmavatu",
       "translated_text": "May that protect me.",
       "segment_number": 593236
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "tadvaktāramavatu",
       "translated_text": "May that protect the speaker.",
       "segment_number": 593237
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "avatu mām",
       "translated_text": "May it protect me.",
       "segment_number": 593238
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "avatu vaktāram",
       "translated_text": "May it protect the speaker.",
       "segment_number": 593239
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "āūṃ śāntiḥ śāntiḥ śāntiḥ ||",
       "translated_text": "Om. Peace, peace, peace.",
       "segment_number": 593240
      }
     ]
    }
   ]
  },
  {
   "tag": "div",
   "attributes": {
    "type": "chapter",
    "n": "2"
   },
   "children": [
    {
     "tag": "head",
     "attributes": {},
     "text": "Chapter 2"
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_2.1",
      "label": "DCS 2.1"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "āūṃ śīkṣāṃ vyākhyāsyāmaḥ",
       "translated_text": "Om. We shall explain <s>śikṣā</s> (phonetics).",
       "segment_number": 593241
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "varṇaḥ svaraḥ",
       "translated_text": "Sound and accent,",
       "segment_number": 593242
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "mātrā balam",
       "translated_text": "measure and force,",
       "segment_number": 593243
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "sāma santānaḥ",
       "translated_text": "intonation and continuity:",
       "segment_number": 593244
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "ityuktaḥ śīkṣādhyāyaḥ ||",
       "translated_text": "thus has the chapter on <s>śikṣā</s> been stated.",
       "segment_number": 593245
      }
     ]
    }
   ]
  },
  {
   "tag": "div",
   "attributes": {
    "type": "chapter",
    "n": "3"
   },
   "children": [
    {
     "tag": "head",
     "attributes": {},
     "text": "Chapter 3"
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.1",
      "label": "DCS 3.1"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "saha nau yaśaḥ",
       "translated_text": "May fame be with us both.",
       "segment_number": 593246
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "saha nau brahmavarcasam",
       "translated_text": "May the splendor of <s>brahman</s> be with us both.",
       "segment_number": 593247
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "athātaḥ saṃhitāyā upaniṣadam vyākhyāsyāmaḥ",
       "translated_text": "Now then, we shall explain the secret teaching of the <s>saṃhitā</s> (conjunction),",
       "segment_number": 593248
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "pañcasvadhikaraṇeṣu",
       "translated_text": "in five domains:",
       "segment_number": 593249
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "adhilokam adhijyautiṣam adhividyam adhiprajam adhyātmam",
       "translated_text": "concerning the worlds, concerning the lights, concerning knowledge, concerning progeny, and concerning the self.",
       "segment_number": 593250
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "tā mahāsaṃhitāyā ityācakṣate",
       "translated_text": "These they call the great <s>saṃhitās</s>.",
       "segment_number": 593251
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "athādhilokam",
       "translated_text": "Now, concerning the worlds:",
       "segment_number": 593252
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "pṛthivī pūrvarūpam",
       "translated_text": "earth is the prior form;",
       "segment_number": 593253
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "dyauruttararūpam",
       "translated_text": "heaven is the latter form;",
       "segment_number": 593254
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "ākāśaḥ sandhiḥ ||",
       "translated_text": "space is the junction.",
       "segment_number": 593255
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.2",
      "label": "DCS 3.2"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "vāyuḥ sandhānam",
       "translated_text": "Wind is the joining.",
       "segment_number": 593256
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "ityadhilokam",
       "translated_text": "Thus, concerning the worlds.",
       "segment_number": 593257
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "athādhijyautiṣam",
       "translated_text": "Now, concerning the lights:",
       "segment_number": 593258
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "agniḥ pūrvarūpam",
       "translated_text": "fire is the prior form;",
       "segment_number": 593259
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "āditya uttararūpam",
       "translated_text": "the sun is the latter form;",
       "segment_number": 593260
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "āpaḥ sandhiḥ",
       "translated_text": "the waters are the junction;",
       "segment_number": 593261
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "vaidyutaḥ sandhānam",
       "translated_text": "lightning is the joining.",
       "segment_number": 593262
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "ityadhijyautiṣam",
       "translated_text": "Thus, concerning the lights.",
       "segment_number": 593263
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "athādhividyam",
       "translated_text": "Now, concerning knowledge:",
       "segment_number": 593264
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "ācāryaḥ pūrvarūpam ||",
       "translated_text": "the teacher is the prior form;",
       "segment_number": 593265
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.3",
      "label": "DCS 3.3"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "antevāsyuttararūpam",
       "translated_text": "the pupil is the latter form;",
       "segment_number": 593266
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "vidyā sandhiḥ",
       "translated_text": "knowledge is the junction;",
       "segment_number": 593267
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "pravacanaṃ sandhānam",
       "translated_text": "recitation is the joining.",
       "segment_number": 593268
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "ityadhividyam",
       "translated_text": "Thus, concerning knowledge.",
       "segment_number": 593269
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "athādhiprajam",
       "translated_text": "Now, concerning progeny:",
       "segment_number": 593270
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "mātā pūrvarūpam",
       "translated_text": "the mother is the prior form;",
       "segment_number": 593271
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "pitottararūpam",
       "translated_text": "the father is the latter form;",
       "segment_number": 593272
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "prajā sandhiḥ",
       "translated_text": "offspring is the junction;",
       "segment_number": 593273
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "prajananaṃ sandhānam",
       "translated_text": "procreation is the joining.",
       "segment_number": 593274
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "ityadhiprajam ||",
       "translated_text": "Thus, concerning progeny.",
       "segment_number": 593275
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_3.4",
      "label": "DCS 3.4"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "athādhyātmam",
       "translated_text": "Now, concerning the self:",
       "segment_number": 593276
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "adharā hanuḥ pūrvarūpam",
       "translated_text": "the lower jaw is the prior form;",
       "segment_number": 593277
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "uttarā hanuruttararūpam",
       "translated_text": "the upper jaw is the latter form;",
       "segment_number": 593278
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "vāksandhiḥ",
       "translated_text": "speech is the junction;",
       "segment_number": 593279
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "jihvā sandhānam",
       "translated_text": "the tongue is the joining.",
       "segment_number": 593280
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "ityadhyātmam",
       "translated_text": "Thus, concerning the self.",
       "segment_number": 593281
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "itīmā mahāsaṃhitāḥ",
       "translated_text": "Thus are these great <s>saṃhitās</s>.",
       "segment_number": 593282
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "ya evametā mahāsaṃhitā vyākhyātā veda",
       "translated_text": "Whoever knows these great <s>saṃhitās</s> as they have been explained",
       "segment_number": 593283
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "saṃdhīyate prajayā paśubhiḥ",
       "translated_text": "is joined with offspring and cattle,",
       "segment_number": 593284
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "brahmavarcasenānnādyena suvargyeṇa lokena ||",
       "translated_text": "with the splendor of <s>brahman</s>, with food to eat, and with the heavenly world.",
       "segment_number": 593285
      }
     ]
    }
   ]
  },
  {
   "tag": "div",
   "attributes": {
    "type": "chapter",
    "n": "4"
   },
   "children": [
    {
     "tag": "head",
     "attributes": {},
     "text": "Chapter 4"
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_4.1",
      "label": "DCS 4.1"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "yaśchandasām ṛṣabho viśvarūpaḥ",
       "translated_text": "He who is the bull of the meters, having all forms,",
       "segment_number": 593286
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "chandobhyo 'dhyamṛtāt saṃbabhūva",
       "translated_text": "who arose from the meters, from the immortal,",
       "segment_number": 593287
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "sa mendro medhayā spṛṇotu",
       "translated_text": "may that <s>Indra</s> fill me with intelligence.",
       "segment_number": 593288
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "amṛtasya deva dhāraṇo bhūyāsam",
       "translated_text": "O god, may I become a holder of immortality.",
       "segment_number": 593289
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "śarīraṃ me vicarṣaṇam",
       "translated_text": "May my body be vigorous.",
       "segment_number": 593290
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "jihvā me madhumattamā",
       "translated_text": "May my tongue be most sweet.",
       "segment_number": 593291
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "karṇābhyāṃ bhūri viśruvam",
       "translated_text": "May I hear much with my ears.",
       "segment_number": 593292
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "brahmaṇaḥ kośo 'si medhayā pihitaḥ",
       "translated_text": "You are the sheath of <s>brahman</s>, covered by intelligence.",
       "segment_number": 593293
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "śrutaṃ me gopāya",
       "translated_text": "Guard what I have heard.",
       "segment_number": 593294
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "āvahantī vitanvānā ||",
       "translated_text": "Bringing and spreading forth,",
       "segment_number": 593295
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_4.2",
      "label": "DCS 4.2"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "kurvāṇācīram ātmanaḥ",
       "translated_text": "making clothing for oneself without delay,",
       "segment_number": 593296
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "vāsāṃsi mama gāvaśca",
       "translated_text": "bring garments for me, and cows,",
       "segment_number": 593297
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "annapāne ca sarvadā",
       "translated_text": "and food and drink at all times.",
       "segment_number": 593298
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "tato me śriyamāvaha",
       "translated_text": "Then bring prosperity to me,",
       "segment_number": 593299
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "lomaśāṃ paśubhiḥ saha svāhā",
       "translated_text": "rich in wool, together with cattle. Svāhā.",
       "segment_number": 593300
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "āmāyantu brahmacāriṇaḥ svāhā",
       "translated_text": "May students of <s>brahmacarya</s> come to me. Svāhā.",
       "segment_number": 593301
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "vimāyantu brahmacāriṇaḥ svāhā",
       "translated_text": "May students of <s>brahmacarya</s> come from every side. Svāhā.",
       "segment_number": 593302
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "pramayantu brahmacāriṇaḥ svāhā",
       "translated_text": "May students of <s>brahmacarya</s> come forth to me. Svāhā.",
       "segment_number": 593303
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "damāyantu brahmacāriṇaḥ svāhā",
       "translated_text": "May students of <s>brahmacarya</s> come under self-control. Svāhā.",
       "segment_number": 593304
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "śamāyantu brahmacāriṇaḥ svāhā ||",
       "translated_text": "May students of <s>brahmacarya</s> come in tranquillity. Svāhā.",
       "segment_number": 593305
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_4.3",
      "label": "DCS 4.3"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "yaśo jane 'sāni svāhā",
       "translated_text": "May I be famous among people. Svāhā.",
       "segment_number": 593306
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "śreyān vasyaso 'sāni svāhā",
       "translated_text": "May I be better than the wealthy. Svāhā.",
       "segment_number": 593307
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "taṃ tvā bhaga praviśāni svāhā",
       "translated_text": "Into you, O <s>Bhaga</s>, may I enter. Svāhā.",
       "segment_number": 593308
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "sa mā bhaga praviśa svāhā",
       "translated_text": "May you, O <s>Bhaga</s>, enter into me. Svāhā.",
       "segment_number": 593309
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "tasmin sahasraśākhe nibhagāhaṃ tvayi mṛje svāhā",
       "translated_text": "In you, who have a thousand branches, O <s>Bhaga</s>, may I cleanse myself. Svāhā.",
       "segment_number": 593310
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "yathāpaḥ pravatā yanti yathā māsā aharjaram",
       "translated_text": "As waters go down a slope, as months go to the year,",
       "segment_number": 593311
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "evaṃ māṃ brahmacāriṇaḥ",
       "translated_text": "so may students of <s>brahmacarya</s>",
       "segment_number": 593312
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "dhātarāyantu sarvataḥ svāhā",
       "translated_text": "come to me from every side, O establisher. Svāhā.",
       "segment_number": 593313
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "prativeśo 'si pra mā bhāhi pra mā padyasva ||",
       "translated_text": "You are a neighboring refuge; shine upon me, enter into me.",
       "segment_number": 593314
      }
     ]
    }
   ]
  },
  {
   "tag": "div",
   "attributes": {
    "type": "chapter",
    "n": "5"
   },
   "children": [
    {
     "tag": "head",
     "attributes": {},
     "text": "Chapter 5"
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_5.1",
      "label": "DCS 5.1"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "bhūrbhuvaḥ suvariti vā etāstisro vyāhṛtayaḥ",
       "translated_text": "Bhūḥ, bhuvaḥ, suvaḥ: these indeed are the three <s>vyāhṛtis</s> (sacred utterances).",
       "segment_number": 593315
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "tāsām u ha smaitāṃ caturthīm",
       "translated_text": "Of them, this fourth one",
       "segment_number": 593316
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "māhācamasyaḥ pravedayate",
       "translated_text": "<s>Māhācamasya</s> made known:",
       "segment_number": 593317
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "maha iti",
       "translated_text": "maha, thus.",
       "segment_number": 593318
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "tat brahma",
       "translated_text": "That is <s>brahman</s>.",
       "segment_number": 593319
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "sa ātmā",
       "translated_text": "That is the self.",
       "segment_number": 593320
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "aṅgānyanyā devatāḥ",
       "translated_text": "The other deities are its limbs.",
       "segment_number": 593321
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "bhūriti vā ayaṃ lokaḥ",
       "translated_text": "Bhūḥ indeed is this world;",
       "segment_number": 593322
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "bhuva ityantarikṣam",
       "translated_text": "bhuvaḥ is the midspace;",
       "segment_number": 593323
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "suvarityasau lokaḥ ||",
       "translated_text": "suvaḥ is that world.",
       "segment_number": 593324
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_5.2",
      "label": "DCS 5.2"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "maha ityādityaḥ",
       "translated_text": "Maha is the sun.",
       "segment_number": 593325
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "ādityena vāva sarve lokā mahīyante",
       "translated_text": "By the sun, indeed, all worlds are magnified.",
       "segment_number": 593326
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "bhūriti vā agniḥ",
       "translated_text": "Bhūḥ indeed is fire;",
       "segment_number": 593327
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "bhuva iti vāyuḥ",
       "translated_text": "bhuvaḥ is wind;",
       "segment_number": 593328
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "suvarityādityaḥ",
       "translated_text": "suvaḥ is the sun;",
       "segment_number": 593329
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "maha iti candramāḥ",
       "translated_text": "maha is the moon.",
       "segment_number": 593330
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "candramasā vāva sarvāṇi jyotīṃṣi mahīyante",
       "translated_text": "By the moon, indeed, all lights are magnified.",
       "segment_number": 593331
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "bhūriti vā ṛcaḥ",
       "translated_text": "Bhūḥ indeed is the Ṛg verses;",
       "segment_number": 593332
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "bhuva iti sāmāni",
       "translated_text": "bhuvaḥ is the Sāman chants;",
       "segment_number": 593333
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "suvariti yajūṃṣi ||",
       "translated_text": "suvaḥ is the Yajus formulas.",
       "segment_number": 593334
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_5.3",
      "label": "DCS 5.3"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "maha iti brahma",
       "translated_text": "Maha is <s>brahman</s>.",
       "segment_number": 593335
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "brahmaṇā vāva sarve vedā mahīyante",
       "translated_text": "By <s>brahman</s>, indeed, all the Vedas are magnified.",
       "segment_number": 593336
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "bhūriti vai prāṇaḥ",
       "translated_text": "Bhūḥ indeed is <s>prāṇa</s> (up-breath);",
       "segment_number": 593337
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "bhuva ityapānaḥ",
       "translated_text": "bhuvaḥ is <s>apāna</s> (down-breath);",
       "segment_number": 593338
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "suvariti vyānaḥ",
       "translated_text": "suvaḥ is <s>vyāna</s> (pervading breath);",
       "segment_number": 593339
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "maha ityannam",
       "translated_text": "maha is food.",
       "segment_number": 593340
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "annena vāva sarve prāṇā mahīyante",
       "translated_text": "By food, indeed, all breaths are magnified.",
       "segment_number": 593341
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "tā vā etāścatasraścaturdhā",
       "translated_text": "These, then, are the four, fourfold;",
       "segment_number": 593342
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "catasraścatasro vyāhṛtayaḥ",
       "translated_text": "four and four are the <s>vyāhṛtis</s>.",
       "segment_number": 593343
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "tā yo veda",
       "translated_text": "Whoever knows them",
       "segment_number": 593344
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "sa veda brahma",
       "translated_text": "knows <s>brahman</s>.",
       "segment_number": 593345
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "sarve 'smai devā balimāvahanti ||",
       "translated_text": "All the gods bring offering to him.",
       "segment_number": 593346
      }
     ]
    }
   ]
  },
  {
   "tag": "div",
   "attributes": {
    "type": "chapter",
    "n": "6"
   },
   "children": [
    {
     "tag": "head",
     "attributes": {},
     "text": "Chapter 6"
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_6.1",
      "label": "DCS 6.1"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "sa ya eṣo 'ntarahṛdaya ākāśaḥ",
       "translated_text": "Now that space which is within the heart,",
       "segment_number": 593347
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "tasminnayaṃ puruṣo manomayaḥ",
       "translated_text": "in it is this person made of mind,",
       "segment_number": 593348
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "amṛto hiraṇmayaḥ",
       "translated_text": "immortal and golden.",
       "segment_number": 593349
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "antareṇa tāluke",
       "translated_text": "Between the palates,",
       "segment_number": 593350
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "ya eṣa stana ivāvalaṃbate",
       "translated_text": "this which hangs down like a teat,",
       "segment_number": 593351
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "sendrayoniḥ",
       "translated_text": "is the womb of <s>Indra</s>.",
       "segment_number": 593352
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "yatrāsau keśānto vivartate",
       "translated_text": "Where that end of the hair turns,",
       "segment_number": 593353
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "vyapohya śīrṣakapāle",
       "translated_text": "parting the skull-cap,",
       "segment_number": 593354
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "bhūrityagnau pratitiṣṭhati",
       "translated_text": "with the utterance bhūḥ he is established in fire,",
       "segment_number": 593355
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "bhuva iti vāyau ||",
       "translated_text": "with bhuvaḥ in wind,",
       "segment_number": 593356
      }
     ]
    },
    {
     "tag": "lg",
     "attributes": {
      "id": "DCS_6.2",
      "label": "DCS 6.2"
     },
     "children": [
      {
       "tag": "l",
       "attributes": {},
       "text": "suvarityāditye",
       "translated_text": "with suvaḥ in the sun,",
       "segment_number": 593357
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "maha iti brahmaṇi",
       "translated_text": "with maha in <s>brahman</s>.",
       "segment_number": 593358
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "āpnoti svārājyam",
       "translated_text": "He attains self-sovereignty.",
       "segment_number": 593359
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "āpnoti manasaspatim",
       "translated_text": "He attains lordship over the mind.",
       "segment_number": 593360
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "vākpatiścakṣuṣpatiḥ",
       "translated_text": "He becomes lord of speech and lord of sight,",
       "segment_number": 593361
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "śrotraptirvijñānapatiḥ",
       "translated_text": "lord of hearing and lord of understanding.",
       "segment_number": 593362
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "etattato bhavati",
       "translated_text": "Thereafter he becomes this:",
       "segment_number": 593363
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "ākāśaśarīraṃ brahma",
       "translated_text": "<s>brahman</s>, whose body is space,",
       "segment_number": 593364
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "satyātma prāṇārāmaṃ mana ānandam",
       "translated_text": "whose self is truth, whose delight is breath, whose bliss is mind,",
       "segment_number": 593365
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "śānti samṛddham amṛtam",
       "translated_text": "peaceful, rich, and immortal.",
       "segment_number": 593366
      },
      {
       "tag": "l",
       "attributes": {},
       "text": "iti prācīnayogyopāssva ||",
       "translated_text": "Thus, O <s>Prācīnayogya</s>, worship it.",
       "segment_number": 593367
      }
     ]
    }
   ]
  }
 ]
}
