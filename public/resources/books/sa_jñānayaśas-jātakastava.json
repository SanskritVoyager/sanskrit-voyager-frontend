          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "yat sandoham iva śriyāḥ phalam iva procchrāyi puṇyaujasāṃ",
              "segment_number": 86
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "digdhaṃ raktakaṇaiḥ sphuratkuvalayacchāyābhinīlāyitam",
              "segment_number": 87
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "utpāṭyākṣatalocanadvayam adād viprāya niścakṣuṣe",
              "segment_number": 88
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "tenāndhasya tamasvato 'sya jagatas tuṅgaikadīpo bhavān",
              "segment_number": 89
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 90
            }
          ]
        }
      ]
    },
    {
