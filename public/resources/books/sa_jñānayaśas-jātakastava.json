          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "ity ātmārthanibandhinedam ṛṣivākyālaṃkṛtaṃ darśitaṃ",
              "segment_number": 91
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "leśasyāpi na kīrtanaṃ jina kṛtaṃ tvadvarṇarāśer mama",
              "segment_number": 92
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "tārābdhānavatāṃ jalaṃ jalapurām ākarṣatā vāridher",
              "segment_number": 93
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "velānteṣv iva rodhasāṃ jalalavacchedo hi saṃlakṣyate",
              "segment_number": 94
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 95
            }
          ]
        }
      ]
    },
    {
