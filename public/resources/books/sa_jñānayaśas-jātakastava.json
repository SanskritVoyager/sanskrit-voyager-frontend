          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "tenātyantaparopakāranirataḥ svārthe 'pi mandādaro",
              "segment_number": 98
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "bhūyāt sarvavidāṃ parārthaviduṣāṃ yānaikatāno janaḥ",
              "segment_number": 99
