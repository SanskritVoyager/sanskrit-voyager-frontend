  "body": [
    {
      "tag": "note",
      "attributes": {},
      "text": "metre: Śārdūlavikrīḍita"
    },
    {
      "tag": "lg",
      "attributes": {
        "id": "Js_1"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "kvedaṃ dāśabalaṃ guṇair aśabalaṃ caryāvibhutvaṃ vibho",
              "segment_number": 1
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "janmasyandanikāvivartanajaḍaṃ cetaḥ kva cedaṃ mama",
              "segment_number": 2
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "yenāvandhyaphalodayās tvayi bhavanty abhyāhitāḥ pāṃsavas",
              "segment_number": 3
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "tena stutyanubandhinā mukharatām ālambate bhāratī",
              "segment_number": 4
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 5
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "id": "Js_2"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "cittālambanalaṅghinaḥ śamadṛśām āveṇikāḥ sadguṇā",
              "segment_number": 6
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "vācāṃ gocaratāṃ tu yānti kalayā sthūlā hi vo mādṛśām",
              "segment_number": 7
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "ratnāny ambunidher upāmbupulineṣv āvir bhavanty arthinām",
              "segment_number": 8
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "antarbhinnataraṅgadyotarucakajyotsnāni gṛhṇāti kaḥ",
              "segment_number": 9
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 10
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "id": "Js_3"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "yā vo bodhipathānuyānamahatām utsāhinī karmaṇām",
              "segment_number": 11
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "āsīl lokahitodaye jina kṛpāviṣyandinī santatiḥ",
              "segment_number": 12
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "sānekāpacitaḥ punāti bhagavan saṃkīrtyamānādhunā",
              "segment_number": 13
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "jñeyābhogavisāriṇo gatamalāḥ prāg eva bodhau guṇāḥ",
              "segment_number": 14
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 15
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "id": "Js_4"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "uddāmadviradasya rāgavaśino vṛttiṃ puronmādinīm",
              "segment_number": 16
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "ālokyāvyativartinā praṇihitā bodhau dhiyo yat tvayā",
              "segment_number": 17
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "vinyasyanta ivāmarās tvayi ciraṃ dharmābhiṣekaśriyaṃ",
              "segment_number": 18
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "tenākampitakeśarāntam asṛjan puṣpopahāraṃ divaḥ",
              "segment_number": 19
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 20
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "id": "Js_5"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "kṣudduḥkhaglapitodarīṃ giridarīrandhrāntarālasthitāṃ",
              "segment_number": 21
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "dṛṣtvā śāvakaghālanaikarabhasāṃ vyāghrīṃ dayāghrātadhīḥ",
              "segment_number": 22
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "yat tvaṃ valkalinīṃ jaṭājanavatīṃ mūrtiṃ samutsṛṣṭavāṃs",
              "segment_number": 23
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "trāṇaṃ tena bhavān bhavādrivivaravyāvartināṃ dehinām",
              "segment_number": 24
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 25
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "id": "Js_6"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "yat prāleyasitopalādribahalāṃ mātaṅgatāṃ bibhratā",
              "segment_number": 26
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "kāntārāntaravartināṃ tanubhṛtām ucchittaye vyāpadām",
              "segment_number": 27
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "śailendraṃ pṛthulopalaṃ calayatā muktas tvayātmā taṭān",
              "segment_number": 28
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "manye matsariṇāṃ nitāntamalinās tena kṣatā vṛttayaḥ",
              "segment_number": 29
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 30
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "id": "Js_7"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "yal lokāmbaracandracandravapuṣā candraprabhatve tvayā",
              "segment_number": 31
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "kalmāṣāntaśikhaṃ śikhāmaṇirucā dattaṃ dvijāyārthine",
              "segment_number": 32
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "nālāl lūnam ivāravindam asinā vyutkṛttamūlaṃ śiras",
              "segment_number": 33
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "tenaiṣāṃ jagatāṃ gato 'si gurutām usṇīṣavan mūrdhani",
              "segment_number": 34
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 35
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "id": "Js_8"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "bālān bālasarojakomalatanūn yat putrakān arthine",
              "segment_number": 36
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "paryastākṣacalacchikhaṇḍakabhṛto dārāṃs ca bhāvanugān",
              "segment_number": 37
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "prādās tvaṃ jina tena nūnam ahhavan mārāṅganānāṃ mukhaṃ",
              "segment_number": 38
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "saṃkocāñcitapakṣmalocanadalaṃ lajjālasāmantharam",
              "segment_number": 39
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 40
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "id": "Js_9"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "śayyāsvapnavicāriṇā vanabhuvāṃ bhūtvā purā pakṣiṇā",
              "segment_number": 41
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "bhinnāśeṣakale jagaty avikale jyāyaḥpathāśaṃsinā",
              "segment_number": 42
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "vistāraṃ gamitaṃ vrataṃ vratabhṛtāṃ yan nātha kāpiñjalaṃ",
              "segment_number": 43
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "tenājñānarujāṃ kirīṭakiraṇacchāyās padaṃ vo gatāḥ",
              "segment_number": 44
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 45
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "id": "Js_10"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "yat parṇāmbuphalāśinīṃ śaśatanuṃ tvaṃ nātha bibhrat purā",
              "segment_number": 46
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "tatkālātithaye kṛpāparicayād ātithyam āvedayan",
              "segment_number": 47
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "ārūḍhaḥ sphuṭavisphuliṅgam analaṃ tenādhunāpi kṣitāv",
              "segment_number": 48
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "indor maṇḍalalāñchanaṃ śaśamayaṃ yuṣmadyaśo laksyate",
              "segment_number": 49
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 50
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "id": "Js_11"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "yat kopāruṇadṛṣṭinā kalabhuvā kṛtvā bhruvor bhaṅginīṃ",
              "segment_number": 51
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "lekhām ullasitāsinā vidalitapratyaṅgam āśaṅkinā",
              "segment_number": 52
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "tvām āsīt kṣaṇam apy avikṣatadhiyaṃ tyaktukṣamā na kṣamā",
              "segment_number": 53
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "manye tena niraṅkuśāḥ smaraśarāḥ puṅkheṣu bhaṅgaṃ gatāḥ",
              "segment_number": 54
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 55
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "id": "Js_12"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "yad dveṣī kariṇā cirātatadhanur dantais tvayābhyarcitaḥ",
              "segment_number": 56
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "ṣaḍdantena satā sitonnatabṛhajjīmūtapuñjatviṣā",
              "segment_number": 57
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "kośākarṣaṇavāntabhūrirudhirakṣodāruṇais tena vaḥ",
              "segment_number": 58
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "pātāle 'pi bhujaṃgamaiḥ ślathaphaṇair adyāpi daṃṣtrārcyate",
              "segment_number": 59
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 60
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "id": "Js_13"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "saṃrambhāt phaṇināṃ phaṇāhaticalād bhīmormimālād apāṃ",
              "segment_number": 61
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "patyur yan makaracchaṭāvilulitāt paryastanaukā narāḥ",
              "segment_number": 62
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "premṇā kāyamahāplavena bhavatā tīrāntam āpāditās",
              "segment_number": 63
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "tatkarmātiśayena tena nikhilā lokāḥ kalatrīkrtāḥ",
              "segment_number": 64
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 65
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "id": "Js_14"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "śailān maṇḍalino vilaṅghya viṣayāṃs toyāvalīmekhalān",
              "segment_number": 66
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "yac cintāmaṇinā narendra badaradvīpāntarālodarāt",
              "segment_number": 67
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "labdhvā pūrṇaphalās tvayā praṇayinām āśāvabandhāḥ kṛtās",
              "segment_number": 68
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "tvattas tena samudbhavanti viduṣāṃ saddharmaratnāṅkurāḥ",
              "segment_number": 69
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 70
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "id": "Js_15"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "sāndrābhrāntavitānanīlavapuṣām ojomuṣāṃ rakṣasāṃ",
              "segment_number": 71
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "khaḍgotkṛttadalair vipāṭitaśirārandhrasravallohitaiḥ",
              "segment_number": 72
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "yan māṃsair akṛthāḥ kṣudhāvyupaśamaṃ svair avyapetoṣmabhir",
              "segment_number": 73
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "yogā janmarudho bhavodbhavatṛṣām ucchedinas tena vaḥ",
              "segment_number": 74
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 75
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "id": "Js_16"
