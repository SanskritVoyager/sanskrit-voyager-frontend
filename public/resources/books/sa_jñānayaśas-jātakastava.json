      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "śyenottrāsaviśuṣkakampitagalasyotsaṅgasaṃsarpiṇo",
              "segment_number": 76
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "yan niḥsaṅgaratā śivāya śibinā rājñā satā pakṣiṇaḥ",
              "segment_number": 77
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "raktodgārakalaṅkitātulatulām āropitā te tanur",
              "segment_number": 78
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "māras tena dukūlapakṣmataralaṃ nītas tulālāghavam",
              "segment_number": 79
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 80
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "id": "Js_17"
      },
      "children": [
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "a"
              },
              "text": "lakṣmīm apy avadhūya vāñchitaphalām ākhaṇḍam ādhvaṃsinīṃ",
              "segment_number": 81
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "b"
              },
              "text": "yat tiryakpratisandhibandham adhamaṃ kṛtvā bhavāñ janmanām",
              "segment_number": 82
            }
          ]
        },
        {
          "tag": "l",
          "attributes": {},
          "children": [
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "c"
              },
              "text": "cakre marmabhidāṃ rujāṃ svapiśitaiḥ prābandhakīnāṃ śamaṃ",
              "segment_number": 83
            },
            {
              "tag": "seg",
              "attributes": {
                "type": "pāda",
                "n": "d"
              },
              "text": "tena kleśaviṣacchidāṃ tava dhiyāṃ avyāhatāḥ śaktayaḥ",
              "segment_number": 84
            },
            {
              "tag": "text",
              "text": "//",
              "segment_number": 85
            }
          ]
        }
      ]
    },
    {
      "tag": "lg",
      "attributes": {
        "id": "Js_18"
      },
      "children": [
