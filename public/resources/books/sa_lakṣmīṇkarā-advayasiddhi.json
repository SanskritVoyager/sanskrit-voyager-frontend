  "body": [
    {
      "tag": "div",
      "attributes": {},
      "children": [
        {
          "tag": "head",
          "attributes": {},
          "text": "advayasiddhi",
          "children": [
            {
              "tag": "lb",
              "attributes": {}
            },
            {
              "tag": "text",
              "text": "yoginī lakṣmīṅkarā viracitā",
              "segment_number": 2
            }
          ],
          "segment_number": 1
        },
        {
          "tag": "p",
          "attributes": {},
          "text": "oṃ namaḥ śrīvajrasattvāya",
          "segment_number": 3
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_1"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "prakṛtiprabhāsvaraṃ nāthaṃ sarvajñaṃ tribhavodbhavam /",
              "segment_number": 4
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "praṇamya śirasā vajram īpsitārthaphalapradam //",
              "segment_number": 5
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_2"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "deśakālatithivāranakṣatrair maṇḍalair vinā /",
              "segment_number": 6
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "vakṣye haṃ vajrasattvasya saṃkṣepāt sādhanaṃ param //",
              "segment_number": 7
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_3"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "niyamavratopavāsair akṣaroccāraṇabhāvanaiḥ /",
              "segment_number": 8
            },
            {
              "tag": "l",
              "attributes": {},
              "children": [
                {
                  "tag": "app",
                  "attributes": {},
                  "children": [
                    {
                      "tag": "lem",
                      "attributes": {},
                      "text": "atattvayogo",
                      "segment_number": 9
                    },
                    {
                      "tag": "rdg",
                      "attributes": {
                        "wit": "#Rinpoche1987"
                      },
                      "text": "atattvayogī",
                      "segment_number": 10
                    }
                  ]
                },
                {
                  "tag": "text",
                  "text": "na siddhyet kalpakoṭiśatair api //",
                  "segment_number": 11
                }
              ]
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_4"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "viḍvajrodakabījādyair nāsikābhyantarodbhavaiḥ /",
              "segment_number": 12
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "pūjayed satataṃ mantrī ātmānaṃ tattvabhāvanaiḥ //",
              "segment_number": 13
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_5"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "jananīṃ bhaginīś caiva duhitṛbhāgineyikān /",
              "segment_number": 14
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "prajñnopāyavidhānena pūjayed yogavit sadā //",
              "segment_number": 15
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_6"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "ekāṅgavikalāṃ hīnāṃ śilpanīṃ śvapacīṃ tathā /",
              "segment_number": 16
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "yoṣitāṃ pūjayen nityaṃ jñānavajraprabhāvanaiḥ //",
              "segment_number": 17
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "text": "tatremāni bījapadāni – o",
          "children": [
            {
              "tag": "choice",
              "attributes": {},
              "children": [
                {
                  "tag": "orig",
                  "attributes": {},
                  "text": "ṁ",
                  "segment_number": 19
                },
                {
                  "tag": "reg",
                  "attributes": {},
                  "text": "ṃ",
                  "segment_number": 20
                }
              ]
            },
            {
              "tag": "text",
              "text": "āḥ hū",
              "segment_number": 21
            },
            {
              "tag": "choice",
              "attributes": {},
              "children": [
                {
                  "tag": "orig",
                  "attributes": {},
                  "text": "ṁ",
                  "segment_number": 22
                },
                {
                  "tag": "reg",
                  "attributes": {},
                  "text": "ṃ",
                  "segment_number": 23
                }
              ]
            }
          ],
          "segment_number": 18
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_7"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "yena yena hi baddhyante jantavo raudrakarmaṇā /",
              "segment_number": 24
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "sopāyena tu tenaiva mucyante bhavabandhanāt //",
              "segment_number": 25
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_8"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "samayān aharahaḥ kuryād divyān pañcakulodbhavān /",
              "segment_number": 26
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "pūjayec ca pradīpādyaiḥ sakṣīrair viśvasambhavaiḥ //",
              "segment_number": 27
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_9"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "protphullanayano mantrī nityaṃ prahasitānanaḥ /",
              "segment_number": 28
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "cittam āropya saṃbodhau bhāvayej jñānasāgaram //",
              "segment_number": 29
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_10"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "yāvat sthiracalā bhāvā santy atra tribhavālaye /",
              "segment_number": 30
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "sarve te tattvayogena draṣṭavyā vajradhṛg yathā //",
              "segment_number": 31
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_11"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "paravādinaś ca kecil lingabhedair vyavastitāḥ /",
              "segment_number": 32
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "te 'py atra nāvamantavyā vajrasattvavikurvitaiḥ //",
              "segment_number": 33
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_12"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "sarvān samarasīkrtya bhāvān nairātmyaniḥsṛtān /",
              "segment_number": 34
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "bhāvayet satataṃ mantrī dehaṃ prakṛtinirmalam //",
              "segment_number": 35
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_13"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "gandhamālyādibhir vastrair dhūpanaivedyakais tathā /",
              "segment_number": 36
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "gītavādyais tathā nṛtyaiḥ sopāyair bhajate vibhuḥ //",
              "segment_number": 37
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_14"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "na kaṣṭakalpanāṃ kuryān nopavāsaṃ na ca kriyām /",
              "segment_number": 38
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "snānaṃ śaucaṃ na caivātra grāmadharmavivarjanaṃ //",
              "segment_number": 39
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_15"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "na cāpi vandayed devān kāṣṭhapāṣāṇamṛṇmayān /",
              "segment_number": 40
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "pūjām asyaiva kāyasya kurvān nityaṃ smāhitaḥ //",
              "segment_number": 41
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_16"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "makṣikācchardisaṃmiśrair viṇmūtrādyaiś ca bhāvitaiḥ /",
              "segment_number": 42
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "pañcapradīpasaṃyuktaiḥ pūjayed vajradhāriṇam //",
              "segment_number": 43
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_17"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "abalā svayambhukusumaiḥ sakṣīrair viśvasambhavaiḥ /",
              "segment_number": 44
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "pūjayed devatāṃ tena dehasthāṃ tattvabhāvanaiḥ //",
              "segment_number": 45
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_18"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "parasvaharaṇaṃ kuryāt paradāraniṣevanam /",
              "segment_number": 46
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "vaktavyaṃ ca mṛṣāvākyaṃ sarvabuddhāṃś ca ghātayet //",
              "segment_number": 47
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_19"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "śailamṛṇmayacaityādīn na kuryāt pustake ratim /",
              "segment_number": 48
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "na maṇḍalāni svapne 'pi kāyavākcittakarmaṇā //",
              "segment_number": 49
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_20"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "jugupsāṃ naiva kurvīta sarvavastuṣu mantravit /",
              "segment_number": 50
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "vajrasattvaḥ svayaṃ tatra sākṣād rūpeṇa saṃsthitaḥ //",
              "segment_number": 51
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_21"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "gamyāgamyavikalpaṃ tu bhakṣyābhakṣyaṃ tathaiva ca /",
              "segment_number": 52
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "peyāpeyaṃ tathā mantrī kuryān naiva samāhitaḥ //",
              "segment_number": 53
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_22"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "vairocanasamudbhūtān sarvaprāṇyaṅgasambhavān /",
              "segment_number": 54
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "prāṇakān guhyatattvajño bhakṣayet siddhihetunā //",
              "segment_number": 55
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_23"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "sarvavarṇasamudbhūtā jugupsyā naiva yoṣitaḥ /",
              "segment_number": 56
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "saiva bhagavatī prajñā saṃvṛtyā rūpam āśrityā //",
              "segment_number": 57
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_24"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "na tithir na ca nakṣatraṃ nopavāso vidhīyate /",
              "segment_number": 58
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "advayajñānayuktasya siddhir bhavati saugatī //",
              "segment_number": 59
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_25"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "bahunātra kim uktena yad bhaved upalabdhikam /",
              "segment_number": 60
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "tat sarvaṃ tattvayogena draṣṭavyaṃ tattvavedinā //",
              "segment_number": 61
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_26"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "hastyaśvakharagāvoṣṭrapradīpaṃ śvānasambhavam /",
              "segment_number": 62
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "mahāpradīpasaṃmiśraṃ bhakṣayed yogavit sadā //",
              "segment_number": 63
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_27"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "na cādhyāsaktiṃ kurvīta ekasminn api yogavit /",
              "segment_number": 64
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "samatācittayogena bhāvanīyo bhavārṇavaḥ //",
              "segment_number": 65
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_28"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "utpattisthitinirodhaṃ cāsampṛktaṃ pṛthagjanaiḥ /",
              "segment_number": 66
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "tasya bhāve tu saṃsāro nānyatra pralayodbhavaḥ //",
              "segment_number": 67
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_29"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "dinaṃ tu bhagavān vajrī naktaṃ prajñā vidhīyate /",
              "segment_number": 68
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "evaṃ tu bhāvayed yogī laghu siddhim avāpnuyāt //",
              "segment_number": 69
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_30"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "yat tad avyaktarūpaṃ tu sarvasattveṣu saṃsthitam /",
              "segment_number": 70
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "guruvaktrāt paraṃ tattvaṃ prāpyate nātra samśayaḥ //",
              "segment_number": 71
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_31"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "apratiṣṭhitanirvāṇaṃ nirnimittaṃ nirālayam /",
              "segment_number": 72
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "vyāpakaṃ sarvasattveṣu saṃbodhiḥ paramaṃ padam //",
              "segment_number": 73
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_32"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "evaṃ matvā tu vai yogī yo 'bhyased buddhimān sadā /",
              "segment_number": 74
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "sa siddhyati na sandeho mandapuṇyo 'pi mānavaḥ //",
              "segment_number": 75
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_33"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "ācāryāt parataraṃ nāsti trailokye sacarācare /",
              "segment_number": 76
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "yasya prasādāt prāpyante siddhayo 'nekadhā budhaiḥ //",
              "segment_number": 77
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_34"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "vajrasattvaḥ sa vai jñeyaḥ sarvabuddhair namaskṛtaḥ /",
              "segment_number": 78
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "ācāryaḥ paramo devaḥ pūjanīyaḥ prayatnataḥ //",
              "segment_number": 79
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_35"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "sa eva tathatārūpī lokānugrahahetunā /",
              "segment_number": 80
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "rūpam āśritya saṃvṛtyā saṃsthito yogapīṭhake //",
              "segment_number": 81
            }
          ]
        },
        {
          "tag": "lg",
          "attributes": {
            "id": "ADvS_36"
          },
          "children": [
            {
              "tag": "l",
              "attributes": {},
              "text": "mṛtyur eṣa vikalpo yaṃ na bhāvaḥ sarvavastuṣu /",
              "segment_number": 82
            },
            {
              "tag": "l",
              "attributes": {},
              "text": "hanyate svavikalpena pṛthagjanavijṛmbhitaiḥ //",
              "segment_number": 83
            }
          ]
        },
        {
          "tag": "p",
          "attributes": {},
          "text": "śrīmadoḍīyānavinirgatā mahāyogapīṭhāgatā 'khilayogatantratattvagarbhā śrīlakṣmīmukhakamalād viniḥsṛtā svādhiṣṭhānakramodayā advayasiddhir nāma sādhanopāyikā samāpteti",
          "segment_number": 84
        }
      ]
    }
  ]
}